{
  "manifest_version": 3,
  "name": "Atlas Browser Control",
  "version": "1.0.0",
  "description": "Pair Atlas with a selected Chrome tab for background browser tasks.",
  "permissions": ["debugger", "tabs", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Atlas browser control" }
}
