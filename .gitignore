# Hermes engine runtime home (X2/U0 sync writes here)
data/engine/
# Top-level D:\Atlas\engine is the live Hermes home (config.yaml/logs/installs/
# auth.lock) — machine-local runtime state, never source.
/engine/
.tmp/
data/*.sqlite
data/devices/

# H1 measurement junk (never commit)
**/pytest-temp/
# Whole artifacts/ tree is machine-local measurement output; tracked exceptions
# can be re-included below with !/artifacts/<name>/.
/artifacts/
/artifacts/h8-startup/
/artifacts/h10-live-smoke/
/artifacts/h1r-*/
/artifacts/pytest-*
data/logs/
data/update-status.json
data/build-stamp.json
# MemOS memory engine (local data, config with API key, plugin install) and Atlas memory change log
data/memos-home/
data/memos-plugin/
data/memory_changes.sqlite3
data/memory_paused

# Machine-local clutter (never commit): construction pack + config backups
/.construction-pack/
data/user-settings.json.bak-*
data/library/
