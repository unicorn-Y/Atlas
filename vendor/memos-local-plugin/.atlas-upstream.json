{
  "npm": "@memtensor/memos-local-plugin",
  "version": "2.0.20",
  "repo": "MemTensor/MemOS",
  "repo_path": "apps/memos-local-plugin",
  "build": [
    ["npm", "install", "--legacy-peer-deps", "--ignore-scripts", "--no-audit", "--no-fund"],
    ["npm", "rebuild", "better-sqlite3"],
    ["npm", "run", "build"]
  ],
  "note": "Atlas 追新用：version 是这份 fork 所基于的上游 npm 版本。更新时以该版本为基准，把新版本三方合并进来（见 core/atlas/upstream/forks.py）。"
}
