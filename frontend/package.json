{
  "name": "@atlas/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/electron.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "test:adapter": "vitest run --root .. backend-adapter/tests/client.test.ts",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@atlas/backend-adapter": "file:../backend-adapter",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.1"
  }
}
