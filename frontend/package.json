{
  "name": "@atlas/frontend",
  "version": "0.1.1",
  "description": "Atlas AI Personal Assistant desktop application",
  "author": "Atlas",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/electron.js",
  "scripts": {
    "install:electron": "node ../node_modules/electron/install.js",
    "predev": "npm run install:electron",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && npm run build:preload && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:preload": "node scripts/build-preload.mjs",
    "build": "tsc -p tsconfig.electron.json && npm run build:preload && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "test": "vitest run --root .",
    "test:preload": "npm run build:preload && node scripts/test-preload-bundle.mjs",
    "test:adapter": "vitest run --root .. backend-adapter/tests/client.test.ts",
    "start": "electron .",
    "prestart": "npm run install:electron",
    "package:backend": "node scripts/build-backend.mjs && node scripts/package-sqlite.mjs",
    "package:node": "node scripts/package-node.mjs",
    "clean:packaging": "node scripts/clean-packaging-output.mjs",
    "clean:release": "node scripts/clean-release-output.mjs",
    "dist:win": "npm run clean:release && npm run build && npm run package:backend && npm run package:node && node scripts/stage-electron.mjs && electron-builder --win nsis --x64 --publish never && node scripts/write-release-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@ast-grep/cli": "0.50.0",
    "@atlas/backend-adapter": "file:../backend-adapter",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@playwright/mcp": "0.0.83",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/math": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chrome-devtools-mcp": "1.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.56.0",
    "mermaid": "^12.2.0",
    "motion": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "rehype-highlight": "^7.0.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.atlas.desktop",
    "productName": "Atlas",
    "protocols": [
      {
        "name": "Atlas",
        "schemes": [
          "atlas"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "windows-release"
    },
    "electronDist": "electron-runtime",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "assets/icon/icon-*.png"
    ],
    "extraResources": [
      {
        "from": "dist/dashboard.html",
        "to": "atlas/dashboard/dashboard.html"
      },
      {
        "from": "dist/assets",
        "to": "atlas/dashboard/assets",
        "filter": [
          "dashboard-*",
          "rolldown-runtime-*",
          "jsx-runtime-*",
          "client-*"
        ]
      },
      {
        "from": "../core/atlas",
        "to": "atlas/core/atlas",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "./backend-release/atlas_backend",
        "to": "atlas/backend"
      },
      {
        "from": "./backend-release/runtime/node",
        "to": "atlas/runtime/node"
      },
      {
        "from": "./backend-release/runtime/whatsapp-bridge",
        "to": "atlas/runtime/whatsapp-bridge"
      },
      {
        "from": "../skills",
        "to": "atlas/skills",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../config/atlas.example.toml",
        "to": "atlas/config/atlas.example.toml"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon/icon.ico",
      "uninstallerIcon": "assets/icon/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas"
    },
    "afterPack": "scripts/after-pack-icon.cjs"
  }
}
