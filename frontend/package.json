{
  "name": "@atlas/frontend",
  "version": "0.1.0",
  "description": "Atlas AI Personal Assistant desktop application",
  "author": "Atlas",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/electron.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "test": "vitest run --root .",
    "test:adapter": "vitest run --root .. backend-adapter/tests/client.test.ts",
    "start": "electron .",
    "clean:packaging": "node scripts/clean-packaging-output.mjs",
    "dist:win": "npm run clean:packaging && npm run build && electron-builder --win nsis --x64 --publish never",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@atlas/backend-adapter": "file:../backend-adapter",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.atlas.desktop",
    "productName": "Atlas",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": { "output": "windows-release" },
    "electronDist": "../node_modules/electron/dist",
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "extraResources": [
      { "from": "../core/atlas", "to": "atlas/core/atlas", "filter": ["**/*", "!**/__pycache__", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "../skills", "to": "atlas/skills", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "../config/atlas.example.toml", "to": "atlas/config/atlas.example.toml" }
    ],
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
