{
  "name": "atlas",
  "version": "0.1.0",
  "description": "Atlas - All-in-one AI Personal Assistant",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:backend": "cd core && python -m uvicorn atlas.server:app --reload --port 8765",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm --prefix frontend run build",
    "dev:desktop": "npm --prefix frontend run dev",
    "dist:win": "npm --prefix frontend run dist:win",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop atlas"
  },
  "author": "",
  "license": "UNLICENSED",
  "allowScripts": {
    "electron@44.7.0": true
  }
}
