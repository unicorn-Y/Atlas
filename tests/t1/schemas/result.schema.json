{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/tests/t1/result.schema.json",
  "title": "T1 attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "participant", "track", "model", "task_id", "attempt", "status", "success",
    "check_exit_code", "participant_exit_code", "duration_ms", "total_duration_ms", "tool_calls", "turns", "input_tokens", "output_tokens", "cached_tokens",
    "cost_usd", "changed_files", "forbidden_changes", "test_files_deleted", "junk_files", "runner_error",
    "participant_error", "raw_log_paths", "usage_source", "scenario_events", "fingerprint", "unsupported", "git_diff_path", "approval_changed_files"
  ],
  "properties": {
    "schema_version": {"type": "string"}, "participant": {"type": "string"}, "track": {"type": "string"},
    "model": {"type": ["string", "null"]}, "task_id": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "unsupported", "unavailable", "runner_error", "real_execution_denied", "dry_run"]},
    "success": {"type": ["boolean", "null"]}, "check_exit_code": {"type": ["integer", "null"]},
    "participant_exit_code": {"type": ["integer", "null"]},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "total_duration_ms": {"type": ["number", "null"], "minimum": 0},
    "tool_calls": {"type": ["integer", "null"], "minimum": 0}, "turns": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_tokens": {"type": ["integer", "null"], "minimum": 0}, "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "test_files_deleted": {"type": "array", "items": {"type": "string"}}, "junk_files": {"type": "array", "items": {"type": "string"}},
    "runner_error": {"type": ["string", "null"]}, "participant_error": {"type": ["string", "null"]},
    "raw_log_paths": {"type": "object", "additionalProperties": {"type": "string"}}, "usage_source": {"type": "string"},
    "scenario_events": {"type": "array", "items": {"type": "object"}}, "fingerprint": {"type": ["string", "null"]},
    "unsupported": {"type": "array", "items": {"type": "string"}}, "git_diff_path": {"type": ["string", "null"]},
    "approval_changed_files": {"type": "array", "items": {"type": "string"}}
  }
}
