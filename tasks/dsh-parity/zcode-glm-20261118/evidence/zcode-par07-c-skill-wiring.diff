diff --git a/core/tests/test_skill_sources_dsh.py b/core/tests/test_skill_sources_dsh.py
new file mode 100644
index 00000000..ab4ca7fa
--- /dev/null
+++ b/core/tests/test_skill_sources_dsh.py
@@ -0,0 +1,384 @@
+"""DSH-style skill source ladder: .dsh/.agents roots, custom/runtime/bundled."""
+
+from pathlib import Path
+
+import pytest
+
+from atlas.config import AtlasConfig
+from atlas.skills import (
+    SKILL_SOURCE_PRIORITY,
+    SkillManager,
+    SkillSource,
+    default_skill_sources,
+    skill_source_config_overrides,
+)
+
+pytestmark = pytest.mark.unit
+
+# (ladder key, registered source name), highest priority first.
+LADDER = (
+    ("project-dsh", "project-dsh"),
+    ("project-agents", "project-agents"),
+    ("runtime", "runtime"),
+    ("custom", "custom:custom-root"),
+    ("user-dsh", "user-dsh"),
+    ("user-agents", "user-agents"),
+    ("bundled", "bundled"),
+)
+
+
+def write_skill(root: Path, name: str, description: str, extra: str = "") -> Path:
+    directory = root / name
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / "SKILL.md"
+    path.write_text(
+        f"---\nname: {name}\ndescription: {description}\n{extra}---\nbody of {name}\n",
+        encoding="utf-8",
+    )
+    return path
+
+
+def sources_by_name(**kwargs):
+    return {source.name: source for source in default_skill_sources(**kwargs)}
+
+
+def build_manager(sources: dict[str, SkillSource]) -> SkillManager:
+    manager = SkillManager()
+    for source in sources.values():
+        manager.register_skill_source(source)
+    manager.scan_skills_sync()
+    return manager
+
+
+def ladder_roots(tmp_path: Path) -> dict[str, Path]:
+    workspace = tmp_path / "ws"
+    home = tmp_path / "home"
+    return {
+        "project-dsh": workspace / ".dsh" / "skills",
+        "project-agents": workspace / ".agents" / "skills",
+        "runtime": tmp_path / "runtime-root",
+        "custom": tmp_path / "custom-root",
+        "user-dsh": home / ".dsh" / "skills",
+        "user-agents": home / ".agents" / "skills",
+        "bundled": tmp_path / "bundled-root",
+    }
+
+
+def ladder_sources(tmp_path: Path) -> dict[str, SkillSource]:
+    roots = ladder_roots(tmp_path)
+    return sources_by_name(
+        workspace=tmp_path / "ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "home",
+        custom_skill_dirs=[roots["custom"]],
+        runtime_skills_dir=roots["runtime"],
+        bundled_skills_dir=roots["bundled"],
+    )
+
+
+def write_ladder_copy(root: Path, source_name: str) -> None:
+    if source_name == "bundled":
+        # Bundled roots use the category layout: <root>/<category>/<skill>/SKILL.md.
+        write_skill(root / "packaged", "ladder", f"copy from {source_name}")
+    else:
+        write_skill(root, "ladder", f"copy from {source_name}")
+
+
+def test_dsh_project_roots_join_only_when_present_and_win_same_name(tmp_path: Path) -> None:
+    workspace = tmp_path / "ws"
+    write_skill(workspace / ".dsh" / "skills", "shared", "dsh copy")
+    write_skill(workspace / ".agents" / "skills", "shared", "agents copy")
+    write_skill(workspace / ".claude" / "skills", "shared", "claude copy")
+
+    sources = sources_by_name(
+        workspace=workspace, atlas_home=tmp_path / "atlas", user_home=tmp_path / "home",
+    )
+    assert sources["project-dsh"].priority > sources["project-agents"].priority
+    assert sources["project-agents"].priority > sources["claude-project"].priority
+
+    manager = build_manager(sources)
+    shared = manager.get_skill("shared")
+    assert shared is not None
+    assert shared.source == "project-dsh"
+    assert shared.description == "dsh copy"
+
+    empty = sources_by_name(
+        workspace=tmp_path / "empty", atlas_home=tmp_path / "atlas", user_home=tmp_path / "home",
+    )
+    assert "project-dsh" not in empty and "project-agents" not in empty
+
+
+def test_dsh_user_roots_follow_dsh_precedence(tmp_path: Path) -> None:
+    home = tmp_path / "home"
+    write_skill(home / ".dsh" / "skills", "user-shared", "user dsh")
+    write_skill(home / ".agents" / "skills", "user-shared", "user agents")
+    hermes = tmp_path / "hermes" / "skills"
+    write_skill(hermes / "cat", "user-shared", "hermes copy")
+
+    sources = sources_by_name(
+        atlas_home=tmp_path / "atlas", user_home=home, hermes_skills_dir=hermes,
+    )
+    assert sources["user-dsh"].priority > sources["user-agents"].priority
+    assert sources["user-agents"].priority > sources["hermes"].priority
+    assert sources["hermes"].priority > sources["atlas"].priority
+
+    manager = build_manager(sources)
+    skill = manager.get_skill("user-shared")
+    assert skill is not None and skill.source == "user-dsh"
+
+
+def test_custom_runtime_and_bundled_roots_follow_the_ladder(tmp_path: Path) -> None:
+    custom_a = tmp_path / "custom-a"
+    custom_b = tmp_path / "custom-b"
+    runtime = tmp_path / "runtime"
+    bundled = tmp_path / "bundled"
+    home = tmp_path / "home"
+    write_skill(custom_a, "portable", "custom a")
+    write_skill(custom_b, "portable", "custom b")
+    write_skill(runtime, "portable", "runtime")
+    # Category layout keeps the packaged source scannable.
+    write_skill(bundled / "packaged", "portable", "bundled")
+    write_skill(home / ".dsh" / "skills", "portable", "user dsh")
+
+    sources = sources_by_name(
+        atlas_home=tmp_path / "atlas",
+        user_home=home,
+        custom_skill_dirs=[custom_a, custom_b, tmp_path / "missing"],
+        runtime_skills_dir=runtime,
+        bundled_skills_dir=bundled,
+    )
+    # This used to be a conditional ("if user-dsh exists else True") that was
+    # never exercised; the user-dsh root now exists, so the assertion is real.
+    assert sources["runtime"].priority > sources["custom:custom-a"].priority
+    assert sources["custom:custom-a"].priority > sources["user-dsh"].priority
+    assert sources["custom:custom-b"].priority == sources["custom:custom-a"].priority
+    assert sources["bundled"].priority < sources["atlas"].priority
+    assert "custom:missing" not in sources
+
+    manager = build_manager(sources)
+    portable = manager.get_skill("portable")
+    assert portable is not None and portable.source == "runtime"
+
+
+def test_invocation_policy_survives_new_sources(tmp_path: Path) -> None:
+    workspace = tmp_path / "ws"
+    write_skill(
+        workspace / ".dsh" / "skills", "manual-only", "human only",
+        "disable-model-invocation: true\nuser-invocable: false\n",
+    )
+    sources = sources_by_name(
+        workspace=workspace, atlas_home=tmp_path / "atlas", user_home=tmp_path / "home",
+    )
+    manager = build_manager(sources)
+    skill = manager.get_skill("manual-only")
+    assert skill is not None
+    assert skill.disable_model_invocation is True
+    assert skill.user_invocable is False
+
+
+def test_absent_dsh_roots_leave_the_source_list_unchanged(tmp_path: Path) -> None:
+    names = [source.name for source in default_skill_sources(
+        workspace=tmp_path / "empty-ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "empty-home",
+    )]
+    assert names == ["atlas", "library", "claude-user", "claude-project"]
+    no_workspace = [source.name for source in default_skill_sources(
+        atlas_home=tmp_path / "atlas", user_home=tmp_path / "empty-home",
+    )]
+    assert no_workspace == ["atlas", "library", "claude-user"]
+
+
+def test_extension_config_absent_or_invalid_values_change_nothing(tmp_path: Path) -> None:
+    defaults = [source.name for source in default_skill_sources(
+        workspace=tmp_path / "empty-ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "empty-home",
+    )]
+    assert skill_source_config_overrides(None) == {}
+    assert skill_source_config_overrides(AtlasConfig({})) == {}
+    assert skill_source_config_overrides(
+        AtlasConfig({"extensions": {"custom_skill_dirs": 42, "runtime_skills_dir": []}}),
+    ) == {}
+
+    overrides = skill_source_config_overrides(AtlasConfig({"extensions": {
+        "custom_skill_dirs": [],
+        "runtime_skills_dir": "   ",
+        "bundled_skills_dir": str(tmp_path / "missing-bundled"),
+    }}))
+    assert overrides == {"bundled_skills_dir": str(tmp_path / "missing-bundled")}
+    names = [source.name for source in default_skill_sources(
+        workspace=tmp_path / "empty-ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "empty-home",
+        **overrides,
+    )]
+    assert names == defaults
+
+
+def test_extension_config_wires_custom_runtime_and_bundled_roots(tmp_path: Path) -> None:
+    custom = tmp_path / "custom-root"
+    runtime = tmp_path / "runtime-root"
+    bundled = tmp_path / "bundled-root"
+    write_skill(custom, "wired", "custom")
+    write_skill(runtime, "wired", "runtime")
+    write_skill(bundled / "packaged", "wired", "bundled")
+
+    cfg = AtlasConfig({"extensions": {
+        "custom_skill_dirs": [str(custom), str(tmp_path / "missing")],
+        "runtime_skills_dir": str(runtime),
+        "bundled_skills_dir": str(bundled),
+    }})
+    overrides = skill_source_config_overrides(cfg)
+    assert overrides == {
+        "custom_skill_dirs": [str(custom), str(tmp_path / "missing")],
+        "runtime_skills_dir": str(runtime),
+        "bundled_skills_dir": str(bundled),
+    }
+    # A single string is accepted like ``extensions.hermes_skills`` is.
+    assert skill_source_config_overrides(
+        AtlasConfig({"extensions": {"custom_skill_dirs": str(custom)}}),
+    ) == {"custom_skill_dirs": [str(custom)]}
+
+    sources = sources_by_name(
+        workspace=tmp_path / "ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "home",
+        **overrides,
+    )
+    assert "custom:custom-root" in sources
+    assert "runtime" in sources
+    assert "bundled" in sources
+    assert "custom:missing" not in sources
+
+    manager = build_manager(sources)
+    wired = manager.get_skill("wired")
+    assert wired is not None and wired.source == "runtime"
+
+
+def test_project_sources_do_not_escape_the_workspace(tmp_path: Path) -> None:
+    workspace = tmp_path / "ws"
+    sibling = tmp_path / "sibling"
+    write_skill(sibling / ".dsh" / "skills", "sibling-dsh", "sibling dsh")
+    write_skill(sibling / ".agents" / "skills", "sibling-agents", "sibling agents")
+    # Only <workspace>/.dsh/skills is a project root; nested copies are not.
+    write_skill(workspace / "nested" / ".dsh" / "skills", "nested-dsh", "nested dsh")
+    write_skill(workspace / "nested" / ".agents" / "skills", "nested-agents", "nested agents")
+
+    sources = sources_by_name(
+        workspace=workspace, atlas_home=tmp_path / "atlas", user_home=tmp_path / "home",
+    )
+    assert "project-dsh" not in sources and "project-agents" not in sources
+    manager = build_manager(sources)
+    assert manager.get_skill("sibling-dsh") is None
+    assert manager.get_skill("sibling-agents") is None
+    assert manager.get_skill("nested-dsh") is None
+    assert manager.get_skill("nested-agents") is None
+
+    write_skill(workspace / ".dsh" / "skills", "own-dsh", "own dsh")
+    write_skill(workspace / ".agents" / "skills", "own-agents", "own agents")
+    sources = sources_by_name(
+        workspace=workspace, atlas_home=tmp_path / "atlas", user_home=tmp_path / "home",
+    )
+    assert sources["project-dsh"].root == workspace / ".dsh" / "skills"
+    assert sources["project-agents"].root == workspace / ".agents" / "skills"
+    manager = build_manager(sources)
+    assert manager.get_skill("own-dsh").source == "project-dsh"
+    assert manager.get_skill("own-agents").source == "project-agents"
+    assert manager.get_skill("sibling-dsh") is None
+
