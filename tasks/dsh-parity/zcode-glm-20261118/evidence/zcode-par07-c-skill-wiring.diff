+def skill_source_config_overrides(config: Any | None) -> dict[str, Any]:
+    """Translate the ``[extensions]`` skill-root keys into source kwargs.
+
+    Reuses the plain-config convention already used for
+    ``extensions.hermes_skills`` (no separate schema registry): values are read
+    from ``atlas.toml``/the expert overlay through ``AtlasConfig.get``. The
+    keys are:
+
+    - ``extensions.custom_skill_dirs``: one path or a list of paths, each
+      becoming its own ``custom:<name>`` source (priority 22).
+    - ``extensions.runtime_skills_dir``: one directory (priority 25).
+    - ``extensions.bundled_skills_dir``: one directory (priority 5).
+
+    Missing, blank and wrongly-typed values are ignored, so a stale config can
+    never prevent boot. The returned paths are passed through unchanged to
+    :func:`default_skill_sources`, which drops any that are not directories.
+    """
+    if config is None:
+        return {}
+    overrides: dict[str, Any] = {}
+    custom = config.get("extensions.custom_skill_dirs", None)
+    if isinstance(custom, str):
+        custom = [custom]
+    if isinstance(custom, (list, tuple)):
+        directories = [
+            value.strip() for value in custom
+            if isinstance(value, str) and value.strip()
+        ]
+        if directories:
+            overrides["custom_skill_dirs"] = directories
+    for key, kwargs_key in (
+        ("extensions.runtime_skills_dir", "runtime_skills_dir"),
+        ("extensions.bundled_skills_dir", "bundled_skills_dir"),
+    ):
+        value = config.get(key, None)
+        if isinstance(value, str) and value.strip():
+            overrides[kwargs_key] = value.strip()
+    return overrides
+
