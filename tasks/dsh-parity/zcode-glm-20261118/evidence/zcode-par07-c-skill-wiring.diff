+def test_runtime_root_is_a_filesystem_source_only(tmp_path: Path) -> None:
+    runtime = tmp_path / "runtime-root"
+    missing = tmp_path / "missing-runtime"
+    sources = sources_by_name(
+        workspace=tmp_path / "ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "home",
+        runtime_skills_dir=missing,
+    )
+    assert "runtime" not in sources
+
+    # A plain file is not a skill root: the source gate is is_dir(), not a
+    # provider call, so nothing can appear without an on-disk directory.
+    runtime.write_text("not a directory", encoding="utf-8")
+    sources = sources_by_name(
+        workspace=tmp_path / "ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "home",
+        runtime_skills_dir=runtime,
+    )
+    assert "runtime" not in sources
+
+    runtime.unlink()
+    runtime.mkdir()
+    write_skill(runtime, "disk-only", "on disk")
+    sources = sources_by_name(
+        workspace=tmp_path / "ws",
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "home",
+        runtime_skills_dir=runtime,
+    )
+    assert sources["runtime"].root == runtime
+    manager = build_manager(sources)
+    skill = manager.get_skill("disk-only")
+    assert skill is not None and skill.source == "runtime"
+    assert Path(skill.path) == runtime / "disk-only" / "SKILL.md"
+    runtime_skills = [
+        item.name for item in manager.list_skills() if item.source == "runtime"
+    ]
+    assert runtime_skills == ["disk-only"]
+
+
+def test_same_name_precedence_walks_the_whole_dsh_ladder(tmp_path: Path) -> None:
+    roots = ladder_roots(tmp_path)
+    for key, source_name in LADDER:
+        write_ladder_copy(roots[key], source_name)
+
+    sources = ladder_sources(tmp_path)
+    present = [sources[source_name] for _key, source_name in LADDER]
+    assert [source.priority for source in present] == [
+        SKILL_SOURCE_PRIORITY[key] for key, _source_name in LADDER
+    ]
+    assert all(
+        higher.priority > lower.priority
+        for higher, lower in zip(present, present[1:])
+    )
+
+    manager = build_manager(sources)
+    winner = manager.get_skill("ladder")
+    assert winner is not None
+    assert winner.source == "project-dsh"
+    assert winner.description == "copy from project-dsh"
+    assert Path(winner.path) == roots["project-dsh"] / "ladder" / "SKILL.md"
+
+
+@pytest.mark.parametrize(
+    ("higher", "lower"),
+    list(zip(LADDER, LADDER[1:])),
+    ids=[f"{high[0]}-beats-{low[0]}" for high, low in zip(LADDER, LADDER[1:])],
+)
+def test_adjacent_dual_source_same_name_prefers_higher_priority(
+    tmp_path: Path,
+    higher: tuple[str, str],
+    lower: tuple[str, str],
+) -> None:
+    """Real two-source resolution: the higher ladder rung owns the duplicate."""
+    higher_key, higher_name = higher
+    lower_key, lower_name = lower
+    roots = ladder_roots(tmp_path)
+    write_ladder_copy(roots[higher_key], higher_name)
+    write_ladder_copy(roots[lower_key], lower_name)
+
+    sources = ladder_sources(tmp_path)
+    assert sources[higher_name].priority > sources[lower_name].priority
+    manager = SkillManager()
+    manager.register_skill_source(sources[higher_name])
+    manager.register_skill_source(sources[lower_name])
+    manager.scan_skills_sync()
+
+    winner = manager.get_skill("ladder")
+    assert winner is not None
+    assert winner.source == higher_name
+    assert winner.description == f"copy from {higher_name}"
+    assert Path(winner.path).parent.parent == roots[higher_key]
