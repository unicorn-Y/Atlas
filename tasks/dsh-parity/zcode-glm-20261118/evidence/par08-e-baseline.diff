+            natural_exit = True
+        finally:
+            if process.poll() is None:
+                if process.stdin and not process.stdin.closed:
+                    process.stdin.close()
+                try:
+                    process.terminate()
+                    process.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=3)
