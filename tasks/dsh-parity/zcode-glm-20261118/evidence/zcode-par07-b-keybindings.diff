@@ -0,0 +1,132 @@
+import { act, create, type ReactTestRenderer } from 'react-test-renderer';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import ShortcutsPanel from './ShortcutsPanel';
+import type { KeybindingsDocument, KeybindingsMap } from '../services/keybindings';
+
+let state: KeybindingsDocument;
+let writes: Array<{ bindings: KeybindingsMap; expected: string | null }>;
+let version: number;
+
+function response(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+}
+
+const fetchMock = vi.fn(async (_input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+  if (init?.method === 'PUT') {
+    const body = JSON.parse(String(init.body)) as { bindings: KeybindingsMap; expected_revision: string | null };
+    writes.push({ bindings: body.bindings, expected: body.expected_revision });
+    if (body.expected_revision !== state.revision) {
+      return response({ detail: 'keybindings.json 已被其他窗口修改，请重新加载后再保存' }, 409);
+    }
+    state = {
+      bindings: body.bindings,
+      revision: `rev-${++version}`,
+      updated_at: version,
+    };
+    return response(state);
+  }
+  return response({
+    bindings: state.bindings,
+    updated_at: state.revision === null ? -1 : state.updated_at,
+    revision: state.revision,
+  });
+});
+
+function installStorage(): Map<string, string> {
+  const values = new Map<string, string>();
+  vi.stubGlobal('localStorage', {
+    getItem: (key: string) => values.get(key) ?? null,
+    setItem: (key: string, value: string) => { values.set(key, value); },
+    removeItem: (key: string) => { values.delete(key); },
+    clear: () => values.clear(),
+  });
+  return values;
+}
+
+async function renderPanel(): Promise<ReactTestRenderer> {
+  let view!: ReactTestRenderer;
+  await act(async () => { view = create(<ShortcutsPanel apiBaseUrl="http://127.0.0.1:8765" />); });
+  return view;
+}
+
+/** Records Ctrl+Alt+U for the first binding of the palette action. */
+async function changePaletteBinding(view: ReactTestRenderer): Promise<void> {
+  const label = { 'aria-label': '修改「搜索与命令」的第 1 组快捷键' };
+  act(() => { view.root.findByProps(label).props.onClick(); });
+  // Ctrl+Alt+U is free in SHORTCUTS and is not a reserved combo.
+  const native = {
+    key: 'u', ctrlKey: true, altKey: true, metaKey: false, shiftKey: false,
+    isComposing: false, keyCode: 85,
+  };
+  const event = { ...native, nativeEvent: native, preventDefault: vi.fn(), stopPropagation: vi.fn() };
+  await act(async () => { view.root.findByProps(label).props.onKeyDown(event); });
+}
+
+function buttonWithText(view: ReactTestRenderer, text: string) {
+  return view.root.findAllByType('button').find((button) => button.children.includes(text));
+}
+
+beforeEach(() => {
+  version = 1;
+  state = { bindings: { palette: ['Ctrl+K'], newTask: ['Ctrl+N'] }, revision: 'rev-1', updated_at: 1 };
+  writes = [];
+  vi.stubGlobal('window', new EventTarget());
+  installStorage();
+  vi.stubGlobal('fetch', fetchMock);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.clearAllMocks();
+});
+
+describe('ShortcutsPanel keybindings CAS', () => {
+  it('keeps the local edit on 409 and reloads the file instead of overwriting another window', async () => {
+    const view = await renderPanel();
+    // The other window saves after this panel read revision rev-1.
+    state = { bindings: { palette: ['Ctrl+P'], newTask: ['Ctrl+N'] }, revision: 'rev-2', updated_at: 2 };
+
+    await changePaletteBinding(view);
+
+    expect(writes.at(-1)?.expected).toBe('rev-1');
+    expect(writes.at(-1)?.bindings.palette).toEqual(['Ctrl+Alt+U']);
+    expect(writes.at(-1)?.bindings.newTask).toEqual(['Ctrl+N']);
+    expect(state.bindings.palette).toEqual(['Ctrl+P']);
+    expect(JSON.stringify(view.toJSON())).toContain('保存冲突');
+    expect(JSON.stringify(view.toJSON())).toContain('用本机改动重试保存');
+    // The pending local preference stays in the localStorage cache.
+    const cached = JSON.parse(localStorage.getItem('atlas.shortcuts') ?? '{}') as Record<string, string[]>;
+    expect(cached.palette).toEqual(['Ctrl+Alt+U']);
+
+    const reload = buttonWithText(view, '重新加载');
+    expect(reload).toBeDefined();
+    await act(async () => { reload!.props.onClick(); });
+
+    const reloaded = JSON.parse(localStorage.getItem('atlas.shortcuts') ?? '{}') as Record<string, string[]>;
+    expect(reloaded.palette).toEqual(['Ctrl+P']);
+    expect(JSON.stringify(view.toJSON())).not.toContain('保存冲突');
+    expect(JSON.stringify(view.toJSON())).toContain('已重新加载 keybindings.json');
+    expect(state.bindings.palette).toEqual(['Ctrl+P']);
+    act(() => view.unmount());
+  });
+
+  it('refreshes the revision and retries the pending local edit after the user asks for it', async () => {
+    const view = await renderPanel();
+    state = { bindings: { palette: ['Ctrl+P'], newTask: ['Ctrl+N'] }, revision: 'rev-2', updated_at: 2 };
+    await changePaletteBinding(view);
+
+    const retry = buttonWithText(view, '用本机改动重试保存');
+    expect(retry).toBeDefined();
+    await act(async () => { retry!.props.onClick(); });
+
+    expect(writes.at(-1)?.expected).toBe('rev-2');
+    expect(writes.at(-1)?.bindings.palette).toEqual(['Ctrl+Alt+U']);
+    expect(writes.at(-1)?.bindings.newTask).toEqual(['Ctrl+N']);
+    expect(state.bindings.palette).toEqual(['Ctrl+Alt+U']);
+    const cached = JSON.parse(localStorage.getItem('atlas.shortcuts') ?? '{}') as Record<string, string[]>;
+    expect(cached.palette).toEqual(['Ctrl+Alt+U']);
+    expect(JSON.stringify(view.toJSON())).not.toContain('保存冲突');
+    expect(JSON.stringify(view.toJSON())).toContain('已按本机改动重新保存');
+    act(() => view.unmount());
+  });
+});
