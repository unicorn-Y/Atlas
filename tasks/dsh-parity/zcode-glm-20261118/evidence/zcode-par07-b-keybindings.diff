+/**
+ * Device-level keybindings persisted to data/keybindings.json.
+ *
+ * The backend exposes a content-hash `revision` (sha256 of the file bytes) and
+ * accepts `expected_revision` on PUT. Passing the revision that was read makes
+ * the write compare-and-swap: another window that saved in between gets a 409
+ * instead of silently replacing the newer file. A null revision means the file
+ * does not exist yet, so the first save must send null.
+ *
+ * localStorage stays the local cache; this module only owns the file contract.
+ */
+export type KeybindingsMap = Record<string, string[]>;
+
+export type KeybindingsDocument = {
+  bindings: KeybindingsMap;
+  updated_at: number;
+  revision: string | null;
+};
+
+export const KEYBINDINGS_CONFLICT_MESSAGE = 'keybindings.json 已被其他窗口修改，请重新加载后再保存';
+
+export class KeybindingsConflictError extends Error {
+  constructor(message = KEYBINDINGS_CONFLICT_MESSAGE) {
+    super(message);
+    this.name = 'KeybindingsConflictError';
+  }
+}
+
+export class KeybindingsRequestError extends Error {
+  readonly status: number;
+
+  constructor(status: number, message: string) {
+    super(message);
+    this.name = 'KeybindingsRequestError';
+    this.status = status;
+  }
+}
+
+export interface KeybindingsTransport {
+  read(): Promise<KeybindingsDocument>;
+  write(bindings: KeybindingsMap, expectedRevision: string | null): Promise<KeybindingsDocument>;
+}
+
+/** Keeps only action id -> string[] entries so a malformed document cannot break the UI. */
+export function normalizeKeybindings(value: unknown): KeybindingsMap {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return {};
+  const bindings: KeybindingsMap = {};
+  for (const [action, combos] of Object.entries(value)) {
+    if (Array.isArray(combos) && combos.every((combo) => typeof combo === 'string')) {
+      bindings[action] = [...combos];
+    }
+  }
+  return bindings;
+}
+
+/** Accepts current responses and legacy responses that predate the revision field. */
+export function normalizeKeybindingsDocument(value: unknown): KeybindingsDocument {
+  const source = value && typeof value === 'object' && !Array.isArray(value)
+    ? value as Record<string, unknown>
+    : {};
+  return {
+    bindings: normalizeKeybindings(source.bindings),
+    updated_at: typeof source.updated_at === 'number' ? source.updated_at : -1,
+    revision: typeof source.revision === 'string' && source.revision ? source.revision : null,
+  };
+}
+
+type FetchLike = (input: string, init?: RequestInit) => Promise<Response>;
+
+async function parseKeybindingsResponse(response: Response): Promise<KeybindingsDocument> {
+  if (!response.ok) {
+    let detail = '';
+    try {
+      const body = await response.json() as { detail?: unknown };
+      detail = typeof body?.detail === 'string' ? body.detail : JSON.stringify(body?.detail ?? body);
+    } catch { /* non-JSON error */ }
+    if (response.status === 409) throw new KeybindingsConflictError(detail || KEYBINDINGS_CONFLICT_MESSAGE);
+    throw new KeybindingsRequestError(
+      response.status,
+      detail ? `HTTP ${response.status}：${detail}` : `HTTP ${response.status}`,
+    );
+  }
+  return normalizeKeybindingsDocument(await response.json());
+}
+
+export function createHttpKeybindingsTransport(
+  apiBaseUrl: string,
+  fetchImpl: FetchLike = fetch,
+): KeybindingsTransport {
+  const url = `${apiBaseUrl}/api/u6/keybindings`;
+  return {
+    read: async () => parseKeybindingsResponse(await fetchImpl(url)),
+    write: async (bindings, expectedRevision) => parseKeybindingsResponse(await fetchImpl(url, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ bindings, expected_revision: expectedRevision }),
+    })),
+  };
+}
+
+/**
+ * Serialized compare-and-swap writer for one renderer window.
+ *
+ * Saves are queued so rapid edits cannot race each other with the same
+ * revision. A 409 marks the instance as needing a reload; subsequent saves
+ * refuse until `refresh()`/`retry()` adopts the newer revision, so the
+ * conflicted local change is never written implicitly.
+ */
+export class KeybindingsSync {
+  private revision: string | null | undefined;
+  private stale = false;
+  private queue: Promise<unknown> = Promise.resolve();
+
+  constructor(private readonly transport: KeybindingsTransport) {}
+
+  /** undefined = never read; null = file missing at last read. */
+  get currentRevision(): string | null | undefined { return this.revision; }
+
+  get needsReload(): boolean { return this.stale; }
+
+  private enqueue<T>(task: () => Promise<T>): Promise<T> {
+    const result = this.queue.then(task, task);
+    this.queue = result.then(() => undefined, () => undefined);
+    return result;
+  }
+
+  /** Reads the file and adopts its revision. */
+  refresh(): Promise<KeybindingsDocument> {
+    return this.enqueue(async () => {
+      const document = await this.transport.read();
+      this.revision = document.revision;
+      this.stale = false;
+      return document;
+    });
+  }
+
+  /** PUT with the revision read earlier. First create sends null. */
+  save(bindings: KeybindingsMap): Promise<KeybindingsDocument> {
+    return this.enqueue(async () => {
+      if (this.stale) throw new KeybindingsConflictError();
+      if (this.revision === undefined) {
+        const loaded = await this.transport.read();
+        this.revision = loaded.revision;
+      }
+      try {
+        const document = await this.transport.write(bindings, this.revision ?? null);
+        this.revision = document.revision;
+        return document;
+      } catch (error) {
+        if (error instanceof KeybindingsConflictError) this.stale = true;
+        throw error;
+      }
+    });
+  }
+
+  /** Explicit user-approved retry: read the latest revision, then write local changes. */
+  retry(bindings: KeybindingsMap): Promise<KeybindingsDocument> {
+    return this.enqueue(async () => {
+      const latest = await this.transport.read();
+      this.revision = latest.revision;
+      this.stale = false;
+      try {
+        const document = await this.transport.write(bindings, this.revision);
+        this.revision = document.revision;
+        return document;
+      } catch (error) {
+        if (error instanceof KeybindingsConflictError) this.stale = true;
+        throw error;
+      }
+    });
+  }
+}
