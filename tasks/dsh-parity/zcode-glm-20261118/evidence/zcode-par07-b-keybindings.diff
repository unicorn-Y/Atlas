+import { describe, expect, it } from 'vitest';
+import {
+  createHttpKeybindingsTransport,
+  KeybindingsConflictError,
+  KeybindingsSync,
+  normalizeKeybindingsDocument,
+  type KeybindingsDocument,
+  type KeybindingsMap,
+  type KeybindingsTransport,
+} from './keybindings';
+
+/** Small stateful stand-in for the FastAPI keybindings routes (content-revision CAS). */
+class FakeKeybindingsServer {
+  bindings: KeybindingsMap | null = null;
+  revision: string | null = null;
+  updated_at = -1;
+  writes: Array<{ bindings: KeybindingsMap; expected: string | null }> = [];
+  reads = 0;
+  private version = 0;
+
+  constructor(initial?: KeybindingsMap) {
+    if (initial) {
+      this.bindings = JSON.parse(JSON.stringify(initial)) as KeybindingsMap;
+      this.revision = this.nextRevision();
+      this.updated_at = this.version;
+    }
+  }
+
+  private nextRevision(): string {
+    this.version += 1;
+    return `rev-${this.version}`;
+  }
+
+  read(): KeybindingsDocument {
+    this.reads += 1;
+    return {
+      bindings: this.bindings ? JSON.parse(JSON.stringify(this.bindings)) as KeybindingsMap : {},
+      updated_at: this.updated_at,
+      revision: this.revision,
+    };
+  }
+
+  write(bindings: KeybindingsMap, expected: string | null): KeybindingsDocument {
+    this.writes.push({ bindings, expected });
+    if (expected !== this.revision) throw new KeybindingsConflictError();
+    this.bindings = JSON.parse(JSON.stringify(bindings)) as KeybindingsMap;
+    this.revision = this.nextRevision();
+    this.updated_at = this.version;
+    return {
+      bindings: JSON.parse(JSON.stringify(this.bindings)) as KeybindingsMap,
+      updated_at: this.updated_at,
+      revision: this.revision,
+    };
+  }
+}
+
+function transportFor(server: FakeKeybindingsServer): KeybindingsTransport {
+  return {
+    read: async () => server.read(),
+    write: async (bindings, expected) => server.write(bindings, expected),
+  };
+}
+
+describe('KeybindingsSync compare-and-swap', () => {
+  it('rejects the second writer that started from the same revision and keeps the winner', async () => {
+    const server = new FakeKeybindingsServer({ palette: ['Ctrl+K'] });
+    const first = new KeybindingsSync(transportFor(server));
+    const second = new KeybindingsSync(transportFor(server));
+    await first.refresh();
+    await second.refresh();
+    const baseline = server.revision;
+
+    await first.save({ palette: ['Ctrl+P'] });
+    await expect(second.save({ palette: ['Ctrl+O'] })).rejects.toBeInstanceOf(KeybindingsConflictError);
+
+    expect(server.writes).toHaveLength(2);
+    expect(server.writes[0].expected).toBe(baseline);
+    expect(server.writes[1].expected).toBe(baseline);
+    expect(server.bindings).toEqual({ palette: ['Ctrl+P'] });
+    expect(second.needsReload).toBe(true);
+  });
+
+  it('succeeds after refresh adopts the winning revision, and retry does the read before writing', async () => {
+    const server = new FakeKeybindingsServer({ palette: ['Ctrl+K'] });
+    const first = new KeybindingsSync(transportFor(server));
+    const second = new KeybindingsSync(transportFor(server));
+    await first.refresh();
+    await second.refresh();
+    await first.save({ palette: ['Ctrl+P'] });
+    await expect(second.save({ palette: ['Ctrl+O'] })).rejects.toBeInstanceOf(KeybindingsConflictError);
+
+    const latest = await second.refresh();
+    expect(latest.bindings).toEqual({ palette: ['Ctrl+P'] });
+    expect(second.needsReload).toBe(false);
+    const retried = await second.retry({ palette: ['Ctrl+O'] });
+    expect(retried.revision).toBe(server.revision);
+    expect(server.bindings).toEqual({ palette: ['Ctrl+O'] });
+    expect(server.writes.at(-1)?.expected).toBe(latest.revision);
+  });
+
+  it('sends expected_revision null for the first create', async () => {
+    const server = new FakeKeybindingsServer();
+    const sync = new KeybindingsSync(transportFor(server));
+
+    await sync.save({ palette: ['Ctrl+K'] });
+
+    expect(server.reads).toBe(1);
+    expect(server.writes).toEqual([{ bindings: { palette: ['Ctrl+K'] }, expected: null }]);
+    expect(sync.currentRevision).toBe(server.revision);
+  });
+
+  it('reads a legacy document without a revision field and treats it as the null baseline', async () => {
+    const legacy = normalizeKeybindingsDocument({
+      bindings: { palette: ['Ctrl+Shift+K'], newTask: [] },
+      updated_at: 123,
+    });
+    expect(legacy).toEqual({
+      bindings: { palette: ['Ctrl+Shift+K'], newTask: [] },
+      updated_at: 123,
+      revision: null,
+    });
+
+    const expectations: Array<string | null> = [];
+    const sync = new KeybindingsSync({
+      read: async () => legacy,
+      write: async (bindings, expected) => {
+        expectations.push(expected);
+        return { bindings, updated_at: 124, revision: 'rev-new' };
+      },
+    });
+
+    const read = await sync.refresh();
+    expect(read.bindings).toEqual({ palette: ['Ctrl+Shift+K'], newTask: [] });
+    await sync.save({ palette: ['Ctrl+Alt+K'] });
+    expect(expectations).toEqual([null]);
+  });
+});
+
+describe('HTTP keybindings transport', () => {
+  it('PUTs bindings together with the expected revision and maps 409 to a conflict error', async () => {
+    const calls: Array<{ input: string; init?: RequestInit }> = [];
+    const fetchImpl = async (input: string, init?: RequestInit): Promise<Response> => {
+      calls.push({ input, init });
+      if (!init) {
+        return new Response(JSON.stringify({
+          bindings: { palette: ['Ctrl+K'] }, updated_at: 7, revision: 'rev-1',
+        }), { status: 200, headers: { 'Content-Type': 'application/json' } });
+      }
+      return new Response(JSON.stringify({ detail: 'keybindings.json 已被其他窗口修改，请重新加载后再保存' }), {
+        status: 409,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    };
+    const transport = createHttpKeybindingsTransport('http://127.0.0.1:8765', fetchImpl);
+
+    const document = await transport.read();
+    expect(document.revision).toBe('rev-1');
+    await expect(transport.write({ palette: ['Ctrl+P'] }, 'rev-1')).rejects.toBeInstanceOf(KeybindingsConflictError);
+
+    const put = calls[1];
+    expect(put?.input).toBe('http://127.0.0.1:8765/api/u6/keybindings');
+    expect(put?.init?.method).toBe('PUT');
+    expect(JSON.parse(String(put?.init?.body))).toEqual({
+      bindings: { palette: ['Ctrl+P'] },
+      expected_revision: 'rev-1',
+    });
+  });
+});
