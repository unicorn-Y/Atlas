+"""Keybindings persistence: content revision CAS and atomic replacement."""
+
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from atlas.api import u6_router
+
+pytestmark = pytest.mark.unit
+
+
+@pytest.fixture
+def client(tmp_path: Path, monkeypatch) -> TestClient:
+    monkeypatch.setattr("atlas.config.DATA_ROOT", tmp_path)
+    app = FastAPI()
+    app.include_router(u6_router.router)
+    return TestClient(app)
+
+
+@pytest.fixture
+def keybindings_path(tmp_path: Path) -> Path:
+    return tmp_path / "data" / "keybindings.json"
+
+
+def test_missing_file_reads_empty_with_null_revision(client: TestClient) -> None:
+    response = client.get("/api/u6/keybindings")
+    assert response.status_code == 200
+    assert response.json() == {"bindings": {}, "updated_at": -1, "revision": None}
+
+
+def test_create_with_null_revision_is_atomic_and_stale_create_conflicts(
+    client: TestClient, keybindings_path: Path,
+) -> None:
+    first = client.put("/api/u6/keybindings", json={
+        "bindings": {"palette": ["Ctrl+K"]}, "expected_revision": None,
+    })
+    assert first.status_code == 200
+    revision = first.json()["revision"]
+    assert isinstance(revision, str) and len(revision) == 64
+    assert json.loads(keybindings_path.read_text(encoding="utf-8")) == {"palette": ["Ctrl+K"]}
+    assert not list(keybindings_path.parent.glob(f".{keybindings_path.name}.*.tmp"))
+
+    stale = client.put("/api/u6/keybindings", json={
+        "bindings": {"palette": ["Ctrl+Shift+K"]}, "expected_revision": None,
+    })
+    assert stale.status_code == 409
+    assert json.loads(keybindings_path.read_text(encoding="utf-8")) == {"palette": ["Ctrl+K"]}
+    assert client.get("/api/u6/keybindings").json()["revision"] == revision
+
+
+def test_stale_revision_is_rejected_and_matching_revision_updates(
+    client: TestClient, keybindings_path: Path,
+) -> None:
+    created = client.put("/api/u6/keybindings", json={"bindings": {"palette": ["Ctrl+K"]}}).json()
+    winner = client.put("/api/u6/keybindings", json={
+        "bindings": {"palette": ["Ctrl+P"]}, "expected_revision": created["revision"],
+    })
+    assert winner.status_code == 200
+    loser = client.put("/api/u6/keybindings", json={
+        "bindings": {"palette": ["Ctrl+O"]}, "expected_revision": created["revision"],
+    })
+    assert loser.status_code == 409
+    assert "其他窗口" in loser.json()["detail"]
+    assert json.loads(keybindings_path.read_text(encoding="utf-8")) == {"palette": ["Ctrl+P"]}
+    latest = client.get("/api/u6/keybindings").json()
+    assert latest["revision"] == winner.json()["revision"]
+    assert latest["revision"] != created["revision"]
+
+
+def test_legacy_keybindings_file_stays_readable_and_updatable(
+    client: TestClient, keybindings_path: Path,
+) -> None:
+    """A file written by the pre-revision client (plain action -> array map) remains usable."""
+    keybindings_path.parent.mkdir(parents=True)
+    legacy = {"palette": ["Ctrl+Shift+K"], "newTask": ["Ctrl+Alt+N"]}
+    raw = (json.dumps(legacy, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
+    keybindings_path.write_bytes(raw)
+
+    response = client.get("/api/u6/keybindings")
+    assert response.status_code == 200
+    body = response.json()
+    assert body["bindings"] == legacy
+    assert body["updated_at"] == keybindings_path.stat().st_mtime_ns
+    assert body["revision"] == hashlib.sha256(raw).hexdigest()
+
+    saved = client.put("/api/u6/keybindings", json={
+        "bindings": {"palette": ["Ctrl+K"]}, "expected_revision": body["revision"],
+    })
+    assert saved.status_code == 200
+    assert saved.json()["revision"] != body["revision"]
+    assert json.loads(keybindings_path.read_text(encoding="utf-8")) == {"palette": ["Ctrl+K"]}
+
+
+def test_invalid_shape_writes_nothing(client: TestClient, keybindings_path: Path) -> None:
+    response = client.put("/api/u6/keybindings", json={"bindings": {"palette": "Ctrl+K"}})
+    assert response.status_code == 422
+    assert not keybindings_path.exists()
+    invalid_expected = client.put("/api/u6/keybindings", json={
+        "bindings": {}, "expected_revision": 7,
+    })
+    assert invalid_expected.status_code == 422
+    assert not keybindings_path.exists()
+
+
+def test_replace_failure_keeps_previous_file_and_cleans_temp(
+    client: TestClient, keybindings_path: Path, monkeypatch,
+) -> None:
+    client.put("/api/u6/keybindings", json={"bindings": {"palette": ["Ctrl+K"]}})
+    before = keybindings_path.read_text(encoding="utf-8")
+
+    def fail_replace(*_args, **_kwargs):
+        raise OSError("disk full")
+
+    monkeypatch.setattr(u6_router.os, "replace", fail_replace)
+    response = client.put("/api/u6/keybindings", json={"bindings": {"palette": ["Ctrl+P"]}})
+    assert response.status_code == 500
+    assert "写入失败" in response.json()["detail"]
+    assert keybindings_path.read_text(encoding="utf-8") == before
+    assert not list(keybindings_path.parent.glob(f".{keybindings_path.name}.*.tmp"))
+
+
+def test_malformed_existing_file_is_reported_but_repairable(
+    client: TestClient, keybindings_path: Path,
+) -> None:
+    keybindings_path.parent.mkdir(parents=True)
+    keybindings_path.write_text("{not json", encoding="utf-8")
+    assert client.get("/api/u6/keybindings").status_code == 422
+    repaired = client.put("/api/u6/keybindings", json={"bindings": {"palette": ["Ctrl+K"]}})
+    assert repaired.status_code == 200
+    assert json.loads(keybindings_path.read_text(encoding="utf-8")) == {"palette": ["Ctrl+K"]}
