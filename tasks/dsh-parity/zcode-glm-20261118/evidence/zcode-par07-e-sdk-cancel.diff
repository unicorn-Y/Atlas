+        workspace = tmp_path / "workspace"
+        workspace.mkdir()
+        server = AppServer(
+            [sys.executable, "-m", "atlas.cli"], workspace=workspace, env=env,
+        ).start()
+        process = server._process
+        try:
+            session = server.new_session()
+            inputs: list[dict] = []
+            cancellations: list[dict] = []
+
+            def answer(params: dict) -> None:
+                inputs.append(params)
+                server.cancel_session(session.session_id)
+                return None
+
+            result = server.prompt(
+                session.session_id, "ask and cancel",
+                answer=answer, on_input_cancelled=cancellations.append,
