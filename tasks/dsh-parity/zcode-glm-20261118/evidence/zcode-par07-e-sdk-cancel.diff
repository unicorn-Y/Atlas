+            }], "the SDK must receive exactly one cancellation notification"
+
+            with pytest.raises(AppServerError) as raised:
+                server.respond_input(request_id, "late answer")
+            assert raised.value.code == -32602
+        finally:
+            server.close()
+        assert process is not None
+        assert process.wait(timeout=0) == 0
+
+        assert len(fake.main_requests()) == 1, "cancelled question must stop the run"
+
+        from hermes_state import SessionDB
+
+        with SessionDB(db_path=tmp_path / "atlas" / "engine" / "state.db") as db:
+            rows = db.list_session_events(session.conversation_id, after_seq=0, limit=1000)
+        request_rows = [
+            row["payload"] for row in rows if row["event_type"] == "appserver.request"
+        ]
+        assert [row["state"] for row in request_rows] == ["pending", "invalidated"]
+        assert all(set(row) == {"request_id", "session_id", "kind", "state", "instance_id"}
+                   for row in request_rows)
+
+        # Reconnect/restart with the same conversation: the cancelled request
+        # stays closed and a fresh process still rejects the late answer.
+        restarted = AppServer(
+            [sys.executable, "-m", "atlas.cli"], workspace=workspace, env=env,
+        ).start()
+        restarted_process = restarted._process
+        try:
+            resumed = restarted.new_session(conversation_id=session.conversation_id)
+            with pytest.raises(AppServerError) as raised:
+                restarted.respond_input(request_id, "still late")
+            assert raised.value.code == -32602
+            assert resumed.conversation_id == session.conversation_id
+        finally:
+            restarted.close()
+        assert restarted_process is not None
+        assert restarted_process.wait(timeout=0) == 0
