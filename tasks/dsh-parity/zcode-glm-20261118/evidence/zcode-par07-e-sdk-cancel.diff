@@ -0,0 +1,553 @@
+"""DSH SDK parity: user-question cancellation closure over Atlas' app-server.
+
+The runtime-side contract under test:
+
+* a cancelled pending ``ask_user`` emits exactly one
+  ``user-question.cancelled`` notification with the original ``requestId`` and
+  ``sessionId``;
+* the tool never receives an empty answer as a cancellation substitute;
+* the durable ``appserver.request`` row ends ``invalidated`` (never ``resolved``);
+* late answers are rejected with JSON-RPC -32602 and never delivered;
+* graceful shutdown and reconnect/restart close leftover pending questions.
+
+Server tests drive the real ``serve_stdio`` JSON-RPC loop through the existing
+in-process harness. The final test drives the real Python SDK subprocess path
+against the scripted model stack.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import queue
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from atlas.tools import app_server
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, ToolCall, write_atlas_home
+
+SDK_ROOT = Path(__file__).resolve().parents[2] / "sdk" / "python"
+if str(SDK_ROOT) not in sys.path:
+    sys.path.insert(0, str(SDK_ROOT))
+
+from atlas_sdk.app_server import AppServer, AppServerError  # noqa: E402
+
+pytestmark = pytest.mark.unit
+
+
+# ---------------------------------------------------------------------------
+# In-process real JSON-RPC harness
+# ---------------------------------------------------------------------------
+
+
+class _Memory:
+    def __init__(self):
+        self.rows = {}
+
+    async def init(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def save_conversation_metadata(self, conversation_id, *, title_hint=""):
+        self.rows.setdefault(conversation_id, {
+            "id": conversation_id, "title": title_hint, "workspace": None,
+            "metadata": "{}", "updated_at": "2026-11-18T00:00:00Z",
+        })
+
+    async def get_conversation(self, conversation_id):
+        return self.rows.get(conversation_id)
+
+    async def update_conversation(self, conversation_id, **values):
+        row = self.rows[conversation_id]
+        for key, value in values.items():
+            if key == "metadata":
+                value = json.dumps(value)
+            row[key] = value
+        return True
+
+    async def list_conversations(self, limit=50):
+        rows = list(self.rows.values())
+        return rows if limit is None else rows[:limit]
+
+
+class _AskOrchestrator:
+    """The run asks the host one question, then finishes or is cancelled."""
+
+    answers: list[str] = []
+    cancellations: int = 0
+
+    def __init__(self, **_kwargs):
+        pass
+
+    async def run(self, _prompt, _conversation_id, **kwargs):
+        type(self).answers = []
+        try:
+            answer = await kwargs["input_callback"]("call-1", "Proceed?", ["yes", "no"])
+            type(self).answers.append(answer)
+        except asyncio.CancelledError:
+            type(self).cancellations += 1
+            raise
+        yield {"type": "chunk", "content": "finished"}
+
+
+class _ModelManager:
+    pass
+
+
+class _PresetStore:
+    def __init__(self, _path):
+        pass
+
+    def resolve(self, preset_id):
+        return {"preset": preset_id}
+
+
+class _QueueInput:
+    """Blocking stdin replacement: the test pushes frames when it wants them."""
+
+    def __init__(self, lines=()):
+        self.lines: queue.Queue[str] = queue.Queue()
+        for line in lines:
+            self.push(line)
+
+    def push(self, line: str = "") -> None:
+        self.lines.put(line + "\n" if line else "")
+
+    def readline(self):
+        return self.lines.get()
+
+
+class _CollectingOutput:
+    def __init__(self):
+        self.lines: list[str] = []
+
+    def write(self, line):
+        self.lines.append(line)
+        return len(line)
+
+    def flush(self):
+        pass
+
+
+def _frame(**payload) -> str:
+    return json.dumps({"jsonrpc": "2.0", **payload})
+
+
+async def _messages(stdout: _CollectingOutput) -> list[dict]:
+    return [json.loads(line) for line in list(stdout.lines) if line.strip()]
+
+
+async def _wait_for(stdout: _CollectingOutput, predicate, timeout: float = 8.0) -> list[dict]:
+    async def poll():
+        while True:
+            messages = await _messages(stdout)
+            if predicate(messages):
+                return messages
+            await asyncio.sleep(0.02)
+
+    return await asyncio.wait_for(poll(), timeout)
+
+
+def _by_id(messages: list[dict]) -> dict:
+    return {item.get("id"): item for item in messages if "id" in item}
+
+
+async def _migration_ready(*_args):
+    return SimpleNamespace(status="ready", error=None)
+
+
+def _install_harness(monkeypatch, tmp_path, stdin, stdout, orchestrator):
+    memory = _Memory()
+    monkeypatch.setattr(app_server, "_claim_stdio_channel", lambda: (stdin, stdout))
+    monkeypatch.setattr("atlas.memory.MemoryStore", lambda: memory)
+    monkeypatch.setattr("atlas.agent.AgentOrchestrator", orchestrator)
+    monkeypatch.setattr("atlas.models.ModelManager", _ModelManager)
+    monkeypatch.setattr("atlas.task_artifacts.AgentPresetStore", _PresetStore)
+    monkeypatch.setattr(
+        "atlas.config.get_config",
+        lambda: SimpleNamespace(db_path=tmp_path / "atlas.db"),
+    )
+    monkeypatch.setattr(
+        "atlas.engine.session_migration.migrate_legacy_sessions", _migration_ready,
+    )
+    return memory
+
+
+def _audit_rows(conversation_id: str, request_id: str) -> list[dict]:
+    from atlas.config import DATA_ROOT
+    from atlas.engine.session_sync import read_session_events
+
+    rows = read_session_events(DATA_ROOT / "engine", conversation_id)
+    return [
+        row["payload"] for row in rows
+        if row.get("event_type") == "appserver.request"
+        and isinstance(row.get("payload"), dict)
+        and row["payload"].get("request_id") == request_id
+    ]
+
+
+async def _start_session(stdin, stdout, tmp_path) -> tuple[str, str]:
+    stdin.push(_frame(id=1, method="initialize", params={"protocolVersion": 1}))
+    stdin.push(_frame(id=2, method="session/start", params={"workspace": str(tmp_path)}))
+    await _wait_for(stdout, lambda items: any(item.get("id") == 2 for item in items))
+    result = _by_id(await _messages(stdout))[2]["result"]
+    return str(result["session_id"]), str(result["conversation_id"])
+
+
+# ---------------------------------------------------------------------------
+# Server channel tests
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_ask_cancel_notifies_once_before_terminal_and_rejects_late_answer(
+    tmp_path, monkeypatch,
+):
+    stdin, stdout = _QueueInput(), _CollectingOutput()
+    _install_harness(monkeypatch, tmp_path, stdin, stdout, _AskOrchestrator)
+    _AskOrchestrator.answers = []
+    _AskOrchestrator.cancellations = 0
+    server = asyncio.create_task(app_server.serve_stdio(protocol="app-server"))
+
+    session_id, conversation_id = await _start_session(stdin, stdout, tmp_path)
+    stdin.push(_frame(id=3, method="session/prompt",
+                      params={"session_id": session_id, "prompt": "need input"}))
+    await _wait_for(stdout, lambda items: any(
+        item.get("method") == "input/request" for item in items
+    ))
