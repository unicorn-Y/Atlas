+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it } from 'vitest';
+import type { WorkspaceFile } from '@atlas/backend-adapter';
+import { canPreviewDocument, DocumentPreview, documentPreviewRenderer } from './documentPreviewRegistry';
+
+const file = (over: Partial<WorkspaceFile>): WorkspaceFile => ({
+  path: 'src/app.py', content: 'def main():\n    return 1', truncated: false, binary: false, ...over,
+});
+
+describe('built-in code preview', () => {
+  it('claims common source extensions and keeps other built-in families', () => {
+    for (const path of ['src/app.ts', 'src/main.py', 'conf/settings.yaml', 'style.css', 'data.json', 'run.sh']) {
+      expect(documentPreviewRenderer(path)?.id).toBe('code');
+      expect(canPreviewDocument(path)).toBe(true);
+    }
+    expect(documentPreviewRenderer('notes.MD')?.id).toBe('markdown');
+    expect(documentPreviewRenderer('report.pdf')?.id).toBe('pdf');
+    expect(documentPreviewRenderer('workbook.xlsx')?.id).toBe('office');
+    expect(canPreviewDocument('plain.txt')).toBe(false);
+  });
+
+  it('renders numbered lines without altering content', () => {
+    const markup = renderToStaticMarkup(<DocumentPreview file={file({})} workspace="C:/ws" fallback={<p>built-in</p>} />);
+    expect(markup).toContain('data-code-preview="src/app.py"');
+    expect(markup).toContain('def main():');
+    expect(markup).toContain('return 1');
+    expect(markup).toContain('>1</span>');
+    expect(markup).not.toContain('built-in');
+  });
+
+  it('does not fake binary content and notes truncation explicitly', () => {
+    const binary = renderToStaticMarkup(<DocumentPreview file={file({ binary: true, content: '' })} workspace="C:/ws" fallback={<p>built-in</p>} />);
+    expect(binary).toContain('data-code-preview="binary"');
+    expect(binary).toContain('二进制文件');
+    expect(binary).not.toContain('def main():');
+    const truncated = renderToStaticMarkup(<DocumentPreview file={file({ truncated: true })} workspace="C:/ws" fallback={<p>built-in</p>} />);
+    expect(truncated).toContain('已截断');
+    expect(truncated).toContain('def main():');
+  });
+});
