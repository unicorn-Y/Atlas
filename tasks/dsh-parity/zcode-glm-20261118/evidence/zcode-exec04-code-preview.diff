+import type { DocumentPreviewProps } from './documentPreviewRegistry';
+
+/** Built-in code preview claims text source extensions (html/pdf/office stay separate). */
+export const CODE_PREVIEW_EXTENSIONS = [
+  'ts', 'tsx', 'js', 'jsx', 'mjs', 'cjs', 'py', 'rs', 'go', 'java', 'c', 'h', 'cpp', 'hpp',
+  'cs', 'rb', 'php', 'swift', 'kt', 'sh', 'bat', 'ps1', 'sql', 'toml', 'yaml', 'yml', 'ini',
+  'css', 'json', 'xml',
+] as const;
+
+const MAX_RENDERED_LINES = 2000;
+
+/**
+ * Built-in preview for text source files: numbered monospace lines.
+ * Binary files and empty files render an explicit note instead of invented content.
+ */
+export function CodeFilePreview({ file }: DocumentPreviewProps) {
+  if (file.binary) {
+    return (
+      <div className="rounded border border-border p-3 text-xs text-muted-foreground" role="note" data-code-preview="binary">
+        二进制文件不以代码预览呈现。
+      </div>
+    );
+  }
+  const lines = file.content.length ? file.content.split('\n') : [];
+  const shown = lines.slice(0, MAX_RENDERED_LINES);
+  return (
+    <div className="flex flex-col gap-1" data-code-preview={file.path} aria-label={`代码预览 ${file.path}`}>
+      {file.truncated && (
+        <div className="text-xs text-amber-600" role="note">内容已截断，仅显示已加载部分。</div>
+      )}
+      {lines.length === 0 ? (
+        <div className="rounded border border-border p-3 text-xs text-muted-foreground">空文件。</div>
+      ) : (
+        <pre className="max-h-96 overflow-auto rounded border border-border bg-muted/30 p-2 font-mono text-xs leading-5">
+          {shown.map((line, index) => (
+            <div key={index} className="whitespace-pre">
+              <span className="mr-2 inline-block w-10 select-none text-right text-muted-foreground">{index + 1}</span>
+              {line.length ? line : ' '}
+            </div>
+          ))}
+          {lines.length > MAX_RENDERED_LINES && (
+            <div className="text-muted-foreground">… 其余 {lines.length - MAX_RENDERED_LINES} 行未渲染</div>
+          )}
+        </pre>
+      )}
+    </div>
+  );
+}
