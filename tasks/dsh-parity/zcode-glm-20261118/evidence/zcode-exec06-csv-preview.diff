+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it } from 'vitest';
+import type { WorkspaceFile } from '@atlas/backend-adapter';
+import { CsvFilePreview, parseDelimited } from './csvPreview';
+import { canPreviewDocument, documentPreviewRenderer } from './documentPreviewRegistry';
+
+const file = (path: string, content: string, extra: Partial<WorkspaceFile> = {}): WorkspaceFile => ({
+  path, content, binary: false, truncated: false, sha256: '', size: content.length, ...extra,
+} as WorkspaceFile);
+
+const render = (path: string, content: string, extra: Partial<WorkspaceFile> = {}) => renderToStaticMarkup(
+  <CsvFilePreview file={file(path, content, extra)} workspace="C:/ws" fallback={<p>fallback</p>} />,
+);
+
+describe('csv/tsv table preview', () => {
+  it('registers both extensions and renders a header plus body cells', () => {
+    expect(documentPreviewRenderer('data.CSV')?.id).toBe('csv');
+    expect(documentPreviewRenderer('data.tsv')?.id).toBe('csv');
+    expect(canPreviewDocument('data.csv')).toBe(true);
+    const html = render('data.csv', 'name,value\nalpha,42\nbeta,7');
+    expect(html).toContain('<table');
+    expect(html).toContain('<th');
+    expect(html).toContain('name');
+    expect(html).toContain('alpha');
+    expect(html).toContain('42');
+    expect(html).toContain('beta');
+    expect(html).toContain('3 行');
+  });
+
+  it('parses quoted separators, embedded newlines and escaped quotes as one cell', () => {
+    const table = parseDelimited('name,note\r\n"Doe, Jane","line1\nline2 ""quoted"""\r\n', 'notes.csv');
+    expect(table.delimiter).toBe(',');
+    expect(table.rows).toEqual([
+      ['name', 'note'],
+      ['Doe, Jane', 'line1\nline2 "quoted"'],
+    ]);
+    const html = render('notes.csv', 'name,note\n"Doe, Jane","line1\nline2 ""quoted"""');
+    expect(html).toContain('Doe, Jane');
+    expect(html).toContain('line1');
+    expect(html).toContain('&quot;quoted&quot;');
+  });
+
+  it('honors .tsv and detects semicolon delimiters outside quotes', () => {
+    expect(parseDelimited('a\tb\n1\t2', 'data.tsv').delimiter).toBe('\t');
+    const semicolon = parseDelimited('name;value\n"x;y";1', 'data.csv');
+    expect(semicolon.delimiter).toBe(';');
+    expect(semicolon.rows[1]).toEqual(['x;y', '1']);
+    expect(render('data.tsv', 'a\tb\n1\t2')).toContain('制表符');
+  });
+
+  it('caps rows and states truncation instead of rendering an unbounded table', () => {
+    const rows = ['id,value', ...Array.from({ length: 510 }, (_, index) => `${index},${index * 2}`)];
+    const table = parseDelimited(rows.join('\n'), 'big.csv');
+    expect(table.rows).toHaveLength(500);
+    expect(table.totalRows).toBe(511);
+    expect(table.truncated).toBe(true);
+    const html = render('big.csv', rows.join('\n'));
+    expect(html).toContain('仅显示前 500 行');
+    expect(html).toContain('511 行');
+  });
+
+  it('keeps ragged rows and caps columns without inventing cells', () => {
+    const table = parseDelimited('a,b,c\n1\n2,3', 'ragged.csv');
+    expect(table.rows).toEqual([['a', 'b', 'c'], ['1'], ['2', '3']]);
+    const wide = parseDelimited(`h,${Array.from({ length: 80 }, (_, index) => `c${index}`).join(',')}`, 'wide.csv');
+    expect(wide.rows[0]).toHaveLength(64);
+  });
+
+  it('states binary, empty and truncated-source conditions explicitly', () => {
+    expect(render('data.csv', '', { binary: true })).toContain('二进制文件');
+    expect(render('data.csv', '')).toContain('空文件');
+    const html = render('data.csv', 'a,b\n1,2', { truncated: true });
+    expect(html).toContain('文件已截断');
+  });
+});
