+async def _wait_until(
+    predicate: Callable[[], bool],
+    *,
+    timeout: float = 10.0,
+    describe: str = "",
+) -> None:
+    """Poll a real lifecycle observation; never a fixed-duration sleep."""
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        await asyncio.sleep(0.02)
+    raise AssertionError(describe or "condition was not observed before timeout")
+
+
+def _connected_names(client: MCPClient) -> set[str]:
+    servers = client.get_runtime_status().get("servers") or []
+    return {
+        str(item.get("name"))
+        for item in servers
+        if item.get("state") == "connected"
+    }
+
