+"""POST conversation worktree: create once, move the conversation, roll back on record failure."""
+
+import asyncio
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+
+from atlas.api import workspace_router
+from atlas.memory import MemoryStore
+from atlas.task_artifacts import WorktreeService
+
+pytestmark = pytest.mark.unit
+
+
+def git(cwd: Path, *args: str) -> str:
+    result = subprocess.run(
+        ["git", "-C", str(cwd), *args], capture_output=True, text=True,
+        encoding="utf-8", errors="replace", check=False,
+    )
+    assert result.returncode == 0, result.stderr or result.stdout
+    return result.stdout.strip()
+
+
+@pytest.fixture
+async def memory(tmp_path: Path):
+    store = MemoryStore(db_path=tmp_path / "memory.sqlite3")
+    await store.init()
+    yield store
+    await store.close()
+
+
+@pytest.fixture
+def repo(tmp_path: Path) -> Path:
+    root = tmp_path / "repo"
+    root.mkdir()
+    git(root, "init")
+    git(root, "config", "user.email", "atlas@example.invalid")
+    git(root, "config", "user.name", "Atlas Test")
+    (root / "README.md").write_text("base\n", encoding="utf-8")
+    git(root, "add", "README.md")
+    git(root, "commit", "-m", "base")
+    return root
+
+
+async def new_conversation(memory: MemoryStore, workspace: Path) -> str:
+    conversation_id = await memory.create_conversation("worktree task")
+    assert await memory.update_conversation(conversation_id, workspace=str(workspace))
+    return conversation_id
+
+
+@pytest.fixture
+def fake_server(monkeypatch, tmp_path: Path):
+    worktrees = WorktreeService(tmp_path)
+    monkeypatch.setattr(workspace_router, "_server", lambda: SimpleNamespace(_worktrees=lambda: worktrees))
+    return worktrees
+
+
+async def test_create_moves_conversation_and_returns_branch(
+    memory: MemoryStore, repo: Path, fake_server,
+) -> None:
+    conversation_id = await new_conversation(memory, repo)
+    short = conversation_id.replace("-", "")[:8]
+    result = await workspace_router.create_conversation_worktree(
+        SimpleNamespace(memory=memory), conversation_id, {"name": "Feature Login!"},
+    )
+    assert result["worktree_branch"] == f"atlas/{short}-feature-login"
+    path = Path(result["worktree_path"])
+    assert path.is_dir() and (path / ".git").is_file()
+    assert git(repo, "worktree", "list", "--porcelain").count("worktree ") == 2
+
+    conversation = await memory.get_conversation(conversation_id)
+    assert conversation is not None
+    assert conversation["workspace"] == str(path)
+    assert conversation["worktree_path"] == str(path)
+    assert conversation["worktree_branch"] == result["worktree_branch"]
+    assert conversation["base_branch"] == result["base_branch"]
+
+    git(repo, "worktree", "remove", "--force", str(path))
+    git(repo, "branch", "-D", result["worktree_branch"])
+
+
+async def test_second_create_conflicts_without_touching_the_tree(
+    memory: MemoryStore, repo: Path, fake_server,
+) -> None:
+    conversation_id = await new_conversation(memory, repo)
+    first = await workspace_router.create_conversation_worktree(
+        SimpleNamespace(memory=memory), conversation_id, {},
+    )
+    with pytest.raises(HTTPException) as caught:
+        await workspace_router.create_conversation_worktree(
+            SimpleNamespace(memory=memory), conversation_id, {"name": "again"},
+        )
+    assert caught.value.status_code == 409
+    assert git(repo, "worktree", "list", "--porcelain").count("worktree ") == 2
+    assert Path(first["worktree_path"]).is_dir()
+
+    git(repo, "worktree", "remove", "--force", first["worktree_path"])
+    git(repo, "branch", "-D", first["worktree_branch"])
+
+
+async def test_non_git_workspace_and_missing_conversation_are_rejected(
+    memory: MemoryStore, tmp_path: Path, fake_server,
+) -> None:
+    plain = tmp_path / "plain"
+    plain.mkdir()
+    conversation_id = await new_conversation(memory, plain)
+    with pytest.raises(HTTPException) as non_git:
+        await workspace_router.create_conversation_worktree(
+            SimpleNamespace(memory=memory), conversation_id, {},
+        )
+    assert non_git.value.status_code == 409
+    assert "git repository" in str(non_git.value.detail)
+
+    with pytest.raises(HTTPException) as missing:
+        await workspace_router.create_conversation_worktree(
+            SimpleNamespace(memory=memory), "missing-conversation", {},
+        )
+    assert missing.value.status_code == 404
+
+
+async def test_record_failure_removes_the_created_worktree(
+    memory: MemoryStore, repo: Path, fake_server, monkeypatch,
+) -> None:
+    conversation_id = await new_conversation(memory, repo)
+
+    async def refuse(*_args, **_kwargs) -> bool:
+        return False
+
+    monkeypatch.setattr(memory, "update_conversation", refuse)
+    with pytest.raises(HTTPException) as caught:
+        await workspace_router.create_conversation_worktree(
+            SimpleNamespace(memory=memory), conversation_id, {"name": "rollback"},
+        )
+    assert caught.value.status_code == 500
+    assert "has been removed" in str(caught.value.detail)
+    assert git(repo, "worktree", "list", "--porcelain").count("worktree ") == 1
+    worktree_root = repo.parent / ".atlas-worktrees" / repo.name
+    assert not any(worktree_root.glob("*/**")) if worktree_root.exists() else True
+
+
+async def test_concurrent_create_yields_one_winner(
+    memory: MemoryStore, repo: Path, fake_server,
+) -> None:
+    conversation_id = await new_conversation(memory, repo)
+    services = SimpleNamespace(memory=memory)
+    results = await asyncio.gather(
+        workspace_router.create_conversation_worktree(services, conversation_id, {"name": "one"}),
+        workspace_router.create_conversation_worktree(services, conversation_id, {"name": "two"}),
+        return_exceptions=True,
+    )
+    winners = [item for item in results if isinstance(item, dict)]
+    conflicts = [item for item in results if isinstance(item, HTTPException)]
+    assert len(winners) == 1 and len(conflicts) == 1
+    assert conflicts[0].status_code == 409
+    assert git(repo, "worktree", "list", "--porcelain").count("worktree ") == 2
+
+    git(repo, "worktree", "remove", "--force", winners[0]["worktree_path"])
+    git(repo, "branch", "-D", winners[0]["worktree_branch"])
