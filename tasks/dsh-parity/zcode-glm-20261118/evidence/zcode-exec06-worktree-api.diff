+@router.post("/api/conversations/{conversation_id}/worktree")
+async def create_conversation_worktree(
+    services: Annotated[AppServices, Depends(get_app_services)],
+    conversation_id: str, req: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Create this conversation's branch/worktree and move it there, once.
+
+    The conversation is the single owner: a second create is a conflict, never a
+    second checkout. If recording the new path fails, the just-created worktree
+    is removed so the conversation cannot point at an unowned tree.
+    """
+    memory = _service("memory", services)
+    assert memory is not None
+    conv = await memory.get_conversation(conversation_id)
+    if not conv:
+        raise HTTPException(status_code=404, detail="Conversation not found")
+    if conv.get("worktree_path"):
+        raise HTTPException(status_code=409, detail="Conversation already has a worktree")
+    workspace_value = str(conv.get("workspace") or "").strip()
+    if not workspace_value:
+        raise HTTPException(status_code=409, detail="Conversation has no workspace")
+    workspace = Path(workspace_value).expanduser().resolve()
+    if not workspace.is_dir():
+        raise HTTPException(status_code=409, detail="Conversation workspace is missing")
+    if not (workspace / ".git").exists():
+        raise HTTPException(status_code=409, detail="Workspace is not a git repository")
+    payload = req or {}
+    name = str(payload.get("name") or "").strip() or None
+    base_branch = str(payload.get("base_branch") or "").strip() or None
+    async with _worktree_create_lock:
+        conv = await memory.get_conversation(conversation_id)
+        if not conv:
+            raise HTTPException(status_code=404, detail="Conversation not found")
+        if conv.get("worktree_path"):
+            raise HTTPException(status_code=409, detail="Conversation already has a worktree")
+        try:
+            info = await asyncio.to_thread(
+                _server()._worktrees().create, workspace, conversation_id, base_branch, name,
+            )
+        except ValueError as exc:
+            raise HTTPException(status_code=400, detail=str(exc)) from exc
+        except (OSError, RuntimeError) as exc:
+            raise HTTPException(status_code=409, detail=str(exc)) from exc
+        try:
+            recorded = await memory.update_conversation(
+                conversation_id,
+                workspace=info["worktree_path"],
+                worktree_path=info["worktree_path"],
+                worktree_branch=info["worktree_branch"],
+                base_branch=info["base_branch"],
+            )
+        except Exception:
+            recorded = False
+        if not recorded:
+            try:
+                await asyncio.to_thread(
+                    _server()._worktrees().remove, workspace,
+                    Path(info["worktree_path"]), info["worktree_branch"], True, False,
+                )
+            except Exception:
+                pass
+            raise HTTPException(
+                status_code=500,
+                detail="Conversation worktree was created but could not be recorded; it has been removed.",
+            )
+    return {**info, "workspace": info["worktree_path"]}
+
+
