@@ -544,7 +544,17 @@ class MCPClient:
         try:
             task.result()
         except Exception as exc:
-            log.warning("mcp.background_start_failed", reason=_failure_reason(exc))
+            reason = _failure_reason(exc)
+            log.warning("mcp.background_start_failed", reason=reason)
+            # A raised startup attempt must settle the server's lifecycle state:
+            # stay fail-closed (state=failed + blocking reason) instead of leaving
+            # it "starting" forever. _failure_reason never echoes command args.
+            server_name = task.get_name().removeprefix("mcp-start:")
+            status = self._server_status.get(server_name)
+            if status is not None and status.get("state") == "starting":
+                status["state"] = "failed"
+                status["blocking_reason"] = reason
+                self._progress(server_name, "failed", reason, status.get("transport") or "")
 
     async def stop(self) -> None:
         """Disconnect all MCP servers."""
@@ -1256,9 +1266,19 @@ class MCPClient:
             item for item in statuses
             if item["enabled"] and item["state"] == "failed"
         ]
-        server_blocker = failed_servers[0]["blocking_reason"] if failed_servers else None
+        # Fail closed while a configured server's start attempt is still undecided:
+        # background handshakes must not delay startup, but the MCP runtime is only
+        # available once every enabled server has settled (connected or failed).
+        pending_servers = [
+            item for item in statuses
+            if item["enabled"] and item["state"] in ("starting", "connecting")
+        ]
+        server_blocker = (
+            failed_servers[0]["blocking_reason"] if failed_servers
+            else ("MCP server startup is still in progress" if pending_servers else None)
+        )
         return {
-            "available": not node_blocker and not failed_servers,
+            "available": not node_blocker and not failed_servers and not pending_servers,
             "node_required": needs_node,
             "blocking_reason": (
                 node_status["blocking_reason"] if node_blocker else server_blocker
