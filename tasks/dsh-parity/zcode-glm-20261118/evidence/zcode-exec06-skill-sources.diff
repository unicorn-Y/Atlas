diff --git a/core/tests/test_skill_sources_dsh.py b/core/tests/test_skill_sources_dsh.py
new file mode 100644
index 00000000..07826aca
--- /dev/null
+++ b/core/tests/test_skill_sources_dsh.py
@@ -0,0 +1,122 @@
+"""DSH-style skill source ladder: .dsh/.agents roots, custom/runtime/bundled."""
+
+from pathlib import Path
+
+import pytest
+
+from atlas.skills import SkillManager, default_skill_sources
+
+pytestmark = pytest.mark.unit
+
+
+def write_skill(root: Path, name: str, description: str, extra: str = "") -> Path:
+    directory = root / name
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / "SKILL.md"
+    path.write_text(
+        f"---\nname: {name}\ndescription: {description}\n{extra}---\nbody of {name}\n",
+        encoding="utf-8",
+    )
+    return path
+
+
+def sources_by_name(**kwargs):
+    return {source.name: source for source in default_skill_sources(**kwargs)}
+
+
+def test_dsh_project_roots_join_only_when_present_and_win_same_name(tmp_path: Path) -> None:
+    workspace = tmp_path / "ws"
+    write_skill(workspace / ".dsh" / "skills", "shared", "dsh copy")
+    write_skill(workspace / ".agents" / "skills", "shared", "agents copy")
+    write_skill(workspace / ".claude" / "skills", "shared", "claude copy")
+
+    sources = sources_by_name(workspace=workspace, atlas_home=tmp_path / "atlas", user_home=tmp_path / "home")
+    assert sources["project-dsh"].priority > sources["project-agents"].priority
+    assert sources["project-agents"].priority > sources["claude-project"].priority
+
+    manager = SkillManager()
+    for source in sources.values():
+        manager.register_skill_source(source)
+    manager.scan_skills_sync()
+    shared = manager.get_skill("shared")
+    assert shared is not None
+    assert shared.source == "project-dsh"
+    assert shared.description == "dsh copy"
+
+    empty = sources_by_name(workspace=tmp_path / "empty", atlas_home=tmp_path / "atlas", user_home=tmp_path / "home")
+    assert "project-dsh" not in empty and "project-agents" not in empty
+
+
+def test_dsh_user_roots_follow_dsh_precedence(tmp_path: Path) -> None:
+    home = tmp_path / "home"
+    write_skill(home / ".dsh" / "skills", "user-shared", "user dsh")
+    write_skill(home / ".agents" / "skills", "user-shared", "user agents")
+    hermes = tmp_path / "hermes" / "skills"
+    write_skill(hermes / "cat", "user-shared", "hermes copy")
+
+    sources = sources_by_name(
+        atlas_home=tmp_path / "atlas", user_home=home, hermes_skills_dir=hermes,
+    )
+    assert sources["user-dsh"].priority > sources["user-agents"].priority
+    assert sources["user-agents"].priority > sources["hermes"].priority
+    assert sources["hermes"].priority > sources["atlas"].priority
+
+    manager = SkillManager()
+    for source in sources.values():
+        manager.register_skill_source(source)
+    manager.scan_skills_sync()
+    skill = manager.get_skill("user-shared")
+    assert skill is not None and skill.source == "user-dsh"
+
+
+def test_custom_runtime_and_bundled_roots_follow_the_ladder(tmp_path: Path) -> None:
+    custom_a = tmp_path / "custom-a"
+    custom_b = tmp_path / "custom-b"
+    runtime = tmp_path / "runtime"
+    bundled = tmp_path / "bundled"
+    for root in (custom_a, custom_b, runtime, bundled):
+        write_skill(root, "portable", root.name)
+
+    sources = sources_by_name(
+        atlas_home=tmp_path / "atlas",
+        user_home=tmp_path / "home",
+        custom_skill_dirs=[custom_a, custom_b, tmp_path / "missing"],
+        runtime_skills_dir=runtime,
+        bundled_skills_dir=bundled,
+    )
+    assert sources["runtime"].priority > sources["custom:custom-a"].priority
+    assert sources["custom:custom-a"].priority > sources["user-dsh"].priority if "user-dsh" in sources else True
+    assert sources["custom:custom-b"].priority == sources["custom:custom-a"].priority
+    assert sources["bundled"].priority < sources["atlas"].priority
+    assert "custom:missing" not in sources
+
+    manager = SkillManager()
+    for source in sources.values():
+        manager.register_skill_source(source)
+    manager.scan_skills_sync()
+    portable = manager.get_skill("portable")
+    assert portable is not None and portable.source == "runtime"
+
+
+def test_invocation_policy_survives_new_sources(tmp_path: Path) -> None:
+    workspace = tmp_path / "ws"
+    write_skill(
+        workspace / ".dsh" / "skills", "manual-only", "human only",
+        "disable-model-invocation: true\nuser-invocable: false\n",
+    )
+    sources = sources_by_name(workspace=workspace, atlas_home=tmp_path / "atlas", user_home=tmp_path / "home")
+    manager = SkillManager()
+    for source in sources.values():
+        manager.register_skill_source(source)
+    manager.scan_skills_sync()
+    skill = manager.get_skill("manual-only")
+    assert skill is not None
+    assert skill.disable_model_invocation is True
+    assert skill.user_invocable is False
+
+
+def test_absent_dsh_roots_leave_the_source_list_unchanged(tmp_path: Path) -> None:
+    names = [source.name for source in default_skill_sources(
+        workspace=tmp_path / "empty-ws", atlas_home=tmp_path / "atlas", user_home=tmp_path / "empty-home",
+    )]
+    assert names == ["atlas", "library", "claude-user", "claude-project"]
