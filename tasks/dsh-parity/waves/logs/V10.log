/** Backend boot progress, broadcast while the desktop backend starts (H8 §10.3). */
export type BackendStartupPhase = 'probing' | 'starting' | 'ready' | 'failed';
export interface BackendStartupProgress {
  phase: BackendStartupPhase;
  /** True when this Electron session spawned the backend (vs. attaching to an external one). */
  managed: boolean;
  elapsedMs: number;
  /** Short human-readable status for the UI, e.g. which health components are still starting. */
  detail?: string;
  message?: string;
  logPath?: string;
}
/** IPC channel the main process sends {@link BackendStartupProgress} events on. */
export const BACKEND_STARTUP_CHANNEL = 'backend:startup-progress';

/** Source-mode update state (Atlas running from a git checkout). */
export interface SourceUpdateStatus {
  supported: boolean;
  available: boolean;
  behind: number;
  branch?: string;
  commits: Array<{ hash: string; subject: string }>;
  blocked?: string;
  error?: string;
}
export interface ReleaseUpdateStatus { supported: boolean; available: boolean; current: string; latest?: string; notes?: string; assetName?: string; error?: string; skipped?: boolean }

export type AtlasSettingsSection =
  | 'models' | 'advanced' | 'usage' | 'limits' | 'profiles' | 'hooks' | 'tools' | 'telegram' | 'channels'
  | 'devices' | 'localModels' | 'shortcuts' | 'appearance' | 'plugins' | 'notifications' | 'mcp'
  | 'skills' | 'recipes' | 'extensions' | 'transfer' | 'diagnostics' | 'security' | 'commands' | 'platform' | 'integrations' | 'network';

export type AtlasDeepLink =
  | { id: string; type: 'conversation'; conversationId: string; draft?: string }
  | { id: string; type: 'share-import'; token: string; shareUrl: string }
  | { id: string; type: 'settings'; section: AtlasSettingsSection };
import { useEffect, useState } from 'react';
import { ArrowUpCircle, LoaderCircle, X } from 'lucide-react';
import type { ReleaseUpdateStatus, SourceUpdateStatus } from '../../shared/ipc';
import { appendUpdateJournal, createUpdateCoordinator } from '../services/update-coordinator';
import { tn } from '../services/i18n';

const CHANNEL_KEY = 'atlas.preference.update-channel';
const SOURCE_KEY = 'atlas.preference.release-source';
// Atlas 自己的发布仓库（私有仓库时主进程会带上 gh 登录令牌）。
export const DEFAULT_RELEASE_SOURCE = 'https://api.github.com/repos/unicorn-Y/Atlas/releases/latest';
type View = { channel: 'release' | 'source'; release?: ReleaseUpdateStatus; source?: SourceUpdateStatus };
export default function UpdateBanner() {
  const [view, setView] = useState<View | null>(null);
  const [dismissed, setDismissed] = useState(false);
  const [expanded, setExpanded] = useState(false);
  const [busy, setBusy] = useState(false);
  const [progress, setProgress] = useState(0);
  const api = window.atlasDesktop;
  useEffect(() => {
    let alive = true;
    let checkedChannel: 'source' | 'release' = 'source';
    const check = async () => {
      // 用户没选过通道时沿用原来的源码更新（老用户一直用的“立即更新”），发布版通道需显式切换。
      const storedChannel = localStorage.getItem(CHANNEL_KEY);
      const channel = storedChannel === 'release' ? 'release' : 'source';
      checkedChannel = channel;
      if (channel === 'source') {
        if (!api?.checkForUpdate) throw new Error('源码更新检查不可用');
        return api.checkForUpdate();
      }
      if (!api?.checkReleaseUpdate) throw new Error('发布版更新检查不可用');
      const source = localStorage.getItem(SOURCE_KEY) || DEFAULT_RELEASE_SOURCE;
      return api.checkReleaseUpdate(source);
    };
    const coordinator = createUpdateCoordinator({
      check,
      channel: () => localStorage.getItem(CHANNEL_KEY) === 'release' ? 'release' : 'source',
      initialDelayMs: 8000,
      journal: (entry) => appendUpdateJournal(entry, localStorage),
      onResult: (result) => {
        if (!alive) return;
        setView(checkedChannel === 'source' ? { channel: 'source', source: result as SourceUpdateStatus } : { channel: 'release', release: result as ReleaseUpdateStatus });
        setDismissed(false);
      },
    });
    coordinator.start();
    const onFocus = () => coordinator.checkNow(); const onChange = () => coordinator.checkNow();
    window.addEventListener('focus', onFocus); window.addEventListener('atlas:update-settings-changed', onChange);
    return () => { alive = false; coordinator.stop(); window.removeEventListener('focus', onFocus); window.removeEventListener('atlas:update-settings-changed', onChange); };
  }, [api]);
  const download = async () => {
    const version = view?.release?.latest; const source = localStorage.getItem(SOURCE_KEY) || DEFAULT_RELEASE_SOURCE;
    if (!version || !api?.downloadReleaseUpdate || !api.installReleaseUpdate) return;
    setBusy(true); setProgress(0);
    const off = api.onReleaseDownloadProgress?.(setProgress);
    try { await api.downloadReleaseUpdate(source, version); await api.installReleaseUpdate(); }
    catch (error) { setView((old) => old?.release ? { ...old, release: { ...old.release, error: error instanceof Error ? error.message : String(error) } } : old); setBusy(false); }
    finally { off?.(); }
  };
  if (!view || dismissed) return null;
  const sourceUpdate = view.channel === 'source' && view.source?.available;
  const releaseUpdate = view.channel === 'release' && view.release?.available;
  if (!sourceUpdate && !releaseUpdate) return null;
  const commits = view.source?.commits ?? [];
  return <div role="status" className="shrink-0 border-b border-line px-5 py-2 text-[12.5px] text-fg">


