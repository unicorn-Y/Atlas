+    await expect(checkReleaseUpdate('https://api.github.com/repos/atlas/atlas/releases/latest', '2.3.0', 'unused-test-userdata'))
+      .resolves.toEqual(expect.objectContaining({ mandatory: false, available: true }));
+  });
+});
