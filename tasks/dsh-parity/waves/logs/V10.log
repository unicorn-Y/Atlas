+  it('does not force a current version that meets the declared minimum', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue({
+      status: 200,
+      ok: true,
+      json: async () => ({ tag_name: 'v2.4.0', body: 'Minimum-Atlas-Version: 2.3.0', assets: [] }),
