+import { describe, expect, it } from 'vitest';
+import { allocateBackendPort, injectBackendPort } from './backendPort.js';
+
+describe('backend port assignment', () => {
+  it('uses an OS-assigned loopback port and injects it before backend startup', async () => {
+    const env: NodeJS.ProcessEnv = {};
+    const port = await injectBackendPort(env);
+    expect(port).toBeGreaterThan(0);
+    expect(env.ATLAS_PORT).toBe(String(port));
+  });
+
+  it('preserves an explicit port and allocates distinct ports when no override is set', async () => {
+    const fixed: NodeJS.ProcessEnv = { ATLAS_PORT: '8838' };
+    await expect(injectBackendPort(fixed)).resolves.toBe(8838);
+    const [first, second] = await Promise.all([allocateBackendPort(), allocateBackendPort()]);
+    expect(first).not.toBe(second);
+  });
+});
diff --git a/frontend/src/main/backendPort.ts b/frontend/src/main/backendPort.ts
new file mode 100644
index 0000000000000000000000000000000000000000..11e05392f82186def5aa890abc69368c1fdebde8
--- /dev/null
+++ b/frontend/src/main/backendPort.ts
@@ -0,0 +1,26 @@
+import { createServer } from 'node:net';
+
+/** Select an unused loopback port before the backend or renderer starts. */
+export async function allocateBackendPort(): Promise<number> {
+  const server = createServer();
+  await new Promise<void>((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(0, '127.0.0.1', () => resolve());
+  });
+  const address = server.address();
+  if (!address || typeof address === 'string') {
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    throw new Error('操作系统没有返回可用的本地端口');
+  }
+  const port = address.port;
+  await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+  return port;
+}
+
+export async function injectBackendPort(env: NodeJS.ProcessEnv = process.env): Promise<number> {
+  const configured = Number(env.ATLAS_PORT);
+  if (env.ATLAS_PORT && Number.isInteger(configured) && configured > 0 && configured <= 65535) return configured;
+  const port = await allocateBackendPort();
+  env.ATLAS_PORT = String(port);
+  return port;
+}
