import { EventEmitter } from 'node:events';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import type { BackendStartupProgress } from '../shared/ipc.js';

// H8 §10.3 unit tests: slow starts are not killed, process exits surface immediately,
// the total cap still bounds the wait, and failure reports carry the log tail.
// Only `spawn` is replaced (partial mock keeps the worker's own child_process usable).
const h = vi.hoisted(() => ({ spawn: vi.fn() }));
vi.mock('node:child_process', async (importOriginal) => {
  const actual = await importOriginal<typeof import('node:child_process')>();
  return { ...actual, spawn: h.spawn };
});

import { ensureBackendRunning } from './backendProcess.js';

/** Repository root (this file lives at <root>/frontend/src/main/). */
const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../..');

interface FakeChild extends EventEmitter {
  stdout: EventEmitter;
  stderr: EventEmitter;
  pid: number;
  exitCode: number | null;
  signalCode: number | null;
  kill: ReturnType<typeof vi.fn>;
}

function makeChild(): FakeChild {
  const child = new EventEmitter() as FakeChild;
  child.stdout = new EventEmitter();
  child.stderr = new EventEmitter();
  child.pid = 4242;
  child.exitCode = null;
  child.signalCode = null;
  child.kill = vi.fn();
  return child;
}

/** One fake child for the backend process; `taskkill` invocations get their own child that closes instantly. */
function stubSpawn(child: FakeChild): void {
  h.spawn.mockImplementation((command: string) => {
    if (command === 'taskkill') {
      const killer = new EventEmitter();
      queueMicrotask(() => killer.emit('close'));
      return killer;
    }
    return child;
  });
}

function stubHealth(body: () => unknown, status = 200): void {
  vi.stubGlobal('fetch', vi.fn(async () => ({ status, json: async () => body() })));
}

/** Health for a backend this session spawns: nothing listens on the port until spawn. */
function stubManagedHealth(body: () => unknown, status = 200): void {
  vi.stubGlobal('fetch', vi.fn(async () => {
    if (h.spawn.mock.calls.length === 0) throw new Error('ECONNREFUSED');
    return { status, json: async () => body() };
  }));
}

describe('backendProcess startup (H8 §10.3)', () => {
  beforeEach(() => {
    vi.useFakeTimers();
    // Point the backend resolver at this repository; spawn itself is mocked.
    vi.stubEnv('ATLAS_ROOT', REPO_ROOT);
    vi.stubEnv('ATLAS_PYTHON', 'atlas-fake-python');
  });
  afterEach(() => {
    vi.unstubAllGlobals();
    vi.unstubAllEnvs();
    vi.useRealTimers();
    h.spawn.mockReset();
  });

  it('attaches to an external ready backend without spawning anything', async () => {
    stubHealth(() => ({ status: 'ok' }));
    const progress: BackendStartupProgress[] = [];
    const result = await ensureBackendRunning({ onProgress: (p) => progress.push(p) });
    expect(result).toEqual({ ready: true, managed: false });
    expect(h.spawn).not.toHaveBeenCalled();
    expect(progress.map((p) => p.phase)).toEqual(['probing', 'ready']);
  });

  it('keeps waiting through a slow 30-second start and kills nothing', async () => {
    let health: unknown = { status: 'starting', components: { mcp: { status: 'starting' } } };
    stubManagedHealth(() => health);
    const child = makeChild();
    stubSpawn(child);
    const progress: BackendStartupProgress[] = [];
    const promise = ensureBackendRunning({ onProgress: (p) => progress.push(p) });

    // A slow boot that used to lose the race against the fixed 15s timeout.
    await vi.advanceTimersByTimeAsync(30_000);
    expect(h.spawn).toHaveBeenCalledTimes(1);
    expect(child.kill).not.toHaveBeenCalled();
    expect(progress.some((p) => p.phase === 'starting')).toBe(true);

    health = { status: 'ok' };
    await vi.advanceTimersByTimeAsync(1_000);
    await expect(promise).resolves.toEqual({ ready: true, managed: true, pid: 4242 });
    expect(child.kill).not.toHaveBeenCalled();
    expect(progress.at(-1)?.phase).toBe('ready');
    expect(progress.at(-1)?.managed).toBe(true);
  });

  it('reports progress details while health components are still starting', async () => {
    let health: unknown = { status: 'starting', components: { mcp: { status: 'starting' }, lsp: { status: 'starting' } } };
    stubManagedHealth(() => health);
    const child = makeChild();
    stubSpawn(child);
    const progress: BackendStartupProgress[] = [];
    const promise = ensureBackendRunning({ onProgress: (p) => progress.push(p) });
    await vi.advanceTimersByTimeAsync(1_200);

    const starting = progress.filter((p) => p.phase === 'starting');
    expect(starting.length).toBeGreaterThan(0);
    expect(starting.at(-1)?.detail).toContain('mcp');

    health = { status: 'ok' };
    await vi.advanceTimersByTimeAsync(1_000);
    await promise;
  });

  it('reads the backend string state contract and shows failed component details', async () => {
    let health: unknown = {
      status: 'starting',
      components: { session_migration: 'failed', mcp: 'starting' },
      component_errors: { session_migration: 'legacy import failed' },
    };
    stubManagedHealth(() => health);
    const child = makeChild();
    stubSpawn(child);
    const progress: BackendStartupProgress[] = [];
    const promise = ensureBackendRunning({ onProgress: (p) => progress.push(p) });
    await vi.advanceTimersByTimeAsync(1_200);

    expect(progress.at(-1)?.detail).toContain('session_migration(failed: legacy import failed)');
    expect(progress.at(-1)?.detail).toContain('mcp');

    health = { status: 'ok' };
    await vi.advanceTimersByTimeAsync(1_000);
    await promise;
  });

  it('fails immediately when the process exits, with the last 50 log lines', async () => {
    stubManagedHealth(() => null);
    const child = makeChild();
    stubSpawn(child);

    const promise = ensureBackendRunning();
    // Let the spawn + wait loop actually start before the process dies.
    await vi.advanceTimersByTimeAsync(300);
    child.stderr.emit('data', 'FIRST-LINE\n');
    for (let i = 0; i < 58; i += 1) child.stderr.emit('data', `filler ${i}\n`);
    child.stderr.emit('data', 'LAST-LINE\n');
    child.exitCode = 1;
    child.emit('exit', 1, null);
    const error = await promise.then(
      () => { throw new Error('expected rejection'); },
      (caught: Error) => caught,
    );
    expect(error.message).toContain('exited before becoming healthy');
    expect(error.message).toContain('LAST-LINE');
    expect(error.message).not.toContain('FIRST-LINE');
  });

  it('waits for an external backend that is still starting instead of spawning a second one', async () => {
    let health: unknown = { status: 'starting', components: { mcp: 'starting' } };
    stubHealth(() => health);
    const promise = ensureBackendRunning();
    await vi.advanceTimersByTimeAsync(5_000);
    expect(h.spawn).not.toHaveBeenCalled();
    health = { status: 'ok' };
    await vi.advanceTimersByTimeAsync(1_000);
    await expect(promise).resolves.toEqual({ ready: true, managed: false });
  });
import { EventEmitter } from 'node:events';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';

const { spawnMock } = vi.hoisted(() => ({ spawnMock: vi.fn() }));
vi.mock('node:child_process', async (importOriginal) => ({
  ...await importOriginal<typeof import('node:child_process')>(), spawn: spawnMock,
}));

describe('backend lifecycle evidence after startup', () => {
  let child: EventEmitter & { pid: number; exitCode: number | null;
    signalCode: NodeJS.Signals | null; stdout: EventEmitter; stderr: EventEmitter };
  let root: string;
  let spawned: boolean;

  beforeEach(() => {
    vi.resetModules();
    vi.useFakeTimers();
    const scratch = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../.tmp');
    fs.mkdirSync(scratch, { recursive: true });
    root = fs.mkdtempSync(path.join(scratch, 'backend-lifecycle-'));
    vi.stubEnv('ATLAS_DATA_DIR', root);
    vi.stubEnv('ATLAS_ROOT', path.resolve(scratch, '..'));
    vi.stubEnv('ATLAS_PORT', '28999');
    vi.stubEnv('ATLAS_PYTHON', 'isolated-test-python');
    vi.stubEnv('ATLAS_BACKEND_EXECUTABLE', '');
    child = Object.assign(new EventEmitter(), {
      pid: 12345678, exitCode: null, signalCode: null,
      stdout: new EventEmitter(), stderr: new EventEmitter(),
    });
    spawned = false;
    spawnMock.mockReset().mockImplementation(() => { spawned = true; return child; });
    vi.stubGlobal('fetch', vi.fn(async (url: string) => {
      if (String(url).includes('/api/runtime/shutdown')) {
        child.exitCode = 0;
        child.emit('exit', 0, null);
        child.emit('close', 0, null);
        return { status: 202 };
      }
      return spawned ? { status: 200, json: async () => ({ status: 'ok' }) } : { status: 503 };
    }));
  });

  afterEach(() => {
    child.emit('close', child.exitCode, child.signalCode);
    vi.restoreAllMocks();
    vi.unstubAllEnvs();
    vi.unstubAllGlobals();
    vi.useRealTimers();
  });

  async function started() {
    const backend = await import('./backendProcess.js');
    const launch = backend.ensureBackendRunning();
    const ready = expect(launch).resolves.toMatchObject({ ready: true, managed: true });
    await vi.runAllTimersAsync();
    await ready;
    return backend;
  }

  function records(logPath: string) {
    return fs.readFileSync(logPath, 'utf8').trim().split(/\r?\n/)
      .filter(Boolean).map((line) => JSON.parse(line));
  }

  it('records an unexpected exit code and process identity after becoming ready', async () => {
    const backend = await started();
    child.exitCode = 23;
    child.emit('exit', 23, null);
    child.emit('close', 23, null);
    expect(records(backend.getBackendLogPath())).toContainEqual(expect.objectContaining({
      event: 'backend.process_exit', pid: 12345678, code: 23, signal: null,
      stop_reason: null,
    }));
  });

  it('distinguishes a requested shutdown from an unexpected exit', async () => {
    const backend = await started();
    await backend.stopManagedBackend();
    const events = records(backend.getBackendLogPath());
    expect(events).toContainEqual(expect.objectContaining({
      event: 'backend.stop_requested', pid: 12345678, reason: 'app_quit',
    }));
    expect(events).toContainEqual(expect.objectContaining({
      event: 'backend.process_exit', code: 0, stop_reason: 'app_quit',
    }));
  });
});
    throw new Error('Skill Center authority is unavailable to untrusted pages');
  }
  return process.env.ATLAS_SKILL_CENTER_TOKEN;
});

app.whenReady().then(async () => {
  if (!hasSingleInstanceLock) return;
  applySavedDataRoot();
  platformPreferences = loadPlatformPreferences();
  app.setLoginItemSettings({ openAtLogin: platformPreferences.openAtLogin, args: platformPreferences.openAtLogin ? ['--background'] : [] });
  registerPreferredGlobalShortcut();
  // Dedicated system-wide shortcut for the floating composer; it does not replace the user's
  // configurable Atlas focus shortcut. Registration failure leaves the in-app API available.
  globalShortcut.register('Control+Alt+Space', showFloatingComposer);
  if (app.isPackaged) app.setAsDefaultProtocolClient('atlas');
  else if (process.platform === 'win32' || process.platform === 'linux') {
    app.setAsDefaultProtocolClient('atlas', process.execPath, [path.resolve(process.argv[1] ?? '.')]);
  }
  // Atlas draws its own title bar; the default menu's hidden accelerators (Ctrl+W closes the
  // window, Ctrl+R reloads) would fire over the app's own shortcuts.
  createApplicationMenu();
  if (app.isPackaged) {
    process.env.ATLAS_ROOT ??= path.join(process.resourcesPath, 'atlas');
    process.env.ATLAS_DATA_DIR ??= app.getPath('userData');
    process.env.ATLAS_BACKEND_EXECUTABLE ??= path.join(process.resourcesPath, 'atlas', 'backend', 'atlas_backend.exe');
    process.env.ATLAS_NODE_RUNTIME_DIR = path.join(process.resourcesPath, 'atlas', 'runtime', 'node');
    process.env.ATLAS_NODE_RUNTIME_REQUIRED = '1';
    const packageJson = JSON.parse(readFileSync(path.join(app.getAppPath(), 'package.json'), 'utf8'));
    const selectedPackages = [
      '@agentclientprotocol/claude-agent-acp',
      '@agentclientprotocol/codex-acp',
      '@ast-grep/cli',
      '@mariozechner/pi-coding-agent',
      '@playwright/mcp',
      'chrome-devtools-mcp',
    ];
    process.env.ATLAS_NPM_PACKAGE_VERSIONS = JSON.stringify(
      Object.fromEntries(selectedPackages.map((name) => [name, packageJson.dependencies?.[name]])),
    );
  }
  prepareSharedApiToken();
  attachBackendToken();
  lockDownWebviews();
  createTray();
  createWindow();
  if (platformPreferences.safeModeOnNextStart) void restartBackendNow('safe_mode_preference_start', true);
  else startBackend();
  void refreshTrayBackendStatus();
  trayRefreshTimer = setInterval(() => { void refreshTrayBackendStatus(); }, 5_000);
  const initialDeepLink = findAtlasUrl(process.argv);
  if (initialDeepLink) receiveAtlasDeepLink(initialDeepLink);
  // The window may appear after boot already finished (fast external backend): give the
  // renderer the current state once so its startup surfaces resolve immediately.
  windowRef?.webContents.send(BACKEND_STARTUP_CHANNEL, lastProgress);
  app.on('activate', () => { if (BrowserWindow.getAllWindows().length === 0) createWindow(); });
}).catch((error: unknown) => {
  // An exception here used to leave a windowless main process running with no backend.
  const message = error instanceof Error ? error.stack ?? error.message : String(error);
  dialog.showErrorBox('Atlas 启动失败', `Atlas 启动时出错，请把下面的信息发给维护者：\n\n${message}`);
  app.exit(1);
/** Backend boot progress, broadcast while the desktop backend starts (H8 §10.3). */
export type BackendStartupPhase = 'probing' | 'starting' | 'ready' | 'failed';
export interface BackendStartupProgress {
  phase: BackendStartupPhase;
  /** True when this Electron session spawned the backend (vs. attaching to an external one). */
  managed: boolean;
  elapsedMs: number;
  /** Short human-readable status for the UI, e.g. which health components are still starting. */
  detail?: string;
  message?: string;
  logPath?: string;
}
/** IPC channel the main process sends {@link BackendStartupProgress} events on. */
export const BACKEND_STARTUP_CHANNEL = 'backend:startup-progress';

/** Source-mode update state (Atlas running from a git checkout). */
export interface SourceUpdateStatus {
  supported: boolean;
  available: boolean;
  behind: number;
  branch?: string;
  commits: Array<{ hash: string; subject: string }>;
  blocked?: string;
  error?: string;
}
export interface ReleaseUpdateStatus { supported: boolean; available: boolean; current: string; latest?: string; notes?: string; assetName?: string; error?: string; skipped?: boolean }

