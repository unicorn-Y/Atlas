+  private async repairRunEventGap(
+    runId: string,
+    afterSequence: number,
+    onEvent: (event: RuntimeStreamEvent) => void,
+  ): Promise<{ cursor: number; terminal: boolean }> {
+    let cursor = afterSequence;
+    let highWater = cursor;
