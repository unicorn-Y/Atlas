+    services: Annotated[AppServices, Depends(get_app_services)],
+    after_sequence: Annotated[int, Query(ge=0)] = 0,
+    limit: Annotated[int, Query(ge=1, le=500)] = 200,
+) -> dict[str, object]:
+    """Read a bounded event page for repairing a live WebSocket sequence gap."""
+    run = services.runtime_mgr.runs.get(run_id)
+    if run is None:
+        raise HTTPException(status_code=404, detail="Run state is no longer available")
+    async with run.event_lock:
+        events = [event for event in run.events if int(event.get("sequence", 0)) > after_sequence]
+        page = events[:limit]
+        cursor = max((int(event.get("sequence", 0)) for event in run.events), default=0)
+        header = run.events[:1]
+        tail = run.events[-10:]
+        return {
+            "events": page,
+            "next_cursor": int(page[-1]["sequence"]) if page else after_sequence,
+            "cursor": cursor,
+            "header": header,
+            "tail": tail,
+            "projection_baseline": {"run_id": run_id, "sequence": cursor},
+            "has_more": bool(page and int(page[-1]["sequence"]) < cursor),
+        }
+
+
 @router.websocket("/ws/chat")
 async def ws_chat(
     ws: WebSocket, services: Annotated[AppServices, Depends(get_app_services)],
diff --git a/core/tests/test_runtime_event_paging.py b/core/tests/test_runtime_event_paging.py
new file mode 100644
index 0000000000000000000000000000000000000000..56d6938196d09a28017481b494ef9170f89d4e19
--- /dev/null
+++ b/core/tests/test_runtime_event_paging.py
@@ -0,0 +1,28 @@
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from atlas.api.runtime import RunState
+from atlas.api.runtime_ws_router import page_run_events
+
+
+@pytest.mark.unit
+def test_run_event_page_exposes_cursor_header_tail_and_bounded_events() -> None:
+    run = RunState("run-1", "conversation-1", "model")
+    run.next_envelope("run.started", {"content": "hello"})
+    for index in range(1, 6):
+        run.next_envelope("message.delta", {"content": str(index)})
+    services = SimpleNamespace(runtime_mgr=SimpleNamespace(runs={run.run_id: run}))
+
+    page = asyncio.run(page_run_events(run.run_id, services, 2, 2))
+
+    assert [event["sequence"] for event in page["events"]] == [3, 4]
+    assert page["next_cursor"] == 4
+    assert page["cursor"] == 6
+    assert page["has_more"] is True
+    assert page["header"][0]["sequence"] == 1
+    assert [event["sequence"] for event in page["tail"]] == [1, 2, 3, 4, 5, 6]
+    assert page["projection_baseline"] == {"run_id": "run-1", "sequence": 6}
