+        cursor = max((int(event.get("sequence", 0)) for event in run.events), default=0)
+        header = run.events[:1]
+        tail = run.events[-10:]
+        return {
+            "events": page,
+            "next_cursor": int(page[-1]["sequence"]) if page else after_sequence,
+            "cursor": cursor,
+            "header": header,
+            "tail": tail,
+            "projection_baseline": {"run_id": run_id, "sequence": cursor},
