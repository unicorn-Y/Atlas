function activityDetail(): string {
  const lines = [
    `本地运行任务：${quitActivitySummary.runningTasks} 个（退出会中断仍在运行的任务）`,
    `已启用排期任务：${quitActivitySummary.scheduledTasks} 个（退出期间不会触发，Atlas 下次启动后恢复）`,
  ];
  return lines.join('\n');
}

