  }

  /** Send a client message on the socket of a live run (protocol 1.3 steer, input and plan replies). */
  private sendOnRun(runId: string, message: Record<string, unknown>): void {
    const socket = this.runSockets.get(runId);
    if (!socket || socket.readyState !== WebSocket.OPEN) throw new BackendError('和后端的连接已断开，这条操作没能送达', 'Agent Runtime socket is not connected');
    socket.send(JSON.stringify(message));
  }

  /** Add an instruction to a running run; it reaches the model before its next turn. */
  steerRun(runId: string, content: string, eventId: string, immediate = false): void {
    this.sendOnRun(runId, { type: 'run.steer', run_id: runId, content, event_id: eventId, immediate });
  }

  /** Add an instruction directly to a running delegated subtask. */
  steerSubtask(runId: string, subtaskId: string, text: string, eventId: string): void {
    this.sendOnRun(runId, { type: 'subtask.message', run_id: runId, subtask_id: subtaskId, text, event_id: eventId });
  }

  /** Runs the backend still holds as running or waiting (input/approval/plan), per conversation. */
  async liveBackendRuns(): Promise<Array<{ conversation_id: string; run_id: string; status: string; waiting_for: string | null }>> {
    if (!this.live) return [];
    const result = await this.request<{ items: Array<{ conversation_id: string; run_id: string; status: string; waiting_for: string | null }> }>('/api/conversation-activity');
    return (result.items ?? []).filter((item) => item.status === 'running' || item.status === 'waiting');
  }

  /**
   * Re-attach to a run that is still alive on the backend after the renderer lost it (page reload,
   * reopened window) and replay all of its events, so pending question/approval cards come back and
   * can be answered. Registers the socket so respondToInput/approve reach this run.
   */
  async attachRun(runId: string, onEvent: (event: RuntimeStreamEvent) => void): Promise<void> {
    if (!this.live) await this.initialize(3000);
    if (!this.live || this.runSockets.has(runId)) return;
    const cursorKey = `atlas.runtime.cursor.${runId}`;
    let lastSequence = Number(localStorage.getItem(cursorKey) ?? 0) || 0;
    let retries = 0;
    let terminal = false;
    let firstConnect = true;
    const connect = (): Promise<void> => new Promise<void>((resolve, reject) => {
      const socket = new WebSocket(`${this.baseUrl.replace(/^http/, 'ws')}/ws/chat`);
      this.runSockets.set(runId, socket);
      let opened = false;
      let settled = false;
      const finish = (error?: Error) => {
        if (settled) return;
        settled = true;
        if (this.runSockets.get(runId) === socket) this.runSockets.delete(runId);
        if (error) reject(error); else resolve();
      };
      socket.addEventListener('open', () => {
        opened = true;
        socket.send(JSON.stringify({ type: 'resume', run_id: runId, after_sequence: firstConnect ? 0 : lastSequence }));
        firstConnect = false;
      }, { once: true });
      socket.addEventListener('message', (message) => {
        let event: RuntimeStreamEvent;
        try { event = JSON.parse(String(message.data)) as RuntimeStreamEvent; } catch { return; }
        if (!('type' in event) || event.type !== 'agent_event') return;
        const runtimeEvent = event as RuntimeEventEnvelope;
        if (runtimeEvent.run_id !== runId || !Number.isInteger(runtimeEvent.sequence) || runtimeEvent.sequence <= lastSequence) return;
        if (runtimeEvent.sequence !== lastSequence + 1) {
          socket.close(4000, 'Repair event sequence gap');
          return;
        }
        lastSequence = runtimeEvent.sequence;
        localStorage.setItem(cursorKey, String(lastSequence));
        onEvent(runtimeEvent);
        retries = 0;
        if (['run.completed', 'run.failed', 'run.cancelled'].includes(runtimeEvent.event)) {
          terminal = true;
          socket.close(1000, 'Run complete');
          finish();
        }
      });
      socket.addEventListener('error', () => {
        if (!opened) finish(new BackendError('连不上后端的任务通道', 'WebSocket connection failed'));
      });
      socket.addEventListener('close', () => {
        if (this.runSockets.get(runId) === socket) this.runSockets.delete(runId);
        if (settled) return;
        if (terminal) { finish(); return; }
        if (!opened) { finish(new BackendError('任务恢复通道连接失败', 'Run follow socket failed before opening')); return; }
        retries += 1;
        window.setTimeout(() => { void connect().then(() => finish(), finish); }, Math.min(1000 * 2 ** (retries - 1), 8000));
      }, { once: true });
    });
    await connect();
  }

  respondToInput(runId: string, eventId: string, text: string): void {
    this.sendOnRun(runId, { type: 'input.response', event_id: eventId, text });
  }

  /** Answer rules.trust_required: whether this directory's AGENTS.md etc. may be loaded. */
  trustRules(runId: string, eventId: string, trust: boolean): void {
    this.sendOnRun(runId, { type: 'rules.trust', run_id: runId, event_id: eventId, trust });
  }

