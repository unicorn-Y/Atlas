"""Persistence behavior for the extracted per-app runtime manager."""

import ast
from pathlib import Path

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient

from atlas.api.app_services import AppServices
from atlas.api.runtime import RunState, RuntimeManager
from atlas.api.runtime_router import router as runtime_router


@pytest.mark.asyncio
async def test_runtime_manager_recovers_interrupted_run_as_failed(tmp_path) -> None:
    db_path = tmp_path / "runtime.sqlite3"
    manager = RuntimeManager(db_path)
    await manager.init()
    run = RunState("run-1", "conversation-1", "model-1")
    run.next_envelope("run.started", {})
    await manager.persist_run(run)
    await manager.close()

    restarted = RuntimeManager(db_path)
    await restarted.init()
    try:
        recovered = restarted.runs["run-1"]
        assert recovered.status == "failed"
        assert recovered.events[-1]["event"] == "run.failed"
        assert recovered.events[-1]["data"]["category"] == "interrupted"
        assert recovered.sequence == 2
    finally:
        await restarted.close()


@pytest.mark.asyncio
async def test_ephemeral_runs_are_not_written_to_runtime_database(tmp_path) -> None:
    db_path = tmp_path / "runtime.sqlite3"
    manager = RuntimeManager(db_path)
    await manager.init()
    run = RunState("temporary-run", "ephemeral-temporary-run", "model-1")
    run.ephemeral = True
    run.next_envelope("run.started", {})
    await manager.persist_run(run)
[project]
name = "atlas-core"
version = "0.1.0"
description = "Atlas AI Agent - Core Backend"
# 3.11, because that is what Atlas actually runs on. Three other places in this
# repository already say so — [tool.ruff] target-version = "py311", the runtime
# check in atlas/api/diagnostics_router.py (>= 3, 11), and the interpreter the
# editable install lives in (3.11.16). This line alone said 3.14, which made
# `pip install -e ./core` fail outright:
#   ERROR: Package 'atlas-core' requires a different Python: 3.11.16 not in '>=3.14'
# The intent behind 3.14 was presumably to move forward eventually; raising this
# floor without raising the runtime is not a plan, it is a broken install.
requires-python = ">=3.11"
readme = "README.md"
license = { text = "UNLICENSED" }

