  const hasActivity = quitActivitySummary.runningTasks > 0 || quitActivitySummary.scheduledTasks > 0;
  if (hasActivity) {
    const options = {
      type: 'warning' as const,
      title: '退出 Atlas？',
      message: '退出会停止本地活动并暂停排期任务。',
