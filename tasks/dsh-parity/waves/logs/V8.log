  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.atlas.desktop",
    "productName": "Atlas",
    "protocols": [
      {
        "name": "Atlas",
        "schemes": [
          "atlas"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "windows-release"
    },
    "electronDist": "electron-runtime",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "assets/icon/icon-*.png"
    ],
    "extraResources": [
      {
        "from": "dist/dashboard.html",
        "to": "atlas/dashboard/dashboard.html"
      },
      {
        "from": "dist/assets",
        "to": "atlas/dashboard/assets",
        "filter": [
          "dashboard-*",
          "rolldown-runtime-*",
          "jsx-runtime-*",
          "client-*"
        ]
      },
      {
        "from": "../core/atlas",
        "to": "atlas/core/atlas",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "./backend-release/atlas_backend",
        "to": "atlas/backend"
      },
      {
        "from": "./backend-release/runtime/node",
        "to": "atlas/runtime/node"
      },
      {
        "from": "./backend-release/runtime/whatsapp-bridge",
        "to": "atlas/runtime/whatsapp-bridge"
      },
      {
        "from": "../skills",
        "to": "atlas/skills",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../config/atlas.example.toml",
        "to": "atlas/config/atlas.example.toml"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon/icon.ico",
      "uninstallerIcon": "assets/icon/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas"
    },
    "afterPack": "scripts/after-pack-icon.cjs"
  }
}
