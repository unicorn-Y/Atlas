    "sherpa-onnx>=1.12.20",
    "litellm>=1.50.0",
    "anthropic>=0.76.0",
    "json-repair>=0.60.0",
    "charset-normalizer>=3.4.0",
    "langchain-core>=0.3.0",
    "pydantic>=2.9.0",
    "pydantic-settings>=2.5.0",
    "aiosqlite>=0.20.0",
    "apscheduler>=4.0.0a5",
    "tzlocal>=5.2",
    "httpx>=0.27.0",
    "httpcore>=1.0.0",
    "click>=8.1.0",
    "rich>=13.9.0",
    "tomli>=2.0.0",
    "tomli-w>=1.0.0",
    "structlog>=24.4.0",
    "numpy>=2.0.0",
    "psutil>=6.0.0",
    "Pygments>=2.18.0",
    "requests>=2.32.0",
    "snowballstemmer>=2.2.0",
