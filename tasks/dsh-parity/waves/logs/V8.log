      on: vi.fn(),
      send: vi.fn(),
      setWindowOpenHandler: vi.fn(),
      loadURL: vi.fn(),
      reload: vi.fn(),
    },
  };
  const BrowserWindow = Object.assign(
    vi.fn(function BrowserWindowMock() { return window; }),
