+  private async repairRunEventGap(runId: string, afterSequence: number, onEvent: (event: RuntimeStreamEvent) => void): Promise<{ cursor: number; terminal: boolean }> {
+    let cursor = afterSequence;
+    let highWater = cursor;
+    let terminal = false;
+    for (;;) {
+      const page = await this.request<{ events: RuntimeStreamEvent[]; next_cursor: number; cursor: number; has_more: boolean }>(
