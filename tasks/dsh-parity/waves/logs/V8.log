async function ensureBackendRunningImpl(options?: EnsureBackendOptions): Promise<BackendLaunchResult> {
  const onProgress = options?.onProgress;
  const startedAt = Date.now();
  const emit = (phase: BackendStartupProgress['phase'], managed: boolean, detail?: string) => {
    onProgress?.({ phase, managed, elapsedMs: Date.now() - startedAt, detail });
  };

  try {
    loadSharedApiToken();
    // The window reports "probing" as soon as it starts looking, before it knows whether
    // it will attach to a resident backend or spawn one.
    emit('probing', false);
    // Fast path (resident backend): a healthy Atlas that accepts our token is attached
    // without the netstat/PowerShell process checks below, which cost seconds on Windows.
    const live = await probeHealth();
    if (live?.ready && isAtlasHealthPayload(live.payload) && await externalAcceptsSessionToken()) {
      emit('ready', false, '复用已运行的 Atlas 后端');
      return { ready: true, managed: false, pid: readBackendPid() ?? undefined };
    }
    const verdict = await preparePreviousBackend(onProgress);
    if (verdict === 'reuse') {
      emit('ready', false, '复用已运行的 Atlas 后端');
      return { ready: true, managed: false, pid: readBackendPid() ?? undefined };
    }
    if (verdict === 'wait') {
      // Alive and ours, just slow. Wait it out; never take it down.
      try {
        return await waitForRunningBackend(onProgress, startedAt + STARTUP_MAX_WAIT_MS);
      } catch (error) {
        if (error instanceof Error && error.message === '__backend_gone__') {
          // Fall through to the spawn path below.
        } else {
          throw error;
        }
      }
    }
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    emit('failed', false, `${message}\n日志文件：${getBackendLogPath()}`);
    throw new Error(`${message}\n日志文件：${getBackendLogPath()}`);
  }

  // A busy backend (mid model-switch engine rebuild, heartbeat/automation tick
  // burst) can miss one probe, and an external backend may still be starting
  // its deferred components. Spawning a second backend then dies on the occupied
  // port and takes the window down with it, so: re-probe a few times, and once
  // an external backend answers at all, wait for it instead of spawning.
  for (let attempt = 0; attempt < 3; attempt += 1) {
    const probeStartedAt = Date.now();
    const contact = await probeHealth();
    if (contact?.ready) {
      const attached = await attachExternal();
      emit('ready', false);
      return attached;
    }
    if (contact && isAtlasHealthPayload(contact.payload)) {
      // Something Atlas-shaped owns the port; wait for it rather than race it.
      try {
        return await waitForRunningBackend(onProgress, startedAt + STARTUP_MAX_WAIT_MS);
      } catch (error) {
        // It exited while we waited; the port is free, so spawn normally.
        if (!(error instanceof Error && error.message === '__backend_gone__')) throw error;
        break;
      }
    }
    // Only a probe that ran into its timeout suggests a busy backend worth re-probing;
    // a refused connection means nothing is listening, so spawn right away.
    const timedOut = contact === null && Date.now() - probeStartedAt >= PROBE_TIMEOUT_MS;
    if (!timedOut) break;
    if (attempt < 2) await sleep(600);
  }

  const packagedBackend = process.env.ATLAS_BACKEND_EXECUTABLE;
  const rootDir = process.env.ATLAS_ROOT
    ? path.resolve(process.env.ATLAS_ROOT)
    : path.resolve(moduleDir, '../../..');
  const coreDir = packagedBackend ? rootDir : resolveCoreDir();
  const candidates: BackendCandidate[] = packagedBackend
    ? [{ command: packagedBackend, args: options?.safeMode ? ['--safe-mode'] : [], cwd: rootDir }]
    : pythonCandidates(coreDir).map((candidate) => ({
      command: candidate.command,
      args: [...candidate.args, '-m', 'atlas.desktop_entry', ...(options?.safeMode ? ['--safe-mode'] : [])],
      cwd: coreDir,
    }));
  let lastNotFound: NodeJS.ErrnoException | null = null;
  for (const candidate of candidates) {
    let started: Awaited<ReturnType<typeof startCandidate>> | null = null;
    try {
      started = await startCandidate(candidate.command, candidate.args, candidate.cwd);
      managedChild = started.child;
      emit('starting', true, '后端进程已启动，等待健康检查');
      await waitUntilReady(started.child, started.stderr, started.outcome, onProgress);
      return { ready: true, managed: true, pid: started.child.pid };
    } catch (error) {
      if (started) await stopManagedBackend('startup_failed');
      const spawnError = error as NodeJS.ErrnoException;
      if (spawnError.code === 'ENOENT') {
        lastNotFound = spawnError;
        continue;
      }
      throw error;
    }
  }
  const message = `Could not start the Atlas backend.${lastNotFound ? ` ${lastNotFound.message}` : ''}`;
  emit('failed', false, `${message}\n日志文件：${getBackendLogPath()}`);
  throw new Error(`${message}\n日志文件：${getBackendLogPath()}`);
}

/** Start or attach to the backend. Calling again after rejection is the retry API. */
export async function ensureBackendRunning(options?: EnsureBackendOptions): Promise<BackendLaunchResult> {
  const startedAt = Date.now();
  let lastPhase: BackendStartupProgress['phase'] | undefined;
  try {
    return await ensureBackendRunningImpl({
      ...options,
      onProgress: (progress) => {
        lastPhase = progress.phase;
        options?.onProgress?.(progress);
      },
    });
  } catch (error) {
    if (lastPhase !== 'failed') {
      const message = error instanceof Error ? error.message : String(error);
      options?.onProgress?.({
        phase: 'failed',
        managed: false,
        elapsedMs: Date.now() - startedAt,
        detail: `${message}\n日志文件：${getBackendLogPath()}`,
      });
    }
    throw error;
  }
}

export function stopManagedBackend(reason = 'app_quit'): Promise<void> {
  if (stopPromise) return stopPromise;
  const child = managedChild;
  managedChild = null;
  if (!child) return Promise.resolve();
  stopReasons.set(child, reason);
  recordBackendLifecycle('backend.stop_requested', { pid: child.pid ?? null, reason });
  stopPromise = terminate(child).finally(() => { stopPromise = null; });
import type { AgentEvent, AgentRun, AgentRunPhase, AgentRunStatus } from '../../types/runtime';

export interface RuntimeEventEnvelope {
  type: 'agent_event';
  event_id: string;
  run_id: string;
  sequence: number;
  timestamp: string;
  event: string;
  data?: Record<string, unknown>;
}

const statuses = new Set<AgentRunStatus>(['idle', 'planning', 'running', 'waiting', 'paused', 'completed', 'failed', 'cancelled']);
const phases = new Set<AgentRunPhase>(['planning', 'reasoning', 'execution', 'verification', 'final']);

export function isRuntimeEvent(value: unknown): value is RuntimeEventEnvelope {
  if (!value || typeof value !== 'object') return false;
  const event = value as Partial<RuntimeEventEnvelope>;
  return event.type === 'agent_event' && typeof event.event_id === 'string' && typeof event.run_id === 'string'
    && Number.isInteger(event.sequence) && typeof event.timestamp === 'string' && typeof event.event === 'string';
}

const DOCUMENT_KIND: Record<string, string> = { document: '生成了 Word 文档', spreadsheet: '生成了 Excel 表格', presentation: '生成了 PPT 演示文稿' };

export function normalizeRuntimeEvent(envelope: RuntimeEventEnvelope): AgentEvent | null {
  // 已知事件才会被渲染；新的 wire 事件（如 lsp.diagnostics、review.findings、X2 的 computer.* / browser.*）加入这里即可显示。
  const known = new Set(['run.started', 'run.status', 'run.phase', 'run.background', 'message.delta', 'message.completed', 'tool.preparing', 'tool.started', 'tool.output', 'tool.completed', 'approval.required', 'approval.responded', 'artifact.updated', 'run.paused', 'run.resumed', 'run.plan.updated', 'run.steered', 'run.usage', 'run.todos', 'rules.loaded', 'run.context.sources', 'input.required', 'run.plan.proposed', 'subtask.started', 'subtask.progress', 'subtask.output', 'subtask.completed', 'subtask.group_completed', 'subtask.background_completed', 'check.results', 'rules.trust_required', 'hook.ran', 'run.model_switched', 'run.verify_nudge', 'session.title', 'process.completed', 'run.compaction.progress', 'run.recovery.notice', 'context.window.switched', 'chapter.marked', 'lsp.diagnostics', 'review.findings', 'run.completed', 'run.failed', 'run.cancelled',
    // X2 电脑操控：前台确认、恢复与每一步动作（供 ForegroundConfirmCard / ComputerEdgeBar / ComputerReplayPanel）。
    'computer.foreground_required', 'computer.foreground_resumed', 'computer.foreground_denied', 'computer.step', 'computer.frame',
    // X2 浏览器代理：交接确认与结果、面板地址同步、录制中的每一步（供 BrowserHandoffCard / BrowserRecorderPanel）。
    'browser.handoff_required', 'browser.handoff_resolved', 'browser.panel.sync', 'browser.step', 'browser.artifact',
    'browser.vault_fill_denied', 'mcp.startup.progress', 'media.ocr.progress', 'canvas.update', 'component.push',
    // Already rendered elsewhere but dropped here — a name missing from this set is a silent
    // runtime drop, not a type error. Steer feedback (ConversationActivity:322) and the goal
    // notices (timeline goal case) both used to be unreachable for exactly that reason.
    'subtask.steered', 'subtask.steer_rejected', 'run.steer.rejected',
    'goal.updated', 'goal.continuation', 'safety.reviewed', 'moa.references', 'run.context.warning']);
  known.add('process.notification');
  const base = { id: envelope.event_id, runId: envelope.run_id, sequence: envelope.sequence, timestamp: envelope.timestamp };
  // Office files and other generated documents: shown like any other artifact.
  if (envelope.event === 'artifact.created') {
    const data = envelope.data ?? {};
    const path = String(data.path ?? '');
    return { ...base, type: 'artifact.updated', data: {
      ...data, artifact_id: `created:${path || envelope.event_id}`, artifact_type: 'file',
      name: path.split(/[\\/]/).pop() || '文件', summary: DOCUMENT_KIND[String(data.kind)] ?? '生成了文件',
    } };
  }
  if (!known.has(envelope.event)) return null;
  return { ...base, type: envelope.event as AgentEvent['type'], data: envelope.data ?? {} };
}

export function applyRuntimeEvent(run: AgentRun, event: AgentEvent): AgentRun {
  const data = event.data;
  let status = run.status;
  let phase = run.phase;
  const background = event.type === 'run.background' && typeof data.background === 'boolean' ? data.background : run.background;
  if (event.type === 'run.status' && typeof data.status === 'string' && statuses.has(data.status as AgentRunStatus)) status = data.status as AgentRunStatus;
  if (event.type === 'run.phase' && typeof data.phase === 'string' && phases.has(data.phase as AgentRunPhase)) phase = data.phase as AgentRunPhase;
  if (event.type === 'run.paused') status = 'paused';
  if (event.type === 'run.resumed') status = 'running';
  if (event.type === 'run.cancelled') status = 'cancelled';
  if (event.type === 'approval.required' || event.type === 'input.required' || event.type === 'run.plan.proposed' || event.type === 'rules.trust_required') status = 'waiting';
  // The answer to a question or plan arrives as ordinary progress, not as its own event.
  if ((event.type === 'message.delta' || event.type === 'tool.started') && status === 'waiting') status = 'running';
  if (event.type === 'run.completed') { status = 'completed'; phase = 'final'; }
  if (event.type === 'run.failed') status = 'failed';
  // 去重：sequence 单调递增是 wire 契约，新 sequence 不可能重复，免去每个事件两次 O(n) 扫描；
  // 乱序/重放（sequence <= lastEventSequence，例如断线续传）才做完整查重并按 sequence 排回原位。
  let events: AgentEvent[];
  if (event.type === 'tool.preparing' && event.sequence > run.lastEventSequence) {
    // Argument-growth updates replace the previous one for the same call, keeping when it started,
    // so a long write_file does not create a row for every argument update.
    let previous: AgentEvent | undefined;
    for (let i = run.events.length - 1; i >= 0; i -= 1) {
      const item = run.events[i];
      if (item.type === 'tool.started' || item.type === 'run.started') break;
      if (item.type === 'tool.preparing' && item.data.index === data.index && item.data.attempt === data.attempt) { previous = item; break; }
    }
    if (previous) {
      const kept = { ...event, data: { ...data, started_at: previous.data.started_at ?? previous.timestamp } };
      events = run.events.filter((item) => item !== previous);
      events.push(kept);
    } else events = [...run.events, event];
  } else if (event.sequence > run.lastEventSequence) {
    events = [...run.events, event];
  } else {
    if (run.events.some((item) => item.id === event.id) || run.events.some((item) => item.sequence === event.sequence)) return run;
    events = [...run.events, event].sort((a, b) => a.sequence - b.sequence);
  }
  return { ...run, status, phase, background, updatedAt: event.timestamp, lastEventSequence: Math.max(run.lastEventSequence, event.sequence), events,
    eventsTruncated: run.eventsTruncated ?? false, droppedEventCount: run.droppedEventCount ?? 0 };
}
