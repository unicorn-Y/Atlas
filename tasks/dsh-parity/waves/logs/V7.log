import asyncio, json, uuid
import websockets

async def main():
    rid = str(uuid.uuid4())
    prompt = ('Use local_shell exactly once with command \"echo E18_APPROVAL_PROBE\". '
              'For that tool call set sandbox_permissions to \"read-only\" and justification to '
              '\"Verify one-call sandbox escalation approval\". Do not call any other tool. '
              'After the result, report what happened in one sentence.')
    async with websockets.connect('ws://127.0.0.1:8837/ws/chat', max_size=8*1024*1024) as ws:
        await ws.send(json.dumps({
            'type':'run.start', 'run_id':rid, 'conversation_id':'dsh-e18-'+rid[:8],
            'workspace':r'D:\\Atlas\\.worktrees\\dsh2-V7', 'content':prompt,
            'model':'deepseek-v4.1-flash', 'mode':'act',
            'approval_policy':'ask', 'sandbox_mode':'workspace-write'
        }))
        deadline=asyncio.get_running_loop().time()+150
        parts=[]
        while asyncio.get_running_loop().time()<deadline:
            try: raw=await asyncio.wait_for(ws.recv(),timeout=5)
            except asyncio.TimeoutError: continue
            if isinstance(raw,bytes): raw=raw.decode('utf-8','replace')
            try: frame=json.loads(raw)
            except ValueError: continue
            event=frame.get('event') or frame.get('type')
            data=frame.get('data') or {}
            if event in {'approval.required','input.required','run.plan.proposed'}:
                print(f\"[event] {event} tool={data.get('tool')} approval_id={data.get('approval_id') or data.get('event_id')}\",flush=True)
                print('[approval_input] '+json.dumps(data.get('input') or {},ensure_ascii=False),flush=True)
                await ws.send(json.dumps({'type':'approval.response','event_id':data.get('approval_id') or data.get('event_id'),'choice':'allow_once'}))
            elif event in {'tool.started','tool.preparing'}:
                print(f\"[event] {event} name={data.get('name')}\",flush=True)
            elif event=='message.delta':
                parts.append(str(data.get('content') or ''))
            elif event in {'run.completed','run.failed','run.cancelled'}:
                print('[terminal] '+event+' '+json.dumps(data,ensure_ascii=False)[:350],flush=True)
                break
            elif event:
                print('[event] '+str(event),flush=True)
        print('[reply] '+repr(''.join(parts).strip()[:500]),flush=True)

asyncio.run(main())
