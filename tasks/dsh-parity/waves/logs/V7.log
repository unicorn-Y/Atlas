"C:\\Users\\25011\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe" -Command "@'
import asyncio,json,uuid,os
from pathlib import Path
import websockets
async def main():
 rid=str(uuid.uuid4()); wsroot=str(Path(os.environ['TEMP'])/'atlas-dsh-e18-empty')
 prompt=('Use local_shell exactly once with command \"echo E18_APPROVAL_PROBE\". '
  'For that tool call set sandbox_permissions to \"read-only\" and justification to '
  '\"Verify one-call sandbox escalation approval\". Do not call any other tool. '
  'After the result, report what happened in one sentence.')
 async with websockets.connect('ws://127.0.0.1:8837/ws/chat',max_size=8*1024*1024) as ws:
  await ws.send(json.dumps({'type':'run.start','run_id':rid,'conversation_id':'dsh-e18-'+rid[:8],
   'workspace':wsroot,'content':prompt,'model':'deepseek-v4.1-flash','mode':'act',
   'approval_policy':'ask','sandbox_mode':'workspace-write'}))
  deadline=asyncio.get_running_loop().time()+150; parts=[]; approvals=0
  while asyncio.get_running_loop().time()<deadline:
   try: raw=await asyncio.wait_for(ws.recv(),timeout=5)
   except asyncio.TimeoutError: continue
   if isinstance(raw,bytes): raw=raw.decode('utf-8','replace')
   try: f=json.loads(raw)
   except ValueError: continue
   ev=f.get('event') or f.get('type'); d=f.get('data') or {}
   if ev in {'approval.required','input.required','run.plan.proposed'}:
    aid=d.get('approval_id') or d.get('event_id'); approvals+=1
    print(f'[event] {ev} tool={d.get(\"tool\")} id={aid}',flush=True)
    print('[approval_input] '+json.dumps(d.get('input') or {},ensure_ascii=False),flush=True)
    await ws.send(json.dumps({'type':'approval.response','event_id':aid,'choice':'allow_once'}))
   elif ev=='rules.trust_required':
    print('[event] rules.trust_required; approving this live run',flush=True)
    await ws.send(json.dumps({'type':'rules.trust','run_id':rid,'trust':True}))
   elif ev in {'tool.started','tool.preparing'}: print(f'[event] {ev} name={d.get(\"name\")}',flush=True)
   elif ev=='message.delta': parts.append(str(d.get('content') or ''))
   elif ev in {'run.completed','run.failed','run.cancelled'}:
    print('[terminal] '+ev+' '+json.dumps(d,ensure_ascii=False)[:400],flush=True); break
   elif ev: print('[event] '+str(ev),flush=True)
  print(f'[summary] approvals={approvals} reply='+repr(''.join(parts).strip()[:500]),flush=True)
asyncio.run(main())
