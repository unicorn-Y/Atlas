512:             raise
513:         except Exception as exc:
514:             self.consecutive_failures += 1
515:             return recover_by_trimming(f"summary failed: {exc}")
516:         self.consecutive_failures = 0
517:         return CompactionResult(replacement, "summary", before, size, budget)
1: """One queryable answer for "how full is this context right now".
2: 
3: The kernel already knows four numbers per turn — what the compressor last saw,
4: the model window, the auto-compact trigger and the blocking watermark — but they
5: live in a compressor instance that no request can reach. ``run.context.warning``
6: is emitted mid-turn only, so before a turn starts there is nothing to ask.
7: 
8: This module reads the same values the loop reads, so the number the UI shows and
9: the number that decides compaction cannot disagree. It never estimates a window
10: it does not know: an unknown model reports ``pressure: "unknown"`` rather than a
11: comforting zero.
12: """
13: 
14: from __future__ import annotations
15: 
16: from collections.abc import Callable, Mapping, Sequence
17: from typing import Any
18: 
19: from atlas.engine.kernel.context import (
20:     DEFAULT_CONTEXT_WINDOW,
21:     ContextManager,
22:     ContextThresholds,
23: )
24: 
25: #: Named bands, ordered. ``critical`` is the one that stops a turn.
26: LEVELS = ("idle", "roomy", "filling", "tight", "critical")
27: 
28: #: Fraction of the gap between warning and blocking that still counts as roomy.
29: _ROOMY_BELOW = 0.25
30: _IMAGE_PART_TYPES = frozenset({"image", "image_url", "input_image"})
31: 
32: 
33: def _band(used: int, thresholds: ContextThresholds) -> str:
34:     """Which band a token count falls in, given the real watermarks."""
35:     if used <= 0:
36:         return "idle"
37:     # A window small enough that the reserve swallows it collapses every
38:     # watermark to zero. The kernel then reads ``count >= 0`` as over the limit
39:     # and refuses the turn, so reporting "roomy" here would be the exact
40:     # opposite of what happens next.
41:     if thresholds.blocking <= 0:
42:         return "critical"
43:     if used >= thresholds.blocking:
44:         return "critical"
45:     if thresholds.auto_compact > 0 and used >= thresholds.auto_compact:
46:         return "tight"
47:     if thresholds.warning > 0 and used >= thresholds.warning:
48:         return "filling"
49:     # Below the warning watermark but within a quarter of the way to it is not
50:     # "roomy": a UI that flips straight from empty to warning hides the climb.
51:     if thresholds.warning > 0 and used >= thresholds.warning * _ROOMY_BELOW:
52:         return "filling"
53:     return "roomy"
54: 
55: 
56: _SENTENCES = {
57:     "idle": "上下文还是空的。",
58:     "roomy": "还有大把空间，可以继续正常对话。",
59:     "filling": "开始占地方了，暂时不用管。",
60:     "tight": "下一轮会先压缩历史再继续，回答可能变简。",
61:     "critical": "已经到硬上限，再不压缩这一轮就会失败。",
62:     "unknown": "不知道这个模型的窗口大小，无法判断压力。",
63: }
64: 
65: 
66: def _headroom(used: int, limit: int) -> int:
67:     return max(0, limit - max(0, used)) if limit > 0 else 0
68: 
69: 
70: def measure(
71:     *,
72:     used: int | None = None,
73:     model_window: int | None = None,
74:     config: dict[str, Any] | None = None,
75:     compressor: Any = None,
76:     surface_nodes: Sequence[Mapping[str, Any]] | None = None,
77:     route: Mapping[str, Any] | None = None,
78:     image_pricing: Callable[
79:         [Mapping[str, Any], Sequence[Mapping[str, Any]]], Sequence[Mapping[str, Any]]
80:     ]
81:     | None = None,
82: ) -> dict[str, Any]:
83:     """Report context pressure for one live turn.
84: 
85:     ``compressor`` is the same object the kernel thread holds; when given it wins
86:     over the explicit ``used`` argument so callers cannot accidentally report a
87:     stale figure next to live thresholds.
88:     """
89:     if compressor is not None:
90:         # The compressor is the live object: it wins unconditionally, so a caller
91:         # cannot report a stale figure beside live watermarks.
92:         used = getattr(compressor, "last_prompt_tokens", None)
93:         if model_window is None:
94:             model_window = getattr(compressor, "context_length", None)
95:             if not model_window:
96:                 configured = getattr(compressor, "config", None)
97:                 if isinstance(configured, dict):
98:                     model_window = configured.get("context_window")
99:     try:
100:         used_value = int(used) if used is not None else None
101:     except (TypeError, ValueError):
102:         used_value = None
103:     try:
104:         window = int(model_window) if model_window is not None else None
105:     except (TypeError, ValueError):
106:         window = None
107:     if window is not None and window <= 0:
108:         window = None
109: 
110:     if window is None or used_value is None:
111:         return _with_surface_prices({
112:             "pressure": "unknown",
113:             "sentence": _SENTENCES["unknown"],
114:             "used_tokens": used_value,
115:             "model_window": window,
116:             "used_percent": None,
117:             "thresholds": None,
118:             "headroom": {},
119:         }, surface_nodes, route, image_pricing)
120: 
121:     manager = ContextManager(config or {})
122:     thresholds = manager.thresholds(window)
123:     band = _band(used_value, thresholds)
124:     percent = max(0, min(100, round(used_value / window * 100)))
125:     # A window smaller than a watermark would otherwise report a negative gap.
126:     return _with_surface_prices({
127:         "pressure": band,
128:         "sentence": _SENTENCES[band],
129:         "used_tokens": used_value,
130:         "model_window": window,
131:         "used_percent": percent,
132:         "thresholds": {
133:             "warning": thresholds.warning,
134:             "auto_compact": thresholds.auto_compact,
135:             "blocking": thresholds.blocking,
136:             "effective_window": thresholds.effective_window,
137:         },
138:         "headroom": {
139:             "to_warning": _headroom(used_value, thresholds.warning),
140:             "to_auto_compact": _headroom(used_value, thresholds.auto_compact),
141:             "to_blocking": _headroom(used_value, thresholds.blocking),
142:         },
143:     }, surface_nodes, route, image_pricing)
144: 
145: 
146: def measure_session(session_usage: dict[str, Any], model_window: int | None = None) -> dict[str, Any]:
147:     """Measure from a stored usage row, for a session with no live agent.
148: 
149:     Stored rows carry whatever the provider reported last; the window is often
150:     absent, which is exactly when ``unknown`` is the honest answer.
151:     """
152:     used = (
153:         session_usage.get("context_tokens")
154:         or session_usage.get("prompt_tokens")
155:         or session_usage.get("input_tokens")
156:     )
157:     window = model_window or session_usage.get("context_window") or session_usage.get("context_max")
158:     return measure(used=used, model_window=window or None)
159: 
160: 
161: def price_surface_nodes(
162:     nodes: Sequence[Mapping[str, Any]],
163:     *,
164:     route: Mapping[str, Any],
165:     image_pricing: Callable[
166:         [Mapping[str, Any], Sequence[Mapping[str, Any]]], Sequence[Mapping[str, Any]]
167:     ]
168:     | None = None,
169: ) -> dict[str, Any]:
170:     """Price ordered transcript surface nodes under one model request route.
171: 
172:     Each node is ``{"seq": int, "message": mapping}``. ``image_pricing`` is
173:     the routed adapter's pricing function: it receives this route and every
174:     image occurrence in positional order, returning matching
175:     ``{"visual_tokens": int, "text": str}`` records. Missing image pricing
176:     keeps Atlas' fixed heuristic for the entire node. The input messages are
177:     never mutated.
178:     """
179:     from atlas.engine.agent.model_metadata import estimate_messages_tokens_rough
180: 
181:     if not isinstance(route, Mapping):
182:         raise TypeError("route must be a mapping")
183:     output_nodes: list[dict[str, int]] = []
184:     surface_tokens = 0
185:     for index, node in enumerate(nodes):
186:         if not isinstance(node, Mapping):
187:             raise TypeError(f"surface node {index} must be a mapping")
188:         seq = node.get("seq")
189:         message = node.get("message")
190:         if type(seq) is not int or seq < 0:
191:             raise ValueError(f"surface node {index} seq must be a non-negative integer")
192:         if not isinstance(message, Mapping):
193:             raise TypeError(f"surface node {index} message must be a mapping")
194:         heuristic_tokens = estimate_messages_tokens_rough([dict(message)])
195:         images = _image_parts(message)
196:         tokens = heuristic_tokens
197:         if image_pricing is not None and images:
198:             prices = list(image_pricing(route, images))
199:             if len(prices) != len(images):
200:                 raise ValueError(
201:                     "route image pricing returned "
202:                     f"{len(prices)} prices for {len(images)} image occurrences"
203:                 )
204:             replacements: dict[int, str] = {}
205:             visual_tokens = 0
206:             for image_index, price in enumerate(prices):
207:                 if not isinstance(price, Mapping):
208:                     raise TypeError(f"route image price {image_index} must be a mapping")
209:                 visual = price.get("visual_tokens")
210:                 text = price.get("text")
211:                 if type(visual) is not int or visual < 0:
212:                     raise ValueError(
213:                         f"route image price {image_index} visual_tokens must be non-negative"
214:                     )
215:                 if not isinstance(text, str):
216:                     raise TypeError(f"route image price {image_index} text must be a string")
217:                 visual_tokens += visual
218:                 replacements[image_index] = text
219:             projected = _replace_image_parts(message, replacements)
220:             tokens = estimate_messages_tokens_rough([projected]) + visual_tokens
221:         surface_tokens += tokens
222:         output_nodes.append({"seq": seq, "tokens": tokens, "heuristic_tokens": heuristic_tokens})
223:     return {"surface_tokens": surface_tokens, "nodes": output_nodes}
224: 
225: 
226: def _with_surface_prices(
227:     result: dict[str, Any],
228:     surface_nodes: Sequence[Mapping[str, Any]] | None,
229:     route: Mapping[str, Any] | None,
230:     image_pricing: Callable[
231:         [Mapping[str, Any], Sequence[Mapping[str, Any]]], Sequence[Mapping[str, Any]]
232:     ]
233:     | None,
234: ) -> dict[str, Any]:
235:     if surface_nodes is None:
236:         return result
237:     return {
238:         **result,
239:         **price_surface_nodes(surface_nodes, route=route or {}, image_pricing=image_pricing),
240:     }
241: 
242: 
243: def _image_parts(message: Mapping[str, Any]) -> list[Mapping[str, Any]]:
244:     content = message.get("content")
245:     if not isinstance(content, list):
246:         return []
247:     return [
248:         part
249:         for part in content
250:         if isinstance(part, Mapping) and part.get("type") in _IMAGE_PART_TYPES
251:     ]
252: 
253: 
254: def _replace_image_parts(
255:     message: Mapping[str, Any], replacements: Mapping[int, str]
256: ) -> dict[str, Any]:
257:     content = message.get("content")
258:     if not isinstance(content, list):
259:         return dict(message)
260:     projected_content: list[Any] = []
261:     image_index = 0
262:     for part in content:
263:         if isinstance(part, Mapping) and part.get("type") in _IMAGE_PART_TYPES:
264:             projected_content.append({"type": "text", "text": replacements[image_index]})
265:             image_index += 1
266:         else:
267:             projected_content.append(part)
268:     return {**message, "content": projected_content}
269: 
270: 
271: def level_index(band: str) -> int:
272:     """Sort key for a band; unknown sorts before every real band."""
273:     return LEVELS.index(band) if band in LEVELS else -1
274: 
275: 
276: __all__ = [
277:     "DEFAULT_CONTEXT_WINDOW", "LEVELS", "level_index", "measure", "measure_session",
278:     "price_surface_nodes",
279: ]

