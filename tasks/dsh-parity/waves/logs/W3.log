385:     async def prepare(self, history: Sequence[Mapping[str, Any]], *, model_window: int = DEFAULT_CONTEXT_WINDOW,
386:                       summarize: Callable[[list[dict[str, Any]], str], Awaitable[str]] | None = None,
387:                       preserved: Mapping[str, Any] | None = None, focus: str = "",
388:                       prefix_tokens: int = 0, manual: bool = False,
389:                       force: bool = False,
390:                       before_compact: Callable[[CompactionResult], Awaitable[None]] | None = None) -> CompactionResult:
391:         budget = self.budget(model_window)
392:         before = estimate_tokens(history) + prefix_tokens
393:         messages = await asyncio.to_thread(self.microcompact, history, budget_tokens=budget,
394:                                            prefix_tokens=prefix_tokens)
395:         after = estimate_tokens(messages) + prefix_tokens
396:         method = "microcompact" if messages != list(history) else "none"
397:         result = CompactionResult(messages, method, before, after, budget)
398: 
399:         def recover_by_trimming(note: str) -> CompactionResult:
400:             if not force:
401:                 result.error = note
402:                 return result
403:             trimmed = self.microcompact(messages, budget_tokens=0, prefix_tokens=prefix_tokens,
404:                                         aggressive=True)
405:             trimmed_size = estimate_tokens(trimmed) + prefix_tokens
406:             if trimmed != messages and trimmed_size < after:
407:                 return CompactionResult(trimmed, "aggressive_microcompact", before,
408:                                         trimmed_size, budget, recovery_note=note)
409:             result.error = note
410:             return result
411:         announced = False
412:         auto_threshold = self.thresholds(model_window).auto_compact
413:         if before_compact is not None and (method != "none" or after >= auto_threshold or manual or force):
414:             await before_compact(result)
415:             announced = True
416:         # Hysteresis: if trimming old tool outputs could not bring the context back
417:         # under the microcompact threshold, summarize now. Otherwise every later
418:         # request nibbles one more tool result (each nibble busts the prompt cache)
419:         # until the hard budget is finally hit.
420:         if after < auto_threshold and not manual and not force:
421:             return result
422:         if summarize is None:
423:             return recover_by_trimming("context_over_budget: no summarizer available")
424:         if self.consecutive_failures >= MAX_CONSECUTIVE_FAILURES and not manual:
425:             return recover_by_trimming("compaction_circuit_breaker")
426:         # Keep recent turns and every unmatched call outside the summarized range.
427:         keep_messages = max(1, int(self.config.get("context_keep_messages", 6)))
428:         cut = max(0, len(messages) - keep_messages)
429:         latest_user = next((i for i in range(len(messages) - 1, -1, -1)
430:                             if messages[i].get("role") == "user"), None)
431:         pending: dict[str, int] = {}
432:         for index, message in enumerate(messages):
433:             for call in _calls(message):
434:                 pending[str(call.get("id", ""))] = index
435:             if message.get("role") == "tool":
436:                 pending.pop(_call_id(message), None)
437:         if pending:
438:             cut = min(cut, min(pending.values()))
439:         # Move a boundary before the associated assistant call, never split pairs.
440:         while cut > 0 and messages[cut].get("role") == "tool":
441:             cut -= 1
442:         for index in range(cut):
443:             ids = {str(call.get("id", "")) for call in _calls(messages[index])}
444:             if any(m.get("role") == "tool" and _call_id(m) in ids for m in messages[cut:]):
445:                 cut = index
446:                 break
447:         old = [m for m in messages[:cut] if m.get("role") != "system"]
448:         if not old:
449:             return recover_by_trimming("context_over_budget: no safely compactable history")
450:         # The hysteresis path can summarize while microcompact changed nothing and the
451:         # context is still under the hard budget; the caller must still get its
452:         # PreCompact/lease callback before a summary replaces history.
453:         if before_compact is not None and not announced:
454:             await before_compact(result)
455:         invariants = json.dumps(dict(preserved or {}), ensure_ascii=False, default=str)
456:         prompt = SUMMARY_PROMPT + "\nPreserved task state:\n" + invariants
457:         read_restore: list[tuple[str, tuple[int, ...]]] = []
458:         read_budget = max(0, int(self.config.get("post_compact_read_restore_tokens", 12_000)))
459:         used_read_tokens = 0
460:         occupied: set[int] = set()
461:         for _call_index, indices, path in reversed(_read_call_files(messages[:cut])):
462:             if not path or any(index >= cut or index in occupied for index in indices):
463:                 continue
464:             pair_tokens = estimate_tokens([messages[index] for index in indices])
465:             if used_read_tokens + pair_tokens > read_budget:
466:                 continue
467:             read_restore.append((path, indices))
468:             occupied.update(indices)
469:             used_read_tokens += pair_tokens
470:         if read_restore:
471:             prompt += "\nRecent read files selected for verbatim restoration after the summary:\n- " + \
472:                 "\n- ".join(path for path, _indices in read_restore)
473:         if focus:
474:             prompt += "\nUser compaction focus: " + focus
475:         try:
476:             summary = await summarize(copy.deepcopy(old), prompt)
477:             if not isinstance(summary, str) or not summary.strip():
478:                 raise ValueError("compaction completed without a summary")
479:             retained_user: list[dict[str, Any]] = []
480:             if latest_user is not None and latest_user < cut:
481:                 remaining_user_tokens = min(COMPACT_USER_MESSAGE_MAX_TOKENS, budget)
482:                 for index in range(latest_user, -1, -1):
483:                     if messages[index].get("role") != "user":
484:                         continue
485:                     message_tokens = estimate_tokens([messages[index]])
486:                     if message_tokens > remaining_user_tokens:
487:                         break
488:                     retained_user.append(messages[index])
489:                     remaining_user_tokens -= message_tokens
490:                 retained_user.reverse()
491:             system_prefix = [m for m in messages[:cut] if m.get("role") == "system"]
492:             restored_messages = [messages[index] for _path, indices in reversed(read_restore)
493:                                  for index in indices]
494:             while True:
495:                 restored_paths = [path for path, _indices in read_restore]
496:                 restored_note = ("\n[Recent read-file results were restored verbatim: " +
497:                                  ", ".join(restored_paths) + "]") if restored_paths else ""
