281:     def clip_tool_result(self, content: str, *, tool_name: str = "") -> ToolOutputClip:
282:         """Persist and preview oversized tool text before adding it to model history.
283: 
284:         Claude Code caps a result at 50,000 characters and 100,000 estimated
285:         tokens (400,000 UTF-8 bytes), then gives the model a file reference. We
286:         retain a larger leading section and a useful tail; the complete result
287:         remains available in the content-addressed output file.
288:         """
289:         raw = str(content)
290:         original_bytes = len(raw.encode("utf-8"))
291:         cfg = self.config.get("tool_result_limits", {})
292:         max_chars = max(0, int(cfg.get("max_chars", 50_000)))
293:         max_bytes = max(0, int(cfg.get("max_tokens", MAX_TOOL_RESULT_TOKENS))) * BYTES_PER_TOKEN
294:         if len(raw) <= max_chars and original_bytes <= max_bytes:
295:             return ToolOutputClip(raw, None, original_bytes, original_bytes)
296:         message: dict[str, Any] = {}
297:         ref = self._output_ref(message, raw)
298:         if ref is None:
299:             # Preserve evidence when no durable destination was provided.
300:             return ToolOutputClip(raw, None, original_bytes, original_bytes)
301:         preview_budget = min(max_chars, max_bytes)
302:         if preview_budget <= 256:
303:             preview_budget = 256
304:         notice = f"\n[Tool output truncated; source is {original_bytes} UTF-8 bytes; full output saved at {ref}]\n"
305:         available = max(0, preview_budget - len(notice))
306:         head = min(available * 3 // 4, len(raw))
307:         tail = min(available - head, len(raw) - head)
308:         while head + tail > 0 and len((raw[:head] + notice + (raw[-tail:] if tail else "")).encode("utf-8")) > max_bytes:
309:             if head * 3 >= tail:
310:                 head -= 1
311:             else:
312:                 tail -= 1
313:         preview = raw[:head] + notice + (raw[-tail:] if tail else "")
314:         if tool_name:
315:             preview = f"[Tool: {tool_name}]\n" + preview
316:         return ToolOutputClip(preview, ref, original_bytes, len(preview.encode("utf-8")))
317: 
318:     @staticmethod
319:     def _micro_threshold(budget_tokens: int) -> int:
320:         return max(0, min(int(budget_tokens * 0.9), budget_tokens - 2000))
321: 
322:     def microcompact(self, history: Sequence[Mapping[str, Any]], *, budget_tokens: int,
323:                      prefix_tokens: int = 0, aggressive: bool = False) -> list[dict[str, Any]]:
324:         messages = copy.deepcopy(list(history))
325:         cfg = dict(self.config.get("microcompact", {}))
326:         if aggressive:
327:             cfg.update(enabled=True, keep_recent_tool_results=0, head_chars=500,
328:                        tail_chars=500, min_token_savings=1)
329:         if cfg.get("enabled") is False and not aggressive:
330:             return messages
331:         threshold = self._micro_threshold(budget_tokens)
332:         idle = (self.last_assistant_completed_at is not None and
333:                 time.time() - self.last_assistant_completed_at > float(cfg.get("idle_minutes", 60)) * 60)
334:         if not idle and estimate_tokens(messages) + prefix_tokens < threshold:
335:             return messages
336:         groups: list[list[int]] = []
337:         group: list[int] | None = None
338:         tool_names: dict[str, str] = {}
339:         allowed = cfg.get("compactable_tools", COMPACTABLE_TOOLS)
340:         for index, message in enumerate(messages):
341:             if message.get("role") == "assistant" and _calls(message):
342:                 if group:
343:                     groups.append(group)
344:                 group = []
345:                 for call in _calls(message):
346:                     tool_names[str(call.get("id", ""))] = str(
347:                         call.get("name") or (call.get("function") or {}).get("name") or "")
348:             if message.get("role") != "tool" or not _call_id(message):
349:                 continue
350:             content = message.get("content")
351:             if not isinstance(content, str) or message.get("microcompacted"):
352:                 continue  # Structured/media outputs are protected as upstream.
353:             if (message.get("isError") or message.get("is_error")) and not cfg.get("clear_error_results"):
354:                 continue
355:             name = message.get("name") or message.get("toolName") or tool_names.get(_call_id(message))
356:             if name not in allowed:
357:                 continue
358:             if group is None:
359:                 groups.append([index])
360:             else:
361:                 group.append(index)
362:         if group:
363:             groups.append(group)
364:         keep = max(0 if aggressive else 1, int(cfg.get("keep_recent_tool_results", 5)))
365:         head = max(0, int(cfg.get("head_chars", 2000)))
366:         tail = max(0, int(cfg.get("tail_chars", 2000)))
367:         eligible_groups = groups[:len(groups) - keep] if keep else groups
368:         for indices in eligible_groups:
369:             for index in indices:
370:                 message = messages[index]
371:                 content = message["content"]
372:                 if len(content) <= head + tail + 256:
373:                     continue
374:                 ref = self._output_ref(message, content)
375:                 if ref is None:
376:                     continue
377:                 message["content"] = (content[:head] +
378:                     f"\n[Old tool output shortened; full output: {ref}]\n" +
379:                     (content[-tail:] if tail else ""))
380:                 message["output_ref"] = ref
381:                 message["microcompacted"] = True
382:         savings = estimate_tokens(history) - estimate_tokens(messages)
383:         return messages if savings >= int(cfg.get("min_token_savings", 256)) else copy.deepcopy(list(history))
