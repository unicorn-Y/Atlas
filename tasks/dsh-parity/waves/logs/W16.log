+export function tn(namespace: LocaleNamespace, source: string, locale: Locale = readLocale()): string {
+  const scoped = namespaceCatalogs.get(namespace)?.[locale]?.[source];
+  return scoped ?? t(source, locale);
+}
diff --git a/frontend/src/renderer/services/update-coordinator.test.ts b/frontend/src/renderer/services/update-coordinator.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2c9ca6cb872fe2fcffb3f4d4e15510d7d22f5f01
--- /dev/null
+++ b/frontend/src/renderer/services/update-coordinator.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it, vi } from 'vitest';
+import { appendUpdateJournal, createUpdateCoordinator } from './update-coordinator';
+
+describe('update coordinator', () => {
+  it('journals checks and retries failures with bounded exponential backoff and jitter', async () => {
+    vi.useFakeTimers();
+    const check = vi.fn().mockRejectedValueOnce(new Error('offline')).mockResolvedValue({ available: false });
+    const journal = vi.fn();
+    const coordinator = createUpdateCoordinator({ check, journal, random: () => 0.25, intervalMs: 60_000, baseBackoffMs: 1_000, maxBackoffMs: 8_000 });
+
+    coordinator.start();
+    await vi.advanceTimersByTimeAsync(0);
+    expect(check).toHaveBeenCalledTimes(1);
+    expect(journal).toHaveBeenLastCalledWith(expect.objectContaining({ event: 'check.failed', error: 'offline' }));
+
+    await vi.advanceTimersByTimeAsync(899);
+    expect(check).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(check).toHaveBeenCalledTimes(2);
+    expect(journal).toHaveBeenLastCalledWith(expect.objectContaining({ event: 'check.completed' }));
+    coordinator.stop();
+    vi.useRealTimers();
+  });
+
+  it('caps its persisted journal to the newest entries', () => {
+    const values = new Map<string, string>();
+    const storage = { getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => values.set(key, value) };
+    appendUpdateJournal({ at: '1', event: 'check.started', channel: 'release' }, storage, 2);
+    appendUpdateJournal({ at: '2', event: 'check.completed', channel: 'release' }, storage, 2);
+    appendUpdateJournal({ at: '3', event: 'check.failed', channel: 'release', error: 'offline' }, storage, 2);
+    expect(JSON.parse(values.get('atlas.update.journal') ?? '[]').map((entry: { at: string }) => entry.at)).toEqual(['2', '3']);
+  });
+});
diff --git a/frontend/src/renderer/services/update-coordinator.ts b/frontend/src/renderer/services/update-coordinator.ts
new file mode 100644
index 0000000000000000000000000000000000000000..97f829d1e542cdc7e0c16f6148ec21bb75d3e112
--- /dev/null
+++ b/frontend/src/renderer/services/update-coordinator.ts
@@ -0,0 +1,86 @@
+export type UpdateJournalEntry = {
+  at: string;
+  event: 'check.started' | 'check.completed' | 'check.failed';
+  channel: string;
+  current?: string;
+  latest?: string;
+  error?: string;
+};
+
+type CoordinatorOptions<T> = {
+  check: () => Promise<T>;
+  journal: (entry: UpdateJournalEntry) => void;
+  onResult?: (result: T) => void;
+  channel?: string | (() => string);
+  intervalMs?: number;
+  initialDelayMs?: number;
+  baseBackoffMs?: number;
+  maxBackoffMs?: number;
+  random?: () => number;
+  now?: () => Date;
+};
+
+export function createUpdateCoordinator<T>(options: CoordinatorOptions<T>) {
+  const intervalMs = options.intervalMs ?? 5 * 60_000;
+  const baseBackoffMs = options.baseBackoffMs ?? 10_000;
+  const maxBackoffMs = options.maxBackoffMs ?? 30 * 60_000;
+  const random = options.random ?? Math.random;
+  const now = options.now ?? (() => new Date());
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let stopped = true;
+  let running = false;
+  let failures = 0;
+
+  const record = (event: UpdateJournalEntry['event'], fields: Partial<UpdateJournalEntry> = {}) => {
+    const channel = typeof options.channel === 'function' ? options.channel() : options.channel;
+    options.journal({ at: now().toISOString(), event, channel: channel ?? 'release', ...fields });
+  };
+  const schedule = (delay: number) => {
+    if (stopped) return;
+    if (timer !== undefined) clearTimeout(timer);
+    timer = setTimeout(() => { timer = undefined; void run(); }, delay);
+  };
+  const run = async () => {
+    if (stopped || running) return;
+    running = true;
+    record('check.started');
+    try {
+      const result = await options.check();
+      failures = 0;
+      const status = result as { current?: string; latest?: string };
+      record('check.completed', { current: status.current, latest: status.latest });
+      options.onResult?.(result);
+      schedule(intervalMs);
+    } catch (error) {
+      failures += 1;
+      const cap = Math.min(maxBackoffMs, baseBackoffMs * 2 ** Math.min(failures - 1, 30));
+      const jittered = Math.round(cap * (0.8 + Math.max(0, Math.min(1, random())) * 0.4));
+      record('check.failed', { error: error instanceof Error ? error.message : String(error) });
+      schedule(Math.min(maxBackoffMs, jittered));
+    } finally {
+      running = false;
+    }
+  };
+
+  return {
+    start() {
+      if (!stopped) return;
+      stopped = false;
+      schedule(options.initialDelayMs ?? 0);
+    },
+    checkNow() { if (!stopped && !running) schedule(0); },
+    stop() {
+      stopped = true;
+      if (timer !== undefined) clearTimeout(timer);
+      timer = undefined;
+    },
+  };
+}
+
+export function appendUpdateJournal(entry: UpdateJournalEntry, storage: Pick<Storage, 'getItem' | 'setItem'>, limit = 200): void {
+  try {
+    const current = JSON.parse(storage.getItem('atlas.update.journal') ?? '[]') as unknown;
+    const entries = Array.isArray(current) ? current.filter((item): item is UpdateJournalEntry => Boolean(item && typeof item === 'object' && 'event' in item)) : [];
+    storage.setItem('atlas.update.journal', JSON.stringify([...entries, entry].slice(-limit)));
+  } catch { /* storage can be unavailable or contain invalid prior data */ }
+}

