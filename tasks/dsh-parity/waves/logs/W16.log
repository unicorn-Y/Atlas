function Remove-ActualSecrets("'$value) {
  if ($value -is [System.Collections.IDictionary]) {
    $clean = [ordered]@{}
    foreach ($key in $value.Keys) {
      if ([string]$key -match '"'"'^(?i:api[_-]?key|access[_-]?token|refresh[_-]?token|secret|password|credentials?)$'"') { continue }
      "'$clean[$key] = Remove-ActualSecrets $value[$key]
    }
    return ,$clean
  }
  if ($value -is [System.Collections.IEnumerable] -and $value -isnot [string]) {
    $clean = @()
    foreach ($item in $value) { $clean += ,(Remove-ActualSecrets $item) }
    return ,$clean
  }
  return $value
}
