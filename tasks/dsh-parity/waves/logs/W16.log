function Show-SafeConfig("'$value, [string]$path = '"'') {
  if ("'$null -eq $value) { return }
  if ($value -is [System.Collections.IDictionary]) {
    foreach ($key in $value.Keys) { if ([string]$key -notmatch '"'(?i)key|token|secret|password|credential') { Show-SafeConfig "'$value[$key] ($path + '"'/' + [string]"'$key) } }
    return
  }
  if ($value -is [System.Collections.IEnumerable] -and $value -isnot [string]) { $i=0; foreach ($item in $value) { Show-SafeConfig $item ($path + '"'[' + "'$i + '"']'); "'$i++ }; return }
  if ($value -is [string]) {
    $leaf = ($path -split '"'/')[-1]
    if ("'$leaf -match '"'(?i)model|provider|base_url|endpoint') {
      if ("'$value -match '"'"'^https?://'"') { try { "'$authority = ([uri]$value).GetLeftPart([System.UriPartial]::Authority) } catch { $authority = '"'[invalid-url]' }; Write-Output ("'$path + '"'=' + "'$authority) }
      elseif ($value.Length -lt 120) { Write-Output ($path + '"'=' + "'$value) }
    }
  }
}
