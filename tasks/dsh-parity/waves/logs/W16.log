function Show-SafeConfig("'$value, [string]$path = '"'') {
  if ("'$null -eq $value) { return }
  if ($value -is [System.Collections.IDictionary]) {
    foreach ($key in $value.Keys) {
      if ([string]$key -match '"'(?i)key|token|secret|password|credential') { continue }
      Show-SafeConfig "'$value[$key] ($path + '"'/' + [string]"'$key)
    }
    return
  }
  if ($value -is [System.Collections.IEnumerable] -and $value -isnot [string]) {
    $i = 0; foreach ($item in $value) { Show-SafeConfig $item ($path + '"'[' + "'$i + '"']'); "'$i++ }; return
  }
  if ($value -is [string]) {
