"""Turn phases and run events for the Atlas kernel.

The phase graph follows ZCode's explicit turn machine. Codex's turn driver
informs the interruption and completion boundaries used by the kernel loop.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import StrEnum
from typing import Any


class RunPhase(StrEnum):
    PREPARING = "preparing"
    AWAITING_MODEL_RESPONSE = "awaiting_model_response"
    STREAMING = "streaming"
    SCHEDULING_TOOLS = "scheduling_tools"
    TOOLS = "tools"
    WAITING_APPROVAL = "waiting_approval"
    AGGREGATING_RESULTS = "aggregating_results"
    COMPACTING = "compacting"
    DONE = "done"
    FAILED = "failed"
    INTERRUPTED = "interrupted"


class RunTerminalStatus(StrEnum):
    COMPLETED = "completed"
    USER_INTERRUPTED = "user_interrupted"
    ERROR = "error"
    BUDGET_EXCEEDED = "budget_exceeded"


class TurnEndReason(StrEnum):
    """Typed terminal reason for a user-visible kernel turn."""

    COMPLETED = "completed"
    USER_INTERRUPTED = "user_interrupted"
    BUDGET_EXCEEDED = "budget_exceeded"
    FAILED = "failed"

    @classmethod
    def from_terminal_status(cls, status: RunTerminalStatus) -> "TurnEndReason":
        if status is RunTerminalStatus.COMPLETED:
            return cls.COMPLETED
        if status is RunTerminalStatus.USER_INTERRUPTED:
            return cls.USER_INTERRUPTED
        if status is RunTerminalStatus.BUDGET_EXCEEDED:
            return cls.BUDGET_EXCEEDED
        return cls.FAILED


_TRANSITIONS: dict[RunPhase, frozenset[RunPhase]] = {
    RunPhase.PREPARING: frozenset({
        RunPhase.AWAITING_MODEL_RESPONSE, RunPhase.STREAMING, RunPhase.TOOLS, RunPhase.WAITING_APPROVAL,
        RunPhase.COMPACTING, RunPhase.DONE, RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.AWAITING_MODEL_RESPONSE: frozenset({
        RunPhase.STREAMING, RunPhase.COMPACTING, RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.STREAMING: frozenset({
        RunPhase.AWAITING_MODEL_RESPONSE, RunPhase.SCHEDULING_TOOLS,
        RunPhase.TOOLS, RunPhase.WAITING_APPROVAL, RunPhase.COMPACTING,
        RunPhase.DONE, RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.SCHEDULING_TOOLS: frozenset({
        RunPhase.TOOLS, RunPhase.WAITING_APPROVAL, RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.TOOLS: frozenset({
        RunPhase.WAITING_APPROVAL, RunPhase.AGGREGATING_RESULTS,
        RunPhase.STREAMING, RunPhase.COMPACTING,
        RunPhase.DONE, RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.WAITING_APPROVAL: frozenset({
        RunPhase.TOOLS, RunPhase.AGGREGATING_RESULTS, RunPhase.STREAMING,
        RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.AGGREGATING_RESULTS: frozenset({
        RunPhase.AWAITING_MODEL_RESPONSE, RunPhase.STREAMING, RunPhase.COMPACTING,
        RunPhase.DONE, RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.COMPACTING: frozenset({
        RunPhase.AWAITING_MODEL_RESPONSE, RunPhase.STREAMING,
        RunPhase.FAILED, RunPhase.INTERRUPTED,
    }),
    RunPhase.DONE: frozenset(),
    RunPhase.FAILED: frozenset(),
    RunPhase.INTERRUPTED: frozenset(),
}


@dataclass(slots=True)
class RunState:
    run_id: str
    session_id: str
    phase: RunPhase = RunPhase.PREPARING
    started_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
    response_text: str = ""
    tool_calls: list[dict[str, Any]] = field(default_factory=list)
    streamed_text: str = ""
    streamed_reasoning: str = ""
    streamed_refusal: str = ""
    streamed_tool_calls: dict[tuple[int, int], dict[str, str]] = field(default_factory=dict)
    usage_rows: list[dict[str, Any]] = field(default_factory=list)
    usage: dict[str, Any] = field(default_factory=dict)
    error: str | None = None
    terminal_status: RunTerminalStatus | None = None

    def transition(self, phase: RunPhase) -> None:
        if phase not in _TRANSITIONS[self.phase]:
            raise ValueError(f"invalid kernel phase transition: {self.phase} -> {phase}")
        self.phase = phase


@dataclass(frozen=True, slots=True)
class KernelEvent:
    """An event that can be translated to the existing run_turn dict shape."""

    type: str
    data: dict[str, Any] = field(default_factory=dict)

    def as_run_event(self) -> dict[str, Any]:
        return {"type": self.type, **self.data}


@dataclass(frozen=True, slots=True)
class ToolReceipt:
    """Terminal record for one tool call.

    ``state`` keeps its historical per-call meaning (``completed`` / ``failed`` /
    ``cancelled``) so existing consumers keep working. Everything after
    ``output_ref`` is additive: structured failure detail, cost accounting, and
    the batch-level outcome, which is where a partial batch is reported.
    """

    id: str
    name: str
    state: str
    duration_ms: int
    output_ref: str | None = None
    #: Structured failure classification (``timeout``, ``nonzero_exit``, ...).
    error_code: str | None = None
    #: True when a plain retry can plausibly succeed.
    retryable: bool = False
    #: Attempts made beyond the first one; the scheduler does not retry itself.
    retry_count: int = 0
    #: Model token usage attributed to this call, when the host provides it.
    prompt_tokens: int | None = None
    completion_tokens: int | None = None
    #: Batch outcome: ``completed`` / ``partial`` / ``failed`` / ``cancelled``.
    batch_state: str = "completed"
    #: Call ids in the same batch that failed, and specifically timed out.
    failed_calls: tuple[str, ...] = ()
    timed_out_calls: tuple[str, ...] = ()

    def as_dict(self) -> dict[str, Any]:
        return {
            "id": self.id,
            "name": self.name,
            "state": self.state,
            "duration_ms": self.duration_ms,
            "output_ref": self.output_ref,
            "error_code": self.error_code,
            "retryable": self.retryable,
            "retry_count": self.retry_count,
            "prompt_tokens": self.prompt_tokens,
            "completion_tokens": self.completion_tokens,
            "batch_state": self.batch_state,
            "failed_calls": list(self.failed_calls),
            "timed_out_calls": list(self.timed_out_calls),
        }
"""Callable session lifecycle tools backed by Atlas's existing durable stores."""

from __future__ import annotations

import hashlib
import json
from datetime import datetime
from typing import Any


def _result(data: Any) -> dict[str, Any]:
    return {"content": json.dumps(data, ensure_ascii=False, default=str),
            "data": data, "outcome": "completed"}


async def dispatch_lifecycle_tool(
    name: str, arguments: dict[str, Any], runtime: Any,
) -> dict[str, Any] | None:
    """Execute local automation and conversation lifecycle tools, or return None."""
    if name not in {"CronCreate", "CronList", "CronUpdate", "CronDelete", "ScheduleWakeup", "EndConversation"}:
        return None

    if name == "EndConversation":
        reason = str(arguments.get("reason") or "").strip()
        if not reason:
            return {"content": "reason must not be empty.", "is_error": True, "outcome": "failed"}
        callback = getattr(runtime, "end_conversation_callback", None)
        if callable(callback):
            callback(reason)
        else:
            setattr(runtime, "end_conversation_reason", reason)
            cancel_event = getattr(runtime, "cancel_event", None)
            if cancel_event is not None:
                cancel_event.set()
        queue = getattr(runtime, "event_queue", None)
        if queue is not None:
            await queue.put({"type": "conversation_ended", "reason": reason})
        return _result({"ended": True, "reason": reason})

    from atlas.automation import get_automation_engine
    from atlas.automation.store import normalize_record

    engine = get_automation_engine()
    store = engine.store

    if name != "CronList" and not engine.started:
        return {"content": "The persistent scheduler is not running; no task was created or changed.",
                "is_error": True, "outcome": "failed"}

    if name == "CronList":
        return _result({"automations": store.list()})

    if name == "CronDelete":
        automation_id = str(arguments.get("id") or "").strip()
        if not automation_id or store.get(automation_id) is None:
            return {"content": "Automation not found.", "is_error": True, "outcome": "failed"}
        await engine.remove(automation_id)
        return _result({"deleted": store.delete(automation_id), "id": automation_id})

    if name == "ScheduleWakeup":
        conversation_id = str(getattr(runtime, "conversation_id", "") or "").strip()
        if not conversation_id:
            return {"content": "This run has no conversation id.", "is_error": True, "outcome": "failed"}
        automation_id = f"wakeup-{hashlib.sha256(conversation_id.encode()).hexdigest()[:24]}"
        if bool(arguments.get("stop")):
            existing = store.get(automation_id)
            if existing is None:
                return _result({"stopped": False, "reason": "no pending wakeup"})
            await engine.remove(automation_id)
            store.delete(automation_id)
            return _result({"stopped": True, "id": automation_id})
        prompt = str(arguments.get("prompt") or "Resume this conversation and continue the previous task.").strip()
        when = str(arguments.get("at") or "").strip()
        if not when:
            return {"content": "at must be an ISO 8601 timestamp with timezone.", "is_error": True, "outcome": "failed"}
        try:
            parsed = datetime.fromisoformat(when.replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                raise ValueError("timezone required")
        except ValueError:
            return {"content": "at must be a valid timezone-aware ISO 8601 timestamp.", "is_error": True, "outcome": "failed"}
        record = normalize_record({
            "id": automation_id, "name": f"会话唤醒：{conversation_id[:8]}",
            "trigger": {"kind": "date", "at": parsed.isoformat()},
            "payload": {"kind": "agent_turn", "message": prompt,
                        "conversation_id": conversation_id},
            "delivery": {"mode": "none"},
        })
        saved = store.put(record)
        await engine.sync_automation(saved)
        return _result({"scheduled": True, "automation": saved})

    automation_id = str(arguments.get("id") or "").strip()
    if name == "CronUpdate":
        current = store.get(automation_id) if automation_id else None
        if current is None:
            return {"content": "Automation not found.", "is_error": True, "outcome": "failed"}
        trigger = dict(current["trigger"])
        if "schedule" in arguments:
            trigger = _schedule_trigger(str(arguments["schedule"]), str(arguments.get("timezone") or ""))
        payload = dict(current["payload"])
        if "prompt" in arguments:
            payload["message"] = str(arguments["prompt"])
        updates: dict[str, Any] = {"trigger": trigger, "payload": payload}
        if "name" in arguments:
            updates["name"] = str(arguments["name"])
        if "enabled" in arguments:
            updates["enabled"] = bool(arguments["enabled"])
        saved = store.put({**current, **updates})
    else:
        automation_id = str(arguments.get("id") or "").strip()
        record = normalize_record({
            "id": automation_id or None,
            "name": str(arguments.get("name") or "").strip(),
            "trigger": _schedule_trigger(str(arguments.get("schedule") or ""),
                                         str(arguments.get("timezone") or "")),
            "payload": {"kind": "agent_turn", "message": str(arguments.get("prompt") or "").strip()},
            "delivery": {"mode": "none"},
        })
        saved = store.put(record)
    await engine.sync_automation(saved)
    return _result({"automation": saved})


def _schedule_trigger(schedule: str, timezone: str) -> dict[str, Any]:
    value = schedule.strip()
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return {"kind": "cron", "cron_expr": value, "tz": timezone}
    if parsed.tzinfo is None:
        raise ValueError("one-shot schedule timestamps must include a timezone")
    return {"kind": "date", "at": parsed.isoformat()}
