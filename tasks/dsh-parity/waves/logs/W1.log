+
+
+@pytest.mark.unit
+def test_turn_lifecycle_tracks_model_steps_and_typed_step_end():
+    turn = TurnLifecycle("run-1")
+
+    first = turn.begin_step()
+    assert turn.end_step(first, StepEndReason.TOOL_CALLS) is True
