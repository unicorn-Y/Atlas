+
+
+@pytest.mark.unit
+def test_turn_lifecycle_tracks_model_steps_and_typed_step_end():
+    turn = TurnLifecycle("run-1")
+
+    first = turn.begin_step()
+    assert turn.end_step(first, StepEndReason.TOOL_CALLS) is True
+    assert turn.end_step(first, StepEndReason.RESPONSE) is False
+
+    second = turn.begin_step()
+    assert second == 2
+    assert turn.end_step(second, StepEndReason.RESPONSE) is True
+
+
+@pytest.mark.unit
+def test_idle_maintenance_runs_without_changing_turn_state(tmp_path):
+    kernel = AtlasKernel(data_dir=tmp_path)
+    observed = []
+
+    async def maintenance():
+        observed.append(kernel._active_runs)
+
+    assert asyncio.run(kernel.runMaintenance(maintenance)) is True
+    assert observed == [0]
+    assert kernel._active_runs == 0
+
+
+@pytest.mark.unit
+def test_idle_maintenance_is_skipped_while_a_turn_is_active(tmp_path):
+    kernel = AtlasKernel(data_dir=tmp_path)
+    kernel._active_runs = 1
+    observed = []
+
+    assert asyncio.run(kernel.runMaintenance(lambda: observed.append("ran"))) is False
+    assert observed == []
diff --git a/tasks/dsh-parity/waves/.live-w1.py b/tasks/dsh-parity/waves/.live-w1.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c5306c72a39ce9f2868fc78b8a63b8c9a9990f1
--- /dev/null
+++ b/tasks/dsh-parity/waves/.live-w1.py
@@ -0,0 +1,34 @@
+import asyncio
+import json
+import sys
+import uuid
+
+import websockets
+
+
+async def main():
+    prompt = sys.argv[1]
+    run_id = str(uuid.uuid4())
+    reply = []
+    async with websockets.connect("ws://127.0.0.1:8821/ws/chat") as ws:
+        await ws.send(json.dumps({
+            "type": "run.start", "run_id": run_id,
+            "conversation_id": f"dsh-w1-{run_id[:8]}",
+            "workspace": "D:/Atlas/.worktrees/dsh-W1",
+            "content": prompt, "model": "deepseek-v4.1-flash",
+        }))
+        while True:
+            event = json.loads(await asyncio.wait_for(ws.recv(), timeout=170))
+            name = event.get("event") or event.get("type")
+            data = event.get("data") or {}
+            if name in {"tool.preparing", "tool.started"}:
+                print(f"[event] {name} name={data.get('name')}")
+            if name == "message.delta":
+                reply.append(str(data.get("content") or ""))
+            if name in {"run.completed", "run.failed", "run.cancelled"}:
+                print(f"[terminal] {name} data={json.dumps(data, ensure_ascii=False)[:500]}")
+                break
+    print(f"[reply] {''.join(reply).strip()[:400]!r}")
+
+
+asyncio.run(main())

