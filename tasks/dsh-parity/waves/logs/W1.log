diff --git a/tasks/dsh-parity/waves/.live-w1.py b/tasks/dsh-parity/waves/.live-w1.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ec876a0d98733ef006a1b971bad24243f3f0090
--- /dev/null
+++ b/tasks/dsh-parity/waves/.live-w1.py
@@ -0,0 +1,41 @@
+import asyncio
+import json
+import sys
+import uuid
+
+import websockets
+
+
+async def main():
+    prompt = sys.argv[1]
+    run_id = str(uuid.uuid4())
+    reply = []
+    print(f"[connect] {run_id}", flush=True)
+    async with websockets.connect("ws://127.0.0.1:8821/ws/chat") as ws:
+        await ws.send(json.dumps({
+            "type": "run.start", "run_id": run_id,
+            "conversation_id": f"dsh-w1-{run_id[:8]}",
+            "workspace": "D:/Atlas/.worktrees/dsh-W1",
+            "content": prompt, "model": "deepseek-v4.1-flash",
+        }))
+        print("[sent]", flush=True)
+        while True:
+            event = json.loads(await asyncio.wait_for(ws.recv(), timeout=170))
+            name = event.get("event") or event.get("type")
+            data = event.get("data") or {}
+            print(f"[event] {name}", flush=True)
+            if name == "rules.trust_required":
+                await ws.send(json.dumps({
+                    "type": "rules.trust", "run_id": run_id, "trust": True,
+                }))
+            if name in {"tool.preparing", "tool.started"}:
+                print(f"[event] {name} name={data.get('name')}")
+            if name == "message.delta":
+                reply.append(str(data.get("content") or ""))
+            if name in {"run.completed", "run.failed", "run.cancelled"}:
+                print(f"[terminal] {name} data={json.dumps(data, ensure_ascii=False)[:500]}")
+                break
+    print(f"[reply] {''.join(reply).strip()[:400]!r}")
+
+
+asyncio.run(main())

