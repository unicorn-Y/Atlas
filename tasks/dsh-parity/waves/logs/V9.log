      {(props.failedAttachmentCount ?? 0) > 0 && <><span>{props.failedAttachmentCount} 个附件读取失败</span><button type="button" onClick={props.onRetryFailedAttachments} className="inline-flex items-center gap-1 text-brand hover:underline"><RotateCcw size={12} />重试</button></>}
    </div>}
    <input ref={fileRef} hidden type="file" multiple onChange={(event) => { props.onPickImages(event.target.files); event.currentTarget.value = ''; }} />

    <div className={cn('@container flex items-center gap-1.5', hero ? 'mt-3' : 'mt-2')}>
      <Tip label="添加图片或文件，也可以直接粘贴、拖进来">
        <Menu>
        <MenuTrigger asChild>
        <button ref={shortcutHelpButtonRef} type="button" aria-label="添加附件或目标" title="添加附件或目标"
          className="grid size-8 shrink-0 place-items-center rounded-[9px] text-fg-3 hover:bg-hover hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand">
          {props.attachments.length ? <ImagePlus size={18} /> : <Paperclip size={18} />}
        </button>
        </MenuTrigger>
        <MenuContent align="start" side="top">
          <MenuLabel>添加到消息</MenuLabel>
          {ideConnected && <MenuItem onSelect={() => void attachIdeContext()}><Code2 size={15} />附加 VS Code 当前选区/文件</MenuItem>}
          <MenuItem onSelect={() => fileRef.current?.click()}><Paperclip size={15} />附件</MenuItem>
          <MenuItem disabled={!props.onListCaptureWindows} onSelect={() => { void props.onListCaptureWindows?.().then((items) => { setCaptureWindows(items); setWindowPickerOpen(true); }).catch(() => setCaptureWindows([])); }}><Camera size={15} />截取活动窗口…</MenuItem>
          <MenuItem disabled={!props.recentScreenshots?.length} onSelect={() => { setSelectedRecentIds([]); setRecentPickerOpen(true); }}><ImagePlus size={15} />最近截图…</MenuItem>
          <MenuItem disabled={!props.value.trim()} onSelect={saveStash}><Save size={15} />暂存当前输入</MenuItem>
          <MenuItem onSelect={() => { setStashes(readStash()); setStashOpen(true); }}><Save size={15} />查看输入暂存</MenuItem>
          {props.onExternalEditor && <MenuItem onSelect={props.onExternalEditor}><ExternalLink size={15} />用外部编辑器撰写</MenuItem>}
          <MenuItem onSelect={() => props.onChange(`${props.value}${props.value && !props.value.endsWith(' ') ? ' ' : ''}/goal `)}><Sparkles size={15} />目标命令</MenuItem>
          {props.onEnhancePrompt && <MenuItem disabled={!props.value.trim() || enhancing} onSelect={() => void enhancePrompt()}><Sparkles size={15} />{enhancing ? '正在增强提示词…' : '增强提示词'}</MenuItem>}
          {props.onRefineLastAnswer && <MenuItem disabled={enhancing} onSelect={() => void refineLastAnswer()}><Sparkles size={15} />{enhancing ? '正在精修…' : '精修上一条回答'}</MenuItem>}
          <MenuSeparator />
          <MenuItem checked={enterToSend} onSelect={() => setEnterToSend((current) => { const next = !current; try { localStorage.setItem(ENTER_TO_SEND_KEY, String(next)); } catch { /* storage unavailable */ } return next; })}>Enter 发送</MenuItem>
          <MenuItem checked={screenReaderMode} onSelect={toggleScreenReaderMode}><Accessibility size={15} />屏幕阅读增强</MenuItem>
          <MenuItem onSelect={() => onShortcutHelpOpenChange(true)}><Keyboard size={15} />快捷键帮助</MenuItem>
        </MenuContent>
        </Menu>
      </Tip>
      {/* Narrow composers (split view, wide task panel): the tool row scrolls rather than pushing send out of view. */}
      {props.tools && <div ref={toolsRef} onScroll={measureTools} onWheel={(event) => { if (!event.deltaX && event.deltaY) event.currentTarget.scrollLeft += event.deltaY; }}
        className={cn('flex min-w-0 shrink items-center gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
          toolsFade.left && toolsFade.right ? '[mask-image:linear-gradient(90deg,transparent,#000_20px,#000_calc(100%-20px),transparent)]'

