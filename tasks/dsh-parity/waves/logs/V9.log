@@ -0,0 +1,18 @@
+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it, vi } from 'vitest';
+import { ComposerAttachmentStatus } from './Composer';
+
+describe('ComposerAttachmentStatus', () => {
+  it('shows staging progress with a cancel action', () => {
+    const html = renderToStaticMarkup(<ComposerAttachmentStatus progress="暂存 report.pdf（42%）" onCancel={vi.fn()} />);
+    expect(html).toContain('暂存 report.pdf（42%）');
+    expect(html).toContain('取消');
+    expect(html).toContain('role="status"');
+  });
+
+  it('shows attachment read failures with a retry action', () => {
+    const html = renderToStaticMarkup(<ComposerAttachmentStatus failedCount={2} onRetry={vi.fn()} />);
+    expect(html).toContain('2 个附件读取失败');
+    expect(html).toContain('重试');
+  });
+});
diff --git a/frontend/src/renderer/components/ComposerDraftRestore.test.tsx b/frontend/src/renderer/components/ComposerDraftRestore.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..614e6e44ae7991a270633a990df7c2f7f3c82fa0
--- /dev/null
+++ b/frontend/src/renderer/components/ComposerDraftRestore.test.tsx
@@ -0,0 +1,31 @@
+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it } from 'vitest';
+import { ComposerDraftMentions } from './Composer';
+import { readComposerDraft, writeComposerDraft, type ComposerDraft } from '../services/composerDraft';
+
+describe('Composer draft restore UI', () => {
+  it('restores a session mention chip from persisted draft data after a renderer reload', () => {
+    const persisted = new Map<string, string>();
+    const beforeReload = {
+      getItem: (key: string) => persisted.get(key) ?? null,
+      setItem: (key: string, value: string) => { persisted.set(key, value); },
+      removeItem: (key: string) => { persisted.delete(key); },
+    };
+    const draft: ComposerDraft = {
+      text: 'Review this change',
+      mentions: [{ kind: 'file', id: 'src/main.ts', label: 'main.ts', hint: 'src/main.ts' }],
+      attachments: [],
+    };
+    writeComposerDraft(beforeReload, 'conversation-1', draft);
+
+    const afterReload = {
+      getItem: (key: string) => persisted.get(key) ?? null,
+    };
+    const restored = readComposerDraft(afterReload, 'conversation-1');
+    const markup = renderToStaticMarkup(<ComposerDraftMentions mentions={restored.mentions} />);
+
+    expect(restored.text).toBe('Review this change');
+    expect(markup).toContain('aria-label="引用的上下文"');
+    expect(markup).toContain('main.ts');
+  });
+});
