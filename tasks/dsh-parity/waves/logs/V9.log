function appendHistory(text: string): string[] {
  const trimmed = text.trim();
  if (!trimmed) return readHistory();
  const next = [...readHistory().filter((item) => item !== trimmed), trimmed].slice(-HISTORY_LIMIT);
  try { localStorage.setItem(HISTORY_KEY, JSON.stringify(next)); } catch { /* storage unavailable */ }
  return next;
}
function readSlashHistory(): string[] {
  try {
    const parsed: unknown = JSON.parse(localStorage.getItem(SLASH_HISTORY_KEY) ?? '[]');
    return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string' && item.startsWith('/') && item.trim().length > 1).slice(-HISTORY_LIMIT) : [];
  } catch { return []; }
}
function appendSlashHistory(text: string): string[] {
  const value = text.trim();
  if (!value.startsWith('/') || value.length < 2) return readSlashHistory();
  const next = [...readSlashHistory().filter((item) => item !== value), value].slice(-HISTORY_LIMIT);
  try { localStorage.setItem(SLASH_HISTORY_KEY, JSON.stringify(next)); } catch { /* storage unavailable */ }
  return next;
}
function commandFrequency(history: readonly string[]): Record<string, number> {
  return history.reduce<Record<string, number>>((counts, item) => {
    const id = item.trim().split(/\s+/, 1)[0]?.slice(1).toLowerCase();
    if (id) counts[id] = (counts[id] ?? 0) + 1;
    return counts;
  }, {});
}

interface ComposerProps {
  value: string;
  onChange: (value: string) => void;
  onSubmit: () => void;
  placeholder: string;
  attachments: string[];
  onRemoveAttachment: (index: number) => void;
  onPickImages: (files: FileList | File[] | null) => void;
  onPickFolders?: (folders: Array<{ name: string; path: string; count: number }>) => void;
  listening: boolean;
  onToggleMic: () => void;
  speechInputMode?: 'toggle' | 'hold';
  onStartMic?: () => void;
  onStopMic?: () => void;
  models: ModelInfo[];
  model: string;
  onSelectModel: (id: string) => void;
  onManageModels: () => void;
  status: string;
  autoFocus?: boolean;
  /** `hero` is the large home composer; `dock` sits under a conversation. */
  variant?: 'hero' | 'dock';
  modes?: { value: string; options: ComposerMode[]; onChange: (id: string) => void };
  onCyclePermission?: () => void;
  /** Content shown above the text area, e.g. the live run status. */
  header?: ReactNode;
  commands?: SlashCommand[];
  commandAvailability?: { hasConversation: boolean; busy: boolean };
  /** Non-image attachments, shown as chips. */
  files?: Array<{ name: string; size: number }>;
  onRemoveFile?: (index: number) => void;
  /** Looks up @ files / # conversations for the query being typed. */
  findMentions?: (trigger: '@' | '#', query: string) => Promise<MentionItem[]>;
  /** Picked mentions, shown as chips and sent as context. */
  mentions?: MentionItem[];
  onAddMention?: (item: MentionItem) => void;
  onRemoveMention?: (item: MentionItem) => void;
  /** Called instead of inserting pasted text longer than LONG_PASTE characters. */
  onLongPaste?: (text: string) => void;
  onExternalEditor?: () => void;
  attachmentProgress?: string;
  failedAttachmentCount?: number;
  onRetryFailedAttachments?: () => void;
  onCancelAttachmentUpload?: () => void;
  /** Extra toolbar controls next to the attach button (working directory, plan mode). */
  tools?: ReactNode;
  onEnhancePrompt?: (text: string) => Promise<string>;
  onRefineLastAnswer?: () => Promise<string>;
  onAttachDrawing?: (dataUrl: string) => boolean;
  contextKey?: string;
  contextUsage?: UsageSummary['context'];
  contextFiles?: string[];
  onListCaptureWindows?: () => Promise<CaptureWindowOption[]>;
  onCaptureWindow?: (sourceId: string) => Promise<void>;
  recentScreenshots?: RecentScreenshot[];
  onPickRecentScreenshot?: (screenshot: RecentScreenshot) => void;
  onPickRecentScreenshots?: (screenshots: RecentScreenshot[]) => void;
  onDeleteRecentScreenshot?: (id: string) => void;
}

