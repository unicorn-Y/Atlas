export interface StagedAttachment {
  id: string;
  name: string;
  mime: string;
  size: number;
  kind: 'image' | 'file';
}

const DATABASE = 'atlas-attachments-v1';
const STORE = 'content';

export async function contentAddressedId(bytes: Uint8Array<ArrayBufferLike> | ArrayBuffer): Promise<string> {
  const source = bytes instanceof ArrayBuffer ? new Uint8Array(bytes) : new Uint8Array(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  const copy = new Uint8Array(new ArrayBuffer(source.byteLength));
  copy.set(source);
  const digest = await crypto.subtle.digest('SHA-256', copy.buffer as ArrayBuffer);
  return `sha256:${Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')}`;
}

export async function readFileBytes(file: Blob, signal: AbortSignal, onProgress: (loaded: number, total: number) => void): Promise<Uint8Array> {
  if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
  const reader = file.stream().getReader();
  const chunks: Uint8Array[] = [];
  let loaded = 0;
  const abort = () => { void reader.cancel(); };
  signal.addEventListener('abort', abort, { once: true });
  try {
    onProgress(0, file.size);
    while (true) {
      if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
      loaded += value.length;
      onProgress(loaded, file.size);
    }
    if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
    const bytes = new Uint8Array(loaded);
    let offset = 0;
    for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.length; }
    return bytes;
  } catch (error) {
    if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
    throw error;
  } finally {
    signal.removeEventListener('abort', abort);
    reader.releaseLock();
  }
}

export async function stageAttachment(file: File, kind: StagedAttachment['kind'], signal: AbortSignal, onProgress: (loaded: number, total: number) => void): Promise<StagedAttachment> {
  const bytes = await readFileBytes(file, signal, onProgress);
  const id = await contentAddressedId(bytes);
  if (signal.aborted) throw new DOMException('Attachment staging cancelled', 'AbortError');
  const db = await openDatabase();
  await new Promise<void>((resolve, reject) => {
    const tx = db.transaction(STORE, 'readwrite');
    const abort = () => { try { tx.abort(); } catch { /* transaction already settled */ } };
    const cleanup = () => { signal.removeEventListener('abort', abort); db.close(); };
    tx.objectStore(STORE).put({ id, blob: new Blob([bytes.slice().buffer as ArrayBuffer], { type: file.type }), name: file.name, mime: file.type || 'application/octet-stream', size: bytes.byteLength });
    tx.oncomplete = () => { cleanup(); resolve(); };
    tx.onerror = () => { cleanup(); reject(tx.error ?? new Error('Attachment staging failed')); };
    tx.onabort = () => { cleanup(); reject(signal.aborted ? new DOMException('Attachment staging cancelled', 'AbortError') : tx.error ?? new Error('Attachment staging aborted')); };
    signal.addEventListener('abort', abort, { once: true });
    if (signal.aborted) abort();
  });
  return { id, name: file.name, mime: file.type || 'application/octet-stream', size: bytes.byteLength, kind };
}

export async function loadStagedAttachment(id: string): Promise<Blob | null> {
  const db = await openDatabase();
  return new Promise((resolve, reject) => {
    const request = db.transaction(STORE, 'readonly').objectStore(STORE).get(id);
    request.onsuccess = () => { const blob = (request.result as { blob?: Blob } | undefined)?.blob ?? null; db.close(); resolve(blob); };
    request.onerror = () => { db.close(); reject(request.error ?? new Error('Unable to restore staged attachment')); };
  });
}

async function openDatabase(): Promise<IDBDatabase> {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open(DATABASE, 1);
    request.onupgradeneeded = () => request.result.createObjectStore(STORE, { keyPath: 'id' });
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error ?? new Error('Unable to open attachment store'));
  });
}

import type { MentionItem } from '../components/Composer';

export interface ComposerDraft {
  text: string;
  mentions: MentionItem[];
  attachments: Array<{ id: string; name: string; mime: string; size: number; kind: 'image' | 'file' }>;
}

const keyFor = (conversationId: string) => `atlas.draft.v2.${conversationId || 'home'}`;

export function readComposerDraft(storage: Pick<Storage, 'getItem'>, conversationId: string): ComposerDraft {
  try {
    const raw = storage.getItem(keyFor(conversationId));
    if (raw) {
      const value: unknown = JSON.parse(raw);
      if (value && typeof value === 'object') {
        const row = value as Partial<ComposerDraft>;
        return {
          text: typeof row.text === 'string' ? row.text : '',
          mentions: Array.isArray(row.mentions) ? row.mentions.filter(isMention) : [],
          attachments: Array.isArray(row.attachments) ? row.attachments.filter(isAttachment) : [],
        };
      }
    }
    return { text: storage.getItem(`atlas.draft.${conversationId || 'home'}`) ?? '', mentions: [], attachments: [] };
  } catch { return { text: '', mentions: [], attachments: [] }; }
}

export function writeComposerDraft(storage: Pick<Storage, 'setItem' | 'removeItem'>, conversationId: string, draft: ComposerDraft): void {
  try {
    if (!draft.text && !draft.mentions.length && !draft.attachments.length) {
      storage.removeItem(keyFor(conversationId));
      storage.removeItem(`atlas.draft.${conversationId || 'home'}`);
    } else storage.setItem(keyFor(conversationId), JSON.stringify(draft));
  } catch { /* storage unavailable; attachment bytes remain staged in IndexedDB */ }
}

export function serializeMentionContext(text: string, mentions: MentionItem[]): string {
  if (!mentions.length) return text;
  const instruction: Record<MentionItem['kind'], (item: MentionItem) => string> = {
    file: (item) => `- 文件 ${item.label}（${item.id}）`,
    conversation: (item) => `- 请用 read_session 读取会话 ${item.id}（${item.label}）`,
    resource: (item) => `- MCP 资源 ${item.label}（${item.id}）`,
    element: (item) => `- 请根据 PPT 元素引用进行精确修改：${item.label}（文件/定位：${item.id}）`,
  };
  return `${text}\n\n引用上下文：\n${mentions.map((item) => instruction[item.kind](item)).join('\n')}`;
}

function isMention(value: unknown): value is MentionItem {
  if (!value || typeof value !== 'object') return false;
  const row = value as Partial<MentionItem>;
  return ['file', 'conversation', 'resource', 'element'].includes(String(row.kind)) && typeof row.id === 'string' && typeof row.label === 'string';
}

function isAttachment(value: unknown): value is ComposerDraft['attachments'][number] {
  if (!value || typeof value !== 'object') return false;
  const row = value as Partial<ComposerDraft['attachments'][number]>;
  return typeof row.id === 'string' && typeof row.name === 'string' && typeof row.mime === 'string'
    && typeof row.size === 'number' && (row.kind === 'image' || row.kind === 'file');
}


