"""Drive one real turn through a running Atlas backend over its WebSocket.

Prints every event it receives, so the output is evidence of the live path:
the client sends ``run.start``, the backend runs the real model and tools, and
the script reports the terminal event plus the reply text. No credentials are
read here; the backend owns them.
"""
from __future__ import annotations

import asyncio
import json
import sys
import uuid

try:
    import websockets
except ImportError:  # pragma: no cover - dependency is part of the desktop extras
    print("websockets is not installed; install it to run this check", file=sys.stderr)
    raise SystemExit(2)


async def main() -> int:
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8799
    prompt = sys.argv[2] if len(sys.argv) > 2 else "Reply with exactly the word: OK"
    url = f"ws://127.0.0.1:{port}/ws/chat"
    run_id = str(uuid.uuid4())
    text_parts: list[str] = []
    terminal: str | None = None

    async with websockets.connect(url, max_size=8 * 1024 * 1024) as ws:
        await ws.send(json.dumps({
            "type": "run.start",
            "run_id": run_id,
            "conversation_id": f"dsh-live-{run_id[:8]}",
            "workspace": str(__import__("pathlib").Path.cwd()),
            "content": prompt,
        }))
        deadline = asyncio.get_running_loop().time() + 150
        while asyncio.get_running_loop().time() < deadline:
            try:
                raw = await asyncio.wait_for(ws.recv(), timeout=5)
            except asyncio.TimeoutError:
                continue
            if isinstance(raw, bytes):
                raw = raw.decode("utf-8", "replace")
            try:
                frame = json.loads(raw)
            except ValueError:
                continue
            event = frame.get("event") or frame.get("type")
            data = frame.get("data") or {}
            if event == "message.delta":
                text_parts.append(str(data.get("content") or ""))
            elif event in {"tool.started", "tool.preparing"}:
                print(f"[event] {event} name={data.get('name')}")
            elif event in {"approval.required", "input.required", "run.plan.proposed"}:
                print(f"[event] {event} tool={data.get('tool')} waiting")
                await ws.send(json.dumps({
                    "type": "approval.response",
                    "event_id": data.get("approval_id") or data.get("event_id"),
                    "choice": "allow_once",
                }))
            elif event in {"run.completed", "run.failed", "run.cancelled"}:
                terminal = event
                print(f"[terminal] {event} data={json.dumps(data, ensure_ascii=False)[:300]}")
                break
            elif event:
                print(f"[event] {event}")

    reply = "".join(text_parts).strip()
    print(f"[reply] {reply[:400]!r}")
    print(f"[result] terminal={terminal} chars={len(reply)}")
    return 0 if terminal == "run.completed" else 1


if __name__ == "__main__":
    raise SystemExit(asyncio.run(main()))
"""Atlas configuration — load from atlas.toml with env-var overrides."""

from __future__ import annotations

import json
import os
import shutil
from pathlib import Path
from typing import Any

import structlog

try:
    import tomllib  # Python 3.11+
except ModuleNotFoundError:
    import tomli as tomllib  # type: ignore[no-redef]

log = structlog.get_logger()

# ---------------------------------------------------------------------------
# Path resolution
# ---------------------------------------------------------------------------

PROJECT_ROOT = Path(
    os.environ.get("ATLAS_ROOT", Path(__file__).resolve().parent.parent.parent)
).resolve()  # D:\Atlas\core -> D:\Atlas
DATA_ROOT = Path(os.environ.get("ATLAS_DATA_DIR", PROJECT_ROOT)).resolve()
CONFIG_PATH = (
    (DATA_ROOT if os.environ.get("ATLAS_DATA_DIR") else PROJECT_ROOT) / "config" / "atlas.toml"
)
EXAMPLE_CONFIG_PATH = PROJECT_ROOT / "config" / "atlas.example.toml"
USER_SETTINGS_PATH = DATA_ROOT / "data" / "user-settings.json"

# ``atlas.engine.atlas_constants.get_atlas_home()`` resolves ``ATLAS_HOME``
# → ``HERMES_HOME`` → ``memory.db_path``'s parent. Nothing ever set
# ``ATLAS_HOME``, while a standalone Hermes install exports ``HERMES_HOME`` at
# user level, so the engine home silently resolved to that install's directory:
# boot warned on every start, and every engine path keyed off that home
# (``auth.json``, ``vault/``, browser profiles, ``cache/``, the *default*
# ``state.db``) pointed at another product's data.
#
# Atlas's real engine data lives in ``DATA_ROOT/engine`` — that is the literal
# the rest of ``atlas/`` uses (``DATA_ROOT / "engine"`` appears throughout
# conversations_router, run_phases, deferred_startup, sources, ...). Pinning
# ``ATLAS_HOME`` here, in the module that owns path resolution and that
# ``atlas_constants`` imports anyway, makes the two spellings agree for every
# entry point (desktop_entry, ``uvicorn atlas.server:app``, CLI, workers)
# without touching ``HERMES_HOME``, which stays Hermes's own.
if not os.environ.get("ATLAS_HOME", "").strip():
    os.environ["ATLAS_HOME"] = str(DATA_ROOT / "engine")


def load_user_settings(path: Path | None = None) -> dict[str, Any]:
    """Load persistent settings written through the Atlas settings API."""
    settings_path = path or USER_SETTINGS_PATH
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError):
        log.warning("settings.invalid_or_unreadable", path=str(settings_path))
        return {}
    return _migrate_provider_key(data) if isinstance(data, dict) else {}


_LEGACY_PROVIDER_KEY = "hermes_provider"
_PROVIDER_KEY = "atlas_provider"


def _migrate_provider_key(data: dict[str, Any]) -> dict[str, Any]:
    """Carry the retired ``hermes_provider`` field forward onto ``atlas_provider``.

    The per-model routing field was renamed because Atlas owns the engine. Settings
    files written before the rename still carry the old key; without this every
    user-defined model loses its provider id and silently routes as "custom", which
    sends requests to the wrong endpoint. Migration runs on read so an old settings
    file keeps working even when it is never rewritten, and it runs here rather than
    in ModelManager so all ~40 settings consumers see the new key.
    """
    custom_models = data.get("custom_models")
    if not isinstance(custom_models, list):
        return data
    migrated: list[Any] = []
    changed = False
    for entry in custom_models:
        if isinstance(entry, dict) and _LEGACY_PROVIDER_KEY in entry:
            entry = dict(entry)
            entry.setdefault(_PROVIDER_KEY, entry.pop(_LEGACY_PROVIDER_KEY))
            changed = True
        migrated.append(entry)
    if not changed:
        return data
    return {**data, "custom_models": migrated}


def save_user_settings(data: dict[str, Any], path: Path | None = None) -> None:
    """Atomically persist non-secret preferences and provider credentials."""
    settings_path = path or USER_SETTINGS_PATH
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    temporary = settings_path.with_suffix(settings_path.suffix + ".tmp")
    temporary.write_text(json.dumps(data, indent=2), encoding="utf-8")
    temporary.replace(settings_path)


# ---------------------------------------------------------------------------
# Config dataclass (plain dict wrapper — keeps it simple, no pydantic)
# ---------------------------------------------------------------------------

class AtlasConfig:
    """Thin typed wrapper around the parsed TOML dict.

    Access nested values with dotted helpers; falls back to sensible defaults
    so the app can always boot even with a minimal / empty config file.
    """

    def __init__(self, data: dict[str, Any] | None = None, base: dict[str, Any] | None = None) -> None:
        self._data: dict[str, Any] = data or {}
        # atlas.toml 本身（不含专家模式覆盖层）；往 atlas.toml 回写时必须用它。
        self._base: dict[str, Any] = base if base is not None else self._data

    # -- helpers --

    def get(self, dotted_key: str, default: Any = None) -> Any:
        """Get a nested value like ``cfg.get('server.port', 8765)``."""
        keys = dotted_key.split(".")
        try:
            from atlas.project_context import current_config_override, current_project_id, current_session_id, project_config_ignored
            from atlas.project_settings import load_project_config

            override_node: Any = current_config_override()
            for key in keys:
                if not isinstance(override_node, dict) or key not in override_node:
                    override_node = None
                    break
                override_node = override_node[key]
            if override_node is not None:
                return override_node
            session_id = current_session_id()
            if session_id:
                from atlas.project_settings import load_session_config

                session_node: Any = load_session_config(session_id)
                for key in keys:
                    if not isinstance(session_node, dict) or key not in session_node:
                        session_node = None
                        break
                    session_node = session_node[key]
                if session_node is not None:
                    return session_node
            project_id = current_project_id()
            if project_id and not project_config_ignored():
                project_node: Any = load_project_config(project_id)
                for key in keys:
                    if not isinstance(project_node, dict) or key not in project_node:
                        project_node = None
                        break
                    project_node = project_node[key]
                if project_node is not None:
                    return project_node
        except (ImportError, ValueError):
            provider=provider, api_mode=api_mode, model=model, base_url=base_url,
            key=key, credential_pool=pool, purpose=purpose, fallback_reason=fallback_reason,
            wire_model=wire_model or model, model_id=str(model_data.get("id") or ""),
            capabilities=dict(model_data.get("capabilities") or {})
            if isinstance(model_data.get("capabilities"), dict) else {},
            network_proxy_url=network.proxy_url,
            network_ca_bundle_path=network.ca_bundle_path,
            network_trust_env=network.trust_env,
        )

    async def complete(self, route: RouteSpec, messages: list[dict[str, Any]], **kwargs: Any) -> CompletionResult:
        """Run one auxiliary request over the same Atlas-owned HTTP transport."""
        wire_model = route.wire_model or route.model
        usage_callback = kwargs.pop("usage_callback", None) or _USAGE_CALLBACK.get()
        from atlas.usage import env_run_usage_budget
        from atlas.models.tokens import estimate_tokens
        from atlas.engine.agent.turn_usage import new_usage_request_id

        if route.purpose in _MEMORY_AUXILIARY_PURPOSES and kwargs.get("timeout") is None:
            kwargs["timeout"] = _MEMORY_AUXILIARY_TIMEOUT_SECONDS
        if kwargs.get("timeout") is None:
            kwargs["timeout"] = _provider_timeout(route, streaming=False)
        if (
            route.purpose in _MEMORY_AUXILIARY_PURPOSES
            and (route.wire_model or route.model) in _MEMORY_LOW_REASONING_MODELS
        ):
            extra_body = kwargs.get("extra_body")
            memory_extra_body = dict(extra_body) if isinstance(extra_body, dict) else {}
            memory_extra_body.setdefault("reasoning_effort", "low")
            kwargs["extra_body"] = memory_extra_body

        request_id = new_usage_request_id()
        network = ModelNetworkSettings(
            proxy_url=route.network_proxy_url,
            ca_bundle_path=route.network_ca_bundle_path,
            trust_env=route.network_trust_env,
        )
        assert_transport_supported(network, provider=route.provider, api_mode=route.api_mode)
        budget = env_run_usage_budget()
        request_text = "\n".join(str(item.get("content") or "") for item in messages)
        estimate = max(1, estimate_tokens(request_text, model=wire_model))
        if budget is not None and not budget.reserve(
            request_id, estimate, purpose=route.purpose,
            model=route.model_id or route.model, wire_model=wire_model,
        ):
            reason = (
                "Estimated run cost limit reached or model price is unknown"
                if budget.cost_limit_usd is not None else "Run input-token budget reached"
            )
            raise RuntimeError(f"{reason}; the auxiliary model request was not sent.")
        try:
            response = await asyncio.to_thread(
                _post_completion_queued, route, messages, kwargs, network,
                _provider_semaphore(route),
            )
        except BaseException:
            if budget is not None:
                budget.release(request_id)

