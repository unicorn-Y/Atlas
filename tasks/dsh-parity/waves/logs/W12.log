diff --git a/frontend/src/renderer/components/timelineProjection.test.ts b/frontend/src/renderer/components/timelineProjection.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8fa682ba4f7ffe95ae4eecd96c8e2dcc0442579b
--- /dev/null
+++ b/frontend/src/renderer/components/timelineProjection.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import type { AgentEvent } from '../../types/runtime';
+import { buildTimeline } from './timeline';
+import { TimelineProjection } from './timelineProjection';
+
+const event = (id: string, sequence: number, type: AgentEvent['type'], content: string): AgentEvent => ({
+  id, runId: 'run-1', sequence, type, timestamp: new Date(0).toISOString(), data: { content },
+});
+
+describe('TimelineProjection', () => {
+  it('folds streamed deltas into one node while preserving unaffected node identities', () => {
+    const projection = new TimelineProjection();
+    const input = event('input', 1, 'run.started', 'hello');
+    const firstDelta = event('delta-1', 2, 'message.delta', 'Atlas ');
+    const secondDelta = event('delta-2', 3, 'message.delta', 'here');
+
+    const initial = projection.project([input, firstDelta]);
+    const userNode = initial[0];
+    const firstReplyNode = initial[1];
+    const updated = projection.project([input, firstDelta, secondDelta]);
+
+    expect(updated).toEqual(buildTimeline([input, firstDelta, secondDelta]));
+    expect(updated[0]).toBe(userNode);
+    expect(updated[1]).not.toBe(firstReplyNode);
+  });
+
+  it('rebuilds when the event prefix is replaced or truncated', () => {
+    const projection = new TimelineProjection();
+    const original = event('input', 1, 'run.started', 'old');
+    const replacement = event('input', 1, 'run.started', 'new');
+
+    projection.project([original]);
+    expect(projection.project([replacement])).toEqual(buildTimeline([replacement]));
+    expect(projection.project([])).toEqual([]);
+  });
+});
diff --git a/frontend/src/renderer/components/timelineProjection.ts b/frontend/src/renderer/components/timelineProjection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84d4ac9430fa80b95e234a5f8e6d94d984c65404
--- /dev/null
+++ b/frontend/src/renderer/components/timelineProjection.ts
@@ -0,0 +1,34 @@
+import type { AgentEvent } from '../../types/runtime';
+import { buildTimeline, type TimelineItem } from './timeline';
+
+/** Keeps a run's projection and folds adjacent streamed reply chunks into that reply node. */
+export class TimelineProjection {
+  private events: AgentEvent[] = [];
+  private items: TimelineItem[] = [];
+
+  project(events: AgentEvent[]): TimelineItem[] {
+    let prefixLength = 0;
+    const sharedLength = Math.min(this.events.length, events.length);
+    while (prefixLength < sharedLength && this.events[prefixLength] === events[prefixLength]) prefixLength += 1;
+
+    if (prefixLength !== this.events.length || events.length < this.events.length) {
+      this.events = events.slice(0, prefixLength);
+      this.items = buildTimeline(this.events);
+    }
+
+    for (const event of events.slice(prefixLength)) {
+      this.events.push(event);
+      if (!this.foldMessageDelta(event)) this.items = buildTimeline(this.events);
+    }
+    return this.items;
+  }
+
+  private foldMessageDelta(event: AgentEvent): boolean {
+    if (event.type !== 'message.delta') return false;
+    const last = this.items.at(-1);
+    if (last?.kind !== 'reply' || !last.streaming) return false;
+    const updated: TimelineItem = { ...last, content: last.content + String(event.data.content ?? '') };
+    this.items = [...this.items.slice(0, -1), updated];
+    return true;
+  }
+}
