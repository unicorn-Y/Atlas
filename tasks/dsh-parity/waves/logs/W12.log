import type { AgentEvent } from '../../types/runtime';

const TERMINAL = new Set(['run.completed', 'run.failed', 'run.cancelled']);

export interface EventBuffer {
  /** 送进一个事件：流式 delta 攒批，其余立即透传（透传前先冲出攒着的 delta，保证顺序）。 */
  push: (event: AgentEvent) => void;
  /** 立刻冲出攒着的 delta（合并成一条合成事件）。 */
  flush: () => void;
  /** 停止定时器并冲出剩余事件；之后送进的事件直接透传。 */
  dispose: () => void;
}

export interface EventBufferOptions {
  /** 攒批间隔（毫秒）；默认 80ms，约 12.5Hz。 */
  intervalMs?: number;
}

/**
 * 流式事件合流器：message.delta 按 ~12.5Hz 合并成一条合成 delta 再进 store（内容拼接、
 * id 取第一条保持时间线 reply 的稳定 key、sequence 取最后一条），让长回复流式时
 * React 每秒最多重渲染十几次而不是每个 delta 一次。其余事件零延迟透传。
 */
export function createEventBuffer(sink: (events: AgentEvent[]) => void, options: EventBufferOptions = {}): EventBuffer {
  const intervalMs = Math.max(1, options.intervalMs ?? 80);
  let pending: AgentEvent[] = [];
  let timer: ReturnType<typeof setTimeout> | null = null;
  let disposed = false;

  const flush = () => {
    if (timer) { clearTimeout(timer); timer = null; }
    if (!pending.length) return;
    const events = coalesce(pending);
    pending = [];
    sink(events);
  };
  const schedule = () => {
    if (timer) return;
    timer = setTimeout(() => { timer = null; flush(); }, intervalMs);
  };
  const dispose = () => {
    disposed = true;
    flush();
  };

  return {
    push: (event) => {
      if (disposed || !isStreamChunk(event)) {
        // 非流式事件立即透传，但先把攒着的 delta 冲出去，run.events 的顺序保持到达顺序。
        flush();
        sink([event]);
        if (TERMINAL.has(event.type)) dispose();
        return;
      }
      pending.push(event);
      schedule();
    },
    flush,
    dispose,
  };
}

/** 相邻的 delta 合成一条；不同类型的事件之间保持独立（正常情况下攒批里只有 delta）。 */
/** Streamed text chunks: reply deltas and the kernel's raw thinking chunks (run.status + status=reasoning). */
function isReasoningChunk(event: AgentEvent): boolean {
  return event.type === 'run.status' && event.data.status === 'reasoning' && typeof event.data.text === 'string';
}

function isStreamChunk(event: AgentEvent): boolean {
  return event.type === 'message.delta' || isReasoningChunk(event);
}

function coalesce(deltas: AgentEvent[]): AgentEvent[] {
  const merged: AgentEvent[] = [];
  for (const event of deltas) {
    const previous = merged[merged.length - 1];
    if (previous && isReasoningChunk(previous) && isReasoningChunk(event)) {
      // Thinking used to bypass batching: every few tokens re-ran the whole timeline in five places.
      merged[merged.length - 1] = {
        ...previous,
        sequence: event.sequence,
        // Keep the first chunk's time: the timeline uses it as when thinking started.
        timestamp: previous.timestamp,
        data: { ...previous.data, text: String(previous.data.text ?? '') + String(event.data.text ?? '') },
      };
    } else if (previous && previous.type === 'message.delta' && event.type === 'message.delta') {
      merged[merged.length - 1] = {
        ...previous,
        sequence: event.sequence,
        timestamp: event.timestamp,
        data: { ...previous.data, content: String(previous.data.content ?? '') + String(event.data.content ?? '') },
      };
    } else {
      merged.push(event);
    }
  }
  return merged;
}
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { createEventBuffer } from './eventBuffer';
import type { AgentEvent } from '../../types/runtime';

const delta = (sequence: number, content: string): AgentEvent =>
  ({ id: `e${sequence}`, runId: 'r1', sequence, type: 'message.delta', timestamp: '2026-10-02T00:00:00Z', data: { content } });
const event = (sequence: number, type: AgentEvent['type'], data: Record<string, unknown> = {}): AgentEvent =>
  ({ id: `e${sequence}`, runId: 'r1', sequence, type, timestamp: '2026-10-02T00:00:00Z', data });

describe('eventBuffer', () => {
  beforeEach(() => vi.useFakeTimers());
  afterEach(() => vi.useRealTimers());

  it('coalesces a burst of deltas into one merged event at ~12.5Hz', () => {
    const out: AgentEvent[] = [];
    const buffer = createEventBuffer((events) => out.push(...events), { intervalMs: 80 });
    for (let sequence = 1; sequence <= 50; sequence++) buffer.push(delta(sequence, '字'));
    expect(out).toHaveLength(0);
    vi.advanceTimersByTime(81);
    expect(out).toHaveLength(1);
    expect(out[0].type).toBe('message.delta');
    // id 取第一条（时间线 reply 的稳定 key），sequence 取最后一条，内容按顺序拼接。
    expect(out[0].id).toBe('e1');
    expect(out[0].sequence).toBe(50);
    expect(out[0].data.content).toBe('字'.repeat(50));
  });

  it('passes non-delta events through immediately and flushes pending deltas first', () => {
    const out: AgentEvent[] = [];
    const buffer = createEventBuffer((events) => out.push(...events), { intervalMs: 80 });
    buffer.push(delta(1, 'hello '));
    buffer.push(delta(2, 'world'));
    buffer.push(event(3, 'tool.started', { name: 'local_shell' }));
    expect(out.map((item) => item.type)).toEqual(['message.delta', 'tool.started']);
    expect(out[0].data.content).toBe('hello world');
    expect(out[0].sequence).toBe(2);
  });

  it('keeps ordering across alternating deltas and control events', () => {
    const out: AgentEvent[] = [];
    const buffer = createEventBuffer((events) => out.push(...events), { intervalMs: 80 });
    buffer.push(delta(1, 'one'));
    buffer.push(event(2, 'run.started', { content: 'q' }));
    buffer.push(delta(3, 'two'));
    expect(out.map((item) => [item.type, item.data.content])).toEqual([
      ['message.delta', 'one'],
      ['run.started', 'q'],
    ]);
    vi.advanceTimersByTime(81);
    expect(out.map((item) => item.type)).toEqual(['message.delta', 'run.started', 'message.delta']);
    expect(out[2].data.content).toBe('two');
  });

  it('flushes and disposes on a terminal event, then passes later events straight through', () => {
    const out: AgentEvent[] = [];
    const buffer = createEventBuffer((events) => out.push(...events), { intervalMs: 80 });
    buffer.push(delta(1, 'tail'));
    buffer.push(event(2, 'run.completed', {}));
    expect(out.map((item) => item.type)).toEqual(['message.delta', 'run.completed']);
    buffer.push(delta(3, 'late'));
    expect(out).toHaveLength(3);
    expect(out[2].data.content).toBe('late');
    vi.advanceTimersByTime(400);
    expect(out).toHaveLength(3);
  });
});

