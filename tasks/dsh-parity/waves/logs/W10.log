+    runtime._DISCOVERY_REGISTRY_PATH = None
+    monkeypatch.setattr(runtime, "get_store", lambda: _Store())
+    monkeypatch.setattr(runtime, "_skill_usage_counts", lambda: {})
+
+
+def test_explicit_slash_command_inlines_user_invocable_skill(tmp_path: Path, monkeypatch) -> None:
+    _reset_catalog(tmp_path, monkeypatch)
+    manager = _skill_manager(tmp_path, body="Follow the demo instructions.")
+
+    message = runtime.skill_index_message(manager, "/demo complete this task")
+
+    assert message is not None
+    assert '<activated_skill name="demo">' in message
+    assert "Follow the demo instructions." in message
+    assert "<available_skills" not in message
+
+    regex_only = runtime.skill_index_message(manager, "/demo-other")
+    assert regex_only is not None
+    assert "<activated_skill" not in regex_only
+
+
+def test_skill_catalog_summary_diff_reports_updates_and_retirements(
+    tmp_path: Path, monkeypatch,
+) -> None:
+    _reset_catalog(tmp_path, monkeypatch)
+    manager = _skill_manager(tmp_path)
+
+    first = runtime.skill_index_message(manager, "demo")
+    assert first is not None and '"added"' in first
+
+    skill_file = tmp_path / "dev" / "demo" / "SKILL.md"
+    skill_file.write_text(
+        "---\nname: demo\ndescription: Updated demo summary\n"
+        "version: 1.0.0\ncategory: dev\ntriggers:\n  - command: /demo\n---\nupdated body",
+        encoding="utf-8",
+    )
+    manager.scan_skills_sync()
+    updated = runtime.skill_index_message(manager, "demo")
+    assert updated is not None
+    assert '"updated"' in updated
+    assert "Updated demo summary" in updated
+    assert "revision=\"" in updated
+
+    skill_file.unlink()
+    manager.scan_skills_sync()
+    retired = runtime.skill_index_message(manager, "demo")
+    assert retired is not None
+    assert '"retired": ["demo"]' in retired
+    assert "<available_skills" not in retired
