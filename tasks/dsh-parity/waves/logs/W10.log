tem('atlas-device-id'))+'/commands',{auth:true});render(result.commands)}catch(error){status.textContent=String(error)}}; const start=()=>{form.classList.add('hidden');commands.classList.remove('hidden');status.textContent='已配对；此页会定时检查指令。';void poll();timer=window.setInterval(()=>void poll(),5000)}; const saved=localStorage.getItem('atlas-device-token'),savedId=localStorage.getItem('atlas-device-id');if(saved&&savedId)start();form.addEventListener('submit',async event=>{event.preventDefault();status.textContent='正在发送申请…';try{const result=await api('/api/devices/pairing/claim',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({challenge_id:challenge,code:$('pairCode').value.trim(),device_id:$('deviceId').value.trim(),display_name:$('deviceName').value.trim(),os:navigator.userAgent.slice(0,120)})});status.textContent='等待本机管理员批准…';const deadline=Date.now()+600000;while(Date.now()<deadline){await new Promise(resolve=>setTimeout(resolve,2000));const state=await api('/api/devices/pairing/claim/'+encodeURIComponent(result.request_id)+'?proof='+encodeURIComponent(result.proof));if(state.credential){localStorage.setItem('atlas-device-token',state.credential);localStorage.setItem('atlas-device-id',state.device_id);localStorage.setItem('atlas-device-name',$('deviceName').value.trim());history.replaceState(null,'',location.pathname);start();return}if(['rejected','expired'].includes(state.status)){throw new Error('配对申请已'+state.status)}}throw new Error('配对申请超时，请重新生成二维码')}catch(error){status.textContent=String(error)}});$('refresh').onclick=()=>void poll();$('disconnect').onclick=()=>{clearInterval(timer);localStorage.removeItem('atlas-device-token');localStorage.removeItem('atlas-device-id');localStorage.removeItem('atlas-device-name');location.reload()}})();
