type Intent = { label: string; icon: LucideIcon; note?: string };

const INTENTS: Array<[RegExp, Intent]> = [
  [/视频|短片|剪辑|动画|video/i, { label: '视频', icon: Film, note: '视频生成还没接入，会先按对话处理' }],
  [/画|生图|图片|插画|海报|头像|logo|配图|image/i, { label: '生图', icon: ImageIcon, note: '想直接出图，可以切到「图像」' }],
  [/每天|每周|每月|定时|提醒我|每隔|自动(执行|运行)|cron/i, { label: '自动化', icon: Repeat, note: '也可以在「自动化」里建成定时任务' }],
  [/代码|bug|报错|函数|接口|重构|编译|测试用例|仓库|git|python|typescript|javascript|sql|\.tsx?\b|\.py\b/i, { label: '代码', icon: Code2 }],
  [/搜索|调研|查一下|资料|对比|最新|新闻|research/i, { label: '调研', icon: Search }],
];

export function guessIntent(text: string): Intent | null {
  if (text.trim().length < 2) return null;
  return INTENTS.find(([pattern]) => pattern.test(text))?.[1] ?? { label: '日常', icon: MessageCircle };
}

/** Something an @ or # mention can refer to. */
export interface MentionItem { kind: 'file' | 'conversation' | 'resource' | 'element'; id: string; label: string; hint?: string }

/** The @, #, or $ query being typed at the end of the draft, if any. */
export function mentionAt(value: string): { trigger: '@' | '#' | '$'; query: string; start: number } | null {
  const line = value.slice(value.lastIndexOf('\n') + 1);
  if (/^\s*#(?:\s+|记住(?=[:：\s]|$))/.test(line)) return null;
  const match = /(^|\s)([@#$])([^\s@#$]*)$/.exec(value);
  if (!match) return null;
  return { trigger: match[2] as '@' | '#' | '$', query: match[3], start: match.index + match[1].length };
}

/** Pastes longer than this (a log, a whole file) become an attachment. */
const LONG_PASTE = 4000;
const SCREEN_READER_MODE_KEY = 'atlas.composer.screen-reader-mode';
const ENTER_TO_SEND_KEY = 'atlas.preference.enter-to-send';
export function applyRewrittenDraft(current: string, rewritten: string, append: boolean): string {
  const content = rewritten.trim();
  return append && current.trim() ? `${current.trim()}\n\n${content}` : content;
}
function readScreenReaderMode(): boolean {
  try { return localStorage.getItem(SCREEN_READER_MODE_KEY) === 'true'; } catch { return false; }
}
function readEnterToSend(): boolean {
  try { return localStorage.getItem(ENTER_TO_SEND_KEY) !== 'false'; } catch { return true; }
}
function readShortcutHints(): boolean {
  try { return localStorage.getItem('atlas.shortcut-hints') !== 'false'; } catch { return true; }
}

export interface ComposerMode { id: string; label: string; icon: LucideIcon }

/** An entry in the `/` menu. `takesArgument` commands receive the text typed after the command name. */
export type { SlashCommand } from '../services/slashCommands';

interface SkillSuggestion {
  id: string;
  skillName: string;
  label: string;
  hint?: string;
  group: string;
  source: string;
}

/** Commands matching a `/query` draft; only while the draft is a single command word (plus an argument for argument commands). */
export function matchCommands(value: string, commands: SlashCommand[]): SlashCommand[] {
  return matchSlashCommands(value, commands);
}

export function matchSkillSuggestions(query: string, commands: readonly SlashCommand[]): SkillSuggestion[] {
  return commands
    .filter((command) => command.id.startsWith('skill-'))
    .map((command, index) => {
      const skillName = command.label.replace(/^\/+/, '');
      return {
        command,
        index,
        skillName,
        score: query ? fuzzyScore(query, skillName) : 0,
      };
    })
    .filter((item) => item.score >= 0)
    .sort((left, right) => right.score - left.score || left.index - right.index)
    .slice(0, 8)
    .map(({ command, skillName }) => ({
      id: command.id,
      skillName,
      label: `$${skillName}`,
      hint: command.hint,
      group: '本轮技能调用预览',
      source: command.source ?? '技能',
    }));
}

export function selectedSkillCalls(value: string, commands: readonly SlashCommand[]): Array<{
  name: string; description: string; source: string;
}> {
  const skills = commands.filter((command) => command.id.startsWith('skill-'));
  const names = resolveMessageSkillReferences(value, skills.map((command) => command.label.replace(/^\/+/, '')));
  return names.map((name) => {
    const command = skills.find((item) => item.label.replace(/^\/+/, '').toLocaleLowerCase() === name.toLocaleLowerCase());
    return { name, description: command?.hint || '该技能没有提供说明。', source: command?.source || '技能' };
  });
}

/** 已发送消息的召回历史（像终端的 ↑ 一样）；全局共用一份，localStorage 持久化最近 50 条。 */
const HISTORY_KEY = 'atlas.composer-history';
const SLASH_HISTORY_KEY = 'atlas.slash-command-history';
const HISTORY_LIMIT = 50;
function readHistory(): string[] {
  try {
    const parsed: unknown = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
    return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string' && item.trim().length > 0).slice(-HISTORY_LIMIT) : [];
  } catch { return []; }
}
function appendHistory(text: string): string[] {
  const trimmed = text.trim();
  if (!trimmed) return readHistory();
  const next = [...readHistory().filter((item) => item !== trimmed), trimmed].slice(-HISTORY_LIMIT);
  try { localStorage.setItem(HISTORY_KEY, JSON.stringify(next)); } catch { /* storage unavailable */ }
  return next;
}
function readSlashHistory(): string[] {
  try {
    const parsed: unknown = JSON.parse(localStorage.getItem(SLASH_HISTORY_KEY) ?? '[]');
    return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string' && item.startsWith('/') && item.trim().length > 1).slice(-HISTORY_LIMIT) : [];
  } catch { return []; }
}
function appendSlashHistory(text: string): string[] {
  const value = text.trim();
  if (!value.startsWith('/') || value.length < 2) return readSlashHistory();
  const next = [...readSlashHistory().filter((item) => item !== value), value].slice(-HISTORY_LIMIT);
  try { localStorage.setItem(SLASH_HISTORY_KEY, JSON.stringify(next)); } catch { /* storage unavailable */ }
  return next;
}
function commandFrequency(history: readonly string[]): Record<string, number> {
  return history.reduce<Record<string, number>>((counts, item) => {
    const id = item.trim().split(/\s+/, 1)[0]?.slice(1).toLowerCase();
    if (id) counts[id] = (counts[id] ?? 0) + 1;
    return counts;
  }, {});
}

