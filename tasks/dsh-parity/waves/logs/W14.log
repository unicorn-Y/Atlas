@@ -0,0 +1,20 @@
+import { describe, expect, it, vi } from 'vitest';
+import { contentAddressedId, readFileBytes } from './attachmentStaging';
+
+describe('attachment staging primitives', () => {
+  it('uses a stable SHA-256 content address', async () => {
+    const bytes = new TextEncoder().encode('attachment');
+    expect(await contentAddressedId(bytes)).toBe('sha256:602a5e69c3021bdbd3d25156a02d2cbb467605b8203248eea6af3fb42168d663');
+    expect(await contentAddressedId(bytes)).toBe(await contentAddressedId(bytes));
+  });
+
+  it('reports progress and aborts an active read', async () => {
+    const controller = new AbortController();
+    const onProgress = vi.fn();
+    const file = new Blob([new Uint8Array(64 * 1024)]);
+    const pending = readFileBytes(file, controller.signal, (loaded, total) => onProgress(loaded, total));
+    controller.abort();
+    await expect(pending).rejects.toMatchObject({ name: 'AbortError' });
+    expect(onProgress).toHaveBeenCalled();
+  });
+});
diff --git a/frontend/src/renderer/services/attachmentStaging.ts b/frontend/src/renderer/services/attachmentStaging.ts
new file mode 100644
index 0000000000000000000000000000000000000000..46035c6700f57afce6ad53249716c73586caf640
--- /dev/null
+++ b/frontend/src/renderer/services/attachmentStaging.ts
@@ -0,0 +1,79 @@
+export interface StagedAttachment {
+  id: string;
+  name: string;
+  mime: string;
+  size: number;
+  kind: 'image' | 'file';
+}
+
+const DATABASE = 'atlas-attachments-v1';
+const STORE = 'content';
+
+export async function contentAddressedId(bytes: BufferSource): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', bytes instanceof Uint8Array ? bytes.slice().buffer as ArrayBuffer : bytes);
+  return `sha256:${Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')}`;
+}
+
+export async function readFileBytes(file: Blob, signal: AbortSignal, onProgress: (loaded: number, total: number) => void): Promise<Uint8Array> {
+  if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
+  const reader = file.stream().getReader();
+  const chunks: Uint8Array[] = [];
+  let loaded = 0;
+  const abort = () => { void reader.cancel(); };
+  signal.addEventListener('abort', abort, { once: true });
+  try {
+    onProgress(0, file.size);
+    while (true) {
+      if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
+      const { done, value } = await reader.read();
+      if (done) break;
+      chunks.push(value);
+      loaded += value.length;
+      onProgress(loaded, file.size);
+    }
+    if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
+    const bytes = new Uint8Array(loaded);
+    let offset = 0;
+    for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.length; }
+    return bytes;
+  } catch (error) {
+    if (signal.aborted) throw new DOMException('Attachment read cancelled', 'AbortError');
+    throw error;
+  } finally {
+    signal.removeEventListener('abort', abort);
+    reader.releaseLock();
+  }
+}
+
+export async function stageAttachment(file: File, kind: StagedAttachment['kind'], signal: AbortSignal, onProgress: (loaded: number, total: number) => void): Promise<StagedAttachment> {
+  const bytes = await readFileBytes(file, signal, onProgress);
+  const id = await contentAddressedId(bytes);
+  if (signal.aborted) throw new DOMException('Attachment staging cancelled', 'AbortError');
+  const db = await openDatabase();
+  await new Promise<void>((resolve, reject) => {
+    const tx = db.transaction(STORE, 'readwrite');
+    tx.objectStore(STORE).put({ id, blob: new Blob([bytes.slice().buffer as ArrayBuffer], { type: file.type }), name: file.name, mime: file.type || 'application/octet-stream', size: bytes.byteLength });
+    tx.oncomplete = () => resolve();
+    tx.onerror = () => reject(tx.error ?? new Error('Attachment staging failed'));
+    tx.onabort = () => reject(tx.error ?? new Error('Attachment staging aborted'));
+  });
+  return { id, name: file.name, mime: file.type || 'application/octet-stream', size: bytes.byteLength, kind };
+}
+
+export async function loadStagedAttachment(id: string): Promise<Blob | null> {
+  const db = await openDatabase();
+  return new Promise((resolve, reject) => {
+    const request = db.transaction(STORE, 'readonly').objectStore(STORE).get(id);
+    request.onsuccess = () => resolve((request.result as { blob?: Blob } | undefined)?.blob ?? null);
+    request.onerror = () => reject(request.error ?? new Error('Unable to restore staged attachment'));
+  });
+}
+
+async function openDatabase(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DATABASE, 1);
+    request.onupgradeneeded = () => request.result.createObjectStore(STORE, { keyPath: 'id' });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error ?? new Error('Unable to open attachment store'));
+  });
+}
