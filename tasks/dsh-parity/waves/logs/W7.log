"""Resolve child tool restrictions and per-call sandbox requests."""

import inspect
from collections.abc import Callable, Mapping
from fnmatch import fnmatchcase


SANDBOX_PERMISSION_MODES = frozenset({
    "read-only", "workspace-write", "danger-full-access",
})


def normalize_sandbox_escalation(arguments):
    """Validate a per-call sandbox permission request without granting it.

    The caller must run the returned request through its approval flow and
    apply it to this call only. This helper intentionally does not mutate a
    run's permission preset or treat an omitted/invalid request as consent.
    """
    if not isinstance(arguments, Mapping):
        raise ValueError("sandbox_permissions request must be an object")
    mode = arguments.get("sandbox_permissions")
    if not isinstance(mode, str) or mode not in SANDBOX_PERMISSION_MODES:
        raise ValueError(
            "sandbox_permissions must be read-only, workspace-write, or danger-full-access"
        )
    justification = arguments.get("justification")
    if not isinstance(justification, str) or not justification.strip():
        raise ValueError("justification is required for sandbox permission requests")
    return {
        "sandbox_permissions": mode,
        "justification": justification.strip()[:4000],
    }


async def authorize_sandbox_escalation(
    arguments, approval_callback: Callable | None, *, tool_name: str,
    tool_call_id: str,
):
    """Ask the existing approval channel for a one-call sandbox escalation.

    The result is a decision only; callers must apply the returned mode to
    this invocation and must not persist it as the run's permission mode.
    Missing approval wiring and every non-allowing response fail closed.
    """
    from atlas.approval_outcome import ALLOWED, UNAVAILABLE, normalize

    request = normalize_sandbox_escalation(arguments)
    if approval_callback is None:
        outcome = UNAVAILABLE
    else:
        approval_args = dict(arguments)
        approval_args["sandbox_permissions"] = request["sandbox_permissions"]
        approval_args["justification"] = request["justification"]
        approval_args["_approval_reason"] = request["justification"]
        approval_args["_approval_no_always"] = True
        response = approval_callback(str(tool_call_id), str(tool_name), approval_args)
        if inspect.isawaitable(response):
            response = await response
        outcome = normalize(response)
    return {
        "request": request,
        "approval_outcome": outcome,
        "approved": outcome == ALLOWED,
    }


def tool_allowed(name, allow=None, deny=()):
)
from atlas.engine.kernel.tools import (
    READ_ONLY_TOOLS, ToolExecutionResult, ToolScheduler, validate_tool_arguments,
)

log = logging.getLogger(__name__)

_THINKING_OFF = frozenset({"off", "none", "disabled"})

# Tool-call rounds per run. The user asked for no practical cap: the default is
# high and the hard ceiling only guards against a runaway integer in config.
DEFAULT_MAX_TURNS = 1000


async def authorize_local_sandbox_request(
    arguments: dict[str, Any], approval_callback: Callable | None, *,
    tool_name: str, tool_call_id: str, sandbox_executor_available: bool,
) -> dict[str, Any]:
    """Approve a one-call sandbox request, refusing execution without enforcement."""
    from atlas.engine.tool_permissions import authorize_sandbox_escalation

    try:
        authorization = await authorize_sandbox_escalation(
            arguments, approval_callback, tool_name=tool_name,
            tool_call_id=tool_call_id,
        )
    except (TypeError, ValueError) as exc:
        detail = str(exc)
        return {"approved": False, "sandbox_enforced": False, "is_error": True,
                "detail": detail, "approval_outcome": "unavailable"}
    if not authorization["approved"]:
        detail = f"Sandbox permission request was not approved ({authorization['approval_outcome']})."
        return {**authorization, "sandbox_enforced": False, "is_error": True,
                "detail": detail}
    if not sandbox_executor_available:
        detail = (
            "The per-call sandbox request was approved, but no executor can enforce that mode; "
            "the tool was not run."
        )
        return {**authorization, "sandbox_enforced": False, "is_error": True,
                "detail": detail}
    return {**authorization, "sandbox_enforced": True, "is_error": False}
MAX_TURNS_CAP = 100_000
MAX_UNFULFILLED_ACTION_CONTINUATIONS = 2

import pytest

from atlas.engine.kernel.loop import authorize_local_sandbox_request


@pytest.mark.unit
@pytest.mark.asyncio
async def test_non_docker_escalation_uses_one_call_approval_and_fails_closed():
    calls = []

    async def approve(call_id, tool_name, arguments):
        calls.append((call_id, tool_name, arguments))
        return "allow"

    result = await authorize_local_sandbox_request(
        {"sandbox_permissions": "workspace-write", "justification": "Build output"},
        approve, tool_name="local_exec", tool_call_id="tool-1",
        sandbox_executor_available=False,
    )

    assert len(calls) == 1
    assert calls[0][2]["_approval_no_always"] is True
    assert result["approved"] is True
    assert result["sandbox_enforced"] is False
    assert result["is_error"] is True


@pytest.mark.unit
@pytest.mark.asyncio
async def test_unapproved_escalation_does_not_report_grant():
    async def deny(*_args):
        return "deny"

    result = await authorize_local_sandbox_request(
        {"sandbox_permissions": "danger-full-access", "justification": "Need access"},
        deny, tool_name="local_shell", tool_call_id="tool-2",
        sandbox_executor_available=False,
    )

    assert result["approved"] is False
    assert result["sandbox_enforced"] is False

