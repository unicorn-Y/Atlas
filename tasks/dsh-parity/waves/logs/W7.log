+    await manager.start("run-1", str(tmp_path), {"type": "docker"})
+
+    result = await manager.call_tool("run-1", "local_shell", {
+        "command": "touch output.txt", "cwd": str(tmp_path),
+        "sandbox_permissions": "workspace-write",
