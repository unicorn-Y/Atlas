def _process_owner_allowed(record: LocalProcess, run_id: str | None) -> bool:
    """Unowned/handoff processes are shared; a live run owns its own handles."""
    owner = record.owner_run_id
    return owner is None or (run_id is not None and owner == run_id)


def _wait_reason(record: LocalProcess, *, timed_out: bool = False) -> str:
    """Classify a terminal wait result using the DSH closed reason set."""
    if timed_out:
        return "timeout"
    if record.state != "running":
        return "session_exit"
    return "stdin_read" if record.pty else "inferred_idle"


class LocalExecutionRuntime:
    """Owns only processes it starts and exposes arbitrary-path local tools."""

    def __init__(self, output_callback: OutputCallback | None = None) -> None:
        self.permission_mode = get_config().local_execution_permission_mode
        self.output_callback = output_callback
        self._processes: dict[str, LocalProcess] = {}
        self._closed = False
        self._read_paths: set[str] = set()

    def get_tools_for_llm(self) -> list[dict[str, Any]]:
        tools = copy.deepcopy(LOCAL_TOOLS)
        try:
            shell_name, shell_path = _shell_identity()
        except (OSError, RuntimeError, ValueError):
            shell_name, shell_path = ("unknown", "unavailable")
        try:
            cwd = self._agent_cwd()
            home = Path.home().resolve()
        except (OSError, RuntimeError):
            cwd = Path.cwd().resolve()
            home = None
        home_default = home is not None and cwd == home
        for tool in tools:
            function = tool.get("function") or {}
            shell_schema = ((function.get("parameters") or {}).get("properties") or {}).get("shell")
            if os.name != "nt" and isinstance(shell_schema, dict):
                shell_schema["enum"] = [*shell_schema.get("enum", []), "zsh"]
            if function.get("name") not in {
                "local_shell", "local_exec", "local_process", "local_file", "local_edit",
            }:
                continue
            if home_default:
                detail = (
                    f"Current Atlas working directory: {cwd}. No project/workspace is selected; "
                    "relative paths and commands without cwd are rejected here. Select a workspace "
                    "or provide an explicit cwd (or an absolute file path).\n"
                )
            else:
                detail = (
                    f"Current Atlas working directory: {cwd}. Relative paths use the active session "
                    "workspace when selected, otherwise this directory.\n"
                )
            function["description"] = detail + str(function.get("description") or "")
            if function.get("name") in {"local_shell", "local_process"}:
                function["description"] = (
                    f"Shell: {shell_name} ({shell_path}). This is the actual default shell for this run; "
                    "use syntax for this shell unless an explicit shell argument selects another one.\n"
                    + function["description"]
                )
        return tools

    @staticmethod
    def _agent_cwd() -> Path:
        """Use the same configured/session cwd as Atlas's CLI and environment prompt."""
        try:
            from atlas.engine.kernel.toolkit.runtime_cwd import resolve_agent_cwd

            return resolve_agent_cwd().expanduser().resolve()
        except ImportError:
            return Path.cwd().resolve()

    async def call_tool(
        self,
        name: str,
        arguments: dict[str, Any] | None = None,
        *,
        run_id: str | None = None,
        output_callback: OutputCallback | None = None,
        event_callback: Any = None,
        cancel_event: Any = None,
    ) -> dict[str, Any]:
        from atlas import secrets_store
        args = dict(arguments or {})
        sandbox_request = None
        if "sandbox_permissions" in args:
            from atlas.engine.tool_permissions import normalize_sandbox_escalation

            try:
                sandbox_request = normalize_sandbox_escalation(args)
            except ValueError as exc:
                return self._error(str(exc))
            authorization = args.pop("_sandbox_approval_outcome", None)
            if authorization != "allowed-once":
                from atlas.engine.notifications import publish_notification

                publish_notification(
                    record.conversation_id,
                    kind=event["type"],
                    content=json.dumps(event["data"], ensure_ascii=False),
                    source_id=source_id,
                )
            except Exception:
                log.warning(
                    "local_execution.notification_persist_failed",
                    execution_id=record.execution_id,
                )

    async def _heartbeat(self, record: LocalProcess, seconds: float) -> None:
        while record.state == "running":
            await asyncio.sleep(seconds)
            if record.state == "running":
                await self._notify(record, "heartbeat", "后台进程仍在运行。")

    @staticmethod
    def _error(message: str) -> dict[str, Any]:
        return {
            "data": {"error": message},
            "content": [{"type": "text", "text": message}],
            "is_error": True,
        }

    def _edit_operation(self, args: dict[str, Any]) -> dict[str, Any]:
        """Precise string-replacement edit: read-before-edit + uniqueness."""
        path = self._path(args.get("path"), args.get("cwd"))
        self._ensure_workspace_path(path, self._workspace_root(args))
        old_string = str(args.get("old_string", ""))
        new_string = str(args.get("new_string", ""))
        replace_all = bool(args.get("replace_all", False))
        if not old_string:
            raise ValueError("old_string is required (use local_file write for new files)")
        if str(path) not in self._read_paths:
            raise ValueError(
                f"read the file first with local_file action=read ({path})"
            )
        content = path.read_text(encoding=str(args.get("encoding", "utf-8")))
        count = content.count(old_string)
        if count == 0:
            raise ValueError("old_string not found in file (file may have changed)")
        if count > 1 and not replace_all:
            raise ValueError(
                f"old_string matches {count} locations; add more context or set replace_all"
            )
        updated = content.replace(old_string, new_string) if replace_all else (
            content.replace(old_string, new_string, 1)
        )
        path.write_text(updated, encoding=str(args.get("encoding", "utf-8")))
        replacements = count if replace_all else 1
        return {
            "path": str(path),
            "replacements": replacements,
            "size": len(updated.encode(str(args.get("encoding", "utf-8")))),
        }

    def _edit_batch_operation(self, args: dict[str, Any]) -> dict[str, Any]:
        """Validate every target and replacement before atomically replacing files."""
        edits = args.get("edits")
        if not isinstance(edits, list) or not 1 <= len(edits) <= 32:
            raise ValueError("edits must contain between 1 and 32 changes")
        workspace = self._workspace_root(args)
        cwd = workspace or Path(args.get("cwd") or Path.cwd())
        staged: list[tuple[Path, bytes, bytes, tuple[int, int, int]]] = []
        seen: set[Path] = set()
        for edit in edits:
            if not isinstance(edit, dict):
                raise ValueError("Each edit must be an object")
            path = self._path(edit.get("path"), str(cwd))
            self._ensure_workspace_path(path, workspace)
            if path in seen:
                raise ValueError(f"Duplicate edit target: {path}")
            seen.add(path)
            if str(path) not in self._read_paths:
                raise ValueError(f"read the file first with local_file action=read ({path})")
            encoding = str(edit.get("encoding", "utf-8"))
            old = str(edit.get("old_string", ""))
            if not old:
                raise ValueError("old_string must not be empty")
            original = path.read_bytes()
            if len(original) > _MAX_READ_PAGE_BYTES:
                raise ValueError(f"Batch edit target exceeds {_MAX_READ_PAGE_BYTES} bytes: {path}")
            text = original.decode(encoding)
            count = text.count(old)
            if count == 0:
                raise ValueError(f"old_string not found in file: {path}")
            replace_all = bool(edit.get("replace_all", False))
            if count > 1 and not replace_all:
                raise ValueError(f"old_string matches {count} locations in {path}; set replace_all")
            updated = text.replace(old, str(edit.get("new_string", "")), -1 if replace_all else 1)
            stat = path.stat()
            staged.append((path, original, updated.encode(encoding), (stat.st_mtime_ns, stat.st_size, stat.st_ino)))

        replaced: list[tuple[Path, bytes]] = []
        temp_paths: list[Path] = []
        try:
            for path, original, updated, signature in staged:
                now = path.stat()
                if (now.st_mtime_ns, now.st_size, now.st_ino) != signature:
                    raise RuntimeError(f"File changed during batch validation: {path}")
                fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".atlas-tmp", dir=path.parent)
                temp_path = Path(temp_name)
                temp_paths.append(temp_path)
                with os.fdopen(fd, "wb") as stream:
                    stream.write(updated)
                    stream.flush()
                    os.fsync(stream.fileno())
                os.chmod(temp_path, path.stat().st_mode)
                os.replace(temp_path, path)
                replaced.append((path, original))
        except Exception:
            for path, original in reversed(replaced):
                rollback = path.with_name(f".{path.name}.{uuid.uuid4().hex}.atlas-rollback")
                try:
                    rollback.write_bytes(original)
                    os.replace(rollback, path)
                finally:
                    rollback.unlink(missing_ok=True)
            raise
        finally:
            for temp_path in temp_paths:
                temp_path.unlink(missing_ok=True)
        return {"committed": True, "applied": len(staged),
                "paths": [str(item[0]) for item in staged],
                "atomicity": "all-target-validation plus rollback-on-failure; replacements are sequential"}

    @staticmethod
    def _workspace_root(args: dict[str, Any]) -> Path | None:
        raw = args.get("_atlas_workspace")
        if not isinstance(raw, str) or not raw.strip() or raw.startswith("ssh://"):
            return None
        return Path(raw).expanduser().resolve()

    @staticmethod
    def _default_cwd() -> Path:
        """Return Atlas's configured cwd or launch cwd, refusing an implicit home cwd."""
        cwd = LocalExecutionRuntime._agent_cwd()
        try:
            home = Path.home().resolve()
        except OSError:
            home = None
        if home is not None and cwd == home:
            raise ValueError(
                f"No project or workspace is selected. Atlas's current working directory is {cwd}, "
                "which is the user home directory; select a workspace or provide an explicit cwd "
                "(or absolute file path) before using relative paths."
            )
        if not cwd.is_dir():
            raise NotADirectoryError(f"Atlas current working directory does not exist: {cwd}")
        return cwd

    @staticmethod
    def _ensure_workspace_path(path: Path, workspace: Path | None) -> None:
        # Atlas runs unsandboxed like a CLI agent: approval is the permission
        # layer's job, so a missing or different workspace no longer blocks
        # writes (it forced the model into base64-through-shell workarounds).
        if workspace is not None and path == workspace:
            raise PermissionError("Mutating the workspace root itself is not allowed")

    @staticmethod
    def _path(raw: str | None, cwd: str | None = None) -> Path:
        if not raw:
            raise ValueError("path is required")
        expanded = Path(os.path.expandvars(os.path.expanduser(raw)))
        if not expanded.is_absolute():
            expanded = Path(cwd or os.getcwd()) / expanded
        return expanded.resolve()

    def _read_many(self, args: dict[str, Any]) -> dict[str, Any]:
        """Read several whole files in one call; one bad path doesn't fail the others."""
        paths = args.get("paths")
        if not isinstance(paths, list) or not all(isinstance(item, str) for item in paths):
            raise ValueError("paths must be a list of file paths")
        if len(paths) > _MAX_BATCH_READ:
            raise ValueError(f"paths is limited to {_MAX_BATCH_READ} files per call")
        files: list[dict[str, Any]] = []
        for raw in paths:
            single = {key: value for key, value in args.items()
                      if key not in {"paths", "offset", "limit", "byte_offset", "byte_limit"}}
            single["path"] = raw
            try:
                files.append(self._file_operation(single))
            except Exception as exc:  # noqa: BLE001 — reported per file
                files.append({"path": raw, "error": f"{type(exc).__name__}: {exc}"})
        return {"files": files}

    def _file_operation(
        self, args: dict[str, Any], *, cancel_check: Callable[[], bool] | None = None,
    ) -> dict[str, Any]:
        action = args["action"]
        if not str(args.get("path") or "").strip():
            raise ValueError("local_file requires path (or paths for a multi-file read)")
        path = self._path(args.get("path"), args.get("cwd"))
        encoding = str(args.get("encoding", "utf-8"))
        workspace = self._workspace_root(args)
        if action == "read":
            if not path.exists():
                raise FileNotFoundError(f"File not found: {path}")
            total_size = path.stat().st_size if path.is_file() else 0
            if args.get("byte_offset") is not None or args.get("byte_limit") is not None:
                if not path.is_file():
                    raise ValueError("Byte-range reads require a file")
                byte_offset = int(args.get("byte_offset", 0))
                byte_limit = min(int(args.get("byte_limit", _MAX_READ_PAGE_BYTES)), _MAX_READ_PAGE_BYTES)
                with path.open("rb") as stream:
                    stream.seek(byte_offset)
                    raw = stream.read(byte_limit + 1)
                truncated = len(raw) > byte_limit
                raw = raw[:byte_limit]
                if truncated and not args.get("binary"):
                    raw = _trim_partial_char(raw, encoding)
                next_offset = byte_offset + len(raw)
                complete = not truncated and next_offset >= path.stat().st_size
            elif args.get("offset") is not None or args.get("limit") is not None:
                if not path.is_file() or args.get("binary"):
                    raise ValueError("Line-range reads require a text file")
                offset = max(1, int(args.get("offset", 1)))
                limit = min(int(args.get("limit", _MAX_READ_LINES)), _MAX_READ_LINES)
                chunks: list[str] = []
                byte_count = 0
                truncated = False
                with path.open("r", encoding=encoding, newline="") as stream:
                    for number, line in enumerate(stream, 1):
                        if number < offset:
                            continue
                        encoded_size = len(line.encode(encoding))
                        if len(chunks) >= limit or byte_count + encoded_size > _MAX_READ_PAGE_BYTES:
                            truncated = True
                            break
                        chunks.append(line)
                        byte_count += encoded_size
                raw = "".join(chunks).encode(encoding)
                next_offset = offset + len(chunks)
                complete = not truncated
            else:
                if args.get("binary"):
                    if total_size > _MAX_READ_BYTES:
                        raise ValueError(
                            f"Binary file is {total_size} bytes; default read is limited to "
                            f"{_MAX_READ_BYTES} bytes. Use byte_offset/byte_limit to page it."
                        )
                    with path.open("rb") as stream:
                        raw = stream.read(_MAX_READ_BYTES + 1)
                    if len(raw) > _MAX_READ_BYTES:
                        raise ValueError(f"File grew beyond the {_MAX_READ_BYTES}-byte default read limit")
                    truncated = False
                    next_offset = None
                    complete = True
                else:
                    # Bound default text reads by both lines and bytes, then give the
                    # caller a precise continuation point for large source files.
                    chunks = []
                    byte_count = 0
                    truncated = False
                    with path.open("r", encoding=encoding, newline="") as stream:
                        for line in stream:
                            encoded_size = len(line.encode(encoding))
                            if (len(chunks) >= _MAX_READ_LINES
                                    or byte_count + encoded_size > _MAX_READ_PAGE_BYTES):
                                truncated = True
                                break
                            chunks.append(line)
                            byte_count += encoded_size
                    raw = "".join(chunks).encode(encoding)
