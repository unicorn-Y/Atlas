# -- engine turn ----------------------------------------------------------

_FAILURE_NO_DETAIL = "模型轮次失败：提供方在未产生任何输出的情况下终止了本轮。"


def _terminal_failure_detail(result: Any) -> str:
    """Detail for an engine terminal failed-turn verdict; "" when the turn succeeded.

    The engine stamps every terminal result the turn loop returns with ``failed`` /
    ``interrupted`` (``agent/turn_finalizer.py``): a provider that rejects the
    request without a retryable path (e.g. a 404 wire model) still returns a
    result dict — with an empty ``final_response`` and no usage. Reporting that
    as ``run.completed`` turned permanent model failures into silent successes
    (H10.2-DEFECT-2), so the Atlas run path treats the verdict as an error.
    """
    if not isinstance(result, dict) or not result.get("failed") or result.get("interrupted"):
        return ""
    return str(result.get("error") or "").strip() or _FAILURE_NO_DETAIL


async def _engine_turn(agent, state: _RunState) -> dict[str, Any]:
    """Run one engine turn to completion, forwarding its events to the queue."""
    request, callbacks, runtime = state.request, state.callbacks, state.runtime
    try:
        from atlas.config import DATA_ROOT
        from atlas.engine import AtlasRuntime

        volatile_prefixes = _VOLATILE_PREFIXES
        prompt_sections = [
            str(item.content) for item in state.initial_messages
            if isinstance(item, SystemMessage) and isinstance(item.content, str)
        ]
        volatile_context = [
            section for section in prompt_sections
            if section.startswith(volatile_prefixes)
        ]
        system_message = "\n\n".join(
            section for section in prompt_sections
            if not section.startswith(volatile_prefixes)
        )
        # Forked children reuse the already rendered, provider-visible static
        # scaffold byte-for-byte so the prompt cache recognizes the same prefix.
        runtime.stable_system_prefix = system_message
        engine_history = [
            {"role": item["role"], "content": item["content"]}
            for item in state.history
            if item.get("role") in {"user", "assistant", "tool"}
            and isinstance(item.get("content"), str)
        ]
        if (engine_history and engine_history[-1]["role"] == "user"
                and engine_history[-1]["content"] == state.message):
            engine_history.pop()
        engine = AtlasRuntime(
            data_dir=DATA_ROOT,
            model_manager=agent._model_mgr,
        )
        model_input = (
            agent._multimodal_content(state.message, request.image_attachments)
            if request.image_attachments else None
        )
        last_automatic_title: str | None = None
        automatic_title_candidates = {
            "", "New Conversation", "New conversation",
            state.message.strip()[:40],
        }
        final_result: dict[str, Any] = {}

        async def on_session_title(title: str, title_source: str) -> None:
            nonlocal last_automatic_title
            current = await agent._memory.get_conversation(request.conversation_id)
            current_title = str((current or {}).get("title") or "")
            accepted = bool(
                title.strip()
                and not request.worker
                and (
                    current_title in automatic_title_candidates
                    or (last_automatic_title is not None
                        and current_title == last_automatic_title)
                )
            )
            if accepted:
                await agent._memory.update_conversation_title(
                    request.conversation_id, title.strip(),
                )
                last_automatic_title = title.strip()
            title_event = {
                "type": "session.title", "title": title.strip(),
                "title_source": title_source, "accepted": accepted,
            }
            if callbacks.runtime_event_callback is not None:
            if isinstance(item, SystemMessage) and isinstance(item.content, str)
        ]
        volatile_context = [
            section for section in prompt_sections
            if section.startswith(volatile_prefixes)
        ]
        system_message = "\n\n".join(
            section for section in prompt_sections
            if not section.startswith(volatile_prefixes)
        )
        # Forked children reuse the already rendered, provider-visible static
        # scaffold byte-for-byte so the prompt cache recognizes the same prefix.
        runtime.stable_system_prefix = system_message
        engine_history = [
            {"role": item["role"], "content": item["content"]}
            for item in state.history
            if item.get("role") in {"user", "assistant", "tool"}
            and isinstance(item.get("content"), str)
        ]
        if (engine_history and engine_history[-1]["role"] == "user"
                and engine_history[-1]["content"] == state.message):
            engine_history.pop()
        engine = AtlasRuntime(
            data_dir=DATA_ROOT,
            model_manager=agent._model_mgr,
        )
        model_input = (
            agent._multimodal_content(state.message, request.image_attachments)
            if request.image_attachments else None
        )
        last_automatic_title: str | None = None
        automatic_title_candidates = {
            "", "New Conversation", "New conversation",
            state.message.strip()[:40],
        }
        final_result: dict[str, Any] = {}

        async def on_session_title(title: str, title_source: str) -> None:
            nonlocal last_automatic_title
            current = await agent._memory.get_conversation(request.conversation_id)
            current_title = str((current or {}).get("title") or "")
            accepted = bool(
                title.strip()
                and not request.worker
                and (
                    current_title in automatic_title_candidates
                    or (last_automatic_title is not None
                        and current_title == last_automatic_title)
                )
            )
            if accepted:
                await agent._memory.update_conversation_title(
                    request.conversation_id, title.strip(),
                )
                last_automatic_title = title.strip()
            title_event = {
                "type": "session.title", "title": title.strip(),
                "title_source": title_source, "accepted": accepted,
            }
            if callbacks.runtime_event_callback is not None:
                published = callbacks.runtime_event_callback(title_event)
                if inspect.isawaitable(published):
                    await published
            else:
                await runtime.event_queue.put(title_event)

        async def lifecycle_hook(event_name: str, payload: dict[str, Any]) -> dict[str, Any]:
            return await run_user_hook(callbacks.user_hook_callback, event_name, payload)

        loaded_paths = [
            str(item.get("path")) for item in request.workspace_rules or []
            if isinstance(item, dict) and item.get("path")
        ]
        if isinstance(state.context, dict):
            loaded_paths.extend(
                str(item.get("path")) for item in state.context.get(
                    "discovered_project_instructions", []
                ) if isinstance(item, dict) and item.get("path")
            )
        loaded_paths.extend(
            str(item.get("path")) for item in request.active_skill_instructions or []
            if isinstance(item, dict) and item.get("path")
        )
        instructions_hook = await lifecycle_hook("InstructionsLoaded", {
            "load_reason": "run_start", "file_paths": loaded_paths,
            "cwd": request.workspace or "", "conversation_id": request.conversation_id,
        })
        instructions_context = str(instructions_hook.get("additional_context") or "").strip()
        if instructions_context:
            volatile_context.append("InstructionsLoaded hook context:\n" + instructions_context)

        async def update_kernel_plan(value: dict[str, Any]) -> None:
            plan = TaskPlan.from_dict(value)
            persist = callbacks.plan_update_callback
            if persist is None:
                raise RuntimeError("Plan updates require the existing plan_update_callback")
            result = persist(plan.to_dict())
            if inspect.isawaitable(result):
                await result
            state.plan = plan

        async for event in engine.run_turn(
            message=state.message,
            user_content=model_input,
            conversation_id=request.conversation_id,
            source=request.source,
            workspace=request.workspace,
            history=engine_history,
            system_message=system_message,
            volatile_context=volatile_context,
            cancel_event=callbacks.cancel_event,
            input_callback=callbacks.input_callback,
            steer_queue=callbacks.steer_queue,
            atlas_agent=agent,
            atlas_context=runtime,
            reasoning_effort=request.reasoning_effort,
            max_output_tokens=agent._model_mgr.output_tokens_for_model(
                runtime.model, None, state.selected_config.get("max_output_tokens"),
            ),
            moa_enabled=runtime.moa_enabled,
            run.trust_event_id = next_event_id
            trust_env = run.next_envelope("rules.trust_required", {
                "event_id": next_event_id, "root": untrusted_roots[0],
                "roots": untrusted_roots,
                "files": [{"path": item["path"], "bytes": item["bytes"]}
                          | {"root": item["root"]} for item in run.workspace_rules
                          if item["root"] in untrusted_roots],
            })
            run.status = "waiting"
            await manager.send(conn_id, trust_env)
        else:
            await manager.send(conn_id, run.next_envelope("rules.loaded", {
                "files": [{"path": item["path"], "bytes": item["bytes"]}
                          for item in run.workspace_rules],
            }))
    # Bind the prompt to the run outside every workspace branch. It used to be set
    # only inside the ``elif workspace`` block, so any run without a workspace
    # reached ``persist_run`` below with ``user_input`` still "", and the stored
    # transcript lost the request itself (436 rows in runtime_runs, 432 of them
    # blank — every blank one was workspace-less). Bind it after the ephemeral
    # rewrite so the persisted text matches what the model actually received.
    run.user_input = content
    await manager.send(conn_id, run.next_envelope("run.context.sources", {
        "sources": [
            *[{"kind": "context_file", "path": str(path), "loaded": True} for path in context_files],
            *[{"kind": "user_file", "path": str(item.get("name") or item.get("path") or "attachment"), "loaded": True}
              for item in data.get("files", []) if isinstance(item, dict)],
            *[{"kind": "user_attachment", "path": str(item.get("name") or "attachment"), "loaded": True}
              for item in data.get("attachments", []) if isinstance(item, dict)],
            *([{"kind": "image_attachment", "path": f"{len(image_attachments)} image attachment(s)", "loaded": True}] if image_attachments else []),
            *media_sources,
            *[{"kind": "workspace_rule", "path": str(item.get("path") or ""), "bytes": item.get("bytes"), "loaded": True}
              for item in run.workspace_rules],
            *[{"kind": "referenced_conversation", "id": str(item)} for item in context_conversations],
            *[{"kind": "skill", "name": str(item.get("name") or "")}
              for item in active_skill_instructions if isinstance(item, dict) and item.get("name")],
            {"kind": "workspace", "path": str(run.workspace or "No workspace"), "loaded": bool(run.workspace)},
            {"kind": "system_prompt", "path": "Atlas runtime prompt and conversation policy", "loaded": "runtime-generated"},
            {"kind": "memory", "path": "Retrieved memory (conditional on conversation memory settings)", "loaded": "runtime-dependent"},
            {"kind": "tool_schema", "path": "Registered tools for this run", "loaded": "runtime-dependent"},
            {"kind": "tool_reads", "path": "Files read by tools appear as tool.started/tool.completed events", "loaded": True},
        ],
    }))
    manager.runs[run_id] = run
    manager.conn_runs[conn_id] = run_id
    if not run.ephemeral:
        await manager.persist_run(run)

    # MCP is an optional enrichment. Never put its process launch/handshake on
    # the first-turn critical path: a run can begin with the tools already
    # registered, or without them while background startup continues.
    startup = getattr(services, "startup", None)
    if startup is not None and "mcp" in startup.snapshot():
        if startup.state("mcp") == "failed":
            notice = run.next_envelope("run.recovery.notice", {
                "message": "MCP 启动失败，本次运行继续使用当前可用工具；可在设置→工具中检查 MCP 服务。",
            })
            await manager.send(conn_id, notice)

    # Standing orders are matching-turn guidance. They never create a scheduled
    # run; selection also writes a bounded audit receipt for each matched order.
    try:
        from atlas.standing_orders import DEFAULT_OWNER_ID, matching_orders

        standing_owner_id = agent_key or DEFAULT_OWNER_ID
        matched_orders = matching_orders(standing_owner_id, run.workspace, content)
        if matched_orders:
            active_skill_instructions = list(active_skill_instructions or [])
            active_skill_instructions.extend({
                "name": f"standing-order:{item['id']}",
                "content": "常驻指令（仅在匹配的 Agent turn 中生效）：\n" + item["instruction"],
            } for item in matched_orders)
    except Exception:
        log.exception("standing_orders.inject_failed", agent_id=agent_key or "atlas")

    # Start the run in background so we can keep receiving messages
    execute = _server()._execute_run(
            conn_id, run, content, model_id,
            plan_state=recovered_plan,
            image_attachments=image_attachments,
            active_skill_instructions=active_skill_instructions,
            workspace=run.workspace,
            workspace_rules=run.workspace_rules,
            mode=run.mode,
            manager=manager,
            resume_from=resume_from if isinstance(resume_from, str) else None,
        )
    execution = _server()._execute_after_rule_trust(run, execute) if run.trust_future else execute
    if agent_profile is not None:
        # W10: project the persistent agent's runtime status around the run
        # (working while it lives → idle/waiting_user once it settles).
        _server()._set_agent_status_quiet(agent_key, "working")
        run.task = asyncio.create_task(
            _server()._project_agent_run_status(run, agent_key, execution))
    else:
        run.task = asyncio.create_task(execution)


