884:    ) -> dict[str, Any]:
885:        path = Path(os.path.expandvars(os.path.expanduser(raw_path)))
886:        if not path.is_absolute():
887:            path = Path(cwd or Path.cwd()) / path
888:        path = path.resolve()
889:        root = path.parent
890:        while not root.exists() and root != root.parent:
891:            root = root.parent
892:        if not root.is_dir():
893:            raise ValueError("no existing workspace directory for checkpoint")
894:        relative = path.relative_to(root).as_posix()
895:        return self.checkpoints.create_checkpoint(
896:            root, [relative], run_id=run_id, conversation_id=conversation_id,
897:        )
