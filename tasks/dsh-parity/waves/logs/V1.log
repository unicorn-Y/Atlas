4:"""Turn phases and run events for the Atlas kernel.
5:
6:The phase graph follows ZCode's explicit turn machine. Codex's turn driver
7:informs the interruption and completion boundaries used by the kernel loop.
8:"""
9:
10:from __future__ import annotations
11:
12:from dataclasses import dataclass, field
13:from datetime import datetime, timezone
14:from enum import StrEnum
15:from typing import Any
16:
17:
18:class RunPhase(StrEnum):
19:    PREPARING = "preparing"
20:    AWAITING_MODEL_RESPONSE = "awaiting_model_response"
21:    STREAMING = "streaming"
22:    SCHEDULING_TOOLS = "scheduling_tools"
23:    TOOLS = "tools"
24:    WAITING_APPROVAL = "waiting_approval"
25:    AGGREGATING_RESULTS = "aggregating_results"
26:    COMPACTING = "compacting"
27:    DONE = "done"
28:    FAILED = "failed"
29:    INTERRUPTED = "interrupted"
30:
31:
32:class RunTerminalStatus(StrEnum):
33:    COMPLETED = "completed"
34:    USER_INTERRUPTED = "user_interrupted"
35:    ERROR = "error"
36:    BUDGET_EXCEEDED = "budget_exceeded"
37:
38:
39:class TurnEndReason(StrEnum):
40:    """Typed terminal reason for a user-visible kernel turn."""
41:
42:    COMPLETED = "completed"
43:    USER_INTERRUPTED = "user_interrupted"
44:    BUDGET_EXCEEDED = "budget_exceeded"
45:    FAILED = "failed"
46:
47:    @classmethod
48:    def from_terminal_status(cls, status: RunTerminalStatus) -> "TurnEndReason":
49:        if status is RunTerminalStatus.COMPLETED:
50:            return cls.COMPLETED
51:        if status is RunTerminalStatus.USER_INTERRUPTED:
52:            return cls.USER_INTERRUPTED
53:        if status is RunTerminalStatus.BUDGET_EXCEEDED:
54:            return cls.BUDGET_EXCEEDED
55:        return cls.FAILED
56:
57:
58:class StepEndReason(StrEnum):
59:    """Typed reason one model invocation stopped."""
60:
61:    RESPONSE = "response"
62:    TOOL_CALLS = "tool_calls"
63:    RETRIED = "retried"
64:    INTERRUPTED = "interrupted"
65:    FAILED = "failed"
66:
67:
68:@dataclass(slots=True)
69:class TurnLifecycle:
70:    """Track the ordered model-call steps within one user-message turn."""
71:
72:    turn_id: str
73:    step_count: int = 0
74:    active_step: int | None = None
75:    end_reason: TurnEndReason | None = None
76:
77:    def begin_step(self) -> int:
78:        if self.end_reason is not None:
79:            raise ValueError("turn has ended")
80:        if self.active_step is not None:
81:            raise ValueError("cannot begin a model step before ending the active step")
82:        self.step_count += 1
83:        self.active_step = self.step_count
84:        return self.active_step
85:
86:    def end_step(self, step: int, reason: StepEndReason) -> bool:
87:        if self.active_step != step:
88:            return False
89:        if not isinstance(reason, StepEndReason):
90:            raise TypeError("step end reason must be a StepEndReason")
91:        self.active_step = None
92:        return True
93:
94:    def end_turn(self, reason: TurnEndReason) -> bool:
95:        if self.end_reason is not None:
96:            return False
97:        if self.active_step is not None:
98:            raise ValueError("cannot end a turn while a model step is active")
99:        if not isinstance(reason, TurnEndReason):
100:            raise TypeError("turn end reason must be a TurnEndReason")
101:        self.end_reason = reason
102:        return True
103:
104:
105:@dataclass(slots=True)
106:class TurnConclusion:
107:    """Explicit final response requested by a tool in the current turn."""
108:
109:    requested: bool = False
110:    response: str = ""
111:
