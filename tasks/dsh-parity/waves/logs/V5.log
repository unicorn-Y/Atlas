148: class PluginRealm:
149:     """A read/invoke facade that confines a run to selected plugin child rows."""
150: 
151:     def __init__(self, registry: Any, plugin_rows: list[str]) -> None:
152:         self._registry = registry
153:         self._sources = {f"plugin:{name}" for name in plugin_rows if isinstance(name, str)}
154: 
155:     def discover(self) -> list[dict[str, str]]:
156:         return [row for row in self._registry.discover() if row.get("source") in self._sources]
157: 
158:     async def invoke(self, name: str, inputs: dict[str, Any] | None = None) -> Any:
159:         if not any(row["name"] == name for row in self.discover()):
160:             raise KeyError(name)
161:         return await self._registry.invoke(name, inputs)
