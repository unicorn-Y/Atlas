3261: @plugins_group.command("reload")
3262: @click.argument("name")
3263: def plugins_reload(name: str) -> None:
3264:     """重读一个插件的文件，不用重启进程。"""
3265:     import asyncio
3266: 
3267:     result = asyncio.run(_plugin_runtime().reload(name))
3268:     if not result.get("ok"):
3269:         click.echo(f"重载失败：{result.get('error')}", err=True)
3270:         raise SystemExit(1)
3271:     loaded = result.get("loaded") or {}
3272:     click.echo(
3273:         f"已重载 {name}：技能 {len(loaded.get('skills') or [])}"
3274:         f" 命令 {len(loaded.get('commands') or [])}"
3275:         f" Hook {loaded.get('hooks', 0)}"
3276:         f"；清理旧能力 {result.get('capabilities_removed', 0)} 项、"
3277:         f"旧 Hook {result.get('hooks_cleared', 0)} 个。"
3278:     )
