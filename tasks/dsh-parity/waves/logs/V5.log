120: class _DisposerStack:
121:     """Run plugin contribution cleanups once, in reverse registration order."""
122: 
123:     def __init__(self) -> None:
124:         self._items: list[Any] = []
125:         self._disposed = False
126: 
127:     def add(self, disposer: Any) -> None:
128:         if callable(disposer):
129:             self._items.append(disposer)
130: 
131:     def __len__(self) -> int:
132:         return len(self._items)
133: 
134:     async def dispose(self) -> None:
135:         if self._disposed:
136:             return
137:         self._disposed = True
138:         for disposer in reversed(self._items):
139:             try:
140:                 result = disposer()
141:                 if inspect.isawaitable(result):
142:                     await result
143:             except Exception as exc:  # noqa: BLE001 - one cleanup must not block others
144:                 log.warning("plugin.disposer_failed", error_type=type(exc).__name__)
145:         self._items.clear()
