1459: 
1460:             for server_name, server in self._mcp_configs(root, manifest).items():
1461:                 if server_name in mcp_client.get_server_names():
1462:                     loaded["mcp"].append(server_name)
1463:                     continue
1464:                 transport = str(server.get("transport", server.get("type", "stdio")))
1465:                 config = MCPServerConfig(
1466:                     name=server_name, transport=transport,
1467:                     command=server.get("command"), args=[str(arg) for arg in server.get("args", [])],
1468:                     env={str(k): str(v) for k, v in (server.get("env") or {}).items()},
1469:                     cwd=str(server.get("cwd") or root), url=server.get("url"), enabled=True,
1470:                 )
1471:                 await mcp_client._connect_server(config)
1472:                 loaded["mcp"].append(server_name)
1473:                 async def _disconnect(_name: str = server_name) -> None:
1474:                     await mcp_client.disconnect_server(_name)
1475:                 disposers.add(_disconnect)
1476:         loaded["disposer_count"] = len(disposers)
1477:         self._disposers[plugin_name] = disposers
