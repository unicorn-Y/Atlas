3223: @main.group("plugins")
3224: def plugins_group() -> None:
3225:     """查看与热重载本地插件，不需要重启后端。"""
3226: 
3227: 
3228: def _plugin_runtime():
3229:     """Build a runtime over the same roots the backend uses.
3230: 
3231:     Kept identical to ``atlas/server.py`` on purpose: a reload driven from the CLI
3232:     must see the same plugin set as the app, or "it loaded here but not there"
3233:     becomes unexplainable.
3234:     """
3235:     from atlas.config import PROJECT_ROOT, get_config
3236:     from atlas.plugins import PluginRuntime
3237: 
3238:     data_plugins = get_config().db_path.parent / "plugins"
3239:     return PluginRuntime([PROJECT_ROOT / "plugins", data_plugins], data_plugins / "state.json")
3240: 
3241: 
3242: @plugins_group.command("list")
3243: def plugins_list() -> None:
3244:     """列出发现到的插件及其组件数量。"""
3245:     items = _plugin_runtime().discover()
3246:     if not items:
3247:         click.echo("没有发现插件。")
3248:         return
3249:     click.echo(f"共 {len(items)} 个插件：")
3250:     for item in items:
3251:         state = "已启用" if item.get("enabled") else "已停用"
3252:         click.echo(
3253:             f"  {item['name']}  v{item.get('version', '?')}  {state}"
3254:             f"  技能 {len(item.get('skills') or [])}"
3255:             f"  命令 {len(item.get('commands') or [])}"
3256:             f"  Hook {item.get('hooks', 0)}"
3257:             f"  MCP {len(item.get('mcp_servers') or [])}"
3258:         )
3259: 
