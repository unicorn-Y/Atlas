1403:     async def _load_one(
1404:         self, root: Path, *, plugin_name: str, hook_bus: Any,
1405:         mcp_client: Any, capabilities: Any,
1406:     ) -> dict[str, Any]:
1407:         disposers = _DisposerStack()
1408:         loaded: dict[str, Any] = {
1409:             "skills": [], "commands": [], "hooks": 0, "mcp": [],
1410:         }
1411:         _, manifest = _manifest(root)
1412:         if capabilities is not None:
1413:             for skill in self._component_paths(root, manifest, "skills", root / "skills", directories=True):
1414:                 content = (skill / "SKILL.md").read_text(encoding="utf-8", errors="replace")
1415:                 loaded["skills"].append(skill.name)
1416:                 capability_name = f"plugin.{plugin_name}.skill.{skill.name}"
1417:                 capabilities.register(
1418:                     capability_name, description=f"Skill from plugin {plugin_name}.",
1419:                     handler=lambda _inputs, _content=content: {"content": _content}, source=f"plugin:{plugin_name}",
1420:                 )
1421:                 disposers.add(lambda _name=capability_name: capabilities.unregister(_name))
1422:             for command in self._commands(root, manifest):
1423:                 loaded["commands"].append(command["name"])
1424:                 content = command["content"]
1425:                 if content is None and command["path"]:
1426:                     content = Path(command["path"]).read_text(encoding="utf-8", errors="replace")
1427:                 capability_name = f"plugin.{plugin_name}.command.{command['name']}"
1428:                 capabilities.register(
1429:                     capability_name, description=str(command["metadata"].get("description") or f"Command prompt from plugin {plugin_name}."),
1430:                     handler=lambda _inputs, _content=content: {"prompt": _content}, source=f"plugin:{plugin_name}",
1431:                 )
1432:                 disposers.add(lambda _name=capability_name: capabilities.unregister(_name))
1433:         for spec in [*self._legacy_hook_specs(root), *self._codex_hook_specs(root)]:
1434:             point = str(spec.get("point", ""))
1435:             command = spec.get("command")
1436:             if point not in HOOK_POINTS or not isinstance(command, list) or not command:
1437:                 continue
1438:             argv = [str(arg) for arg in command]
1439:             matcher = str(spec.get("matcher") or "").strip()
1440: 
1441:             def _handler(_argv: list[str] = argv, _matcher: str = matcher,
1442:                          **payload: Any) -> None:
1443:                 if _matcher:
