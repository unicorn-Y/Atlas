1301:     async def _forget_plugin(
1302:         self, name: str, *, capabilities: Any = None, hook_bus: Any = None,
1303:     ) -> tuple[int, int]:
1304:         """Drop everything one plugin registered; returns ``(capabilities, hooks)``."""
1305:         owner = f"plugin:{name}"
1306:         loaded = self._loaded.get(name)
1307:         disposer_stack = self._disposers.pop(name, None)
1308:         disposer = disposer_stack.dispose if disposer_stack is not None else None
1309:         if callable(disposer) and isinstance(loaded, dict):
1310:             removed = len(loaded.get("skills", [])) + len(loaded.get("commands", []))
1311:             hooks_cleared = int(loaded.get("hooks", 0) or 0)
1312:             await disposer()
1313:             # Keep owner cleanup as a fail-safe for contributions registered by
1314:             # older plugin runtimes that did not provide individual disposers.
1315:             if capabilities is not None and hasattr(capabilities, "unregister_source"):
1316:                 capabilities.unregister_source(owner)
1317:             if hook_bus is not None and hasattr(hook_bus, "forget_owner"):
1318:                 hook_bus.forget_owner(owner)
1319:         else:
1320:             removed = 0
1321:             if capabilities is not None and hasattr(capabilities, "unregister_source"):
1322:                 removed = capabilities.unregister_source(owner)
1323:             hooks_cleared = 0
1324:             if hook_bus is not None and hasattr(hook_bus, "forget_owner"):
1325:                 hooks_cleared = hook_bus.forget_owner(owner)
1326:         return removed, hooks_cleared
