core/tests\test_x2_recording.py:401:    """SkillMarket over isolated discovery dirs (same env as test_skills_market)."""
    """Automation ``payload.kind=agent_turn`` → orchestrator turn in its target conversation."""
    automation_id = str(payload.get("automation_id") or "adhoc")
    conversation_id = str(payload.get("conversation_id") or f"automation-{automation_id}")
    agent_id = str(payload.get("agent_id") or "").strip()
    model = str(payload.get("model") or "").strip() or None
    reasoning_effort = str(payload.get("reasoning_effort") or "").strip() or None
    agent_preset_id = str(payload.get("agent_preset_id") or "default").strip()
    permission_preset = str(payload.get("permission_preset") or "ask").strip()
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", agent_preset_id):
        raise ValueError("payload.agent_preset_id must be a valid preset ID")
    if permission_preset not in PERMISSION_PRESETS:
        raise ValueError("payload.permission_preset must be a known permission preset")
    from atlas.task_artifacts import AgentPresetStore

    preset_store = AgentPresetStore(get_config().db_path.parent)
    capabilities = preset_store.resolve(agent_preset_id)
    if "mode" in payload:
        mode = str(payload.get("mode") or "").strip()
        if mode not in {"act", "plan"}:
            raise ValueError("payload.mode must be act or plan")
        mode_explicit = True
    else:
        mode = str(capabilities.get("mode") or "act")
        mode_explicit = False
    preset_model = str(capabilities.get("model") or "inherit").strip()
    if model is None and preset_model.lower() != "inherit":
        model = preset_model
    app = getattr(_server(), "app", None)
    services = getattr(getattr(app, "state", None), "services", None)
    agents = getattr(services, "persistent_agents", None)
    if agent_id and agents is not None:
        # Explicit automation choices win; otherwise honor the selected Agent profile.
        config = agents.resolve_agent_run_config(agent_id)
        model = model or config.get("model") or None
        reasoning_effort = reasoning_effort or config.get("reasoning_effort") or None
    preset_skills = capabilities.get("skills")
    requested_skills = payload.get("skills")
    skills = list(dict.fromkeys([
        *([str(skill) for skill in preset_skills] if isinstance(preset_skills, list) else []),
        *([str(skill) for skill in requested_skills] if isinstance(requested_skills, list) else []),
    ]))
    skill_instructions = await _server()._resolve_active_skill_instructions(skills) if skills else []
    text = await _server()._collect_orchestrator_text(
        str(payload.get("message") or ""), conversation_id,
        model=model,
        reasoning_effort=reasoning_effort,
        workspace=str(payload.get("workspace") or "") or None,
        agent_preset_id=agent_preset_id,
        permission_preset=permission_preset,
        agent_preset_capabilities=capabilities,
        mode=mode,
        mode_explicit=mode_explicit,
        active_skill_instructions=skill_instructions,
    )
    return {"text": text, "conversation_id": conversation_id}


async def _automation_deliver(record: dict[str, Any], outcome: dict[str, Any]) -> bool:
    """Automation delivery: owner → apprise, channel → gateway (§4 delivery spec)."""
    result = outcome.get("result")
    ephemeral: bool = False
    bypass_prompt_cache: bool = False
    # Host-registered content transforms applied to each tool result before the
    # model sees it. ``None`` keeps the kernel's behaviour byte-identical.
    tool_result_finalizers: Any = None
    inbox: Any = None


async def _apply_agent_preset_capabilities(agent, request: RunRequest, runtime) -> str | None:
    """Apply a resolved agent preset before any model-facing work begins."""
    capabilities = request.agent_preset_capabilities
    if capabilities is None:
        if request.agent_preset_id != "default":
            return f"Agent preset {request.agent_preset_id!r} has no resolved capabilities."
        return None
    if not isinstance(capabilities, dict):
        return "Agent preset capabilities must be an object."

    tools = capabilities.get("tools")
    if not isinstance(tools, dict) or not isinstance(tools.get("allow_all"), bool):
        return "Agent preset tool capabilities are malformed."
    allow = tools.get("allow")
    deny = tools.get("deny")
    skills = capabilities.get("skills")
    mcp_servers = capabilities.get("mcp_servers")
    mode = capabilities.get("mode")
    model = capabilities.get("model")
    if (not isinstance(allow, list) or any(not isinstance(item, str) or not item for item in allow)
            or not isinstance(deny, list) or any(not isinstance(item, str) or not item for item in deny)
            or not isinstance(skills, list) or any(not isinstance(item, str) or not item for item in skills)
            or not isinstance(mcp_servers, list)
            or any(not isinstance(item, str) or not item for item in mcp_servers)
            or mode not in {"act", "plan"} or not isinstance(model, str) or not model):
        return "Agent preset capabilities are malformed."

    if not tools["allow_all"]:
        from atlas.engine.tool_permissions import intersect_tool_allow

        request.tool_allow = intersect_tool_allow(request.tool_allow, allow)
    request.tool_deny = sorted(set(request.tool_deny or []) | set(deny))
    runtime.tool_allow = request.tool_allow
    runtime.tool_deny = request.tool_deny
    runtime.mcp_server_allow = list(dict.fromkeys(mcp_servers))

    if not request.mode_explicit:
        request.mode = mode
        runtime.mode = mode
    if not request.model and model != "inherit":
        request.model = model

    existing = {item.get("name") for item in request.active_skill_instructions or []
                if isinstance(item, dict)}
    for name in skills:
        if name in existing:
            continue
        manager = getattr(agent, "_skills", None)
        activator = getattr(manager, "activate_for_model", None)
        if not callable(activator):
            return f"Agent preset skill {name!r} cannot be activated safely."
        try:
            content = await activator(name)
        except Exception as exc:
            return f"Agent preset skill {name!r} activation failed: {exc}"
        if not isinstance(content, str) or not content.strip():
            return f"Agent preset skill {name!r} is unavailable."
        request.active_skill_instructions = [*(request.active_skill_instructions or []), {
            "name": name, "content": content,
        }]
        existing.add(name)
    return None


@dataclass
class RunCallbacks:
    """How one agent run talks back (taskbook H2.2).

    Approval, input, steering, subtask progress and event publication.
    """

    cancel_event: asyncio.Event | None = None


