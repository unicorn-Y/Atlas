1328:     async def reload(
1329:         self, name: str, *, hook_bus: Any = None, mcp_client: Any = None,
1330:         capabilities: Any = None,
1331:     ) -> dict[str, Any]:
1332:         """Re-read one plugin from disk without restarting the backend.
1333: 
1334:         Why this exists: ``load_all`` clears and reloads *everything*, so a plugin
1335:         author editing a ``SKILL.md`` had to restart the whole backend to see the
1336:         change. Reloading one plugin is the operation they actually want.
1337: 
1338:         The three things that can leak are handled explicitly:
1339: 
1340:         * capabilities — ``register`` rejects duplicates, so the plugin's entries
1341:           are removed **by source** before loading (a plugin can contribute fewer
1342:           skills after an edit, so removing the known names is not enough);
1343:         * hooks — the previous generation is cleared through
1344:           ``HookBus.forget_owner`` (handlers are tagged with the plugin name at
1345:           registration, because a reload creates new closure objects whose
1346:           ``__qualname__`` is shared by every plugin);
1347:         * MCP servers — already-connected servers are reused by ``_load_one``.
1348: 
1349:         Unchanged plugins are re-read anyway: the point is to pick up edits, and
1350:         comparing mtimes would make "I edited it but nothing happened" possible.
1351:         """
1352:         hook_bus = hook_bus if hook_bus is not None else self._wiring.get("hook_bus")
1353:         mcp_client = mcp_client if mcp_client is not None else self._wiring.get("mcp_client")
1354:         capabilities = (
1355:             capabilities if capabilities is not None else self._wiring.get("capabilities")
1356:         )
1357: 
1358:         plugin = next((item for item in self.discover() if item["name"] == name), None)
1359:         if plugin is None:
1360:             return {"ok": False, "name": name, "error": "plugin not found"}
1361: 
1362:         # ``_read_json`` is deliberately forgiving elsewhere (a corrupt manifest
1363:         # must not break discovery), but during an explicit reload a file that does
1364:         # not parse is exactly the case the user needs told about: loading it would
1365:         # produce an empty plugin and look like the edit "worked".
1366:         manifest_path, _ = _manifest(Path(plugin["path"]))
1367:         if manifest_path is not None:
1368:             try:
1369:                 json.loads(manifest_path.read_text(encoding="utf-8"))
1370:             except (OSError, UnicodeError, json.JSONDecodeError) as exc:
1371:                 return {
1372:                     "ok": False,
1373:                     "name": name,
1374:                     "error": f"清单无法解析（{manifest_path.name}）：{exc}",
1375:                 }
1376: 
1377:         removed, hooks_cleared = await self._forget_plugin(
1378:             name, capabilities=capabilities, hook_bus=hook_bus,
1379:         )
1380: 
1381:         previous = self._loaded.pop(name, None)
1382:         try:
1383:             loaded = await self._load_one(
1384:                 Path(plugin["path"]), plugin_name=name, hook_bus=hook_bus,
1385:                 mcp_client=mcp_client, capabilities=capabilities,
1386:             )
1387:         except Exception as exc:  # noqa: BLE001 - a bad edit must not kill the app
1388:             # Restore the previous entry so a broken edit leaves the runtime in the
1389:             # state it was in, rather than dropping the plugin entirely.
1390:             if previous is not None:
1391:                 self._loaded[name] = previous
1392:             return {"ok": False, "name": name, "error": f"{type(exc).__name__}: {exc}"}
1393: 
1394:         self._loaded[name] = loaded
1395:         return {
1396:             "ok": True,
1397:             "name": name,
1398:             "capabilities_removed": removed,
1399:             "hooks_cleared": hooks_cleared,
1400:             "loaded": loaded,
1401:         }
