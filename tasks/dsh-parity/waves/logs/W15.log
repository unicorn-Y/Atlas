@router.get("/api/conversations/{conversation_id}/explain")
async def explain_conversation_message(
    services: Annotated[AppServices, Depends(get_app_services)],
    conversation_id: str,
    message_id: str = Query(..., min_length=1, max_length=128),
) -> dict[str, Any]:
    """Explain a message using transcript order, tool links, compaction, rewind, and durable events."""
    memory = services.memory or _server().memory
    if memory is None:
        raise HTTPException(status_code=503, detail="Conversation store is unavailable")
    if await memory.get_conversation(conversation_id) is None:
        raise HTTPException(status_code=404, detail="Conversation not found")

    from atlas.config import DATA_ROOT
    from atlas.engine.state.atlas_state import SessionDB

    def load_causality_inputs() -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
        with SessionDB(db_path=DATA_ROOT / "engine" / "state.db") as db:
            all_messages = db.get_messages_as_conversation(
                conversation_id, include_inactive=True, include_compacted=True,
                include_row_ids=True,
            )
            display_messages = db.get_messages_as_conversation(
                conversation_id, include_compacted=True, include_row_ids=True,
            )
            model_messages = db.get_messages_as_conversation(
                conversation_id, include_row_ids=True,
            )
            events: list[dict[str, Any]] = []
            after_seq = 0
            while True:
                page = db.list_session_events(conversation_id, after_seq=after_seq, limit=10_000)
                if not page:
                    break
                events.extend(page)
                next_seq = int(page[-1]["seq"])
                if next_seq <= after_seq or len(page) < 10_000:
                    break
                after_seq = next_seq
        return all_messages, display_messages, model_messages, events

    inputs = await asyncio.to_thread(load_causality_inputs)
    explanation = _explain_message_causality(message_id, *inputs)
    if explanation is None:
        raise HTTPException(status_code=404, detail="Message not found in conversation")
    return explanation


@router.post("/api/conversations/{conversation_id}/handoff-summary")
async def create_handoff_summary(
    services: Annotated[AppServices, Depends(get_app_services)], conversation_id: str,
    model: str | None = None,
) -> dict[str, str]:
    """Summarize the complete source transcript into a structured, editable handoff draft."""
    memory = services.memory or _server().memory
    if memory is None:
        raise HTTPException(status_code=503, detail="Conversation store is unavailable")
    conversation = await memory.get_conversation(conversation_id)
    if conversation is None:
        raise HTTPException(status_code=404, detail="Conversation not found")
    model_mgr = services.model_mgr or _server().model_mgr
    if model_mgr is None or model_mgr.model_router is None:
        raise HTTPException(status_code=503, detail="No configured model is available for handoff summaries")
    from atlas.config import DATA_ROOT
    from atlas.engine.session_sync import read_session_messages

    pages: list[list[dict[str, Any]]] = []
    before_id: str | None = None
    while True:
        page = await asyncio.to_thread(read_session_messages, DATA_ROOT / "engine", conversation_id,
                                       limit=1000, before_id=before_id)
        if not page:
            break
        pages.insert(0, page)
        if len(page) < 1000:
            break
    }


@router.get("/api/conversations/{conversation_id}/log-location")
async def get_conversation_log_location(
    services: Annotated[AppServices, Depends(get_app_services)],
    conversation_id: str,
) -> dict[str, str]:
    """Return the canonical shared transcript database path for this session."""
    memory = services.memory
    if memory is None:
        from atlas import server as _atlas_server

        memory = _atlas_server.memory
    assert memory is not None
    if not await memory.get_conversation(conversation_id):
        raise HTTPException(status_code=404, detail="Conversation not found")
    from atlas.config import DATA_ROOT

    return {
        "conversation_id": conversation_id,
        "path": str(DATA_ROOT / "engine" / "state.db"),
        "storage": "shared_session_database",
    }


@router.get("/api/conversations/{conversation_id}/export")
async def export_conversation(
    services: Annotated[AppServices, Depends(get_app_services)],
    conversation_id: str,
    include_compacted: bool = Query(
        False,
        description="Include turns that in-place compaction archived (what the user still sees).",
    ),
    include_inactive: bool = Query(
        False,
        description="Include every stored row with its active/compacted flags (lossless backup shape).",
    ),
) -> dict[str, Any]:
    """Export one conversation as a re-importable JSON document.

    ``export_session`` already produces exactly this shape and
    ``import_sessions`` already consumes it; only the HTTP surface was missing,
    which left users with a share-to-HTML route and no way to get their own data
    back out in a machine-readable form. The default is the round-trippable
    projection: ``include_compacted`` is a display read that is deduped and
    ordered for humans, so importing it would turn archived turns into live
    context. Pass ``include_inactive=true`` for an explicitly lossless export.
    """
    memory = services.memory
    if memory is None:
        from atlas import server as _atlas_server

        memory = _atlas_server.memory
    assert memory is not None
    if not await memory.get_conversation(conversation_id):
        raise HTTPException(status_code=404, detail="Conversation not found")

    from atlas.config import DATA_ROOT
    from atlas.engine.session_sync import _open_db

    session_home = DATA_ROOT / "engine"
    if not (session_home / "state.db").exists():
        raise HTTPException(status_code=503, detail="Session store is not initialized")

    def _read() -> dict[str, Any] | None:
        with _open_db(session_home) as db:
            return db.export_session(
                conversation_id,
                include_compacted=include_compacted,
                include_inactive=include_inactive,
            )

    document = await asyncio.to_thread(_read)
    if not document:
        raise HTTPException(status_code=404, detail="Session transcript not found")
    document.setdefault("conversation_id", conversation_id)
    document["export_format"] = "atlas.session.v1"
    return document


@router.get("/api/conversations/{conversation_id}/branches")
async def get_conversation_branches(
    services: Annotated[AppServices, Depends(get_app_services)],
    conversation_id: str,
) -> list[dict[str, Any]]:
    memory = services.memory
    if memory is None:
        from atlas import server as _atlas_server

        memory = _atlas_server.memory
    assert memory is not None
    if await memory.get_conversation(conversation_id) is None:
        raise HTTPException(status_code=404, detail="找不到这段对话。")
    from atlas.config import DATA_ROOT
    from atlas.engine.branch_summaries import branch_summaries
    from atlas.engine.session_sync import list_branch_tree

    tree = await asyncio.to_thread(list_branch_tree, DATA_ROOT / "engine", conversation_id)
    # S2: attach per-branch summaries (cached instantly, missing ones generated
    # fire-and-forget so switching never blocks on a model call).
    summaries = {}
    with suppress(Exception):  # Branch summaries are advisory and must not break the tree.
        summaries = await branch_summaries(memory, conversation_id)
    if summaries:
        merged = []
        for node in tree:
            if isinstance(node, dict):
                summary = summaries.get(str(node.get("id") or ""))
                if summary:
                    node = {**node, "summary": summary}
            merged.append(node)
        return merged
    return tree


