diff --git a/frontend/src/renderer/shell/inspectorLayout.test.ts b/frontend/src/renderer/shell/inspectorLayout.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89026a72eea1a4687f04fe824d542c7f7914f307
--- /dev/null
+++ b/frontend/src/renderer/shell/inspectorLayout.test.ts
@@ -0,0 +1,27 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { inspectorLayoutKey, readInspectorLayout, writeInspectorLayout } from './inspectorLayout';
+
+afterEach(() => { Reflect.deleteProperty(globalThis, 'localStorage'); });
+
+describe('inspector per-session layout', () => {
+  it('stores dock, split tab, and active tab separately for each conversation', () => {
+    const values = new Map<string, string>();
+    Object.defineProperty(globalThis, 'localStorage', {
+      configurable: true,
+      value: { getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => values.set(key, value) },
+    });
+    writeInspectorLayout('chat/one', { version: 1, tab: 'files', splitTab: 'overview', floating: true });
+
+    expect(inspectorLayoutKey('chat/one')).not.toBe(inspectorLayoutKey('chat/two'));
+    expect(readInspectorLayout('chat/one')).toEqual({ version: 1, tab: 'files', splitTab: 'overview', floating: true });
+    expect(readInspectorLayout('chat/two')).toEqual({ version: 1, tab: 'artifacts', splitTab: null, floating: false });
+  });
+
+  it('recovers safely from invalid or old layout data', () => {
+    Object.defineProperty(globalThis, 'localStorage', {
+      configurable: true,
+      value: { getItem: () => '{bad json' },
+    });
+    expect(readInspectorLayout('chat/one')).toEqual({ version: 1, tab: 'artifacts', splitTab: null, floating: false });
+  });
+});
diff --git a/frontend/src/renderer/shell/inspectorLayout.ts b/frontend/src/renderer/shell/inspectorLayout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..45983785f678ec86c3f571a47477c2cd8775040f
--- /dev/null
+++ b/frontend/src/renderer/shell/inspectorLayout.ts
@@ -0,0 +1,30 @@
+export type InspectorLayout = {
+  version: 1;
+  tab: string;
+  splitTab: string | null;
+  floating: boolean;
+};
+
+const STORAGE_PREFIX = 'atlas.inspector.layout.';
+const DEFAULT_LAYOUT: InspectorLayout = { version: 1, tab: 'artifacts', splitTab: null, floating: false };
+
+export function inspectorLayoutKey(conversationId: string): string {
+  return `${STORAGE_PREFIX}${encodeURIComponent(conversationId)}`;
+}
+
+export function readInspectorLayout(conversationId: string): InspectorLayout {
+  try {
+    const value = JSON.parse(localStorage.getItem(inspectorLayoutKey(conversationId)) ?? 'null') as Partial<InspectorLayout> | null;
+    if (!value || value.version !== 1 || typeof value.tab !== 'string') return { ...DEFAULT_LAYOUT };
+    return {
+      version: 1,
+      tab: value.tab,
+      splitTab: typeof value.splitTab === 'string' ? value.splitTab : null,
+      floating: value.floating === true,
+    };
+  } catch { return { ...DEFAULT_LAYOUT }; }
+}
+
+export function writeInspectorLayout(conversationId: string, layout: InspectorLayout): void {
+  try { localStorage.setItem(inspectorLayoutKey(conversationId), JSON.stringify(layout)); } catch { /* layout storage unavailable */ }
+}
diff --git a/frontend/src/renderer/shell/inspectorTabs.test.ts b/frontend/src/renderer/shell/inspectorTabs.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..55e7d7f01f6ac9b4c5f308e944a3d40196d4a6b7
--- /dev/null
+++ b/frontend/src/renderer/shell/inspectorTabs.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from 'vitest';
+import { getInspectorTab, listInspectorTabs, registerInspectorTab } from './inspectorTabs';
+
+describe('pluggable inspector tabs', () => {
+  it('registers an extension tab and removes only its own registration', () => {
+    const first = { id: 'extension:metrics', label: 'Metrics', render: () => null };
+    const disposeFirst = registerInspectorTab(first);
+    const replacement = { ...first, label: 'Updated metrics' };
+    const disposeReplacement = registerInspectorTab(replacement);
+
+    disposeFirst();
+    expect(getInspectorTab(first.id)).toBe(replacement);
+    expect(listInspectorTabs().some((tab) => tab.id === first.id)).toBe(true);
+    disposeReplacement();
+    expect(getInspectorTab(first.id)).toBeUndefined();
+  });
+
+  it('rejects built-in IDs so extensions cannot shadow core panels', () => {
+    expect(() => registerInspectorTab({ id: 'files', label: 'Shadow', render: () => null })).toThrow('reserved');
+  });
+});
diff --git a/frontend/src/renderer/shell/inspectorTabs.ts b/frontend/src/renderer/shell/inspectorTabs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..369081230040c7f209ee11852975a666589464d4
--- /dev/null
+++ b/frontend/src/renderer/shell/inspectorTabs.ts
@@ -0,0 +1,16 @@
+import type { ReactNode } from 'react';
+
+export type InspectorTabContext = { conversationId: string; apiBaseUrl: string; connected: boolean; workspace?: string | null; onToast: (text: string) => void };
+export type InspectorTabDefinition = { id: string; label: string; wide?: boolean; render: (context: InspectorTabContext) => ReactNode };
+
+const BUILTIN_TABS = new Set(['tabs', 'overview', 'artifacts', 'activity', 'changes', 'rollout', 'android', 'files', 'treemap', 'preview', 'canvas', 'specs', 'terminal', 'browser', 'context', 'processes', 'dashboard']);
+const extensionTabs = new Map<string, InspectorTabDefinition>();
+
+export function registerInspectorTab(definition: InspectorTabDefinition): () => void {
+  if (!definition.id.trim() || BUILTIN_TABS.has(definition.id)) throw new Error(`Inspector tab id is empty or reserved: ${definition.id}`);
+  extensionTabs.set(definition.id, definition);
+  return () => { if (extensionTabs.get(definition.id) === definition) extensionTabs.delete(definition.id); };
+}
+
+export const listInspectorTabs = () => [...extensionTabs.values()];
+export const getInspectorTab = (id: string) => extensionTabs.get(id);

