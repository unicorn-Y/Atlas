new file mode 100644
index 0000000000000000000000000000000000000000..89026a72eea1a4687f04fe824d542c7f7914f307
--- /dev/null
+++ b/frontend/src/renderer/shell/inspectorLayout.test.ts
@@ -0,0 +1,27 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { inspectorLayoutKey, readInspectorLayout, writeInspectorLayout } from './inspectorLayout';
+
+afterEach(() => { Reflect.deleteProperty(globalThis, 'localStorage'); });
+
+describe('inspector per-session layout', () => {
+  it('stores dock, split tab, and active tab separately for each conversation', () => {
+    const values = new Map<string, string>();
+    Object.defineProperty(globalThis, 'localStorage', {
+      configurable: true,
+      value: { getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => values.set(key, value) },
+    });
+    writeInspectorLayout('chat/one', { version: 1, tab: 'files', splitTab: 'overview', floating: true });
+
+    expect(inspectorLayoutKey('chat/one')).not.toBe(inspectorLayoutKey('chat/two'));
+    expect(readInspectorLayout('chat/one')).toEqual({ version: 1, tab: 'files', splitTab: 'overview', floating: true });
+    expect(readInspectorLayout('chat/two')).toEqual({ version: 1, tab: 'artifacts', splitTab: null, floating: false });
+  });
+
+  it('recovers safely from invalid or old layout data', () => {
+    Object.defineProperty(globalThis, 'localStorage', {
+      configurable: true,
+      value: { getItem: () => '{bad json' },
+    });
+    expect(readInspectorLayout('chat/one')).toEqual({ version: 1, tab: 'artifacts', splitTab: null, floating: false });
+  });
+});
diff --git a/frontend/src/renderer/shell/inspectorLayout.ts b/frontend/src/renderer/shell/inspectorLayout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..45983785f678ec86c3f571a47477c2cd8775040f
--- /dev/null
+++ b/frontend/src/renderer/shell/inspectorLayout.ts
@@ -0,0 +1,30 @@
+export type InspectorLayout = {
+  version: 1;
+  tab: string;
+  splitTab: string | null;
+  floating: boolean;
+};
+
+const STORAGE_PREFIX = 'atlas.inspector.layout.';
+const DEFAULT_LAYOUT: InspectorLayout = { version: 1, tab: 'artifacts', splitTab: null, floating: false };
+
+export function inspectorLayoutKey(conversationId: string): string {
+  return `${STORAGE_PREFIX}${encodeURIComponent(conversationId)}`;
+}
+
+export function readInspectorLayout(conversationId: string): InspectorLayout {
+  try {
+    const value = JSON.parse(localStorage.getItem(inspectorLayoutKey(conversationId)) ?? 'null') as Partial<InspectorLayout> | null;
+    if (!value || value.version !== 1 || typeof value.tab !== 'string') return { ...DEFAULT_LAYOUT };
+    return {
+      version: 1,
+      tab: value.tab,
+      splitTab: typeof value.splitTab === 'string' ? value.splitTab : null,
+      floating: value.floating === true,
+    };
+  } catch { return { ...DEFAULT_LAYOUT }; }
+}
+
+export function writeInspectorLayout(conversationId: string, layout: InspectorLayout): void {
+  try { localStorage.setItem(inspectorLayoutKey(conversationId), JSON.stringify(layout)); } catch { /* layout storage unavailable */ }
+}
