"""Provider catalog — 16 家服务商的端点与接入元数据（C5 契约 §2）。

每条记录的字段：
- id: catalog id（settings/providers/<pid>、前端网格均用此 id）
- label: 中文展示名（UI 文案）
- atlas_provider: hermes 引擎的 provider id（B3 接线时传给 AIAgent(provider=...)）
- api_mode: "openai"（OpenAI 兼容 chat completions）或 "anthropic_messages"（Anthropic 原生）
- default_base_url: 国内主站默认端点；hermes profile 默认若为海外端点，由 Atlas 传 base_url 覆盖
- docs_url: 2026-10 查证的官方文档链接
- notes: 端点/思考参数说明

端点与思考参数字段已于 2026-10-02 逐家对照当月官方文档核实（链接见各条 docs_url）。
无 hermes profile 的服务商（siliconflow / volcengine-ark / openai）在 hermes 中按
通用 openai-compat 兜底（providers.get_provider_profile 对未注册名返回 None → 通用路径）。
"""

from __future__ import annotations

# 端点/思考参数查证日期：2026-10-02。
PROVIDERS: list[dict] = [
    {
        "id": "openai",
        "label": "OpenAI",
        "atlas_provider": "openai",
        "api_mode": "openai",
        "default_base_url": "https://api.openai.com/v1",
        "docs_url": "https://platform.openai.com/docs/api-reference",
        # 思考参数：chat completions reasoning_effort；Responses API reasoning.effort。
        # hermes 无 "openai" 插件 profile，走内置默认路径（Atlas 现网关行为同源）。
        "notes": "chat completions 用 reasoning_effort；Responses API 用 reasoning.effort。查证 2026-10-02。",
    },
    {
        "id": "anthropic",
        "label": "Anthropic Claude",
        "atlas_provider": "anthropic",
        "api_mode": "anthropic_messages",
        "default_base_url": "https://api.anthropic.com",
        "docs_url": "https://docs.anthropic.com/en/docs/about-claude/models",
        # 思考参数：thinking: {type: "enabled"|"disabled", budget_tokens: int}（Messages API）。
        "notes": "Anthropic 原生 Messages 协议；thinking: {type, budget_tokens}。查证 2026-10-02。",
    },
    {
        "id": "google",
        "label": "Google Gemini",
        "atlas_provider": "google",
        "api_mode": "openai",
        "default_base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "docs_url": "https://ai.google.dev/gemini-api/docs/models",
        # 思考参数：OpenAI 兼容层 extra_body.google.thinking_config（thinkingConfig 蛇形映射）。
        # hermes gemini profile 注册名 "gemini"、"google" 是其别名；默认端点用官方 OpenAI 兼容层。
            return {"available": False, "reason": "missing_credentials", "message": credential_error}
        return {"available": True, "reason": None, "message": None}

    def allowed_sdk_betas(self, values: Any) -> list[str]:
        """Filter caller supplied SDK beta flags through the 1M-only allowlist."""
        if isinstance(values, str):
            values = [values]
        if not isinstance(values, (list, tuple, set, frozenset)):
            return []
        allowed = []
        for value in values:
            beta = str(value).strip()
            if beta in _ALLOWED_SDK_BETAS and beta not in allowed:
                allowed.append(beta)
            elif beta:
                log.warning("model_manager.sdk_beta_ignored", beta=beta)
        return allowed

    def supports_context_1m(self, model_id: str) -> bool:
        """Require explicit model metadata before enabling the 1M beta."""
        model = self._find_model(model_id)
        if model is None:
            return False
        provider = _catalog.resolve_catalog_id(str(model.get("atlas_provider") or model.get("provider") or ""))
        if provider != "anthropic":
            return False
        capabilities = self._model_capabilities(model) or {}
        context_window = capabilities.get("context_window")
        return isinstance(context_window, int) and not isinstance(context_window, bool) and context_window >= 1_000_000

    def context_window_for_model(self, model_id: str, sdk_betas: Any = None) -> int | None:
        """Resolve the runtime model's context window, including eligible 1M beta."""
        model = self._find_model(model_id)
        if model is None:
            return None
        capabilities = self._model_capabilities(model) or {}
        window = capabilities.get("context_window")
        if not isinstance(window, int) or isinstance(window, bool) or window <= 0:
            # A routed model can be selected through a generic OpenAI-compatible
            # entry while another configured entry carries its provider metadata.
            # Reuse capability data only for an identical wire model.
            wire_model = str(model.get("litellm_model") or "")
            native_model = self._native_model_id(model)
            if wire_model or native_model:
                for candidate in self._models:
                    if candidate is model:
                        continue
                    same_wire = wire_model and str(candidate.get("litellm_model") or "") == wire_model
                    same_native = native_model and self._native_model_id(candidate) == native_model
                    if not (same_wire or same_native):
                        continue
