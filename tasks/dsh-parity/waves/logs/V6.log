import json,re
from pathlib import Path
candidates=[Path(r'D:/Atlas/data/user-settings.json'),Path(r'D:/Atlas/.worktrees/dsh2-V6/data/user-settings.json')]
src=next((p for p in candidates if p.exists()),None)
if src is None:
 print('USER_SETTINGS_SOURCE=missing')
 raise SystemExit(0)
data=json.loads(src.read_text(encoding='utf-8'))
def clean(value):
 if isinstance(value,dict):
  return {k:clean(v) for k,v in value.items() if not re.search(r'(api.?key|secret|token|password|authorization)',k,re.I)}
 if isinstance(value,list): return [clean(v) for v in value]
 return value
safe=clean(data)
root=Path(r'C:/Users/25011/AppData/Local/Temp/atlas-dsh-v6-live-8836')
(root/'data').mkdir(parents=True,exist_ok=True)
(root/'data/user-settings.json').write_text(json.dumps(safe,ensure_ascii=False,indent=2),encoding='utf-8')
print('USER_SETTINGS_SOURCE=',str(src))
print('selected_model=',safe.get('selected_model'))
print('gateway_base_url=',safe.get('gateway_base_url'))
print('api_key_fields_copied=',any(re.search(r'(api.?key|secret|token|password|authorization)',k,re.I) for k in safe))
