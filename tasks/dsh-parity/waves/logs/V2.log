_LSP_WRITE_TOOLS = {"write_file", "patch"}
_LSP_SKIP = object()  # sentinel: the LSP write seam did not apply to this call

_ALIASES = {
    "read_file": ("local_file", "read"),
    "write_file": ("local_file", "write"),
