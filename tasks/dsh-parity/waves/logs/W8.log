from __future__ import annotations

import asyncio
import math
import os
import re
import time
from collections.abc import Awaitable, Callable
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

DEFAULT_BASH_TIMEOUT_MS = 120_000
DEFAULT_BASH_MAX_TIMEOUT_MS = 600_000
DEFAULT_MAX_OUTPUT_BYTES = 1024 * 1024
OUTPUT_METADATA_RESERVE_BYTES = 512
MAX_CONCURRENT_TERMINALS = 64
MAX_BACKGROUND_JOBS_PER_OWNER = 10
JOB_OUTPUT_RING_BYTES = 256 * 1024
SETTLED_JOB_OUTPUT_BYTES = 16 * 1024

# Hook subprocess budgets are separate from interactive Bash budgets. Keep the
# policy here so command-execution callers can share the same timeout rules.
DEFAULT_HOOK_TIMEOUT_MS = 600_000
DEFAULT_SESSION_END_HOOK_TIMEOUT_MS = 1_500
DEFAULT_ASYNC_HOOK_TIMEOUT_MS = 15_000
DEFAULT_AGENT_HOOK_TIMEOUT_MS = 60_000
DEFAULT_HTTP_HOOK_TIMEOUT_MS = 600_000
DEFAULT_PROMPT_HOOK_TIMEOUT_MS = 30_000


def hook_timeout_ms(
    requested: Any = None, *, event: str = "", kind: str = "command",
    environ: Any = None,
) -> int:
    """Return a bounded, positive timeout for one hook execution.

    Hook config timeouts are expressed in seconds. SessionEnd has its own
    environment-overridable shutdown budget; the other runtime categories
    match the reference defaults for command, async, agent, HTTP and prompt
    hooks. ``environ`` is injectable to keep policy checks deterministic.
    """
    environment = os.environ if environ is None else environ
    if event == "SessionEnd":
        try:
            value = int(environment.get(
                "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS",
                DEFAULT_SESSION_END_HOOK_TIMEOUT_MS,
            ))
        except (TypeError, ValueError):
            value = DEFAULT_SESSION_END_HOOK_TIMEOUT_MS
        cap = value if value > 0 else DEFAULT_SESSION_END_HOOK_TIMEOUT_MS
        if requested is None or requested == 0 or isinstance(requested, bool):
            return cap
        try:
            seconds = float(requested)
        except (TypeError, ValueError):
            return cap
        if not math.isfinite(seconds) or seconds <= 0:
            return cap
        return min(cap, max(1, int(seconds * 1000)))
    defaults = {
        "command": DEFAULT_HOOK_TIMEOUT_MS,
        "async": DEFAULT_ASYNC_HOOK_TIMEOUT_MS,
        "agent": DEFAULT_AGENT_HOOK_TIMEOUT_MS,
        "http": DEFAULT_HTTP_HOOK_TIMEOUT_MS,
        "prompt": DEFAULT_PROMPT_HOOK_TIMEOUT_MS,
    }
    default = defaults.get(kind, DEFAULT_HOOK_TIMEOUT_MS)
    if requested is None or requested == 0:
        return default
    if isinstance(requested, bool):
        return default
    try:
        seconds = float(requested)
    except (TypeError, ValueError):
        return default
    if not math.isfinite(seconds) or seconds <= 0:
        return default
    return max(1, int(seconds * 1000))


class HeadTailBuffer:
    """Codex stable 50% prefix and rolling 50% suffix, measured in bytes."""
    def __init__(self, max_bytes: int = DEFAULT_MAX_OUTPUT_BYTES) -> None:
        self.max_bytes = max(0, int(max_bytes))
        self.head = bytearray()
        self.tail = bytearray()
        self.omitted_bytes = 0
        self.total_bytes = 0

    def push_chunk(self, chunk: bytes) -> None:
        self.total_bytes += len(chunk)
        take = min(len(chunk), self.max_bytes // 2 - len(self.head))
        self.head.extend(chunk[:take])
        self.tail.extend(chunk[take:])
        excess = max(0, len(self.tail) - (self.max_bytes - self.max_bytes // 2))
        if excess:
            del self.tail[:excess]
            self.omitted_bytes += excess

    def text(self) -> str:
        marker = f"\n... {self.omitted_bytes} bytes omitted ...\n".encode() if self.omitted_bytes else b""
        return _decode_output(bytes(self.head)) + marker.decode() + _decode_output(bytes(self.tail))


class JobOutputRing:
    """Byte-bounded output ring for background job retrieval."""

    def __init__(self, max_bytes: int = JOB_OUTPUT_RING_BYTES) -> None:
        self.max_bytes = max(0, int(max_bytes))
        self.data = bytearray()
        self.total_bytes = 0
        self.omitted_bytes = 0

    def append(self, chunk: bytes) -> None:
        self.total_bytes += len(chunk)
        self.data.extend(chunk)
        excess = max(0, len(self.data) - self.max_bytes)
        if excess:
            del self.data[:excess]
            self.omitted_bytes += excess

    def settle(self) -> None:
        self.max_bytes = min(self.max_bytes, SETTLED_JOB_OUTPUT_BYTES)
        excess = max(0, len(self.data) - self.max_bytes)
        if excess:
            del self.data[:excess]
            self.omitted_bytes += excess

    def read(self, offset: int = 0, limit: int = JOB_OUTPUT_RING_BYTES) -> tuple[bytes, int, int]:
        start = self.total_bytes - len(self.data)
        requested = max(0, int(offset))
        bounded_limit = max(0, min(int(limit), JOB_OUTPUT_RING_BYTES))
        effective = max(requested, start)
        local_start = min(len(self.data), effective - start)
        local_end = min(len(self.data), local_start + bounded_limit)
        return bytes(self.data[local_start:local_end]), effective, start


@dataclass(slots=True)
class RegisteredJob:
    job_id: str
    owner_id: str
    label: str
    kind: str
    output: JobOutputRing = field(default_factory=JobOutputRing)
    state: str = "running"
    kill_callback: Callable[[], Any] | None = None
    refresh_callback: Callable[[], Any] | None = None
    last_output: str = ""
    started: float = field(default_factory=time.monotonic)


def _decode_output(raw: bytes) -> str:
    """Prefer UTF-8, then a detected local CLI encoding, then lossy UTF-8."""
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        pass
    try:
        from charset_normalizer import from_bytes

        match = from_bytes(raw).best()
        if match is not None and match.encoding:
            encoding = match.encoding
            if encoding.casefold().replace("-", "") in {"ibm866", "cp866"}:
                punctuation = {0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x99}
                if all(byte < 0x80 or byte in punctuation for byte in raw):
                    encoding = "cp1252"
            return raw.decode(encoding, errors="replace")
    except (ImportError, LookupError, ValueError):
        pass
    return raw.decode("utf-8", errors="replace")


def command_timeout(command: str, requested: Any = None) -> float:
    def positive_env(name: str, default: int) -> int:
        try:
            match = re.match(r"\s*([+-]?\d+)", os.environ.get(name, ""))
            value = int(match.group(1)) if match else 0
            return value if value > 0 else default
        except (TypeError, ValueError):
            return default
    default_ms = positive_env("BASH_DEFAULT_TIMEOUT_MS", DEFAULT_BASH_TIMEOUT_MS)
    max_ms = max(default_ms, positive_env("BASH_MAX_TIMEOUT_MS", DEFAULT_BASH_MAX_TIMEOUT_MS))
    # Atlas local-process APIs express timeouts in seconds; ZCode's equivalent
    # Bash request uses milliseconds. A zero request follows its `timeout ||`
    # defaulting rule.
    if isinstance(requested, bool):
        raise ValueError("timeout must be positive seconds")
    if requested is None:
        requested = default_ms / 1000
    seconds = float(requested)
    if not math.isfinite(seconds) or seconds < 0:
        raise ValueError("timeout must be positive seconds")
    if seconds == 0:
        seconds = default_ms / 1000
    return min(seconds, max_ms / 1000)


@dataclass(slots=True)
class ExecHandle:
    execution_id: str
    output_path: Path
    buffer: HeadTailBuffer
    job_output: JobOutputRing
    timeout: float | None
    shell: str = "Shell: none (direct argv)"
    yield_time_ms: int = 2_000
    detached: bool = False
    started: float = field(default_factory=time.monotonic)
    offsets: dict[str, int] = field(default_factory=lambda: {"stdout": 0, "stderr": 0})
    outcome: str = "running"
    timed_out: bool = False
    exit_code: int | None = None
    watcher: asyncio.Task[Any] | None = None
    interaction_lock: asyncio.Lock = field(default_factory=asyncio.Lock)
    output_file_bytes: int = 0
    output_file_truncated: bool = False
    output_file_marker_written: bool = False


class ExecManager:
    PROGRESS_AFTER_SECONDS = 2.0
    AUTO_BACKGROUND_AFTER_SECONDS = 15.0
    MAX_OUTPUT_FILE_BYTES = 5 * 1024 * 1024 * 1024
    OUTPUT_FILE_MARKER = b"\n... full output file truncated: disk limit reached ...\n"

    def __init__(self, dispatch: Callable[[str, dict[str, Any]], Awaitable[dict[str, Any]]],
                 *, output_dir: str | Path, run_id: str | None = None,
                 max_output_bytes: int = DEFAULT_MAX_OUTPUT_BYTES, local_runtime: Any = None,
                 event_queue: asyncio.Queue[Any] | None = None) -> None:
        self.dispatch = dispatch
        self.output_dir = Path(output_dir)
        self.run_id = run_id
        self.max_output_bytes = max_output_bytes
        self.local_runtime = local_runtime
        self.event_queue = event_queue
        self.handles: dict[str, ExecHandle] = {}
        self.registered_jobs: dict[str, RegisteredJob] = {}

    def _owner_matches(self, owner_id: str | None) -> bool:
        return owner_id is None or str(owner_id) == str(self.run_id or "")

    def _background_count(self, *, excluding: str | None = None) -> int:
        local = sum(
            handle.outcome == "running" and handle.detached and handle.execution_id != excluding
            for handle in self.handles.values()
        )
        external = sum(job.state == "running" for job in self.registered_jobs.values())
        return local + external

    def register_background_job(
        self, job_id: str, *, label: str = "background job", kind: str = "subagent",
        owner_id: str | None = None, kill: Callable[[], Any] | None = None,
        refresh: Callable[[], Any] | None = None,
    ) -> RegisteredJob:
        """Register an external background producer under this run's owner fence."""
        owner = str(self.run_id or "")
        if owner_id is not None and str(owner_id) != owner:
            raise PermissionError("job_owner_mismatch")
        identifier = str(job_id or "").strip()
        if not identifier:
            raise ValueError("job_id must not be empty")
        if identifier in self.handles or identifier in self.registered_jobs:
            raise ValueError("job_id is already registered")
        for existing in self.registered_jobs.values():
            self._refresh_registered_job(existing)
        if self._background_count() >= MAX_BACKGROUND_JOBS_PER_OWNER:
            raise ValueError("maximum of 10 background jobs per owner")
        job = RegisteredJob(
            identifier, owner, str(label), str(kind),
            kill_callback=kill, refresh_callback=refresh,
        )
        self.registered_jobs[identifier] = job
        return job

    def ensure_background_capacity(self) -> None:
        if self._background_count() >= MAX_BACKGROUND_JOBS_PER_OWNER:
            raise ValueError("maximum of 10 background jobs per owner")

    def _refresh_registered_job(self, job: RegisteredJob) -> None:
        if job.refresh_callback is None or job.state != "running":
            return
        try:
            snapshot = job.refresh_callback()
        except Exception:
            return
        if not isinstance(snapshot, dict):
            return
        state = str(snapshot.get("status") or job.state).lower()
        terminal_state = {
            "done": "completed", "complete": "completed", "completed": "completed",
            "failed": "failed", "error": "failed", "cancelled": "cancelled",
            "canceled": "cancelled", "timed_out": "timed_out",
        }.get(state)
        current_output = str(snapshot.get("result") or snapshot.get("progress") or "")
        if current_output and current_output != job.last_output:
            delta = current_output[len(job.last_output):] if current_output.startswith(job.last_output) else current_output
            job.output.append(delta.encode("utf-8"))
            job.last_output = current_output
        if terminal_state is not None:
            job.state = terminal_state
            job.output.settle()

    def append_job_output(self, job_id: str, chunk: bytes | str, *, owner_id: str | None = None) -> None:
        if not self._owner_matches(owner_id):
            raise PermissionError("job_owner_mismatch")
        job = self.registered_jobs.get(str(job_id))
        if job is None or job.state != "running":
            raise KeyError("unknown_or_settled_job")
        data = chunk.encode("utf-8") if isinstance(chunk, str) else bytes(chunk)
        job.output.append(data)

    def settle_background_job(
        self, job_id: str, *, state: str = "completed", owner_id: str | None = None,
    ) -> None:
        if not self._owner_matches(owner_id):
            raise PermissionError("job_owner_mismatch")
        job = self.registered_jobs.get(str(job_id))
        if job is None:
            raise KeyError("unknown_job")
        if state not in {"completed", "failed", "cancelled", "timed_out"}:
            raise ValueError("invalid terminal job state")
        job.state = state
        job.output.settle()

    def job_list(self, *, owner_id: str | None = None) -> list[dict[str, Any]] | dict[str, str]:
        if not self._owner_matches(owner_id):
            return {"error": "job_owner_mismatch"}
        for job in self.registered_jobs.values():
            self._refresh_registered_job(job)
        jobs = [{
            "job_id": handle.execution_id, "owner_id": str(self.run_id or ""),
            "label": handle.shell, "kind": "terminal", "state": handle.outcome,
            "detached": handle.detached,
        } for handle in self.handles.values()]
        jobs.extend({
            "job_id": job.job_id, "owner_id": job.owner_id,
            "label": job.label, "kind": job.kind, "state": job.state,
            "detached": True,
        } for job in self.registered_jobs.values())
        return jobs

    async def job_output(
        self, job_id: str, *, owner_id: str | None = None, offset: int = 0,
        limit: int = JOB_OUTPUT_RING_BYTES,
    ) -> dict[str, Any]:
        if not self._owner_matches(owner_id):
            return {"error": "job_owner_mismatch", "is_error": True}
        identifier = str(job_id or "")
        handle = self.handles.get(identifier)
        if handle is not None:
            result = await self.poll(identifier)
            if result.get("is_error"):
                return result
            chunk, effective, ring_start = handle.job_output.read(offset, limit)
            return {"job_id": identifier, "state": handle.outcome,
                    "output": _decode_output(chunk), "offset": effective,
                    "next_offset": effective + len(chunk), "omitted_bytes": max(
                        handle.job_output.omitted_bytes, ring_start),
                    "is_error": False}
        job = self.registered_jobs.get(identifier)
        if job is None:
            return {"error": "unknown_job", "is_error": True}
        self._refresh_registered_job(job)
        chunk, effective, ring_start = job.output.read(offset, limit)
        return {"job_id": identifier, "state": job.state,
                "output": _decode_output(chunk), "offset": effective,
                "next_offset": effective + len(chunk),
                "omitted_bytes": max(job.output.omitted_bytes, ring_start),
                "is_error": False}

    async def job_kill(self, job_id: str, *, owner_id: str | None = None) -> dict[str, Any]:
        if not self._owner_matches(owner_id):
            return {"error": "job_owner_mismatch", "is_error": True}
        identifier = str(job_id or "")
        if identifier in self.handles:
            return await self.kill(identifier)
        job = self.registered_jobs.get(identifier)
        if job is None:
            return {"error": "unknown_job", "is_error": True}
        if job.state != "running":
            return {"job_id": identifier, "state": job.state, "is_error": False}
        if job.kill_callback is None:
            return {"error": "job_kill_unavailable", "is_error": True}
        try:
            result = job.kill_callback()
            if hasattr(result, "__await__"):
                result = await result
        except Exception as exc:
            return {"error": str(exc), "is_error": True}
        state = str(result.get("state") if isinstance(result, dict) else "cancelled")
        self.settle_background_job(identifier, state=state)
        return {"job_id": identifier, "state": state, "is_error": False}

    def _output_budget(self, value: Any) -> int:
        if value is None:
            requested = self.max_output_bytes
        elif isinstance(value, bool):
            raise ValueError("max_output_bytes must be a positive integer")
        else:
            try:
                requested = int(value)
            except (TypeError, ValueError, OverflowError) as exc:
                raise ValueError("max_output_bytes must be a positive integer") from exc
            if requested <= 0 or (isinstance(value, float) and not value.is_integer()):
                raise ValueError("max_output_bytes must be a positive integer")
        # Reserve space for state, exit status, and the truncation explanation.
        return min(requested, self.max_output_bytes) - OUTPUT_METADATA_RESERVE_BYTES

    @staticmethod
    def _yield_window(value: Any) -> int:
        if value is None:
            return 15_000
        if isinstance(value, bool):
            return 15_000
        try:
            requested = int(value)
        except (TypeError, ValueError, OverflowError):
            return 15_000
        return max(250, min(requested, 30_000))

    async def start(self, arguments: dict[str, Any]) -> dict[str, Any]:
        args = dict(arguments)
        try:
            output_budget = self._output_budget(args.pop("max_output_bytes", None))
        except ValueError as exc:
            return {"is_error": True, "error": str(exc)}
        if output_budget < 1:
            return {"is_error": True, "error": "max_output_bytes must exceed the output metadata reserve."}
        yield_time_ms = self._yield_window(args.get("yield_time_ms"))
        if sum(handle.outcome == "running" for handle in self.handles.values()) >= MAX_CONCURRENT_TERMINALS:
            return {"is_error": True, "error": f"Atlas already has {MAX_CONCURRENT_TERMINALS} active terminal sessions."}
        direct_process_start = args.get("action") == "start"
        if args.get("background"):
            args["detached"] = True
        args.pop("background", None)
        command = str(args.get("command") or args.get("cmd") or args.get("executable") or "")
        # A resumable start returns a process handle; its default yield/poll
        # window is not a lifetime timeout. Keep an explicitly requested Atlas
        # timeout for compatibility, while detached starts have no implicit cap.
        has_explicit_timeout = args.get("timeout") is not None
        timeout = (
            command_timeout(command, args.get("timeout"))
            if has_explicit_timeout or not (direct_process_start or args.get("detached"))
            else None
        )
        args["action"] = "start"
        args.setdefault("detached", True if direct_process_start else False)
        args.setdefault("keep_stdin", True)
        if args.get("detached") and self._background_count() >= MAX_BACKGROUND_JOBS_PER_OWNER:
            return {"is_error": True,
                    "error": f"Atlas allows a maximum of {MAX_BACKGROUND_JOBS_PER_OWNER} background jobs per owner."}
        if "cmd" in args:
            args["command"] = args.pop("cmd")
        if "workdir" in args:
            args["cwd"] = args.pop("workdir")
        if not str(args.get("cwd") or "").strip():
            try:
                from atlas.engine.kernel.toolkit.runtime_cwd import resolve_agent_cwd

                cwd = resolve_agent_cwd().expanduser().resolve()
                home = Path.home().resolve()
                if cwd == home:
                    return {
                        "is_error": True,
                        "error": (
                            f"No project or workspace is selected. Atlas's current working directory is {cwd}, "
                            "which is the user home directory; select a workspace or provide an explicit cwd "
                            "before running a relative command."
                        ),
                    }
                if not cwd.is_dir():
                    return {"is_error": True, "error": f"Atlas current working directory does not exist: {cwd}"}
                args["cwd"] = str(cwd)
            except ImportError:
                cwd = Path.cwd().resolve()
                if cwd == Path.home().resolve():
                    return {
                        "is_error": True,
                        "error": f"No project or workspace is selected; refusing implicit home cwd {cwd}.",
                    }
                args["cwd"] = str(cwd)
        if "command" in args:
            args.setdefault("shell", "auto")
        result = await self.dispatch("local_process", args)
        if result.get("is_error"):
            return result
        data = result.get("data") or {}
        execution_id = str(data.get("execution_id") or "")
        if not execution_id:
            return {"is_error": True, "error": "Executor returned no process handle", "outcome": "unknown"}
        # Do not let externally supplied handle strings escape the output root.
        safe_id = re.sub(r"[^a-zA-Z0-9_-]", "_", execution_id)
        self.output_dir.mkdir(parents=True, exist_ok=True)
        path = self.output_dir / f"{safe_id}.log"
        path.touch(exist_ok=False)
        shell_label = str(data.get("shell") or "")
        if "command" in args and not shell_label:
            from atlas.tools.local_execution import _shell_identity

            shell_name, shell_path = _shell_identity(str(args.get("shell") or "auto"))
            shell_label = f"Shell: {shell_name} ({shell_path})"
        elif not shell_label:
            shell_label = "Shell: none (direct argv)"
        handle = ExecHandle(
            execution_id, path, HeadTailBuffer(output_budget), JobOutputRing(), timeout,
            shell=shell_label,
            yield_time_ms=yield_time_ms,
            detached=bool(args.get("detached")),
        )
        self.handles[execution_id] = handle
        handle.watcher = asyncio.create_task(self._watch(handle))
        return await self.poll(execution_id)

    async def _capture(self, handle: ExecHandle) -> None:
        # Native logs are complete; read every chunk, never only native result tail.
        # Prefer original bytes over the model-facing text API: UTF-8 characters
        # can cross its 64KiB chunk boundary. This reads only already-authorized
        # process output, not workspace files or a second execution route.
        record = getattr(self.local_runtime, "_processes", {}).get(handle.execution_id)
        if record is not None:
            for stream in ("stdout", "stderr"):
                path = getattr(record, f"{stream}_path")
                with path.open("rb") as source:
                    source.seek(handle.offsets[stream])
                    while chunk := source.read(65536):
                        self._append_output_file(handle, chunk)
                        handle.buffer.push_chunk(chunk)
                        handle.job_output.append(chunk)
                        handle.offsets[stream] += len(chunk)
            return
        for stream in ("stdout", "stderr"):
            while True:
                result = await self.dispatch("local_process", {
                    "action": "read", "execution_id": handle.execution_id,
                    "stream": stream, "offset": handle.offsets[stream], "limit": 65536,
                })
                if result.get("is_error"):
                    raise RuntimeError(str(result.get("error") or result))
                data = result.get("data") or {}
                next_offset = int(data.get("next_offset", handle.offsets[stream]))
                if next_offset <= handle.offsets[stream]:
                    break
                chunk = str(data.get("text") or "").encode("utf-8")
                self._append_output_file(handle, chunk)
                handle.buffer.push_chunk(chunk)
                handle.job_output.append(chunk)
                handle.offsets[stream] = next_offset
                if data.get("complete"):
                    break

    def _append_output_file(self, handle: ExecHandle, chunk: bytes) -> None:
        remaining = max(0, self.MAX_OUTPUT_FILE_BYTES - handle.output_file_bytes)
        stored = chunk[:remaining]
        if stored:
            with handle.output_path.open("ab") as output:
                output.write(stored)
            handle.output_file_bytes += len(stored)
        if len(stored) < len(chunk):
            handle.output_file_truncated = True
            marker_room = self.MAX_OUTPUT_FILE_BYTES - handle.output_file_bytes
            if marker_room and not handle.output_file_marker_written:
                marker = self.OUTPUT_FILE_MARKER[:marker_room]
                with handle.output_path.open("ab") as output:
                    output.write(marker)
                handle.output_file_bytes += len(marker)
                handle.output_file_marker_written = True

    def _result(self, handle: ExecHandle) -> dict[str, Any]:
        native = getattr(self.local_runtime, "_processes", {}).get(handle.execution_id)
        disk_dropped = int(getattr(native, "output_bytes_dropped", 0)) if native else 0
        native_truncated = bool(getattr(native, "output_truncated", False)) if native else False
        cancel_note = str(getattr(native, "cancel_note", "")) if native else ""
        data = {"execution_id": handle.execution_id, "state": handle.outcome,
                "shell": handle.shell,
                "outcome": handle.outcome, "exit_code": handle.exit_code,
                "timed_out": handle.timed_out, "output": handle.buffer.text(),
                "output_bytes": handle.buffer.total_bytes,
                "output_omitted_bytes": handle.buffer.omitted_bytes,
                "output_truncated": bool(handle.buffer.omitted_bytes) or native_truncated,
                "output_bytes_dropped": disk_dropped,
                "output_file_truncated": handle.output_file_truncated,
                "timeout_seconds": handle.timeout if handle.timed_out else None,
                "backgrounded": handle.detached,
                "output_ref": str(handle.output_path.resolve()),
                "duration_seconds": round(time.monotonic() - handle.started, 3)}
        status = (f"Process timed out after {handle.timeout:g}s" if handle.timed_out and handle.timeout is not None
                  else f"Process {handle.execution_id} ({handle.outcome})")
        truncation = (
            f"\nOutput storage capped; {disk_dropped} bytes could not be kept."
            if disk_dropped else ""
        )
        cancellation = f"\n{cancel_note}" if cancel_note else ""
        return {"data": data, "outcome": handle.outcome,
                "output_ref": data["output_ref"], "is_error": handle.outcome in {"failed", "unknown"},
                "content": [{"type": "text", "text": f"{handle.shell}\n{data['output']}\nFull output: {data['output_ref']}\n{status}{truncation}{cancellation}"}]}

    async def poll(self, execution_id: str) -> dict[str, Any]:
        handle = self.handles[execution_id]
        async with handle.interaction_lock:
            return await self._poll_locked(handle)

    async def _poll_locked(self, handle: ExecHandle) -> dict[str, Any]:
        result = await self.dispatch("local_process", {
            "action": "status", "execution_id": handle.execution_id,
        })
        if result.get("is_error"):
            return result
        await self._capture(handle)
        data = result.get("data") or {}
        if data.get("exit_code") is not None:
            handle.exit_code = data.get("exit_code")
        if data.get("timed_out"):
            handle.timed_out = True
        if handle.outcome == "running" and data.get("state") != "running":
            if handle.timed_out:
                handle.outcome = "timed_out"
                handle.exit_code = 124
            elif data.get("state") == "cancelled":
                handle.outcome = "cancelled"
            elif data.get("state") == "failed":
                handle.outcome = "failed"
            else:
                handle.outcome = "completed" if handle.exit_code == 0 else "failed"
            handle.job_output.settle()
        return self._result(handle)

    async def _watch(self, handle: ExecHandle) -> None:
        try:
            while handle.outcome == "running":
                await self.poll(handle.execution_id)
                if handle.outcome != "running":
                    break
                if handle.timeout is not None and time.monotonic() - handle.started >= handle.timeout:
                    handle.timed_out = True
                    await self._timeout(handle)
                    break
                await asyncio.sleep(0.2)
        except asyncio.CancelledError:
            raise
        except Exception:
            if handle.outcome == "running":
                handle.outcome = "unknown"
            # A failed output/poll watcher must not leave an untracked child alive.
            try:
                await self.dispatch("local_process", {"action": "cancel", "execution_id": handle.execution_id})
            except Exception:
                pass

    async def write_stdin(self, execution_id: str, data: str) -> dict[str, Any]:
        handle = self.handles[execution_id]
        async with handle.interaction_lock:
            result = await self.dispatch("local_process", {
                "action": "write_stdin", "execution_id": execution_id, "data": data,
            })
            if result.get("is_error"):
                # The process can exit between the caller's last poll and this
                # write. Preserve its final output/status when that race occurs.
                status = await self.dispatch("local_process", {
                    "action": "status", "execution_id": execution_id,
                })
                if status.get("is_error") or (status.get("data") or {}).get("state") == "running":
                    return result
            return await self._poll_locked(handle)

    async def _timeout(self, handle: ExecHandle) -> dict[str, Any]:
        async with handle.interaction_lock:
            if handle.outcome != "running":
                return self._result(handle)
            result = await self.dispatch("local_process", {
                "action": "cancel", "execution_id": handle.execution_id,
            })
            if result.get("is_error"):
                handle.outcome = "unknown"
                return result
            handle.timed_out = True
            handle.outcome = "timed_out"
            await self._poll_locked(handle)
            # Match Codex's timeout exit status even when the native backend
            # reports a platform-specific signal/termination code.
            handle.exit_code = 124
            return self._result(handle)

    async def kill(self, execution_id: str) -> dict[str, Any]:
        handle = self.handles[execution_id]
        async with handle.interaction_lock:
            if handle.outcome != "running":
                return self._result(handle)
            result = await self.dispatch("local_process", {
                "action": "cancel", "execution_id": execution_id,
            })
            if result.get("is_error"):
                handle.outcome = "unknown"
                return result
            await self._poll_locked(handle)
            if handle.outcome == "running":
                handle.outcome = "cancelled"
            return self._result(handle)

    async def execute(self, name: str, arguments: dict[str, Any]) -> dict[str, Any]:
        args = dict(arguments)
        if name == "job_list":
            jobs = self.job_list(owner_id=args.get("owner_id"))
            if isinstance(jobs, dict):
                return {**jobs, "is_error": True}
            return {"data": {"jobs": jobs}, "content": str(jobs), "is_error": False}
        if name == "job_output":
            result = await self.job_output(
                str(args.get("job_id") or args.get("execution_id") or ""),
                owner_id=args.get("owner_id"), offset=args.get("offset", 0),
                limit=args.get("limit", JOB_OUTPUT_RING_BYTES),
            )
            result["content"] = result.get("output", result.get("error", ""))
            return result
        if name == "job_kill":
            return await self.job_kill(
                str(args.get("job_id") or args.get("execution_id") or ""),
                owner_id=args.get("owner_id"),
            )
        if name == "local_process" and args.get("action") == "start":
            return await self.start(args)
        if name in {"terminal", "local_shell", "local_exec", "exec_command"}:
            result = await self.start(args)
            if result.get("is_error"):
                return result
            execution_id = result["data"]["execution_id"]
            if args.get("background") or args.get("detached"):
                return result
            try:
                watcher = self.handles[execution_id].watcher
                handle = self.handles[execution_id]
                progress_window = min(self.PROGRESS_AFTER_SECONDS, handle.yield_time_ms / 1000)
                done, _ = await asyncio.wait({watcher}, timeout=progress_window)
                if not done and self.event_queue is not None:
                    await self.event_queue.put({
                        "type": "process.progress", "execution_id": execution_id,
                        "elapsed_seconds": round(time.monotonic() - self.handles[execution_id].started, 1),
                    })
                if not done:
                    done, _ = await asyncio.wait(
                        {watcher}, timeout=max(0.0, min(
                            self.AUTO_BACKGROUND_AFTER_SECONDS - progress_window,
                            handle.yield_time_ms / 1000 - progress_window,
                        )),
                    )
                if not done:
                    handle = self.handles[execution_id]
                    handle.detached = True
                    if self.event_queue is not None:
                        await self.event_queue.put({
                            "type": "process.backgrounded", "execution_id": execution_id,
                            "threshold_seconds": round(time.monotonic() - handle.started, 1),
                        })
                    return await self.poll(execution_id)
                await asyncio.shield(watcher)
            except asyncio.CancelledError:
                handle = self.handles[execution_id]
                if not handle.detached:
                    await self.kill(execution_id)
                raise
            return await self.poll(execution_id)
        execution_id = str(args.get("execution_id") or args.get("session_id") or "")
        action = args.get("action", "poll")
        if name == "local_process" and action == "list":
            jobs = self.job_list(owner_id=args.get("owner_id"))
            if isinstance(jobs, dict):
                return {**jobs, "is_error": True}
            return {"data": {"processes": jobs, "jobs": jobs}, "is_error": False}
        if name == "local_process" and execution_id not in self.handles:
            if execution_id in self.registered_jobs:
                if action in {"read", "log", "output"}:
                    result = await self.job_output(
                        execution_id, owner_id=args.get("owner_id"),
                        offset=args.get("offset", 0), limit=args.get("limit", JOB_OUTPUT_RING_BYTES),
                    )
                    result["data"] = {**result}
                    result["data"]["text"] = result.get("output", "")
                    return result
                if action in {"kill", "cancel", "stop"}:
                    return await self.job_kill(execution_id, owner_id=args.get("owner_id"))
            return await self.dispatch(name, args)
        if action in {"poll", "status"}:
            return await self.poll(execution_id)
        if action in {"write", "write_stdin"}:
            return await self.write_stdin(execution_id, str(args.get("data") or args.get("chars") or ""))
        if action in {"kill", "cancel"}:
            return await self.kill(execution_id)
        if action in {"read", "log"}:
            native_action = "read" if action == "log" else action
            handle = self.handles.get(execution_id)
            if handle is None:
                return await self.dispatch("local_process", {**args, "action": native_action})
            async with handle.interaction_lock:
                result = await self.dispatch("local_process", {**args, "action": native_action})
                if result.get("is_error"):
                    return result
                await self._capture(handle)
                data = result.get("data")
                if isinstance(data, dict):
                    data.setdefault("output_ref", str(handle.output_path.resolve()))
            return result
        if action == "wait":
            return await self.dispatch("local_process", {**args, "action": action})
        return await self.dispatch("local_process", args)

    async def shutdown(self) -> None:
        for handle in self.handles.values():
            if handle.outcome == "running":
                await self.kill(handle.execution_id)
            if handle.watcher is not None:
                handle.watcher.cancel()
        for job in self.registered_jobs.values():
            if job.state == "running" and job.kill_callback is not None:
                await self.job_kill(job.job_id)
        await asyncio.gather(*(
            h.watcher for h in self.handles.values()
            if h.watcher is not None
        ), return_exceptions=True)

