async def _apply_agent_preset_capabilities(agent, request: RunRequest, runtime) -> str | None:
    """Apply a resolved agent preset before any model-facing work begins."""
    capabilities = request.agent_preset_capabilities
    if capabilities is None:
        if request.agent_preset_id != "default":
            return f"Agent preset {request.agent_preset_id!r} has no resolved capabilities."
        return None
    if not isinstance(capabilities, dict):
        return "Agent preset capabilities must be an object."

    tools = capabilities.get("tools")
    if not isinstance(tools, dict) or not isinstance(tools.get("allow_all"), bool):
        return "Agent preset tool capabilities are malformed."
    allow = tools.get("allow")
    deny = tools.get("deny")
    skills = capabilities.get("skills")
    mcp_servers = capabilities.get("mcp_servers")
    mode = capabilities.get("mode")
    model = capabilities.get("model")
    if (not isinstance(allow, list) or any(not isinstance(item, str) or not item for item in allow)
            or not isinstance(deny, list) or any(not isinstance(item, str) or not item for item in deny)
            or not isinstance(skills, list) or any(not isinstance(item, str) or not item for item in skills)
            or not isinstance(mcp_servers, list)
            or any(not isinstance(item, str) or not item for item in mcp_servers)
            or mode not in {"act", "plan"} or not isinstance(model, str) or not model):
        return "Agent preset capabilities are malformed."

    if not tools["allow_all"]:
        from atlas.engine.tool_permissions import intersect_tool_allow

        request.tool_allow = intersect_tool_allow(request.tool_allow, allow)
    request.tool_deny = sorted(set(request.tool_deny or []) | set(deny))
    runtime.tool_allow = request.tool_allow
    runtime.tool_deny = request.tool_deny
    runtime.mcp_server_allow = list(dict.fromkeys(mcp_servers))

    if not request.mode_explicit:
        request.mode = mode
        runtime.mode = mode
    if not request.model and model != "inherit":
        request.model = model

    existing = {item.get("name") for item in request.active_skill_instructions or []
                if isinstance(item, dict)}
    for name in skills:
        if name in existing:
            continue
        manager = getattr(agent, "_skills", None)
        activator = getattr(manager, "activate_for_model", None)
        if not callable(activator):
            return f"Agent preset skill {name!r} cannot be activated safely."
        try:
            content = await activator(name)
        except Exception as exc:
            return f"Agent preset skill {name!r} activation failed: {exc}"
        if not isinstance(content, str) or not content.strip():
            return f"Agent preset skill {name!r} is unavailable."
        request.active_skill_instructions = [*(request.active_skill_instructions or []), {
            "name": name, "content": content,
        }]
        existing.add(name)
    return None


@dataclass
class RunCallbacks:
    """How one agent run talks back (taskbook H2.2).

    Approval, input, steering, subtask progress and event publication.
    """

    cancel_event: asyncio.Event | None = None
"""Provider-neutral agent capability registration and invocation."""

from __future__ import annotations

import inspect
from collections.abc import Callable
from dataclasses import dataclass
from typing import Any

CapabilityHandler = Callable[[dict[str, Any]], Any]


@dataclass(frozen=True)
class AgentCapability:
    """A discoverable capability and its independent invocation handler."""

    name: str
    description: str
    handler: CapabilityHandler
    source: str = "agent"

    def to_dict(self) -> dict[str, str]:
        return {
            "name": self.name,
            "description": self.description,
            "source": self.source,
        }


class AgentCapabilityRegistry:
    """Store capabilities separately from the agent's model execution."""

    def __init__(self) -> None:
        self._capabilities: dict[str, AgentCapability] = {}

    def register(
        self,
        name: str,
        *,
        description: str,
        handler: CapabilityHandler,
        source: str = "agent",
    ) -> None:
        if name in self._capabilities:
            raise ValueError(f"Capability already registered: {name}")
        self._capabilities[name] = AgentCapability(
            name=name,
            description=description,
            handler=handler,
            source=source,
        )

    def unregister(self, name: str) -> bool:
        """Drop one capability. Returns whether it existed.

        Needed for reload: :meth:`register` refuses a duplicate name, so a plugin
        that is reloaded must clear its old entries first. Returning a bool rather
        than raising keeps "unload something already gone" an ordinary outcome.
        """
        return self._capabilities.pop(name, None) is not None

    def unregister_source(self, source: str) -> int:
        """Drop every capability from one source, e.g. ``plugin:foo``.

        A plugin can change how many skills/commands it contributes between
        reloads, so removing by source is the only way to guarantee no stale entry
        survives when the list gets shorter.
        """
        stale = [
            name for name, capability in self._capabilities.items()
            if capability.source == source
        ]
        for name in stale:
            del self._capabilities[name]
        return len(stale)

    def sources(self) -> dict[str, int]:
        """Capability count per source, for reload diagnostics."""
        counts: dict[str, int] = {}
        for capability in self._capabilities.values():
            counts[capability.source] = counts.get(capability.source, 0) + 1
        return counts

    def discover(self) -> list[dict[str, str]]:
        return [
            capability.to_dict()
            for capability in sorted(self._capabilities.values(), key=lambda item: item.name)
        ]

    async def invoke(self, name: str, inputs: dict[str, Any] | None = None) -> Any:
        capability = self._capabilities.get(name)
        if capability is None:
            raise KeyError(name)
        result = capability.handler(inputs or {})
        if inspect.isawaitable(result):
            return await result
        return result


def register_skill_capabilities(
    registry: AgentCapabilityRegistry, skill_manager: Any, skill_registry: Any | None = None,
    mcp_client: Any | None = None,
) -> None:
    """Expose each indexed skill as an agent capability that activates it."""
    for skill in skill_manager.list_skills():
        skill_name = skill.name

        async def activate(_inputs: dict[str, Any], name: str = skill_name) -> str | None:
            if skill_registry is not None:
                info = skill_manager.get_skill(name)
                record = skill_registry.get(name, info.version) if info is not None else None
                lifecycle = (record or {}).get("lifecycle", {})
                if lifecycle.get("trust_state") in {"revoked", "blocked"} or lifecycle.get(
                    "state"
                ) in {"quarantined", "removed"}:
                    raise PermissionError("skill lifecycle policy blocks activation")
            connected = mcp_client.get_server_names() if mcp_client is not None else None
            configured = (
                mcp_client.get_configured_server_names() if mcp_client is not None else None
            )
            if hasattr(skill_manager, "preflight_dependencies"):
                dependencies = skill_manager.preflight_dependencies(
                    name, connected_servers=connected, configured_servers=configured,
                    registry=skill_registry,
                )
            else:
                dependencies = []
            blockers = [item for item in dependencies if item["state"] != "satisfied"]
            if blockers:
                detail = ", ".join(
                    f"{item['kind']}:{item['name']} ({item['state']})" for item in blockers
                )
                raise PermissionError("skill dependencies block activation: " + detail)
            if hasattr(skill_manager, "preflight_dependencies"):
                return await skill_manager.activate(
                    name, connected_servers=connected, configured_servers=configured,
                    registry=skill_registry,
                )
            return await skill_manager.activate(name)

        registry.register(
            f"skill.{skill_name}",
            description=skill.description,
            handler=activate,
            source="skill",
        )



def register_skill_dependency_capability(
"""Small file-backed stores used by reusable Agent task configuration."""

from __future__ import annotations

import re
import json
import tomllib
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


def _stamp() -> str:
    return datetime.now(UTC).isoformat()


def _toml_value(value: Any) -> str:
    if value is None:
        raise TypeError("TOML does not support null values")
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(_toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{key} = {_toml_value(item)}" for key, item in value.items()) + " }"
    raise TypeError(f"unsupported TOML value: {type(value).__name__}")


def encode_toml(value: dict[str, Any]) -> str:
    lines: list[str] = []
    scalar_items = [(key, item) for key, item in value.items()
                    if item is not None and not isinstance(item, dict)
                    and not (isinstance(item, list) and item and all(isinstance(row, dict) for row in item))]
    table_items = [(key, item) for key, item in value.items() if isinstance(item, dict)]
    array_table_items = [(key, item) for key, item in value.items()
                         if isinstance(item, list) and item and all(isinstance(row, dict) for row in item)]
    for key, item in scalar_items:
        lines.append(f"{key} = {_toml_value(item)}")
    for key, item in table_items:
        if item is None:
            continue
        if isinstance(item, dict):
            lines.append(f"[{key}]")
            lines.extend(f"{name} = {_toml_value(child)}" for name, child in item.items() if child is not None)
        lines.append("")
    for key, rows in array_table_items:
        for row in rows:
            lines.append(f"[[{key}]]")
            lines.extend(f"{name} = {_toml_value(child)}" for name, child in row.items() if child is not None)
            lines.append("")
    return "\n".join(lines)


class TomlRecordStore:
    def __init__(self, root: Path, kind: str) -> None:
        self.root = root / kind

    def list(self) -> list[dict[str, Any]]:
        self.root.mkdir(parents=True, exist_ok=True)
        return [tomllib.loads(path.read_text(encoding="utf-8")) for path in sorted(self.root.glob("*.toml"))]

    def get(self, record_id: str) -> dict[str, Any] | None:
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", record_id):
            return None
        path = self.root / f"{record_id}.toml"
        if not path.is_file():
            return None
        return tomllib.loads(path.read_text(encoding="utf-8"))

    def put(self, value: dict[str, Any]) -> dict[str, Any]:
        self.root.mkdir(parents=True, exist_ok=True)
        record_id = str(value.get("id") or uuid.uuid4())
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", record_id):
            raise ValueError("id must contain only letters, numbers, '_' or '-'")
        now = _stamp()
        record = {**value, "id": record_id, "created_at": value.get("created_at") or now, "updated_at": now}
        (self.root / f"{record_id}.toml").write_text(encode_toml(record), encoding="utf-8")
        return record

    def delete(self, record_id: str) -> bool:
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", record_id):
            return False
        path = self.root / f"{record_id}.toml"
        if not path.is_file():
            return False
        path.unlink()
        return True


DEFAULT_PROFILES = [
    {"id": "default", "name": "默认", "description": "Atlas 默认行为", "instructions": "", "active_skills": [], "tools": {"allow": None, "deny": []}, "mode": "act"},
    {"id": "architect", "name": "架构师", "description": "只读规划与设计", "instructions": "设计方案并说明取舍，不要修改文件。", "active_skills": [], "tools": {"allow": ["local_file", "coding.repo_map", "coding.ast_grep.run"], "deny": []}, "mode": "plan"},
    {"id": "reviewer", "name": "审查员", "description": "只读代码审查", "instructions": "检查代码的正确性、回归风险和安全问题，不要修改文件。", "active_skills": [], "tools": {"allow": ["local_file", "coding.repo_map", "coding.ast_grep.run"], "deny": []}, "mode": "act"},
]


def seed_profiles(store: TomlRecordStore) -> None:
    legacy_text = {
        "default": {
            "name": "Default", "description": "Atlas default behavior",
            "instructions": "",
        },
        "architect": {
            "name": "Architect", "description": "Read-only planning and design",
            "instructions": "Design a solution and explain tradeoffs. Do not modify files.",
        },
        "reviewer": {
            "name": "Reviewer", "description": "Read-only code review",
            "instructions": "Review code for correctness, regressions, and security issues. Do not modify files.",
        },
    }
    for profile in DEFAULT_PROFILES:
        existing = store.get(profile["id"])
        if existing is None:
            store.put(profile)
        elif all(existing.get(key) == value for key, value in legacy_text[profile["id"]].items()):
            store.put({**existing, **{
                key: profile[key] for key in ("name", "description", "instructions")
            }})


