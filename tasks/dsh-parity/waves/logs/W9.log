+    assert first["loaded"] == ["demo"]
+    assert client.connected == ["demo-mcp"]
+
+    second = await runtime.load_all(mcp_client=client)
+    assert second["loaded"] == ["demo"]
+    assert client.connected == ["demo-mcp"]
+
