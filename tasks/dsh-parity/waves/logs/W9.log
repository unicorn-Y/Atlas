"""Plugin patch layers: keep local edits across an install or upgrade.

The problem this solves
-----------------------
``PluginRuntime._copy_replace`` replaces an installed plugin directory wholesale.
That is correct for a deploy snapshot and catastrophic for a user who fixed one
line in a plugin's ``SKILL.md``: the next ``install``/upgrade silently deletes the
edit, and nothing tells them. ``reload`` re-reads from disk, so it cannot help —
the file is already gone.

The model: three copies, one truth per question
-----------------------------------------------
Every patched file has up to three versions on disk under ``<plugin>/patches/``::

    patches/files/<rel>       what the user wants        (the patch)
    patches/.originals/<rel>  what upstream shipped       (for revert)
    <plugin>/<rel>            what readers actually load  (materialised)

The shipped path is *materialised* — the patch is copied over it — rather than
resolved at read time. That is deliberate: every existing reader (skill registry,
command discovery, hook specs, MCP configs) keeps doing ``root / relative`` and
therefore needs no change at all. A read-time overlay would have required
touching each of them, and any one missed would make a patch look like it did
nothing.

``.originals`` is what makes ``revert`` real. Without it, "undo my edit" is
impossible once the file has been overwritten.

Upgrade behaviour
-----------------
:func:`carry_over` runs before ``_copy_replace`` swaps the directory. It copies
``patches/`` out, and :func:`reapply` runs after the new files land, re-copying
each patch over the freshly shipped version. An upgrade therefore keeps the
user's edits instead of asking them to redo the work. Overrides whose shipped
file no longer exists are reported, not dropped silently.

Security boundary
-----------------
A patch path arrives from an HTTP body, so it is untrusted: ``..`` escapes,
absolute paths, the ``.git`` internals and executables are all refused. A patch
layer that could rewrite ``.git/config`` or drop a ``.exe`` would be a
code-execution vector hiding inside a "text override" feature.
"""

from __future__ import annotations

import json
import shutil
from pathlib import Path
from typing import Any

PATCH_DIRNAME = "patches"
FILES_DIRNAME = "files"
ORIGINALS_DIRNAME = ".originals"
MANIFEST_NAME = "manifest.json"

#: Refused by suffix: the patch layer changes text, it does not deliver binaries.
_DENIED_SUFFIXES = {".exe", ".dll", ".so", ".dylib", ".bat", ".cmd", ".ps1", ".scr", ".msi"}
#: Refused by name: repository internals and the manifest itself.
_DENIED_NAMES = {".git", ".gitignore", ".gitmodules", MANIFEST_NAME}


class PatchError(ValueError):
    """A patch request that must be refused, with a user-readable reason."""

    def __init__(self, message: str, *, code: str = "invalid_patch") -> None:
        super().__init__(message)
        self.message = message
        self.code = code


def _patch_root(plugin_root: str | Path) -> Path:
    return Path(plugin_root) / PATCH_DIRNAME


def _safe_relative(value: str) -> Path:
    """Reject absolute paths and ``..`` escapes before anything touches disk."""
    raw = str(value or "").replace("\\", "/").strip()
    if not raw or raw.startswith("/") or (len(raw) > 1 and raw[1] == ":"):
        raise PatchError(f"补丁路径必须相对于插件根目录：{value!r}")
    relative = Path(raw)
    if any(part == ".." for part in relative.parts):
        raise PatchError(f"补丁路径不能包含 '..'：{value!r}")
    if relative.parts[0] in _DENIED_NAMES or relative.name in _DENIED_NAMES:
        raise PatchError(f"{relative.name} 不能通过补丁层修改", code="denied_path")
    if relative.suffix.lower() in _DENIED_SUFFIXES:
        raise PatchError(
            f"补丁层只改文本，拒绝写入可执行文件 {relative.name}", code="denied_path",
        )
    if relative.parts[0] == PATCH_DIRNAME:
            "tools": {"allow": [], "allow_all": True, "deny": []}, "skills": [], "mcp_servers": [],
            "model": "inherit", "mode": "act",
        },
    },
]


class AgentPresetStore(TomlRecordStore):
    """Revisioned agent capability sets, stored independently from permission policy."""

    def __init__(self, root: Path) -> None:
        super().__init__(root, "agent-presets")

    @staticmethod
    def _names(value: Any, label: str) -> list[str]:
        if not isinstance(value, list) or any(not isinstance(item, str) or not item.strip() for item in value):
            raise ValueError(f"{label} must be a list of non-empty strings")
        return list(dict.fromkeys(item.strip() for item in value))

    @classmethod
    def _capabilities(cls, value: Any) -> dict[str, Any]:
        raw = value if isinstance(value, dict) else {}
        tools = raw.get("tools") if isinstance(raw.get("tools"), dict) else {}
        allow = tools.get("allow")
        allow_all = bool(tools.get("allow_all", allow is None))
        if allow_all:
            allow = None
        if allow is not None:
            allow = cls._names(allow, "tools.allow")
        deny = cls._names(tools.get("deny", []), "tools.deny")
        skills = cls._names(raw.get("skills", []), "skills")
        mcp_servers = cls._names(raw.get("mcp_servers", []), "mcp_servers")
        model = str(raw.get("model") or "inherit")
        mode = str(raw.get("mode") or "act")
        if mode not in {"act", "plan"}:
            raise ValueError("mode must be act or plan")
        return {
            "tools": {"allow": allow or [], "allow_all": allow_all, "deny": deny}, "skills": skills,
            "mcp_servers": mcp_servers, "model": model, "mode": mode,
        }

    def put(self, value: dict[str, Any]) -> dict[str, Any]:
        preset_id = str(value.get("id") or "")
        current = self.get(preset_id) if preset_id else None
        try:
            revision = max(0, int((current or {}).get("revision", 0))) + 1
        except (TypeError, ValueError):
            revision = 1
        record = {
            **value,
            "name": str(value.get("name") or preset_id),
            "description": str(value.get("description") or ""),
            "capabilities": self._capabilities(value.get("capabilities")),
            "revision": revision,
        }
        return super().put(record)

    def seed(self) -> None:
        for preset in DEFAULT_AGENT_PRESETS:
            if self.get(preset["id"]) is None:
                self.put(preset)

    def resolve(self, preset_id: str) -> dict[str, Any]:
        """Return a preset's normalized capability set; never silently fall back."""
        self.seed()
        record = self.get(str(preset_id or ""))
        if record is None:
            raise KeyError(f"unknown agent preset: {preset_id}")
        return self._capabilities(record.get("capabilities"))


class WorktreeService:
    def __init__(self, base_dir: Path) -> None:
        self.base_dir = base_dir

    @staticmethod
    def _git(root: Path, *args: str) -> str:
        import subprocess
        result = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, encoding="utf-8", errors="replace")
        if result.returncode:
            raise ValueError(result.stderr.strip() or "git command failed")
        return result.stdout.strip()

    def create(self, workspace: Path, conversation_id: str, base_branch: str | None = None, name: str | None = None) -> dict[str, str]:
        if not (workspace / ".git").exists():
            raise ValueError("workspace is not a git repository")
        short_id = conversation_id.replace("-", "")[:8]
        suffix = re.sub(r"[^a-z0-9-]", "-", str(name or "").lower())[:24].strip("-")
        branch = f"atlas/{short_id}-{suffix}" if suffix else f"atlas/{short_id}"
        repo_name = workspace.name
        path = workspace.parent / ".atlas-worktrees" / repo_name / short_id
        base = base_branch or self._git(workspace, "branch", "--show-current")
        if not base:
            base = "HEAD"
        path.parent.mkdir(parents=True, exist_ok=True)
    ephemeral: bool = False
    bypass_prompt_cache: bool = False
    # Host-registered content transforms applied to each tool result before the
    # model sees it. ``None`` keeps the kernel's behaviour byte-identical.
    tool_result_finalizers: Any = None
    inbox: Any = None


async def _apply_agent_preset_capabilities(agent, request: RunRequest, runtime) -> str | None:
    """Apply a resolved agent preset before any model-facing work begins."""
    capabilities = request.agent_preset_capabilities
    if capabilities is None:
        if request.agent_preset_id != "default":
            return f"Agent preset {request.agent_preset_id!r} has no resolved capabilities."
        return None
    if not isinstance(capabilities, dict):
        return "Agent preset capabilities must be an object."

    tools = capabilities.get("tools")
    if not isinstance(tools, dict) or not isinstance(tools.get("allow_all"), bool):
        return "Agent preset tool capabilities are malformed."
    allow = tools.get("allow")
    deny = tools.get("deny")
    skills = capabilities.get("skills")
    mcp_servers = capabilities.get("mcp_servers")
    mode = capabilities.get("mode")
    model = capabilities.get("model")
    if (not isinstance(allow, list) or any(not isinstance(item, str) or not item for item in allow)
            or not isinstance(deny, list) or any(not isinstance(item, str) or not item for item in deny)
            or not isinstance(skills, list) or any(not isinstance(item, str) or not item for item in skills)
            or not isinstance(mcp_servers, list)
            or any(not isinstance(item, str) or not item for item in mcp_servers)
            or mode not in {"act", "plan"} or not isinstance(model, str) or not model):
        return "Agent preset capabilities are malformed."

    if not tools["allow_all"]:
        from atlas.engine.tool_permissions import intersect_tool_allow

        request.tool_allow = intersect_tool_allow(request.tool_allow, allow)
    request.tool_deny = sorted(set(request.tool_deny or []) | set(deny))
    runtime.tool_allow = request.tool_allow
    runtime.tool_deny = request.tool_deny
    runtime.mcp_server_allow = list(dict.fromkeys(mcp_servers))

    if not request.mode_explicit:
        request.mode = mode
        runtime.mode = mode
    if not request.model and model != "inherit":
        request.model = model

    existing = {item.get("name") for item in request.active_skill_instructions or []
                if isinstance(item, dict)}
    for name in skills:
        if name in existing:
            continue
        manager = getattr(agent, "_skills", None)
        activator = getattr(manager, "activate_for_model", None)
        if not callable(activator):
            return f"Agent preset skill {name!r} cannot be activated safely."
        try:
            content = await activator(name)
        except Exception as exc:
            return f"Agent preset skill {name!r} activation failed: {exc}"
        if not isinstance(content, str) or not content.strip():
            return f"Agent preset skill {name!r} is unavailable."
        request.active_skill_instructions = [*(request.active_skill_instructions or []), {
            "name": name, "content": content,
        }]
        existing.add(name)
    return None


