            message["metadata"] = metadata if isinstance(metadata, dict) else {}
            messages.append(message)
        return messages

    # ----- Messages -----

    async def save_message(
        self,
        conversation_id: str,
        role: str,
        content: str,
        metadata: dict[str, Any] | None = None,
    ) -> str:
        assert self._db is not None

        # Auto-create conversation if it doesn't exist
        cursor = await self._db.execute(
            "SELECT id FROM conversations WHERE id = ?",
            (conversation_id,),
        )
        if not await cursor.fetchone():
            # Use first ~30 chars of content as title
            title = content[:30].strip() + ("..." if len(content) > 30 else "")
            await self._db.execute(
                "INSERT INTO conversations (id, title) VALUES (?, ?)",
                (conversation_id, title),
            )

        msg_id = str(uuid.uuid4())
        await self._db.execute(
            "INSERT INTO messages (id, conversation_id, role, content, metadata) "
            "VALUES (?, ?, ?, ?, ?)",
            (msg_id, conversation_id, role, content, json.dumps(metadata or {})),
        )

        # Update conversation timestamp
        await self._db.execute(
            "UPDATE conversations SET updated_at = datetime('now') WHERE id = ?",
            (conversation_id,),
        )

        await self._db.commit()
        return msg_id

    async def save_message_first(
        self, conversation_id: str, role: str, content: str,
        metadata: dict[str, Any] | None = None,
    ) -> str:
        """Insert a message before the current transcript, used for fork summaries."""
        assert self._db is not None
        msg_id = str(uuid.uuid4())
        await self._db.execute(
            "INSERT INTO messages (id, conversation_id, role, content, metadata, created_at) "
            "VALUES (?, ?, ?, ?, ?, '0001-01-01T00:00:00+00:00')",
            (msg_id, conversation_id, role, content, json.dumps(metadata or {})),
        )
        await self._db.execute(
            "UPDATE conversations SET updated_at=datetime('now') WHERE id=?",
            (conversation_id,),
        )
        await self._db.commit()
        return msg_id

    async def save_branch_summary(
        self, parent_id: str, child_id: str, fork_message_id: str, content: str,
    ) -> str:
        """Upsert one structured branch summary immediately after its fork-point message."""
        assert self._db is not None
        messages = await self.get_conversation_messages(parent_id, limit=100000)
        anchor = next((item for item in messages if item["id"] == fork_message_id), None)
        if anchor is None:
            raise ValueError("branch fork point is missing from the parent transcript")
        metadata = {"kind": "branch_summary", "child_conversation_id": child_id,
                    "fork_message_id": fork_message_id}
        existing = next((item for item in messages
                         if item.get("metadata", {}).get("kind") == "branch_summary"
                         and item.get("metadata", {}).get("child_conversation_id") == child_id), None)
        if existing:
            await self._db.execute("UPDATE messages SET content=?,metadata=? WHERE id=?",
                                   (content, json.dumps(metadata), existing["id"]))
            msg_id = str(existing["id"])
        else:
            msg_id = str(uuid.uuid4())
            await self._db.execute(
                "INSERT INTO messages (id, conversation_id, role, content, metadata, created_at) VALUES (?,?,?,?,?,?)",
                (msg_id, parent_id, "assistant", content, json.dumps(metadata), anchor["created_at"]),
            )
        await self._db.execute("UPDATE conversations SET updated_at=datetime('now') WHERE id=?", (parent_id,))
        await self._db.commit()
        return msg_id

    # ----- Search -----

    async def search(
        self, query: str, limit: int = 20
    ) -> list[dict[str, Any]]:
        """Full-text search across all messages."""
        assert self._db is not None
        normalized = query.strip()
    with _open_db(home) as db:
        payload = db.export_session(conversation_id, include_compacted=include_compacted)
    if not payload:
        return []
    messages = [_message_for_atlas(item) for item in payload.get("messages", [])]
    if before_id:
        anchor = next((i for i, item in enumerate(messages) if item["id"] == before_id), None)
        if anchor is None:
            return []
        messages = messages[:anchor]
    return messages[-limit:]


def read_session_all_messages(home: str | Path, conversation_id: str) -> list[dict[str, Any]]:
    with _open_db(home) as db:
        payload = db.export_session(conversation_id, include_compacted=True)
    if not payload:
        return []
    return [_message_for_atlas(item) for item in payload.get("messages", [])]


def read_session_model_messages(home: str | Path, conversation_id: str) -> list[dict[str, Any]]:
    """Read the canonical active model history with SessionDB row identities intact."""
    with _open_db(home) as db:
        rows = db._fetch_conversation_rows(
            [conversation_id], db._active_clause(False, False), with_session_id=False,
        )
        model_history = db._rows_to_conversation(
            rows, session_id=conversation_id, include_ancestors=False,
            repair_alternation=False, include_row_ids=True, include_summary_markers=True,
        )
    # Older Atlas writes put tool pairing fields in display_metadata. Promote them
    # before alternation repair so valid tool results are not mistaken for stray rows.
    for message in model_history:
        metadata = message.get("display_metadata")

