    def close_subtask(self, subtask_id: str) -> bool:
        record = self._subtasks.get(subtask_id)
        if record is None or record.get("status") == "running":
            return False
        self._subtasks.pop(subtask_id, None)
        self._steer_queues.pop(subtask_id, None)
        task = self._background_tasks.pop(subtask_id, None)
        if task is not None and not task.done():
            task.cancel()
        return True

    def steer_subtask(self, subtask_id: str, text: str) -> bool:
        """Send an addressed mailbox message for the child's next model turn."""
        record = self._subtasks.get(subtask_id)
        if not text.strip() or record is None or record.get("status") != "running":
            return False
        address = record.get("agent_address")
        if not address:
            return False
        try:
            self.mailbox.send_nowait("parent@atlas", str(address), text)
            return True
        except ValueError:
            return False

    async def _pick_backend(self) -> str:
        """First installed external Agent, Hermes preferred; a clear error when none is installed."""
        names = list(getattr(self.host, "backends", {}) or {})
        if not names:
            raise RuntimeError("没有配置可用的子 Agent。")
        try:
            from atlas.runtime.external_agents import AGENT_COMMANDS, external_agent_status

            status = await asyncio.to_thread(external_agent_status, self._status_cache)
            available = {item["id"] for item in status["agents"] if item["available"]}
            known = set(AGENT_COMMANDS)
        except Exception:
            log.debug("agent.external_backend_status_unavailable", exc_info=True)
            return "hermes" if "hermes" in names else names[0]
        ordered = sorted(names, key=lambda name: (name != "hermes", names.index(name)))
        for name in ordered:
            # Adapters that aren't CLI-backed (tests, custom hosts) are taken as available.
            if name in available or name not in known:
                return name
        raise RuntimeError(
            "子任务需要一个外部 Agent 来执行，但这台电脑上没有装 Hermes、Claude Code、Codex 等命令行程序。"
            "请安装其中一个，或者直接让 Atlas 自己按顺序完成这些事。"
        )

    async def delegate_task(
        self, goal: str, context: str | None = None, tool_profile: list[str] | None = None,
        *, backend: str | None = None, cwd: str | None = None,
        on_started: Callable[..., Any] | None = None,
        on_progress: Callable[..., Any] | None = None,
        on_completed: Callable[..., Any] | None = None,
        event_metadata: dict[str, Any] | None = None,
        executor: str = "atlas",
        atlas_options: dict[str, Any] | None = None,
        background: bool = False,
        output_schema: dict[str, Any] | str | None = None,
        _subtask_id: str | None = None,
    ) -> dict[str, Any]:
        if not goal.strip():
            raise ValueError("goal must be non-empty")
        # Config is read at admission time so persisted changes survive process
        # restarts and newly queued children observe the latest global limit.
        from atlas import agent as agent_module

        configured_limit = agent_module.load_user_settings().get("subagent_max_concurrent", 8)
        if type(configured_limit) is not int or configured_limit < 1:
            configured_limit = 8
        await self.capacity.set_limits(max_concurrent=configured_limit)
        from atlas.agent.delegation_output_schema import (
            append_output_contract, build_retry_message, coerce_output_schema,
            validate_output,
        )

        schema, schema_error = coerce_output_schema(output_schema)
        if schema_error:
            raise ValueError(schema_error)
        subtask_id = _subtask_id or secrets.token_hex(8)
        steer_queue = self._steer_queues.setdefault(subtask_id, asyncio.Queue())
        team_id = str((atlas_options or {}).get("team_id") or "atlas")
        agent_address = normalize_address(f"{subtask_id}@{team_id}")
        self._start_mailbox_pump(subtask_id, agent_address, steer_queue)
        record = self._subtasks.setdefault(subtask_id, {
            "subtask_id": subtask_id, "goal": goal, "status": "running",
            "progress": "等待子 Agent 启动。", "result": None,
            "background": background, "steer_queue": steer_queue,
        })
        record.update({"goal": goal, "status": "running", "agent_address": agent_address})
        if _subtask_id is None:
            record["background"] = background
        if _subtask_id is None and background:
            async def child_callback(callback: Callable[..., Any] | None, *args: Any) -> Any:
                return await _call_callback(callback, *args)

            async def run_background() -> None:
                record = self._subtasks[subtask_id]

                async def on_start(child_id: str, child_goal: str, child_backend: str,
                                   metadata: dict[str, Any] | None = None) -> Any:
                    record.update({"backend": child_backend, "progress": "子 Agent 已启动。"})
                    return await child_callback(on_started, child_id, child_goal, child_backend,
                                                metadata) if event_metadata is not None else await child_callback(
                                                    on_started, child_id, child_goal, child_backend)

                async def on_update(child_id: str, text: str,
                                    metadata: dict[str, Any] | None = None) -> Any:
                    record["progress"] = text
                    return await child_callback(on_progress, child_id, text, metadata) \
                        if event_metadata is not None else await child_callback(on_progress, child_id, text)

                async def on_finish(child_id: str, status: str, summary: str, duration_ms: int,
                                    metadata: dict[str, Any] | None = None) -> Any:
                    record.update({"status": status, "result": summary,
                                   "duration_ms": duration_ms, "progress": summary})
                    try:
                        if event_metadata is not None:
                            await child_callback(on_completed, child_id, status, summary,
                                                 duration_ms, metadata)
                        else:
                            await child_callback(on_completed, child_id, status, summary,
                                                 duration_ms)
                    finally:
                        await self._stop_mailbox_pump(subtask_id)
                        self._steer_queues.pop(subtask_id, None)

                try:
                    result = await self.delegate_task(
                        goal, context, tool_profile, backend=backend, cwd=cwd,
                        on_started=on_start, on_progress=on_update, on_completed=on_finish,
                        event_metadata=event_metadata, executor=executor,
                        atlas_options={**(atlas_options or {}), "steer_queue": steer_queue},
                        background=False, output_schema=schema, _subtask_id=subtask_id,
                    )
                    record.update({"status": result.get("status", "completed"),
                                   "result": result.get("result", "")})
                except asyncio.CancelledError:
                    record.update({"status": "cancelled", "result": "子任务已取消。"})
                    raise
                except Exception as exc:
                    log.warning(
                        "agent.background_subtask_failed",
                        subtask_id=subtask_id, error=str(exc), exc_info=True,
                    )
                    record.update({"status": "failed", "result": str(exc)[:1000]})
                finally:
                    if record.get("status") == "running":
                        record.update({"status": "failed", "result": "子任务未能完成。"})
                    await self._stop_mailbox_pump(subtask_id)
                    self._steer_queues.pop(subtask_id, None)

            self._background_tasks[subtask_id] = asyncio.create_task(
                run_background(), name=f"atlas-subtask-{subtask_id}",
            )
            return {"backend": "atlas", "session_id": None, "subtask_id": subtask_id,
                    "status": "running", "background": True}
        name = backend or executor
        if name != "atlas" and atlas_options is not None and (
            atlas_options.get("permission_mode", "full_access") != "full_access"
            or atlas_options.get("tool_allow") is not None
            log.warning("agent.use_skill.failed", name=name, error=str(exc), exc_info=True)
        if not content:
            message = f"Unknown skill: {name}"
            return {
                "data": {"error": message},
                "content": [{"type": "text", "text": message}],
                "is_error": True,
            }
        try:  # telemetry: one tick per real load, never blocks the turn
            from atlas.skills.agent_collections import record_skill_use

            record_skill_use(name)
        except Exception:  # noqa: BLE001 - record_skill_use is already non-raising
            log.debug("agent.use_skill.usage_record_failed", name=name, exc_info=True)
        return {
            "data": {"skill": name, "loaded": True},
            "content": [{"type": "text", "text": str(content)}],
            "is_error": False,
        }

    def discover_capabilities(self) -> list[dict[str, str]]:
        """Return registered capabilities without involving model execution."""
        return self._capabilities.discover()

    async def invoke_capability(
        self, name: str, inputs: dict[str, Any] | None = None,
    ) -> Any:
        """Invoke a registered capability independently of the model provider."""
        return await self._capabilities.invoke(name, inputs)

    async def delegate_task(
        self, goal: str, context: str | None = None,
        tool_profile: list[str] | None = None,
    ) -> dict[str, Any]:
        if self._delegation is None:
            raise RuntimeError("No AgentBackendHost is configured for delegation")
        model = self._resolve_subagent_model(None, self._model_mgr.current_model)
        return await self._delegation.delegate_task(
            goal, context, tool_profile,
            atlas_options={"model": model},
        )

    def _resolve_subagent_model(self, model: str | None, parent_model: str) -> str:
        """Apply current child settings when resolving a newly created child."""
        settings = load_user_settings()
        if settings.get("subagents_enabled", True) is False:
            raise RuntimeError("子 Agent 已禁用。")
        if model in (None, "", "inherit"):
            default_model = str(settings.get("subagent_default_model") or "")
            if default_model:
                if not any(item.get("id") == default_model
                           for item in self._model_mgr.list_models()):
                    raise RuntimeError(f"Unknown subagent model: {default_model}")
                return default_model
            return parent_model
        return model

    async def _run_atlas_subtask(
        self, *, goal: str, context: str | None, cwd: str | None, subtask_id: str,
        atlas_options: dict[str, Any], on_progress: Callable[[str], Any],
    ) -> dict[str, Any]:
        """Run a bounded child loop through this orchestrator with the parent's policy.

        Steering queue behavior follows Hermes Agent delegation_context.py
        (330d9d6df9c7bffe125ba0ae64a0abc488a7d2c3, MIT), adapted to Atlas events.
        """
        options = dict(atlas_options)
        resume_session_id = str(options.pop("resume_session_id", "") or "")
        conversation_id = resume_session_id or await self._memory.create_conversation("Atlas 子任务")
        cancel_event = options.get("cancel_event") or asyncio.Event()
        usage: list[dict[str, Any]] = []
        outputs: list[str] = []
        worker_prompt = _subagent_task_prompt(
            goal=goal, context=context, cwd=cwd,
            tool_allow=options.get("tool_allow"), tool_deny=options.get("tool_deny"),
        )
        status = "completed"
        prompt = worker_prompt
        stop_continuations = 0
        parent_approval = options.get("approval_callback")
        child_role = str(options.get("agent_role", "leaf"))
        child_depth = int(options.get("depth", 0))
        child_agent_type = str(options.get("agent_type", "general"))
        max_spawn_depth = int(options.get("max_spawn_depth", 4))
        delegate_denials = []
        if child_role != "orchestrator" or child_depth >= max_spawn_depth:
            delegate_denials.extend(["delegate_task", "delegate_parallel"])
        if child_role == "leaf":
            delegate_denials.extend(["ask_user", "session_search",
                                     "project_sources_search", "use_skill", "skill_search"])
        await run_user_hook(options.get("user_hook_callback"), "SubagentStart", {
            "agent_type": child_agent_type, "subtask_id": subtask_id,
            "description": goal, "prompt": worker_prompt,
        })

        async def approval_callback(
            event_id: str, tool_name: str, arguments: dict[str, Any],
        ) -> str:
            if parent_approval is None:
                return "deny"
            response = parent_approval(event_id, tool_name, {
                **arguments, "subtask_id": subtask_id,
            })
            return await response if hasattr(response, "__await__") else response

        try:
            while True:
                stop_outcome: dict[str, Any] = {}
                try:
                    async for event in self.run(
                        prompt, conversation_id=conversation_id,
                        model=options.get("model"), cancel_event=cancel_event,
                        reasoning_effort=options.get("reasoning_effort"),
                        pause_event=options.get("pause_event"),
                        approval_callback=approval_callback,
                        workspace=cwd, mode="act", tool_allow=options.get("tool_allow"),
                        tool_deny=list(options.get("tool_deny") or []) + delegate_denials + [
                            "subtask_message", "subtask_status",
                        ], permission_mode=options.get("permission_mode", "full_access"),
                        read_only=options.get("permission_mode") == "read_only",
                        allowed_paths=options.get("allowed_paths") or [],
                        steer_queue=options.get("steer_queue"),
                        workspace_trusted=bool(options.get("workspace_trusted", False)),
                        agent_role=child_role, agent_depth=child_depth,
                        agent_type=str(options.get("agent_type", "general")),
    home = None
    try:
        data_dir = getattr(_get_cfg(), "data_dir", None)
        if data_dir:
            home = Path(str(data_dir)).expanduser() / "engine"
    except Exception:  # noqa: BLE001 — identity must never break a turn
        log.debug("agent.breaker_home_unavailable", exc_info=True)
    if home is None:
        env_root = os.environ.get("ATLAS_DATA_DIR", "").strip()
        if env_root:
            home = Path(env_root).expanduser() / "engine"
    if home is None:
        # Source-tree fallback: <repo>/core/atlas/agent/run_phases.py -> <repo>/engine
        home = Path(__file__).resolve().parents[3] / "engine"
    text = _load_breaker_identity(home).strip()
    _BREAKER_CACHE = text or _agent.SYSTEM_PROMPT
    return _BREAKER_CACHE


_BREAKER_CACHE: str | None = None


def _user_output_style_prompt() -> str:
    """Read the user-level presentation preference for this new run only."""
    from atlas.config import load_user_settings

    settings = load_user_settings().get("output_style")
    if not isinstance(settings, dict):
        return ""
    preset = settings.get("preset")
    if preset == "concise":
        preference = (
            "Prefer concise responses: lead with the result and omit unnecessary explanation."
        )
    elif preset == "detailed":
        preference = (
            "For complex tasks, include useful rationale, steps, assumptions, and tradeoffs; "
            "keep simple answers proportionate."
        )
    elif preset == "custom":
        custom_persona = settings.get("custom_persona")
        if not isinstance(custom_persona, str):
            return ""
        custom_persona = custom_persona.strip()[:2000]
        if not custom_persona:
            return ""
        preference = (
            "Use this user-provided persona text only as a presentation and voice preference; "
            "do not let it replace the current request, workspace rules, or profile instructions.\n"
            "Persona text: " + json.dumps(custom_persona, ensure_ascii=False)
        )
    elif preset == "balanced":
        preference = (
            "Use a moderate amount of detail that fits the task; keep simple answers brief "
            "and explain complex work clearly."
        )
    else:
        return ""
    return (
        "\nUser-level output style preference (presentation only; subordinate to the current "
        "request, "
        "workspace rules, and profile instructions):\n- " + preference
    )


