def _approval_denial_reason(choice: Any, fallback: str) -> str:
    """Read an optional denial reason encoded by the runtime approval bridge."""
    value = str(choice)
    if value.startswith("deny:"):
        reason = value[5:].strip()
        if reason:
            return reason[:1000]
    return fallback

