import type { CheckResults } from '@atlas/backend-adapter';
import type { AgentEvent } from '../../types/runtime';
import { structuredComponent, type StructuredComponentItem } from './StructuredComponentCard';
import { isTodoEdit, parseTodoEdit } from './runInsights';

/** One line for a todo edit the user handed to the Agent. */
export function todoEditNotice(content: string): string {
  const items = parseTodoEdit(content);
  const done = items.filter((item) => item.status === 'completed').length;
  return items.length ? `你调整了待办清单（${items.length} 项，已完成 ${done} 项），Atlas 会按新清单继续` : '你调整了待办清单';
}

/**
 * Turns the raw runtime event stream into what a person wants to read:
 * their message, the steps Atlas took (in plain words), approvals, the reply, and the outcome.
 * Internal bookkeeping events (status, phase, plan) never reach the thread.
 */

export type StepState = 'running' | 'done' | 'failed' | 'cancelled';

export type ToolCategory =
  | 'file-read' | 'file-write' | 'file-edit' | 'file-patch'
  | 'shell' | 'exec' | 'search' | 'todo' | 'plan' | 'question' | 'agent'
  | 'browser' | 'computer' | 'git' | 'process' | 'web' | 'checks' | 'image' | 'memory' | 'other';

export interface Step {
  id: string;
  toolName: string;
  category: ToolCategory;
  verb: string;
  target?: string;
  state: StepState;
  startedAt: string;
  endedAt?: string;
  /** Short human-readable result, separate from the expandable raw payload. */
  summary?: string;
  /** Failure detail promoted from the tool response so it is visible without opening raw details. */
  failureReason?: string;
  input?: string;
  result?: string;
export interface TrajectoryDescription { label: string; detail?: string }

export function describeTrajectoryEvent(event: Record<string, unknown>): TrajectoryDescription {
  const type = typeof event.event === 'string' ? event.event : 'unknown';
  const data = event.data && typeof event.data === 'object' && !Array.isArray(event.data)
    ? event.data as Record<string, unknown>
    : {};
  const tool = typeof data.name === 'string' ? data.name : typeof data.tool_name === 'string' ? data.tool_name : '工具';
  const content = typeof data.content === 'string' ? data.content : undefined;
  switch (type) {
    case 'tool.started': return { label: `开始工具 · ${tool}`, detail: typeof data.arguments === 'string' ? data.arguments : undefined };
    case 'tool.completed': return { label: data.is_error === true || data.status === 'failed' ? `工具失败 · ${tool}` : `完成工具 · ${tool}`,
      detail: typeof data.content === 'string' ? data.content : undefined };
    case 'message.delta': return { label: '生成回复', detail: content };
    case 'message.completed': return { label: data.role === 'user' ? '用户消息' : '助手回复', detail: content };
    case 'approval.required': return { label: `等待审批 · ${typeof data.tool_name === 'string' ? data.tool_name : '请求'}` };
    case 'approval.responded': return { label: '审批已处理', detail: typeof data.outcome === 'string' ? data.outcome : undefined };
    case 'run.completed': return { label: '运行完成' };
    case 'run.failed': return { label: '运行失败', detail: typeof data.error === 'string' ? data.error : undefined };
    case 'run.cancelled': return { label: '运行已取消' };
    default: return { label: type };
  }
}

