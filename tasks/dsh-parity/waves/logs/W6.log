# ported from hermes-agent@c9e076b atlas_state_timeline.py (MIT)
"""Read-only prompt index and bounded transcript jumps; no transcript-wide payload hydration."""

from __future__ import annotations

import re
from contextlib import contextmanager

from atlas.engine.agent.compaction_display import project_compaction_message_for_display
from atlas.engine.agent.context_compressor import user_originated_turn_view
from atlas.engine.state.atlas_state_messages import DISPLAY_VISIBLE_SQL


_SYNTHETIC_PROMPT = re.compile(
    r"^\s*(?:\[IMPORTANT: Background process |\[ASYNC (?:DELEGATION )?(?:BATCH )?COMPLETE\b|"
    r"A background fan-out of \d+ subagent\(s\) you dispatched earlier has finished\.|"
    r"A background subagent you dispatched earlier has finished\.)",
    re.IGNORECASE,
)


def _prompt_preview(db, content, display_kind, summary):
    message = project_compaction_message_for_display({
        "role": "user", "content": db._decode_content(content),
        "display_kind": display_kind, "_compressed_summary": bool(summary),
    })
    if message is None or user_originated_turn_view(message) is None:
        return ""
    content = message.get("content")
    if isinstance(content, list):
        content = " ".join(
            part if isinstance(part, str) else part.get("text", "")
            for part in content if isinstance(part, (str, dict)))
    if not isinstance(content, str):
        return ""
    text = " ".join(content.split())
    if not text or _SYNTHETIC_PROMPT.match(text):
        return ""
    return text if len(text) <= 120 else text[:119].rstrip() + "…"


@contextmanager
def _snapshot(db):
    # The count and page must see the same compaction/rewind generation.
    with db._read_ctx() as conn:
        conn.execute("BEGIN")
        try:
            yield conn
        finally:
            if conn.in_transaction:
                conn.execute("ROLLBACK")


def _display_rows_sql(conn, session_id, *, users_only=False):
    """Return only representative ids and their stable first-row order, never bodies.

    Legacy stores cannot backfill on a GET. SQL groups their payload identities in
    SQLite; only user content crosses the Python boundary for carrier normalization.
    Current stores use the durable display index, including protected-tail copies.
    """
    filters = (" AND role = 'user'" if users_only else "") + DISPLAY_VISIBLE_SQL
    indexed = conn.execute(
        "SELECT 1 FROM messages WHERE session_id = ? AND (active = 1 OR compacted = 1) "
        f"{filters} AND (display_order IS NULL OR display_identity IS NULL) LIMIT 1",
        (session_id,),
    ).fetchone() is None
    if indexed:
        return f"""WITH display_rows AS (
            SELECT (SELECT candidate.id FROM messages candidate
                    WHERE candidate.session_id = :sid
                      AND candidate.display_order = m.display_order
                      AND (candidate.active = 1 OR candidate.compacted = 1){DISPLAY_VISIBLE_SQL}
                    ORDER BY candidate.active DESC, candidate.id DESC LIMIT 1) AS row_id,
                   m.display_order AS sort_id
            FROM messages m WHERE session_id = :sid AND (active = 1 OR compacted = 1){filters}
            GROUP BY m.display_order
        )"""
    return f"""WITH ranked AS (
        SELECT id, MIN(id) OVER identity AS sort_id,
               ROW_NUMBER() OVER (identity ORDER BY active DESC, id DESC) AS preference
        FROM messages WHERE session_id = :sid AND (active = 1 OR compacted = 1){filters}
        WINDOW identity AS (PARTITION BY role,
            CASE WHEN role = 'user' THEN timeline_identity_content(content, display_kind) ELSE content END,
            timestamp, tool_call_id, tool_calls, tool_name)
    ), display_rows AS (SELECT id AS row_id, sort_id FROM ranked WHERE preference = 1)"""


def _register_functions(db, conn):
    from atlas.engine.agent.context_compressor import split_user_originated_turn

    def identity_content(content, display_kind):
        handoff, live = split_user_originated_turn({
            "role": "user", "content": db._decode_content(content), "display_kind": display_kind})
        return db._encode_content(live.get("content")) if handoff is not None and live is not None else content

    conn.create_function("timeline_identity_content", 2, identity_content, deterministic=True)
    conn.create_function("timeline_preview", 3,
                         lambda content, kind, summary: _prompt_preview(db, content, kind, summary),
                         deterministic=True)


def get_session_messages_around(db, session_id, row_id, *, limit=120):
    """Read at most *limit* display rows starting at an exact human prompt.

    Existence probes/counts contain ids only. Full payloads are fetched only for
    the selected bounded page, even when the anchor is deep in a transcript.
    """
    with _snapshot(db) as conn:
        _register_functions(db, conn)
        anchor = conn.execute(
            "SELECT content, display_kind, _compressed_summary FROM messages "
            "WHERE session_id = ? AND id = ? AND role = 'user' AND (active = 1 OR compacted = 1)",
            (session_id, row_id),
        ).fetchone()
        if anchor is None or not _prompt_preview(db, *anchor):
            return None
        sql = _display_rows_sql(conn, session_id)
        params = {"sid": session_id, "row_id": row_id, "limit": limit}
        selected = conn.execute(sql + """
            SELECT sort_id FROM display_rows WHERE row_id = :row_id
        """, params).fetchone()
        if selected is None:
            return None
        params["start"] = selected["sort_id"]
        counts = conn.execute(sql + """
            SELECT COUNT(*) AS total, COALESCE(SUM(sort_id < :start), 0) AS offset FROM display_rows
        """, params).fetchone()
        rows = conn.execute(sql + """
            SELECT m.* FROM (SELECT row_id, sort_id FROM display_rows
                            WHERE sort_id >= :start ORDER BY sort_id LIMIT :limit) AS page
            JOIN messages m ON m.id = page.row_id ORDER BY page.sort_id
        """, params).fetchall()
    messages = [db._row_to_message_dict(row, warn_context="timeline jump", summary_flag=True) for row in rows]
    return {"messages": messages, "pagination": {
        "row_id": row_id, "limit": limit, "returned": len(messages), "order": "oldest",
        "offset": counts["offset"], "total": counts["total"],
        "has_older": counts["offset"] > 0,
        "has_newer": counts["offset"] + len(messages) < counts["total"],
    }}


def get_session_timeline(db, session_id, *, limit=500, after_row_id=0):
    """Chronological prompts. Cursor is the first physical row id of a logical turn."""
    with _snapshot(db) as conn:
        _register_functions(db, conn)
        sql = _display_rows_sql(conn, session_id, users_only=True) + """,
            prompts AS MATERIALIZED (
                SELECT row_id, sort_id, m.timestamp,
                       timeline_preview(m.content, m.display_kind, m._compressed_summary) AS preview
                FROM display_rows JOIN messages m ON m.id = row_id
            ), eligible AS MATERIALIZED (SELECT * FROM prompts WHERE preview <> '')
        """
        params = {"sid": session_id, "after": after_row_id, "limit": limit + 1}
        rows = conn.execute(sql + """
            SELECT row_id, sort_id, timestamp, preview, (SELECT COUNT(*) FROM eligible) AS total
            FROM eligible WHERE sort_id > :after ORDER BY sort_id LIMIT :limit
        """, params).fetchall()
        total = rows[0]["total"] if rows else conn.execute(
            sql + "SELECT COUNT(*) FROM eligible", params).fetchone()[0]
    has_more = len(rows) > limit
    page = rows[:limit]
    return {
        "entries": [{"row_id": row["row_id"], "preview": row["preview"], "timestamp": row["timestamp"]}
                    for row in page],
        "pagination": {"limit": limit, "after_row_id": after_row_id, "returned": len(page),
                       "total": total, "has_more": has_more,
                       "next_cursor": page[-1]["sort_id"] if has_more else None},
    }


"""OpenTelemetry traces for Atlas runs.

Atlas already emits a rich structured event stream, but that stream is only
visible to a client that is attached. This module exports standard OTLP spans so
an external collector (Jaeger, Tempo, Honeycomb, an OTel Collector) can see the
same work, correlated with the log stream.

Design constraints, in order of importance:

* **Off unless configured.** No endpoint means no provider, no exporter, no
  background thread. Importing this module must stay free.
* **Never breaks a run.** Every entry point swallows its own failures. Telemetry
  that can abort an agent turn is worse than no telemetry.
* **Redaction is shared.** Attribute values pass through the same scrubber the
  logs use, so a secret cannot reach a collector through a span attribute.
* **Trace ids reach the logs.** ``configure_logging`` installs a processor that
  stamps the active ``trace_id``/``span_id`` onto every log line, which is what
  makes "find the trace for this error" a single query.
"""

from __future__ import annotations

import os
from collections.abc import Iterator
from contextlib import contextmanager
from typing import Any

import structlog

log = structlog.get_logger(__name__)

_TRACER_NAME = "atlas"

_state: dict[str, Any] = {"provider": None, "tracer": None, "endpoint": None}


def endpoint_from_env() -> str | None:
    """Resolve the OTLP endpoint from the environment, or ``None``."""
    for key in ("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "OTEL_EXPORTER_OTLP_ENDPOINT"):
        value = os.environ.get(key, "").strip()
        if value:
            return value
    return None


def is_enabled() -> bool:
    """True once a real provider is installed."""
    return _state["provider"] is not None


def setup_telemetry(
    endpoint: str | None = None,
    *,
    service_name: str = "atlas",
    force: bool = False,
) -> dict[str, Any]:
    """Install a global tracer provider exporting OTLP/HTTP.

    Returns a status dict; never raises. Calling twice is a no-op unless ``force``.
    """
    if _state["provider"] is not None and not force:
        return {"enabled": True, "endpoint": _state["endpoint"], "already": True}

    resolved = endpoint or endpoint_from_env()
    if not resolved:
        return {"enabled": False, "reason": "no endpoint configured"}

    try:
        from opentelemetry import trace
        from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
        from opentelemetry.sdk.resources import Resource
        from opentelemetry.sdk.trace import TracerProvider
        from opentelemetry.sdk.trace.export import BatchSpanProcessor
    except ImportError as exc:
        log.warning("telemetry.unavailable", error=str(exc))
        return {"enabled": False, "reason": f"missing dependency: {exc}"}

    try:
        resource = Resource.create({
            "service.name": service_name,
            "service.version": _version(),
        })
        provider = TracerProvider(resource=resource)
        # A local collector is on the same machine; a batch of 512 with a 5s delay
        # keeps per-turn overhead invisible while bounding loss on hard exit.
        provider.add_span_processor(
            BatchSpanProcessor(
                OTLPSpanExporter(endpoint=resolved),
                max_queue_size=2048,
                max_export_batch_size=512,
                schedule_delay_millis=5000,
            )
        )
        trace.set_tracer_provider(provider)
        _state.update(
            provider=provider, tracer=provider.get_tracer(_TRACER_NAME), endpoint=resolved
        )
        log.info("telemetry.enabled", endpoint=resolved)
        return {"enabled": True, "endpoint": resolved}
    except Exception as exc:  # noqa: BLE001 - telemetry must not break startup
        log.warning("telemetry.setup_failed", error=str(exc))
        return {"enabled": False, "reason": str(exc)}


def shutdown() -> None:
    """Flush pending spans. Safe to call when nothing was configured."""
    provider = _state["provider"]
    if provider is None:
        return
    try:
        provider.shutdown()
    except Exception as exc:  # noqa: BLE001
        log.warning("telemetry.shutdown_failed", error=str(exc))
    finally:
        _state.update(provider=None, tracer=None, endpoint=None)


def _version() -> str:
    try:
        from atlas import __version__

        return str(__version__)
    except Exception:  # noqa: BLE001
        return "unknown"


def _scrub_attributes(attributes: dict[str, Any]) -> dict[str, Any]:
    """Redact secret-looking values, and coerce to OTel-safe scalar types.

    Two layers, because either alone leaks:

    * ``is_secret_key`` on the **attribute name** — a span attribute called
      ``api_key`` is a secret regardless of what its value looks like, and
      ``scrub`` is context-based (it needs ``key=value`` in a string), so it
      passes a bare ``sk-...`` straight through.
    * ``scrub`` on every string — catches embedded credentials in free text.
    """
    try:
        from atlas import secrets_store
    except Exception:  # noqa: BLE001
        secrets_store = None  # type: ignore[assignment]

    safe: dict[str, Any] = {}
    for key, value in attributes.items():
        if value is None or isinstance(value, (bool, int, float)):
            safe[key] = value
            continue
        text = value if isinstance(value, str) else str(value)
        if secrets_store is not None:
            if secrets_store.is_secret_key(key):
                safe[key] = secrets_store.mask(text)
                continue
            text = secrets_store.scrub(text)
        safe[key] = text
    return safe


@contextmanager
def span(name: str, attributes: dict[str, Any] | None = None) -> Iterator[Any]:
    """Start a span if telemetry is enabled, otherwise yield ``None``.

    Yields the span so callers can set attributes mid-flight; they must not
    assume it is non-``None``.
    """
    tracer = _state["tracer"]
    if tracer is None:
        yield None
        return
    try:
        span_context = tracer.start_as_current_span(name)
        current = span_context.__enter__()
    except Exception as exc:  # noqa: BLE001 - a span must never abort the caller
        log.debug("telemetry.span_failed", span=name, error=str(exc))
        yield None
        return

    if attributes:
        try:
            for key, value in _scrub_attributes(attributes).items():
                current.set_attribute(key, value)
        except Exception as exc:  # noqa: BLE001 - telemetry cannot abort the caller
            log.debug("telemetry.span_attributes_failed", span=name, error=str(exc))

    try:
        yield current
    except BaseException as exc:
        # Preserve the caller's exception. The exporter should see it, but a
        # broken span processor must not replace it with its own failure.
        try:
            span_context.__exit__(type(exc), exc, exc.__traceback__)
        except Exception as span_exc:  # noqa: BLE001
            log.debug("telemetry.span_failed", span=name, error=str(span_exc))
        raise
    else:
        try:
            span_context.__exit__(None, None, None)
        except Exception as exc:  # noqa: BLE001 - telemetry cannot abort the caller
            log.debug("telemetry.span_failed", span=name, error=str(exc))


def current_ids() -> dict[str, str]:
    """Active ``trace_id``/``span_id`` as hex, or ``{}`` when none."""
    try:
        from opentelemetry import trace

        context = trace.get_current_span().get_span_context()
    except Exception:  # noqa: BLE001
        return {}
    if not context or not context.is_valid:
        return {}
    return {
        "trace_id": format(context.trace_id, "032x"),
        "span_id": format(context.span_id, "016x"),
    }


def trace_log_processor(
    _logger: Any, _method: str, event_dict: dict[str, Any]
) -> dict[str, Any]:
    """Structlog processor: stamp trace context onto every log record."""
    ids = current_ids()
    if ids:
        event_dict.update(ids)
    return event_dict


def status() -> dict[str, Any]:
    """Introspection payload describing the current telemetry state."""
    return {
        "enabled": is_enabled(),
        "endpoint": _state["endpoint"],
        "configured_via": (
            "argument" if is_enabled() else ("env" if endpoint_from_env() else None)
        ),
        "env": {
            key: bool(os.environ.get(key))
            for key in ("OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT")
        },
    }



