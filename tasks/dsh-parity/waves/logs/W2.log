    def deregister(self, name: str, *, scope: Optional[str] = None) -> None:
        """Remove a tool; drops the toolset check/aliases if it was the last in its toolset.

        ``scope`` selects a profile overlay explicitly (multiplexed MCP tools live in the
        owning profile's overlay); plugin callers may not name another scope, non-plugin
        callers default to the process-global map. Gated by the same opt-in as
        ``register(override=True)``, else a plugin could deregister a tool it doesn't own
        and re-register over the empty slot (the override check only runs when an entry
        exists). ``mcp-*`` toolsets are exempt — discovery repaves its own tools per refresh."""
        scope = normalize_scope(scope)
        with self._lock:
            caller_mod = self._caller_module()
            caller_owner = self._plugin_namespace_of_module(caller_mod)
            caller_scope = self._plugin_scope_of(caller_owner) if caller_owner is not None else None
            if caller_owner is not None and scope is not None and scope != caller_scope:
                raise PermissionError(
                    f"Plugin module {caller_mod!r} cannot deregister tools "
                    "outside its own profile scope.")
    def get_toolset_for_tool(self, name: str) -> Optional[str]:
        return self._attr(name, "toolset")

    def get_emoji(self, name: str, default: str = "⚡") -> str:
        """Return the emoji for a tool, or *default* if unset."""
        return self._attr(name, "emoji") or default

    def get_tool_to_toolset_map(self) -> dict[str, str]:
        return {entry.name: entry.toolset for entry in self._snapshot_entries()}

    def is_toolset_available(self, toolset: str) -> bool:
        """True when a toolset has at least one exposable tool (never raises)."""
        return self._toolset_has_exposable_tools(toolset, self._snapshot_entries())


    def check_toolset_requirements(self) -> dict[str, bool]:
        entries = self._snapshot_entries()
        return {
            toolset: self._toolset_has_exposable_tools(toolset, entries)
            for toolset in sorted(self._grouped(entries))}

    def get_available_toolsets(self) -> dict[str, dict]:
        """Return toolset metadata for UI display."""
        entries = self._snapshot_entries()
        toolsets: dict[str, dict] = {}
        for toolset, members in self._grouped(entries).items():
            toolsets[toolset] = {
                "available": self._toolset_has_exposable_tools(toolset, entries),
                "tools": [entry.name for entry in members],
                "description": "",
                "requirements": _unique_env(members)}
        return toolsets

    def get_toolset_requirements(self) -> dict[str, dict]:
        """Build a TOOLSET_REQUIREMENTS-compatible dict for backward compat."""
        entries, toolset_checks = self._snapshot_state()
        result: dict[str, dict] = {}
        for toolset, members in self._grouped(entries).items():
            result[toolset] = {
                "name": toolset,
                "env_vars": _unique_env(members),
                "check_fn": toolset_checks.get(toolset),
                "setup_url": None,
                "tools": [entry.name for entry in members]}
        return result

    def check_tool_availability(self, quiet: bool = False):
        """Return (available_toolsets, unavailable_info) like the old function."""
        available, unavailable = [], []
        entries = self._snapshot_entries()
# SPDX-License-Identifier: Apache-2.0
"""Per-call tool deadlines, non-cancelling fan-out, and structured tool errors.

These tests exercise :class:`atlas.engine.kernel.tools.ToolScheduler` only. The
scheduler dispatch callback is a fake, so nothing here crosses a process or
service boundary and the module stays in the default ``unit`` lane.
"""
from __future__ import annotations

import asyncio

import pytest

from atlas.engine.kernel import tools as tools_module
from atlas.engine.kernel.state import ToolReceipt
from atlas.engine.kernel.tool_errors import (
    ToolTimeoutError,
    error_from_exception,
    error_output,
    tail_text,
)
from atlas.engine.kernel.tools import ToolScheduler, resolve_tool_timeout


def _call(call_id: str, name: str, **arguments) -> dict:
    return {
        "id": call_id,
        "function": {"name": name, "arguments": arguments or {"path": "x"}},
    }


def _read_only(_name: str, _args: dict) -> bool:
    return True


class CommandFailedError(RuntimeError):
    """A handler exception carrying process evidence, like a real exec failure."""

    def __init__(self, message: str, *, exit_code: int, stderr: str) -> None:
        super().__init__(message)
        self.exit_code = exit_code
        self.stderr = stderr


# --------------------------------------------------------------------------- #
# deadline policy
# --------------------------------------------------------------------------- #
def test_timeout_families_are_long_for_build_shell_and_short_for_reads():
    assert resolve_tool_timeout("terminal") == 600.0
    assert resolve_tool_timeout("exec_command") == 900.0
    assert resolve_tool_timeout("web_search") == 120.0
    assert resolve_tool_timeout("apply_patch") == 180.0
    assert resolve_tool_timeout("read_file") == 60.0
    # Unknown tools fall back to the documented global default, never to "no limit".
    assert resolve_tool_timeout("totally_unknown_tool") == 300.0
# DSH → Atlas 差距账（证据级）

> 生成日期：2026-11-13
> 基准：DeepSeek-Harness `deepseek-ai/deepseek-harness@d743267388641bc76f17c45ce8b4c231aed1d32c`
> 本地基准副本：`D:\ENGINE-V3-UPSTREAM-20261011\deepseek-harness`
> 方法：4 条并行线各自**读 DSH 实现体**（不是只读文档）→ 回 Atlas 找对应实现 → 给路径行号 → 判定等级。
> 判定词：`PRESENT-PARITY` 同等 / `PRESENT-WEAKER` 有但少关键性质 / `ABSENT` 没有 /
> `PRESENT-STRONGER` Atlas 更强（DSH 侧是缺口，**不要为了"对齐"而削弱**）。

## 结论摘要

| 维度 | 差距条数 | 其中 P0 | 其中 P1 | Atlas 更强的项 |
|---|---|---|---|---|
| 引擎与工具执行 | 36 | 3 | 12 | 2（重连取消、写路径诊断增量） |
| 会话与持久化 | 33 | 2 | 11 | 2（长期记忆、rewind） |
| 插件与扩展 | 33 | 1 | 10 | 3（hook 信任门、skill 依赖门、agent 声明） |
| 桌面与 UX | 33 | 0 | 10 | 5（rewind、多窗口/分栏、消息操作、富预览、托盘） |

**最重要的判断**：DSH 的优势不在功能数量，而在**两条地基**：
1. **会话事件日志是唯一真源**，模型历史由它派生（`deriveMessages()`）。Atlas 是"可变 SQLite 消息表 + 内容被抹掉的 run JSONL"，这是 P0。
2. **一切皆插件的组合根**（Cordis service/seam/profile/bundle/patch）。Atlas 是 51 字段扁平 `AppServices` + 手写 router 元组，这是 P0。

这两条不补，其余所有"补功能"都会退化成再加一个硬编码分支。

---

## 一、引擎与工具执行（36 条）

