    @property
    def gateway_api_key(self) -> str:
        env = os.environ.get("ATLAS_API_KEY")
        if env:
            return env
        # Plaintext left in atlas.toml means migration hit a conflicting keyring entry: prefer it.
        plaintext = str(self.get("models.gateway.api_key", "") or "")
        if plaintext:
            return plaintext
        try:
