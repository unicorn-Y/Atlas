@dataclass
class RunRequest:
    """Everything one agent run is asked to do (taskbook H2.2).

    Inputs, mode, permissions, workspace and model. Identifiers and plain
    data only — no behavior.
    """

    message: str
    conversation_id: str
    source: str = "foreground"
    model: str | None = None
    plan_state: dict[str, Any] | None = None
    force_plan: bool = False
    evaluate_goal: bool = False
    source_run_id: str | None = None
    image_attachments: list[str] | None = None
    active_skill_instructions: list[dict[str, str]] | None = None
    run_id: str | None = None
    workspace: str | None = None
    workspace_trusted: bool = False
    agent_role: str = "general"
    agent_depth: int = 0
    agent_type: str = "general"
    agent_preset_id: str = "default"
    agent_preset_capabilities: dict[str, Any] | None = None
    permission_preset: str = "ask"
    moa: bool = False
    workspace_rules: list[dict[str, Any]] | None = None
    ignore_workspace_rules: bool = False
    mode: str = "act"
    mode_explicit: bool = False
    tool_allow: list[str] | None = None
    tool_deny: list[str] | None = None
    read_only: bool = False
    permission_mode: str = "full_access"
    allowed_paths: list[str] | None = None
    sandbox_enabled: bool = False
    project_id: str | None = None
    task_id: str | None = None
    reasoning_effort: str | None = None
    worker: bool = False
    stable_system_prefix: str | None = None
    memory_scope_id: str = ""
    session_env: dict[str, str] = field(default_factory=dict)
    ephemeral: bool = False
    bypass_prompt_cache: bool = False
    # Host-registered content transforms applied to each tool result before the
    # model sees it. ``None`` keeps the kernel's behaviour byte-identical.
    tool_result_finalizers: Any = None
    inbox: Any = None


# repeats would otherwise restart the same work on every boot; after this the
# run stays failed and the user decides.
MAX_RESUME_ATTEMPTS = 3


class RunState:
    """Tracks a single agent run's state for the runtime protocol."""

    __slots__ = (
        "run_id", "conversation_id", "model", "started_at", "sequence",
        "status", "events", "cancel_event", "pause_event",
        "approval_futures", "approval_contexts", "task", "plan_state",
        "event_lock", "steer_queue", "input_futures", "mode", "workspace",
        "usage", "workspace_rules", "plan_future", "plan_edits",
        "tool_allow", "tool_deny", "reasoning_effort", "reasoning_effort_applied",
        "ephemeral", "ephemeral_source", "tool_output_dir", "subtasks",
        "read_only", "active_skills", "profile_id", "agent_id", "user_input",
        "permission_mode", "allowed_paths", "trust_future", "trust_event_id",
        "sandbox_mode", "approval_policy", "permission_preset",
        "inbox",
        "executor", "sandbox", "extra_roots",
        "trust_roots",
        "session_env",
        "project_id",
        "task_id",
        "telegram_user_id",
        "updated_at", "waiting_for", "persisted_sequence",
        "dynamic_plan_mode", "plan_approval_callback", "plan_mode_callback", "end_conversation_reason",
        "end_conversation_callback",
        "config_override", "ignore_project_config", "ignore_workspace_rules",
        "resume_attempts", "resume_context", "background",
        "bypass_prompt_cache",
    )

    def __init__(self, run_id: str, conversation_id: str, model: str) -> None:
        self.run_id = run_id
        self.conversation_id = conversation_id
        self.model = model
        self.started_at = datetime.now(UTC).isoformat()
        self.updated_at = self.started_at
        self.waiting_for: str | None = None
        self.persisted_sequence = 0
        self.sequence = 0
        self.status = "running"  # running | paused | waiting | completed | failed | cancelled
        self.events: list[dict[str, Any]] = []  # full event log for replay
        self.cancel_event = asyncio.Event()
        self.pause_event = asyncio.Event()
        self.pause_event.set()  # not paused initially
        self.approval_futures: dict[str, asyncio.Future[str]] = {}
        self.approval_contexts: dict[str, dict[str, Any]] = {}
        self.task: asyncio.Task[None] | None = None
        self.plan_state: dict[str, Any] | None = None
        self.event_lock = asyncio.Lock()
        self.steer_queue: asyncio.Queue[dict[str, str]] = asyncio.Queue()
        self.input_futures: dict[str, asyncio.Future[str]] = {}
        self.mode = "act"
        self.workspace: str | None = None
        self.usage: list[dict[str, Any]] = []
        self.workspace_rules: list[dict[str, Any]] = []
        self.plan_future: asyncio.Future[dict[str, str]] | None = None
        self.plan_edits = ""
        self.tool_allow: list[str] | None = None
        self.tool_deny: list[str] = []
        self.reasoning_effort: str | None = None
        self.reasoning_effort_applied: bool | None = None
        self.ephemeral = False
        self.bypass_prompt_cache = False
        self.ephemeral_source: str | None = None
        self.tool_output_dir: Path | None = None
        self.subtasks: dict[str, dict[str, Any]] = {}
        self.read_only = False
        self.active_skills: list[str] = []
        self.profile_id: str | None = None
        self.agent_id: str | None = None
        self.user_input = ""
        # Auto-resume bookkeeping (restart recovery). ``resume_attempts`` is
        # persisted so a run that keeps getting interrupted is never resumed
        # in an endless loop.
        self.resume_attempts = 0
        self.resume_context: dict[str, Any] = {}
    target = (target or "").strip()
    if not text:
        return
    if target == "owner" or ":" not in target:
        if _server().notifications is not None:
            await _server().notifications.notify("Atlas heartbeat", text)
        return
    channel, _, chat_id = target.partition(":")
    if _server().channel_manager is None:
        return
    try:
        await _server().channel_manager.send(channel, chat_id, text)
    except Exception:  # delivery failure must not crash the tick
        log.exception("heartbeat.channel_delivery_failed", channel=channel)


async def _collect_orchestrator_text(
    message: str, conversation_id: str, *,
    model: str | None = None,
    reasoning_effort: str | None = None,
    workspace: str | None = None,
    active_skill_instructions: list[dict[str, str]] | None = None,
    agent_preset_id: str = "default",
    permission_preset: str = "ask",
    agent_preset_capabilities: dict[str, Any] | None = None,
    mode: str = "act",
    mode_explicit: bool = False,
) -> str:
    """One unattended orchestrator turn (heartbeat / automation / group); assistant text."""
    if _server().orchestrator is None:
        raise RuntimeError("Agent orchestrator 尚未就绪")

    async def deny_unapproved(_event_id: str, _tool_name: str, _payload: dict[str, Any]) -> str:
        return "deny"

    response: list[str] = []
    message_id = ""
    async for event in _server().orchestrator.run(
        message=message,
        conversation_id=conversation_id,
        model=model,
        reasoning_effort=reasoning_effort,
        approval_callback=deny_unapproved,
        source_run_id=uuid.uuid4().hex,
        active_skill_instructions=active_skill_instructions,
        workspace=workspace,
        agent_preset_id=agent_preset_id,
        permission_preset=permission_preset,
        agent_preset_capabilities=agent_preset_capabilities,
        mode=mode,
        mode_explicit=mode_explicit,
    ):
        event_type = event.get("type")
        if event_type == "error":
            raise RuntimeError(str(event.get("detail") or "orchestrator turn failed"))
        if event_type == "chunk":
            piece = event.get("content", "")
            if isinstance(piece, str):
                response.append(piece)
        elif event_type in {"token", "text", "response_delta"}:
            piece = event.get("content", event.get("text", event.get("delta", "")))
            if isinstance(piece, str):
                response.append(piece)
        elif event_type == "done":
            message_id = str(event.get("message_id") or "")
    if not response and message_id and _server().memory is not None:
        # Same fallback as _run_scheduled_goal: a turn that produced no streamed
        # chunks still has its saved assistant message (heartbeat/automation
        # outcomes depend on the model text, not on streaming behaviour).
        messages = await _session_messages(conversation_id)
        saved = next((item.get("content", "") for item in reversed(messages)
                      if item.get("id") == message_id and item.get("role") == "assistant"), "")
        if isinstance(saved, str):
            response.append(saved)
    return "".join(response)
